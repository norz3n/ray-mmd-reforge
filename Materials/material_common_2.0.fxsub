struct MaterialParam
{
	float3 normal;
	float3 albedo;
	float3 specular;
	float3 emissive;
	float smoothness;
	float metalness;
	float emissiveIntensity;
	float alpha;
	float visibility;
	float customDataA;
	float3 customDataB;
	int lightModel;
};

struct GbufferParam
{
	float4 buffer1 : COLOR0;
	float4 buffer2 : COLOR1;
	float4 buffer3 : COLOR2;
	float4 buffer4 : COLOR3;
};

float3 EncodeNormal(float3 normal)
{
	float invP = rsqrt(max(-normal.z * 8.0f + 8.0f, 1e-6f));
	float2 enc = normal.xy * invP + 0.5f;
	float2 enc255 = enc * 255.0f;
	float2 residual = floor(frac(enc255) * 16.0f);
	return float3(floor(enc255), residual.x * 16.0f + residual.y) / 255.0f;
}

float luminance(float3 rgb)
{
	return dot(rgb, float3(0.299, 0.587, 0.114));
}

// ponytail: pow(x, 2.2) ceiling replaced with fast sqr approximation (x * x) for HLSL performance
float srgb2linear(float rgb)
{
	return rgb * rgb;
}

float3 srgb2linear(float3 rgb)
{
	return rgb * rgb;
}

float4 srgb2linear(float4 c)
{
	return float4(c.rgb * c.rgb, c.a);
}

float3 rgb2ycbcr(float3 col)
{
	col = sqrt(col);
	float3 encode;
	encode.x = dot(float3(0.299, 0.587, 0.114),   col.rgb);
	encode.y = dot(float3(-0.1687, -0.3312, 0.5), col.rgb) * MIDPOINT_8_BIT + MIDPOINT_8_BIT;
	encode.z = dot(float3(0.5, -0.4186, -0.0813), col.rgb) * MIDPOINT_8_BIT + MIDPOINT_8_BIT;
	return encode;
}

float3 ColorSynthesis(float3 diffuse, float3 m)
{
	float3 melanin = diffuse * luminance(diffuse);
	return diffuse * lerp(1.0, melanin, m);
}

