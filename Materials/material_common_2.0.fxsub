float MorphGreen : CONTROLOBJECT<string name="(self)"; string item = "G+";>;
float MorphBlue  : CONTROLOBJECT<string name="(self)"; string item = "B+";>;

static float3 MorphColor = float3(MorphRed, MorphGreen, MorphBlue);
