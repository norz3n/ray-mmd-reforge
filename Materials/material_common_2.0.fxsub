// Wyman & McGuire (I3D 2017): Hashed Alpha Testing
float HashedAlphaThreshold(float3 pos, float scale)
{
	float3 p = pos * scale;
	float maxDeriv = max(length(ddx(p)), length(ddy(p)));
	float pixScale = 1.0f / (maxDeriv + 1e-5f);
	float3 cell = floor(p * pixScale);
	float h = frac(sin(dot(cell, float3(127.1f, 311.7f, 74.7f))) * 43758.5453f);
	return clamp(h, 0.001f, 0.999f);
}

float3 HexHeightBlendWeights(float3 weights, float3 heights, float contrast = 0.2f)
{
	float3 combined = weights + heights;
	float maxH = max(max(combined.x, combined.y), combined.z);
	float3 blended = max(0.0f, combined - (maxH - contrast));
	return blended / (blended.x + blended.y + blended.z + 1e-6f);
}

float3 HexDistanceFadeWeights(float3 weights, float dist, float startDist = 15.0f, float endDist = 35.0f)
{
	float fade = saturate((dist - startDist) / max(endDist - startDist, 1e-4f));
	return lerp(weights, float3(1.0f, 0.0f, 0.0f), fade);
}

#if HEX_TILING_ENABLE || ALBEDO_MAP_HEX_TILING || NORMAL_MAP_HEX_TILING || NORMAL_SUB_MAP_HEX_TILING || SMOOTHNESS_MAP_HEX_TILING || METALNESS_MAP_HEX_TILING || OCCLUSION_MAP_HEX_TILING

float2 HexHash(float2 p)
{
	float2 p2 = frac(p * float2(443.8975f, 397.2973f));
	p2 += dot(p2, p2.yx + 19.19f);
	return frac((p2.xx + p2.yy) * p2.xy);
}

void HexTriangleGrid(out float w1, out float w2, out float w3,
                     out int2 vertex1, out int2 vertex2, out int2 vertex3,
                     float2 st)
{
	st *= 2.0f * sqrt(3.0f);
	const float2x2 gridToSkewedGrid = float2x2(1.0f, -0.57735027f, 0.0f, 1.15470054f);
	float2 skewedCoord = mul(gridToSkewedGrid, st);

	int2 baseId = int2(floor(skewedCoord));
	float3 temp = float3(frac(skewedCoord), 0.0f);
	temp.z = 1.0f - temp.x - temp.y;

	float s = step(0.0f, -temp.z);
	float s2 = 2.0f * s - 1.0f;

	w1 = -temp.z * s2;
	w2 = s - temp.y * s2;
	w3 = s - temp.x * s2;

	vertex1 = baseId + int2(s, s);
	vertex2 = baseId + int2(s, 1 - s);
	vertex3 = baseId + int2(1 - s, s);
}

float2 HexMakeCenST(int2 vertex)
{
	const float2x2 invSkewMat = float2x2(1.0f, 0.5f, 0.0f, 0.8660254f);
	return mul(invSkewMat, (float2)vertex) / (2.0f * sqrt(3.0f));
}

float2x2 HexLoadRot2x2(int2 idx, float rotStrength)
{
	float2 h = HexHash((float2)idx);
	float angle = (h.x * 2.0f - 1.0f) * 3.14159265359f * rotStrength;

	float cs = cos(angle);
	float si = sin(angle);
	return float2x2(cs, -si, si, cs);
}

float3 HexGain3(float3 x, float r)
{
	float k = log(1.0f - r) / log(0.5f);
	float3 s = 2.0f * step(0.5f, x);
	float3 m = 2.0f * (1.0f - s);
	float3 res = 0.5f * s + 0.25f * m * pow(max(0.0f, s + x * m), k);
	return res.xyz / (res.x + res.y + res.z + 1e-6f);
}

float2 HexTspaceNormalToDerivative(float3 vM)
{
	const float scale = 1.0f / 128.0f;
	const float3 vMa = abs(vM);
	const float z_ma = max(vMa.z, scale * max(vMa.x, vMa.y));
	return -float2(vM.x, vM.y) / z_ma;
}

struct HexTilingContext
{
	float3 weights;
	float2 st1, st2, st3;
	float2 dSTdx1, dSTdy1;
	float2 dSTdx2, dSTdy2;
	float2 dSTdx3, dSTdy3;
	float2x2 rot1, rot2, rot3;
};

HexTilingContext MakeHexTilingContext(float2 st, float rotStrength = 1.0f)
{
	HexTilingContext ctx;

	float2 dSTdx = ddx(st);
	float2 dSTdy = ddy(st);

	int2 vertex1, vertex2, vertex3;
	HexTriangleGrid(ctx.weights.x, ctx.weights.y, ctx.weights.z, vertex1, vertex2, vertex3, st);

	ctx.rot1 = HexLoadRot2x2(vertex1, rotStrength);
	ctx.rot2 = HexLoadRot2x2(vertex2, rotStrength);
	ctx.rot3 = HexLoadRot2x2(vertex3, rotStrength);

	float2 cen1 = HexMakeCenST(vertex1);
	float2 cen2 = HexMakeCenST(vertex2);
	float2 cen3 = HexMakeCenST(vertex3);

	ctx.st1 = mul(st - cen1, ctx.rot1) + cen1 + HexHash((float2)vertex1);
	ctx.st2 = mul(st - cen2, ctx.rot2) + cen2 + HexHash((float2)vertex2);
	ctx.st3 = mul(st - cen3, ctx.rot3) + cen3 + HexHash((float2)vertex3);

	ctx.dSTdx1 = mul(dSTdx, ctx.rot1);
	ctx.dSTdy1 = mul(dSTdy, ctx.rot1);
	ctx.dSTdx2 = mul(dSTdx, ctx.rot2);
	ctx.dSTdy2 = mul(dSTdy, ctx.rot2);
	ctx.dSTdx3 = mul(dSTdx, ctx.rot3);
	ctx.dSTdy3 = mul(dSTdy, ctx.rot3);

	return ctx;
}

float4 SampleColorHexTiled(sampler2D tex, HexTilingContext ctx, float r = 0.75f, float fallOffContrast = 0.6f, float gExp = 7.0f)
{
	float4 c1 = tex2Dgrad(tex, ctx.st1, ctx.dSTdx1, ctx.dSTdy1);
	float4 c2 = tex2Dgrad(tex, ctx.st2, ctx.dSTdx2, ctx.dSTdy2);
	float4 c3 = tex2Dgrad(tex, ctx.st3, ctx.dSTdx3, ctx.dSTdy3);

	const float3 Lw = float3(0.299f, 0.587f, 0.114f);
	float3 Dw = float3(dot(c1.rgb, Lw), dot(c2.rgb, Lw), dot(c3.rgb, Lw));
	Dw = lerp(1.0f, Dw, fallOffContrast);

	float3 W = Dw * pow(max(0.0f, ctx.weights), gExp);
	W /= (W.x + W.y + W.z + 1e-6f);
	if (r != 0.5f) W = HexGain3(W, r);

	return W.x * c1 + W.y * c2 + W.z * c3;
}

float3 SampleNormalMapHexTiled(sampler2D nmap, HexTilingContext ctx, float r = 0.5f, float fallOffContrast = 0.6f, float gExp = 7.0f)
{
	float3 n1 = tex2Dgrad(nmap, ctx.st1, ctx.dSTdx1, ctx.dSTdy1).rgb * 2.0f - 1.0f;
	float3 n2 = tex2Dgrad(nmap, ctx.st2, ctx.dSTdx2, ctx.dSTdy2).rgb * 2.0f - 1.0f;
	float3 n3 = tex2Dgrad(nmap, ctx.st3, ctx.dSTdx3, ctx.dSTdy3).rgb * 2.0f - 1.0f;

	float2 d1 = mul(ctx.rot1, HexTspaceNormalToDerivative(n1));
	float2 d2 = mul(ctx.rot2, HexTspaceNormalToDerivative(n2));
	float2 d3 = mul(ctx.rot3, HexTspaceNormalToDerivative(n3));

	float3 D = float3(dot(d1, d1), dot(d2, d2), dot(d3, d3));
	float3 Dw = sqrt(D / (1.0f + D));
	Dw = lerp(1.0f, Dw, fallOffContrast);

	float3 W = Dw * pow(max(0.0f, ctx.weights), gExp);
	W /= (W.x + W.y + W.z + 1e-6f);
	if (r != 0.5f) W = HexGain3(W, r);

	float2 blendedDeriv = W.x * d1 + W.y * d2 + W.z * d3;
	return normalize(float3(-blendedDeriv.xy, 1.0f));
}

float4 SampleColorHexTiled(sampler2D tex, float2 st, float rotStrength = 1.0f, float r = 0.75f, float fallOffContrast = 0.6f, float gExp = 7.0f)
{
	HexTilingContext ctx = MakeHexTilingContext(st, rotStrength);
	return SampleColorHexTiled(tex, ctx, r, fallOffContrast, gExp);
}

float3 SampleNormalMapHexTiled(sampler2D nmap, float2 st, float rotStrength = 1.0f, float r = 0.5f, float fallOffContrast = 0.6f, float gExp = 7.0f)
{
	HexTilingContext ctx = MakeHexTilingContext(st, rotStrength);
	return SampleNormalMapHexTiled(nmap, ctx, r, fallOffContrast, gExp);
}

#endif // HEX_TILING_ENABLE

// ponytail: Triplanar projection helper for sampling textures without UV unwrap
float4 SampleTriplanar(sampler texSamp, float3 worldPos, float3 worldNormal, float scale)
{
	float3 blend = abs(worldNormal);
	blend /= (blend.x + blend.y + blend.z + 1e-5);

	float4 x = tex2D(texSamp, worldPos.yz * scale);
	float4 y = tex2D(texSamp, worldPos.xz * scale);
	float4 z = tex2D(texSamp, worldPos.xy * scale);

	return x * blend.x + y * blend.y + z * blend.z;
}

#if NORMAL_MAP_FROM || NORMAL_SUB_MAP_FROM || PROCEDURAL_HAIR > 0
float3 ComputeTangentBinormalNormal(float3 N, float3 P, float2 coord, float3 tangentNormal)
{
	float3 dp1 = ddx(P);
	float3 dp2 = ddy(P);
	float2 duv1 = ddx(coord);
	float2 duv2 = ddy(coord);

	float3x3 M = float3x3(dp1, dp2, N);
	float2x3 I = float2x3(cross(M[1], M[2]), cross(M[2], M[0]));
	float3 T = mul(float2(duv1.x, duv2.x), I);
	float3 B = mul(float2(duv1.y, duv2.y), I);

	float3x3 tbnTransform;
	tbnTransform[0] = T * rsqrt(dot(T, T) + 1e-6f);
	tbnTransform[1] = -B * rsqrt(dot(B, B) + 1e-6f);
	tbnTransform[2] = N;

	return normalize(mul(tangentNormal, tbnTransform));
}

float3 RNMBlendUnpacked(float3 n1, float3 n2)
{
	n1 += float3( 0,  0, 1);
	n2 *= float3(-1, -1, 1);
	return normalize(n1 * dot(n1, n2) / n1.z - n2);
}

#if NORMAL_MAP_TYPE == 2 || NORMAL_SUB_MAP_TYPE == 2
float3 PerturbNormalLQ(float3 N, float3 P, float height)
{
	float3 dp1 = ddx(P);
	float3 dp2 = ddy(P);

	float3x3 M = float3x3(dp1, dp2, N);
	float2x3 I = float2x3(cross(M[1], M[2]), cross(M[2], M[0]));

	float det = dot(dp1, I[0]);

	float slope1 = ddx(height);
	float slope2 = ddy(height);

	float3 surf = sign(det) * mul(float2(slope1, slope2), I);
	return normalize(abs(det) * N - surf);
}
#endif

#if NORMAL_MAP_TYPE == 3 || NORMAL_SUB_MAP_TYPE == 3
float3 PerturbNormalHQ(sampler source, float2 coord)
{
	float e = 0.001; // Fixed texel offset for camera independence
	float center = tex2D(source, coord).x;
	float right = tex2D(source, coord + float2(e, 0)).x;
	float bottom = tex2D(source, coord + float2(0, e)).x;

	float slope1 = center - right;
	float slope2 = center - bottom;

	// Scale slopes to match the visual intensity of LQ bump mapping
	float bumpIntensity = 50.0;
	return normalize(float3(slope1 * bumpIntensity, slope2 * bumpIntensity, 1.0));
}
#endif

#if NORMAL_MAP_TYPE == 5 || NORMAL_SUB_MAP_TYPE == 5
// ponytail: Ultra Quality bump mapping using Sobel filter (9 texture fetches)
float3 PerturbNormalUltra(sampler source, float2 coord)
{
	float e = 0.001; // Fixed texel offset
	
	// Top row
	float tl = tex2D(source, coord + float2(-e, -e)).x;
	float tc = tex2D(source, coord + float2( 0, -e)).x;
	float tr = tex2D(source, coord + float2( e, -e)).x;
	
	// Middle row
	float ml = tex2D(source, coord + float2(-e,  0)).x;
	float mr = tex2D(source, coord + float2( e,  0)).x;
	
	// Bottom row
	float bl = tex2D(source, coord + float2(-e,  e)).x;
	float bc = tex2D(source, coord + float2( 0,  e)).x;
	float br = tex2D(source, coord + float2( e,  e)).x;

	// Compute Sobel gradients (inverted to match normal mapping conventions)
	float slopeX = (tl + 2.0 * ml + bl) - (tr + 2.0 * mr + br);
	float slopeY = (tl + 2.0 * tc + tr) - (bl + 2.0 * bc + br);
	
	// Normalize by 8.0 for Sobel weight sum. 
	// Multiply by 50.0 to match visual intensity of LQ bump mapping.
	float bumpIntensity = 50.0 / 8.0;
	return normalize(float3(slopeX * bumpIntensity, slopeY * bumpIntensity, 1.0));
}
#endif
#endif

#if PARALLAX_MAP_FROM
float GetParallaxOcclusionHeight(sampler heightMap, float2 coord)
{
#if PARALLAX_MAP_SWIZZLE == 1
	return tex2D(heightMap, coord).g;
#elif PARALLAX_MAP_SWIZZLE == 2
	return tex2D(heightMap, coord).b;
#elif PARALLAX_MAP_SWIZZLE == 3
	return tex2D(heightMap, coord).a;
#else
	return tex2D(heightMap, coord).r;
#endif
}

float3 ParallaxOcclusionDirection(float3 normal, float3 worldPos, float2 coord)
{
	float3 viewNormal = mul(normal, (float3x3)matWorldView);
	float3 viewPosition = mul(float4(worldPos, 1), matWorldView).xyz;
	float3 viewdir = normalize(-viewPosition);

	float3 dp1 = ddx(viewPosition);
	float3 dp2 = ddy(viewPosition);

	float2 duv1 = ddx(coord);
	float2 duv2 = ddy(coord);

	float3x3 M = float3x3(dp1, dp2, viewNormal);
	float2x3 I = float2x3(cross(M[1], M[2]), cross(M[2], M[0]));
	   
	float2 proj = mul(I, viewdir) / dot(dp1, I[0]);

	float3 direction;
	direction.xy = duv1 * proj.x + duv2 * proj.y;
	direction.z = dot(viewNormal, viewdir);

	return direction;
}

float2 ParallaxOcclusionMap(sampler heightMap, float2 coord, float3 V, int numSteps, float parallaxScale)
{
	float step = 1.0 / numSteps;
	float2 delta = parallaxScale * V.xy / (-V.z * numSteps);

	float curLayerHeight = 0;
	float curHeight = GetParallaxOcclusionHeight(heightMap, coord);
	float2 curTexcoord = coord;

	// ponytail: using [loop] instead of [unroll] prevents 20-fold unrolled texture samples ceiling
	[loop]
	for (int i = 0; i < numSteps; i++)
	{
		if (curHeight <= curLayerHeight)
			break;

		curLayerHeight += step; 
		curTexcoord -= delta;
		curHeight = GetParallaxOcclusionHeight(heightMap, curTexcoord);
	}

	float2 deltaTexcoord = delta * 0.5;
	float deltaHeight = step * 0.5;

	curTexcoord += deltaTexcoord;
	curLayerHeight -= deltaHeight;

	[loop]
	for (int j = 0; j < 5; j++)
	{
		deltaTexcoord *= 0.5;
		deltaHeight *= 0.5;

		curHeight = GetParallaxOcclusionHeight(heightMap, curTexcoord);

		if (curHeight > curLayerHeight)
		{
			curTexcoord -= deltaTexcoord;
			curLayerHeight += deltaHeight;
		}
		else
		{
			curTexcoord += deltaTexcoord;
			curLayerHeight -= deltaHeight;
		}
	}

	return curTexcoord;
}

float ParallaxSelfShadow(sampler heightMap, float2 coord, float3 L, float initialHeight, float parallaxScale, int numShadowSteps = 8)
{
	if (L.z <= 0.0f) return 0.0f;
	float step = (1.0f - initialHeight) / (float)numShadowSteps;
	float2 delta = parallaxScale * L.xy / (max(L.z, 0.05f) * (float)numShadowSteps);

	float curLayerHeight = initialHeight + step * 0.5f;
	float2 curTexcoord = coord + delta * 0.5f;
	float shadow = 1.0f;

	[loop]
	for (int i = 0; i < numShadowSteps; i++)
	{
		float h = GetParallaxOcclusionHeight(heightMap, curTexcoord);
		if (h > curLayerHeight)
		{
			float occlusion = (h - curLayerHeight) * (1.0f - float(i) / (float)numShadowSteps);
			shadow = min(shadow, saturate(1.0f - occlusion * 4.0f));
			if (shadow <= 0.01f) break;
		}
		curLayerHeight += step;
		curTexcoord += delta;
	}
	return shadow;
}
#endif

/**
 * Cornea Refraction & Iris Parallax Mapping (based on Jimenez / Next-Gen Eye Shading).
 * Computes Snell's law refraction through the corneal dome into the anterior chamber,
 * offsetting the 2D iris texture to create realistic depth, limbal darkening, and caustic focus.
 */
float2 ComputeCorneaIrisParallax(float2 uv, float3 viewDir, float3 normal, float irisDepth, float corneaIOR, out float outCaustic, out float outLimbal)
{
	// Refract view ray through the corneal dome (Air -> Cornea IOR)
	float eta = 1.0f / max(corneaIOR, 1.0f);
	float3 refrRay = refract(-viewDir, normal, eta);
	if (all(refrRay == 0.0f))
		refrRay = -viewDir;

	// Parallax shift into anterior chamber
	float2 uvOffset = (refrRay.xy / max(abs(refrRay.z), 0.25f)) * irisDepth;
	float2 refractedUV = uv + uvOffset;

	// Limbal ring darkening (dark perimeter around iris boundary)
	float2 centeredUV = (uv - 0.5f) * 2.0f;
	float distFromCenter = length(centeredUV);
	outLimbal = saturate(smoothstep(0.98f, 0.70f, distFromCenter) + 0.35f);

	// Iris caustic highlight (light focus on the opposite side of the pupil)
	outCaustic = saturate(pow(saturate(dot(refrRay, normal) * 0.5f + 0.5f), 2.5f) * 1.5f);

	return refractedUV;
}

/**
 * Procedural Micro-Glitter / Sparkle Generator (Stochastic Micro-Flake Distribution).
 * Simulates glittering flakes and crystals on metallic fabrics, cosmetics, snow, and car paint.
 * Evaluates random micro-normal orientations per cell that flash when aligned with the half-vector H.
 */
float ComputeMicroGlitterSparkle(float3 worldPos, float3 N, float3 H, float flakeDensity = 120.0f, float flakeRoughness = 0.55f, float sparkleIntensity = 2.5f)
{
	float3 cellCoord = floor(worldPos * flakeDensity);
	// High-quality branchless 3D pseudo-random hash
	float3 hash = frac(sin(float3(
		dot(cellCoord, float3(12.9898f, 78.233f, 45.164f)),
		dot(cellCoord, float3(39.346f, 11.135f, 83.156f)),
		dot(cellCoord, float3(73.156f, 52.235f, 29.178f))
	)) * 43758.5453f) * 2.0f - 1.0f;

	// Perturb surface normal with stochastic flake orientation
	float3 flakeNormal = normalize(N + hash * flakeRoughness);
	float NdotH = saturate(dot(flakeNormal, H));

	// Sharp microfacet specular response (flash when facing H)
	float sparkle = pow(NdotH, 120.0f) * sparkleIntensity;
	return sparkle;
}

float SmoothnessToRoughness(float smoothness)
{
	return (1.0f - smoothness) * (1.0f - smoothness);
}

float RoughnessToSmoothness(float roughness)
{
	return 1.0f - sqrt(roughness);
}

float ShininessToSmoothness(float spec)
{
	return 1.0f - pow(max(0, 2.0 / (spec + 2)), 0.125);
}

GbufferParam EncodeGbuffer(MaterialParam material, float linearDepth)
{
	GbufferParam gbuffer;
	gbuffer.buffer1.xyz = material.albedo * (1 - material.metalness);
	gbuffer.buffer1.w = material.smoothness;

	material.normal = mul(material.normal, (float3x3)matWorldView);
#if CONVEX_NORMAL
	material.normal.xy = -material.normal.xy;
#endif
	material.normal = normalize(material.normal);

	gbuffer.buffer2.xyz = EncodeNormal(material.normal);
	gbuffer.buffer2.w = material.customDataA;

	gbuffer.buffer3.xyz = lerp(material.specular, max(0.02, material.albedo), material.metalness);
	gbuffer.buffer3.w = 0;

#if CUSTOM_ENABLE || EMISSIVE_ENABLE
	if (material.lightModel != SHADINGMODELID_DEFAULT)
	{
#if EMISSIVE_ENABLE
		material.customDataB = material.emissive;
#elif CUSTOM_ENABLE != SHADINGMODELID_GLASS
		material.customDataB *= (1 - material.metalness);
#endif
		gbuffer.buffer3 = float4(luminance(gbuffer.buffer3.xyz), material.customDataB);
	}
#endif

	gbuffer.buffer4 = float4(linearDepth, material.emissiveIntensity, material.visibility, material.lightModel);
	gbuffer.buffer4.w += material.alpha * MAX_FRACTIONAL_8_BIT;

	return gbuffer;
}

// ponytail: helper function for single-pass UV transformation
float2 TransformUV(float2 coord, int flipMode)
{
	if (flipMode == 1) coord.x = 1.0 - coord.x;
	else if (flipMode == 2) coord.y = 1.0 - coord.y;
	else if (flipMode == 3) coord = 1.0 - coord;
	return coord;
}

#ifndef TRIPLANAR_ENABLE
#define TRIPLANAR_ENABLE 0
#endif

float3 GetAlbedo(float2 coord, float3 worldPos, float3 normal)
{
#if TRIPLANAR_ENABLE
	float3 albedoColor = SampleTriplanar(AlbedoMapSamp, worldPos, normal, triplanarScale).rgb;
#elif ALBEDO_MAP_FROM
	#if ALBEDO_MAP_UV_FLIP
		coord = TransformUV(coord, ALBEDO_MAP_UV_FLIP);
	#endif

	#if ALBEDO_MAP_FROM == 3
		#if ALBEDO_MAP_HEX_TILING
			float3 albedoColor = use_texture ? SampleColorHexTiled(AlbedoMapSamp, coord * albedoMapLoopNum, HEX_TILING_ROTATION, 0.75f, HEX_TILING_CONTRAST, HEX_TILING_SHARPNESS).rgb : MaterialDiffuse.rgb;
		#else
			float3 albedoColor = use_texture ? tex2D(AlbedoMapSamp, coord * albedoMapLoopNum).rgb : MaterialDiffuse.rgb;
		#endif
	#elif ALBEDO_MAP_FROM == 4
		float3 albedoColor = use_spheremap ? tex2D(AlbedoMapSamp, coord * albedoMapLoopNum).rgb : MaterialDiffuse.rgb;
	#elif ALBEDO_MAP_FROM == 5
		float3 albedoColor = use_toon ? tex2D(AlbedoMapSamp, coord * albedoMapLoopNum).rgb : MaterialDiffuse.rgb;
	#elif ALBEDO_MAP_FROM == 7
		float3 albedoColor = use_texture ? tex2D(AlbedoMapSamp, coord * albedoMapLoopNum).rgb : MaterialAmbient.rgb;
	#elif ALBEDO_MAP_FROM == 8
		float3 albedoColor = use_texture ? tex2D(AlbedoMapSamp, coord * albedoMapLoopNum).rgb : MaterialSpecular.rgb;
	#elif ALBEDO_MAP_FROM == 9
		#error Unsupported options 9.
	#else
		#if ALBEDO_MAP_HEX_TILING
			float3 albedoColor = SampleColorHexTiled(AlbedoMapSamp, coord * albedoMapLoopNum, HEX_TILING_ROTATION, 0.75f, HEX_TILING_CONTRAST, HEX_TILING_SHARPNESS).rgb;
		#else
			float3 albedoColor = tex2D(AlbedoMapSamp, coord * albedoMapLoopNum).rgb;
		#endif
	#endif

	#if ALBEDO_MAP_APPLY_DIFFUSE
		#if ALBEDO_MAP_FROM == 3
			albedoColor *= use_texture ? MaterialDiffuse.rgb : 1.0;
		#elif ALBEDO_MAP_FROM == 4
			albedoColor *= use_spheremap ? MaterialDiffuse.rgb : 1.0;
		#elif ALBEDO_MAP_FROM == 5
			albedoColor *= use_toon ? MaterialDiffuse.rgb : 1.0;
		#else
			albedoColor *= MaterialDiffuse.rgb;
		#endif
	#endif

	albedoColor = srgb2linear(albedoColor);

	#if ALBEDO_MAP_APPLY_SCALE == 1
		albedoColor *= albedo;
	#elif ALBEDO_MAP_APPLY_SCALE == 2
		albedoColor = pow(albedoColor, albedo);
	#endif

	#if ALBEDO_MAP_APPLY_MORPH_COLOR
		albedoColor *= MorphColor;
	#endif

#ifdef GLASS_TINT_EXPONENT
	// Tinted glass (ALBEDO_MAP_APPLY_DIFFUSE): compress albedo toward white so transmission
	// stays strongly transparent while keeping the hue; lower exponent = clearer glass
	albedoColor = pow(albedoColor, GLASS_TINT_EXPONENT);
#endif

	return albedoColor;
#else
	float3 albedoColor = albedo;
	#if ALBEDO_MAP_APPLY_DIFFUSE
		albedoColor *= srgb2linear(MaterialDiffuse.rgb);
	#endif
	#if ALBEDO_MAP_APPLY_MORPH_COLOR
		albedoColor *= MorphColor;
	#endif
#ifdef GLASS_TINT_EXPONENT
	albedoColor = pow(albedoColor, GLASS_TINT_EXPONENT);
#endif
	return albedoColor;
#endif
}

float3 GetSubAlbedo(float3 albedo, float2 coord)
{
#if ALBEDO_SUB_ENABLE
	#if ALBEDO_SUB_MAP_FROM
		#if ALBEDO_SUB_MAP_UV_FLIP
			coord = TransformUV(coord, ALBEDO_SUB_MAP_UV_FLIP);
		#endif

		#if ALBEDO_SUB_MAP_FROM == 3
			float4 albedoSubColor = use_texture ? tex2D(AlbedoSubMapSamp, coord * albedoSubMapLoopNum) : MaterialDiffuse;
		#elif ALBEDO_SUB_MAP_FROM == 4
			float4 albedoSubColor = use_spheremap ? tex2D(AlbedoSubMapSamp, coord * albedoSubMapLoopNum) : MaterialDiffuse;
		#elif ALBEDO_SUB_MAP_FROM == 5
			float4 albedoSubColor = use_toon ? tex2D(AlbedoSubMapSamp, coord * albedoSubMapLoopNum) : MaterialDiffuse;
		#elif ALBEDO_SUB_MAP_FROM == 7
			float4 albedoSubColor = MaterialAmbient;
		#elif ALBEDO_SUB_MAP_FROM == 8
			float4 albedoSubColor = MaterialSpecular;
		#elif ALBEDO_SUB_MAP_FROM == 9
			#error Unsupported options 9.
		#else
			float4 albedoSubColor = tex2D(AlbedoSubMapSamp, coord * albedoSubMapLoopNum);
		#endif

		#if ALBEDO_SUB_MAP_APPLY_SCALE == 1
			albedoSubColor.rgb *= albedoSub;
		#elif ALBEDO_SUB_MAP_APPLY_SCALE == 2
			albedoSubColor.rgb = pow(albedoSubColor.rgb, albedoSub);
		#endif
	#else
		float4 albedoSubColor = float4(albedoSub, 1);
	#endif

	#if ALBEDO_SUB_ENABLE == 1
		albedo *= albedoSubColor.rgb;
	#elif ALBEDO_SUB_ENABLE == 2
		albedo = pow(albedo, albedoSubColor.rgb);
	#elif ALBEDO_SUB_ENABLE == 3
		albedo += albedoSubColor.rgb;
	#elif ALBEDO_SUB_ENABLE == 4
		albedo = ColorSynthesis(albedo, albedoSubColor.rgb);
	#elif ALBEDO_SUB_ENABLE == 5
		albedo = lerp(albedo, albedoSubColor.rgb, albedoSubColor.a);
	#endif

	return saturate(albedo);
#else
	return saturate(albedo);
#endif
}

float GetAlpha(float2 coord)
{
#if ALPHA_MAP_FROM
	#if ALPHA_MAP_UV_FLIP
		coord = TransformUV(coord, ALPHA_MAP_UV_FLIP);
	#endif

	#if ALPHA_MAP_FROM == 3
		float4 alphaValues = use_texture ? tex2D(AlphaMapSamp, coord * alphaMapLoopNum) * MaterialDiffuse.a : MaterialDiffuse.a;
	#elif ALPHA_MAP_FROM == 4
		float4 alphaValues = use_spheremap ? tex2D(AlphaMapSamp, coord * alphaMapLoopNum) * MaterialDiffuse.a : MaterialDiffuse.a;
	#elif ALPHA_MAP_FROM == 5
		float4 alphaValues = use_toon ? tex2D(AlphaMapSamp, coord * alphaMapLoopNum) * MaterialDiffuse.a : MaterialDiffuse.a;
	#elif ALPHA_MAP_FROM == 7
		float4 alphaValues = MaterialAmbient;
	#elif ALPHA_MAP_FROM == 8
		float4 alphaValues = MaterialSpecular;
	#elif ALPHA_MAP_FROM == 9
		#error Unsupported options 9.
	#else
		float4 alphaValues = tex2D(AlphaMapSamp, coord * alphaMapLoopNum);
	#endif

	#if ALPHA_MAP_SWIZZLE == 0
		float alphaValue = alphaValues.r;
	#elif ALPHA_MAP_SWIZZLE == 1
		float alphaValue = alphaValues.g;
	#elif ALPHA_MAP_SWIZZLE == 2
		float alphaValue = alphaValues.b;
	#else
		float alphaValue = alphaValues.a;
	#endif

	return saturate(alphaValue);
#else
	return saturate(alpha * MaterialDiffuse.a);
#endif
}

float3 GetMainNormal(float3 N, float3 P, float2 coord)
{
#if NORMAL_MAP_FROM
	#if NORMAL_MAP_UV_FLIP == 1
		coord.x = 1 - coord.x;
	#elif NORMAL_MAP_UV_FLIP == 2
		coord.y = 1 - coord.y;
	#elif NORMAL_MAP_UV_FLIP == 3
		coord = 1 - coord;
	#endif

	#if NORMAL_MAP_FROM == 3
		#if NORMAL_MAP_HEX_TILING
			float3 tangentNormal = use_texture ? SampleNormalMapHexTiled(NormalMapSamp, coord * normalMapLoopNum, HEX_TILING_ROTATION, 0.5f, HEX_TILING_CONTRAST, HEX_TILING_SHARPNESS) : float3(0, 0, 1);
		#else
			float3 tangentNormal = use_texture ? tex2D(NormalMapSamp, coord * normalMapLoopNum).rgb * 2 - 1 : float3(0, 0, 1);
		#endif
	#elif NORMAL_MAP_FROM == 4
		float3 tangentNormal = use_spheremap ? tex2D(NormalMapSamp, coord * normalMapLoopNum).rgb * 2 - 1 : float3(0, 0, 1);
	#elif NORMAL_MAP_FROM == 5
		float3 tangentNormal = use_toon ? tex2D(NormalMapSamp, coord * normalMapLoopNum).rgb * 2 - 1 : float3(0, 0, 1);
	#elif NORMAL_MAP_FROM == 7 || NORMAL_MAP_FROM == 8 || NORMAL_MAP_FROM == 9
		#error Unsupported options 7, 8, 9.
	#else
		#if NORMAL_MAP_HEX_TILING
			float3 tangentNormal = SampleNormalMapHexTiled(NormalMapSamp, coord * normalMapLoopNum, HEX_TILING_ROTATION, 0.5f, HEX_TILING_CONTRAST, HEX_TILING_SHARPNESS);
		#else
			float3 tangentNormal = tex2D(NormalMapSamp, coord * normalMapLoopNum).rgb * 2 - 1;
		#endif
	#endif

	#if NORMAL_MAP_TYPE == 1
		tangentNormal.z = sqrt(1.0 - tangentNormal.x * tangentNormal.x - tangentNormal.y * tangentNormal.y);
	#elif NORMAL_MAP_TYPE == 3
		tangentNormal = PerturbNormalHQ(NormalMapSamp, coord * normalMapLoopNum);
	#elif NORMAL_MAP_TYPE == 5
		tangentNormal = PerturbNormalUltra(NormalMapSamp, coord * normalMapLoopNum);
	#elif NORMAL_MAP_TYPE == 2
		tangentNormal = PerturbNormalLQ(N, P, tangentNormal.x * normalMapScale);
		#if NORMAL_SUB_MAP_FROM
			#error Unsupported bump map (Low Quality) with second normal map. Please set NORMAL_SUB_MAP_FROM to 0.
		#endif
	#endif

	#if NORMAL_MAP_TYPE != 2
		tangentNormal.rg *= normalMapScale;
		tangentNormal = normalize(tangentNormal);
	#endif

#if DETAIL_MAP_ENABLE
	float detailDist = distance(P, CameraPosition);
	float detailFade = saturate(1.0f - detailDist / max(DETAIL_MAP_FADE_DIST, 1e-3f));
	if (detailFade > 0.0f)
	{
		float3 detailN = tex2D(DetailNormalMapSamp, coord * DETAIL_NORMAL_MAP_LOOP_NUM).rgb * 2.0f - 1.0f;
		detailN.xy *= DETAIL_NORMAL_MAP_SCALE * detailFade;
		detailN = normalize(detailN);
		tangentNormal = RNMBlendUnpacked(tangentNormal, detailN);
	}
#endif

	return tangentNormal;
#elif DETAIL_MAP_ENABLE
	float detailDist = distance(P, CameraPosition);
	float detailFade = saturate(1.0f - detailDist / max(DETAIL_MAP_FADE_DIST, 1e-3f));
	if (detailFade > 0.0f)
	{
		float3 detailN = tex2D(DetailNormalMapSamp, coord * DETAIL_NORMAL_MAP_LOOP_NUM).rgb * 2.0f - 1.0f;
		detailN.xy *= DETAIL_NORMAL_MAP_SCALE * detailFade;
		return normalize(detailN);
	}
	return float3(0, 0, 1);
#else
	return float3(0, 0, 1);
#endif
}

float3 GetSubNormal(float3 N, float3 P, float2 coord)
{
#if NORMAL_SUB_MAP_FROM
	#if NORMAL_SUB_MAP_UV_FLIP == 1
		coord.x = 1 - coord.x;
	#elif NORMAL_SUB_MAP_UV_FLIP == 2
		coord.y = 1 - coord.y;
	#elif NORMAL_SUB_MAP_UV_FLIP == 3
		coord = 1 - coord;
	#endif

	#if NORMAL_SUB_MAP_FROM == 3
		#if NORMAL_SUB_MAP_HEX_TILING
			float3 tangentNormal = use_texture ? SampleNormalMapHexTiled(NormalSubMapSamp, coord * normalSubMapLoopNum, HEX_TILING_ROTATION, 0.5f, HEX_TILING_CONTRAST, HEX_TILING_SHARPNESS) * 0.5 + 0.5 : float3(0.5, 0.5, 1);
		#else
			float3 tangentNormal = use_texture ? tex2D(NormalSubMapSamp, coord * normalSubMapLoopNum).rgb : float3(0, 0, 1);
		#endif
	#elif NORMAL_SUB_MAP_FROM == 4
		float3 tangentNormal = use_spheremap ? tex2D(NormalSubMapSamp, coord * normalSubMapLoopNum).rgb : float3(0, 0, 1);
	#elif NORMAL_SUB_MAP_FROM == 5
		float3 tangentNormal = use_toon ? tex2D(NormalSubMapSamp, coord * normalSubMapLoopNum).rgb : float3(0, 0, 1);
	#elif NORMAL_SUB_MAP_FROM == 7 || NORMAL_SUB_MAP_FROM == 8 || NORMAL_SUB_MAP_FROM == 9
		#error Unsupported options 7, 8, 9.
	#else
		#if NORMAL_SUB_MAP_HEX_TILING
			float3 tangentNormal = SampleNormalMapHexTiled(NormalSubMapSamp, coord * normalSubMapLoopNum, HEX_TILING_ROTATION, 0.5f, HEX_TILING_CONTRAST, HEX_TILING_SHARPNESS) * 0.5 + 0.5;
		#else
			float3 tangentNormal = tex2D(NormalSubMapSamp, coord * normalSubMapLoopNum).rgb;
		#endif
	#endif

	#if NORMAL_SUB_MAP_TYPE != 4
		tangentNormal = tangentNormal * 2 - 1;
	#endif

	#if NORMAL_SUB_MAP_TYPE == 1
		tangentNormal.z = sqrt(1.0 - tangentNormal.x * tangentNormal.x - tangentNormal.y * tangentNormal.y);
	#elif NORMAL_SUB_MAP_TYPE == 3
		tangentNormal = PerturbNormalHQ(NormalSubMapSamp, coord * normalSubMapLoopNum, tangentNormal.x);
	#elif NORMAL_SUB_MAP_TYPE == 5
		tangentNormal = PerturbNormalUltra(NormalSubMapSamp, coord * normalSubMapLoopNum);
	#elif NORMAL_SUB_MAP_TYPE == 2
		tangentNormal = PerturbNormalLQ(N, P, tangentNormal.x * normalSubMapScale);
		#if NORMAL_MAP_FROM
			#error Unsupported bump map (Low Quality) with second normal map. Please set NORMAL_MAP_FROM to 0.
		#endif
	#endif

	#if NORMAL_SUB_MAP_TYPE != 2
		tangentNormal.rg *= normalSubMapScale;
		tangentNormal = normalize(tangentNormal);
	#endif

	return tangentNormal;
#else
	return float3(0, 0, 1);
#endif
}

float3 GetNormal(float3 N, float3 P, float2 coord)
{
#if NORMAL_MAP_UV_FLIP == 4
	N.x *= -1;
#endif
#if NORMAL_MAP_FROM || NORMAL_SUB_MAP_FROM
	#if NORMAL_MAP_FROM && NORMAL_SUB_MAP_FROM && (NORMAL_MAP_TYPE == 4 || NORMAL_SUB_MAP_TYPE == 4)
		#error "Unsupported option"
	#endif

	#if NORMAL_MAP_FROM
		float3 tangentNormal1 = GetMainNormal(N, P, coord);
	#endif

	#if NORMAL_SUB_MAP_FROM
		float3 tangentNormal2 = GetSubNormal(N, P, coord);
	#endif

	#if NORMAL_MAP_FROM && NORMAL_SUB_MAP_FROM
		float3 tangentNormal = RNMBlendUnpacked(tangentNormal1, tangentNormal2);
	#elif NORMAL_MAP_FROM
		float3 tangentNormal = tangentNormal1;
	#elif NORMAL_SUB_MAP_FROM
		float3 tangentNormal = tangentNormal2;
	#else
		float3 tangentNormal = float3(0, 0, 1);
	#endif

	#if (NORMAL_MAP_FROM && (NORMAL_MAP_TYPE == 2 || NORMAL_MAP_TYPE == 4)) || (NORMAL_SUB_MAP_FROM && (NORMAL_SUB_MAP_TYPE == 2 || NORMAL_SUB_MAP_TYPE == 4))
		return tangentNormal;
	#else
		#if NORMAL_MAP_UV_FLIP == 1
			coord.x = 1 - coord.x;
		#elif NORMAL_MAP_UV_FLIP == 2
			coord.y = 1 - coord.y;
		#elif NORMAL_MAP_UV_FLIP == 3
			coord = 1 - coord;
		#endif

		#ifndef PROCEDURAL_HAIR
		#define PROCEDURAL_HAIR 0
		#endif

		#if PROCEDURAL_HAIR > 0
			#ifndef PROCEDURAL_HAIR_SCALE
			#define PROCEDURAL_HAIR_SCALE 1.0
			#endif
			#ifndef PROCEDURAL_HAIR_INTENSITY
			#define PROCEDURAL_HAIR_INTENSITY 0.5
			#endif
			
			float nx = coord.x * PROCEDURAL_HAIR_SCALE * 10000.0;
			float hairNoise = sin(nx) * 0.4 + sin(nx * 1.732) * 0.3 + sin(nx * 3.1415) * 0.3;
			
			float fw = fwidth(nx);
			hairNoise *= saturate(exp(-fw * 0.2));

			float3 T_fake = cross(N, float3(0.0, 1.0, 0.0));
			if (dot(T_fake, T_fake) < 0.001) T_fake = float3(1.0, 0.0, 0.0);
			T_fake = normalize(T_fake);

			return normalize(N + T_fake * hairNoise * PROCEDURAL_HAIR_INTENSITY);
		#endif

		return ComputeTangentBinormalNormal(N, P, coord, tangentNormal);
	#endif
#else
	#ifndef PROCEDURAL_HAIR
	#define PROCEDURAL_HAIR 0
	#endif

	#if PROCEDURAL_HAIR > 0
		#ifndef PROCEDURAL_HAIR_SCALE
		#define PROCEDURAL_HAIR_SCALE 1.0
		#endif
		#ifndef PROCEDURAL_HAIR_INTENSITY
		#define PROCEDURAL_HAIR_INTENSITY 0.5
		#endif

		float nx = coord.x * PROCEDURAL_HAIR_SCALE * 10000.0;
		float hairNoise = sin(nx) * 0.4 + sin(nx * 1.732) * 0.3 + sin(nx * 3.1415) * 0.3;
		
		// Anti-aliasing and seam hiding: fade out noise where UVs jump or density is too high
		float fw = fwidth(nx);
		hairNoise *= saturate(exp(-fw * 0.2)); 

		// Generate a stable tangent vector (horizontal to the vertical hair flow)
		float3 T_fake = cross(N, float3(0.0, 1.0, 0.0));
		if (dot(T_fake, T_fake) < 0.001) T_fake = float3(1.0, 0.0, 0.0);
		T_fake = normalize(T_fake);

		return normalize(N + T_fake * hairNoise * PROCEDURAL_HAIR_INTENSITY);
	#else
		return N;
	#endif
#endif
}

float GetSmoothness(float2 coord)
{
#if SMOOTHNESS_MAP_FROM
	#if SMOOTHNESS_MAP_UV_FLIP == 1
		coord.x = 1 - coord.x;
	#elif SMOOTHNESS_MAP_UV_FLIP == 2
		coord.y = 1 - coord.y;
	#elif SMOOTHNESS_MAP_UV_FLIP == 3
		coord = 1 - coord;
	#endif

	#if SMOOTHNESS_MAP_FROM == 3
		#if SMOOTHNESS_MAP_HEX_TILING
			float4 smoothnessValues = use_texture ? SampleColorHexTiled(SmoothnessMapSamp, coord * smoothnessMapLoopNum, HEX_TILING_ROTATION, 0.75f, HEX_TILING_CONTRAST, HEX_TILING_SHARPNESS) : 0;
		#else
			float4 smoothnessValues = use_texture ? tex2D(SmoothnessMapSamp, coord * smoothnessMapLoopNum) : 0;
		#endif
	#elif SMOOTHNESS_MAP_FROM == 4
		float4 smoothnessValues = use_spheremap ? tex2D(SmoothnessMapSamp, coord * smoothnessMapLoopNum) : 0;
	#elif SMOOTHNESS_MAP_FROM == 5
		float4 smoothnessValues = use_toon ? tex2D(SmoothnessMapSamp, coord * smoothnessMapLoopNum) : 0;
	#elif SMOOTHNESS_MAP_FROM == 7
		float4 smoothnessValues = MaterialAmbient;
	#elif SMOOTHNESS_MAP_FROM == 8
		float4 smoothnessValues = MaterialSpecular;
	#elif SMOOTHNESS_MAP_FROM == 9
		float4 smoothnessValues = ShininessToSmoothness(MaterialPower);
	#else
		#if SMOOTHNESS_MAP_HEX_TILING
			float4 smoothnessValues = SampleColorHexTiled(SmoothnessMapSamp, coord * smoothnessMapLoopNum, HEX_TILING_ROTATION, 0.75f, HEX_TILING_CONTRAST, HEX_TILING_SHARPNESS);
		#else
			float4 smoothnessValues = tex2D(SmoothnessMapSamp, coord * smoothnessMapLoopNum);
		#endif
	#endif

	#if SMOOTHNESS_MAP_SWIZZLE == 1
		float smoothnessValue = smoothnessValues.g;
	#elif SMOOTHNESS_MAP_SWIZZLE == 2
		float smoothnessValue = smoothnessValues.b;
	#elif SMOOTHNESS_MAP_SWIZZLE == 3
		float smoothnessValue = smoothnessValues.a;
	#else
		float smoothnessValue = smoothnessValues.r;
	#endif

	#if SMOOTHNESS_MAP_TYPE == 1
		smoothnessValue = RoughnessToSmoothness(smoothnessValue);
	#elif SMOOTHNESS_MAP_TYPE == 2
		smoothnessValue = 1 - smoothnessValue;
	#endif

	#if SMOOTHNESS_MAP_APPLY_SCALE == 1
		smoothnessValue *= smoothness;
	#elif SMOOTHNESS_MAP_APPLY_SCALE == 2
		smoothnessValue = pow(smoothnessValue, smoothness);
	#endif

	return saturate(smoothnessValue);
#else
	return smoothness;
#endif
}

float GetMetalness(float2 coord)
{
#if METALNESS_MAP_FROM
	#if METALNESS_MAP_UV_FLIP == 1
		coord.x = 1 - coord.x;
	#elif METALNESS_MAP_UV_FLIP == 2
		coord.y = 1 - coord.y;
	#elif METALNESS_MAP_UV_FLIP == 3
		coord = 1 - coord;
	#endif

	#if METALNESS_MAP_FROM == 3
		#if METALNESS_MAP_HEX_TILING
			float4 metalnessValues = use_texture ? SampleColorHexTiled(MetalnessMapSamp, coord * metalnessMapLoopNum, HEX_TILING_ROTATION, 0.75f, HEX_TILING_CONTRAST, HEX_TILING_SHARPNESS) : 0;
		#else
			float4 metalnessValues = use_texture ? tex2D(MetalnessMapSamp, coord * metalnessMapLoopNum) : 0;
		#endif
	#elif METALNESS_MAP_FROM == 4
		float4 metalnessValues = use_spheremap ? tex2D(MetalnessMapSamp, coord * metalnessMapLoopNum) : 0;
	#elif METALNESS_MAP_FROM == 5
		float4 metalnessValues = use_toon ? tex2D(MetalnessMapSamp, coord * metalnessMapLoopNum) : 0;
	#elif METALNESS_MAP_FROM == 7
		float4 metalnessValues = MaterialAmbient;
	#elif METALNESS_MAP_FROM == 8
		float4 metalnessValues = MaterialSpecular;
	#elif METALNESS_MAP_FROM == 9
		float4 metalnessValues = ShininessToSmoothness(MaterialPower);
	#else
		#if METALNESS_MAP_HEX_TILING
			float4 metalnessValues = SampleColorHexTiled(MetalnessMapSamp, coord * metalnessMapLoopNum, HEX_TILING_ROTATION, 0.75f, HEX_TILING_CONTRAST, HEX_TILING_SHARPNESS);
		#else
			float4 metalnessValues = tex2D(MetalnessMapSamp, coord * metalnessMapLoopNum);
		#endif
	#endif

	#if METALNESS_MAP_SWIZZLE == 1
		float metalnessValue = metalnessValues.g;
	#elif METALNESS_MAP_SWIZZLE == 2
		float metalnessValue = metalnessValues.b;
	#elif METALNESS_MAP_SWIZZLE == 3
		float metalnessValue = metalnessValues.a;
	#else
		float metalnessValue = metalnessValues.r;
	#endif

	#if METALNESS_MAP_APPLY_SCALE == 1
		metalnessValue *= metalness;
	#elif METALNESS_MAP_APPLY_SCALE == 2
		metalnessValue = pow(metalnessValue, metalness);
	#endif

	return saturate(metalnessValue);
#else
	return metalness;
#endif
}

float3 GetSpecular(float2 coord)
{
#if SPECULAR_MAP_FROM
	#if CUSTOM_ENABLE && SPECULAR_MAP_TYPE <= 1
		#error Unsupported material, When CUSTOM_ENABLE > 0 and specular map has multiple channels (RGB), Please set CUSTOM_ENABLE to 0
	#endif

	#if SPECULAR_MAP_UV_FLIP == 1
		coord.x = 1 - coord.x;
	#elif SPECULAR_MAP_UV_FLIP == 2
		coord.y = 1 - coord.y;
	#elif SPECULAR_MAP_UV_FLIP == 3
		coord = 1 - coord;
	#endif

	#if SPECULAR_MAP_FROM == 3
		float4 specularColor = use_texture ? tex2D(SpecularMapSamp, coord * specularMapLoopNum) : 0.5;
	#elif SPECULAR_MAP_FROM == 4
		float4 specularColor = use_spheremap ? tex2D(SpecularMapSamp, coord * specularMapLoopNum) : 0.5;
	#elif SPECULAR_MAP_FROM == 5
		float4 specularColor = use_toon ? tex2D(SpecularMapSamp, coord * specularMapLoopNum) : 0.5;
	#elif SPECULAR_MAP_FROM == 7
		float4 specularColor = MaterialAmbient;
	#elif SPECULAR_MAP_FROM == 8
		float4 specularColor = MaterialSpecular;
	#elif SPECULAR_MAP_FROM == 9
		#error Unsupported options 9.
	#else
		float4 specularColor = tex2D(SpecularMapSamp, coord * specularMapLoopNum);
	#endif

	#if SPECULAR_MAP_TYPE == 2 || SPECULAR_MAP_TYPE == 3
		#if SPECULAR_MAP_SWIZZLE == 1
			specularColor = specularColor.g;
		#elif SPECULAR_MAP_SWIZZLE == 2
			specularColor = specularColor.b;
		#elif SPECULAR_MAP_SWIZZLE == 3
			specularColor = specularColor.a;
		#else
			specularColor = specularColor.r;
		#endif
	#endif

	#if SPECULAR_MAP_TYPE == 1 || SPECULAR_MAP_TYPE == 3
		specularColor = 0.16 * specularColor * specularColor;
	#else
		specularColor = 0.08 * specularColor;
	#endif

	#if SPECULAR_MAP_APPLY_SCALE == 1
		specularColor.rgb *= specular;
	#elif SPECULAR_MAP_APPLY_SCALE == 2
		specularColor.rgb = pow(specularColor.rgb, specular);
	#endif

	return clamp(specularColor.rgb, 0.01, 1.0);
#else
	#if SPECULAR_MAP_TYPE == 1 || SPECULAR_MAP_TYPE == 3
		return saturate(0.16 * specular * specular);
	#elif SPECULAR_MAP_TYPE == 4
		return saturate(specular);
	#else
		return saturate(0.08 * specular);
	#endif
#endif
}

float GetOcclusion(float2 coord)
{
#if OCCLUSION_MAP_FROM
	#if OCCLUSION_MAP_UV_FLIP == 1
		coord.x = 1 - coord.x;
	#elif OCCLUSION_MAP_UV_FLIP == 2
		coord.y = 1 - coord.y;
	#elif OCCLUSION_MAP_UV_FLIP == 3
		coord = 1 - coord;
	#endif

	#if OCCLUSION_MAP_FROM == 3
		#if OCCLUSION_MAP_HEX_TILING
			float4 occlusionValues = use_texture ? SampleColorHexTiled(OcclusionMapSamp, coord * occlusionMapLoopNum, HEX_TILING_ROTATION, 0.75f, HEX_TILING_CONTRAST, HEX_TILING_SHARPNESS) : 1;
		#else
			float4 occlusionValues = use_texture ? tex2D(OcclusionMapSamp, coord * occlusionMapLoopNum) : 1;
		#endif
	#elif OCCLUSION_MAP_FROM == 4
		float4 occlusionValues = use_spheremap ? tex2D(OcclusionMapSamp, coord * occlusionMapLoopNum) : 1;
	#elif OCCLUSION_MAP_FROM == 5
		float4 occlusionValues = use_toon ? tex2D(OcclusionMapSamp, coord * occlusionMapLoopNum) : 1;
	#elif OCCLUSION_MAP_FROM == 7
		float4 occlusionValues = MaterialAmbient;
	#elif OCCLUSION_MAP_FROM == 8
		float4 occlusionValues = MaterialSpecular;
	#elif OCCLUSION_MAP_FROM == 9
		#error Unsupported options 9.
	#else
		#if OCCLUSION_MAP_HEX_TILING
			float4 occlusionValues = SampleColorHexTiled(OcclusionMapSamp, coord * occlusionMapLoopNum, HEX_TILING_ROTATION, 0.75f, HEX_TILING_CONTRAST, HEX_TILING_SHARPNESS);
		#else
			float4 occlusionValues = tex2D(OcclusionMapSamp, coord * occlusionMapLoopNum);
		#endif
	#endif

	#if OCCLUSION_MAP_SWIZZLE == 1
		float occlusionValue = occlusionValues.g;
	#elif OCCLUSION_MAP_SWIZZLE == 2
		float occlusionValue = occlusionValues.b;
	#elif OCCLUSION_MAP_SWIZZLE == 3
		float occlusionValue = occlusionValues.a;
	#else
		float occlusionValue = occlusionValues.r;
	#endif

	#if OCCLUSION_MAP_TYPE == 1 || OCCLUSION_MAP_TYPE == 3
		occlusionValue = srgb2linear(occlusionValue);
	#endif

	#if OCCLUSION_MAP_APPLY_SCALE == 1
		occlusionValue *= occlusion;
	#elif OCCLUSION_MAP_APPLY_SCALE == 2
		occlusionValue = pow(occlusionValue, occlusion);
	#endif

	return saturate(occlusionValue);
#else
	return saturate(occlusion);
#endif
}

float3 GetEmissiveColor(float2 coord)
{
#if EMISSIVE_ENABLE
	#if EMISSIVE_MAP_UV_FLIP == 1
		coord.x = 1 - coord.x;
	#elif EMISSIVE_MAP_UV_FLIP == 2
		coord.y = 1 - coord.y;
	#elif EMISSIVE_MAP_UV_FLIP == 3
		coord = 1 - coord;
	#endif

	#if EMISSIVE_MAP_FROM == 1 || EMISSIVE_MAP_FROM == 2 || EMISSIVE_MAP_FROM == 6
		float4 emissiveTexCol = tex2D(EmissiveMapSamp, coord * emissiveMapLoopNum);
		float3 emissiveColor = lerp(0, emissiveTexCol.rgb, emissiveTexCol.a);
	#elif EMISSIVE_MAP_FROM == 3
		float4 emissiveTexCol = use_texture ? tex2D(EmissiveMapSamp, coord * emissiveMapLoopNum) : 0;
		float3 emissiveColor = lerp(0, emissiveTexCol.rgb, emissiveTexCol.a);
	#elif EMISSIVE_MAP_FROM == 4
		float4 emissiveTexCol = use_spheremap ? tex2D(EmissiveMapSamp, coord * emissiveMapLoopNum) : 0;
		float3 emissiveColor = lerp(0, emissiveTexCol.rgb, emissiveTexCol.a);
	#elif EMISSIVE_MAP_FROM == 5
		float4 emissiveTexCol = use_toon ? tex2D(EmissiveMapSamp, coord * emissiveMapLoopNum) : 0;
		float3 emissiveColor = lerp(0, emissiveTexCol.rgb, emissiveTexCol.a);
	#elif EMISSIVE_MAP_FROM == 7
		float3 emissiveColor = MaterialAmbient.rgb;
	#elif EMISSIVE_MAP_FROM == 8
		float3 emissiveColor = MaterialSpecular.rgb;
	#elif EMISSIVE_MAP_FROM == 9
		#error Unsupported options 9.
	#else
		float3 emissiveColor = emissive;
	#endif

	emissiveColor = srgb2linear(emissiveColor);

	#if EMISSIVE_MAP_APPLY_SCALE
		emissiveColor *= emissive.rgb;
	#endif

	#if EMISSIVE_MAP_APPLY_MORPH_COLOR
		emissiveColor *= MorphColor;
	#endif

	#if EMISSIVE_MAP_APPLY_BLINK
		emissiveColor *= LightBlink;
	#endif

	return emissiveColor;
#else
	return 0;
#endif
}

float GetEmissiveIntensity()
{
#if EMISSIVE_ENABLE
	#if EMISSIVE_MAP_APPLY_MORPH_INTENSITY
		return emissiveIntensity * LightIntensity;
	#else
		return emissiveIntensity;
	#endif
#else
	return 0;
#endif
}

float GetCustomDataA(float2 coord)
{
#if CUSTOM_ENABLE
	float customData = customA;

	#if CUSTOM_A_MAP_FROM
		#if CUSTOM_A_MAP_UV_FLIP == 1
			coord.x = 1 - coord.x;
		#elif CUSTOM_A_MAP_UV_FLIP == 2
			coord.y = 1 - coord.y;
		#elif CUSTOM_A_MAP_UV_FLIP == 3
			coord = 1 - coord;
		#endif

		#if CUSTOM_A_MAP_FROM == 3
			float4 customValues = use_texture ? tex2D(CustomAMapSamp, coord * customAMapLoopNum) : 0;
		#elif CUSTOM_A_MAP_FROM == 4
			float4 customValues = use_spheremap ? tex2D(CustomAMapSamp, coord * customAMapLoopNum) : 0;
		#elif CUSTOM_A_MAP_FROM == 5
			float4 customValues = use_toon ? tex2D(CustomAMapSamp, coord * customAMapLoopNum) : 0;
		#elif CUSTOM_A_MAP_FROM == 7
			float4 customValues = MaterialAmbient;
		#elif CUSTOM_A_MAP_FROM == 8
			float4 customValues = MaterialSpecular;
		#elif CUSTOM_A_MAP_FROM == 9
			#error Unsupported options 9.
		#else
			float4 customValues = tex2D(CustomAMapSamp, coord * customAMapLoopNum);
		#endif

		#if CUSTOM_A_MAP_SWIZZLE == 1
			customData = customValues.g;
		#elif CUSTOM_A_MAP_SWIZZLE == 2
			customData = customValues.b;
		#elif CUSTOM_A_MAP_SWIZZLE == 3
			customData = customValues.a;
		#else
			customData = customValues.r;
		#endif

		#if CUSTOM_A_MAP_APPLY_SCALE == 1
			customData *= customA;
		#elif CUSTOM_A_MAP_APPLY_SCALE == 2
			customData = pow(customData, customA);
		#endif
	#endif

	#if CUSTOM_ENABLE == SHADINGMODELID_CLEAR_COAT
		#if CUSTOM_A_MAP_COLOR_FLIP
			return RoughnessToSmoothness(customData);
		#else
			return customData;
		#endif
	#else
		#if CUSTOM_A_MAP_COLOR_FLIP
			return 1 - customData;
		#else
			return customData;
		#endif
	#endif
#else
	return 0.0f;
#endif
}

float3 GetCustomDataB(float2 coord)
{
#if CUSTOM_ENABLE
	float3 customData = srgb2linear(customB);

	#if CUSTOM_B_MAP_FROM
		#if CUSTOM_B_MAP_UV_FLIP == 1
			coord.x = 1 - coord.x;
		#elif CUSTOM_B_MAP_UV_FLIP == 2
			coord.y = 1 - coord.y;
		#elif CUSTOM_B_MAP_UV_FLIP == 3
			coord = 1 - coord;
		#endif

		#if CUSTOM_B_MAP_FROM == 3
			customData = use_texture ? tex2D(CustomBMapSamp, coord * customBMapLoopNum).rgb : 0;
		#elif CUSTOM_B_MAP_FROM == 4
			customData = use_spheremap ? tex2D(CustomBMapSamp, coord * customBMapLoopNum).rgb : 0;
		#elif CUSTOM_B_MAP_FROM == 5
			customData = use_toon ? tex2D(CustomBMapSamp, coord * customBMapLoopNum) : 0;
		#elif CUSTOM_B_MAP_FROM == 7
			customData = MaterialAmbient;
		#elif CUSTOM_B_MAP_FROM == 8
			customData = MaterialSpecular;
		#elif CUSTOM_B_MAP_FROM == 9
			#error Unsupported options 9.
		#else
			customData = tex2D(CustomBMapSamp, coord * customBMapLoopNum).rgb;
		#endif

		#if CUSTOM_B_MAP_FROM && CUSTOM_B_MAP_TYPE == 0
			customData = srgb2linear(customData);
		#endif

		#if CUSTOM_B_MAP_COLOR_FLIP
			customData = 1 - customData;
		#endif

		#if CUSTOM_B_MAP_APPLY_SCALE == 1
			customData *= customB;
		#elif CUSTOM_B_MAP_APPLY_SCALE == 2
			customData = pow(customData, customB);
		#endif
	#endif

	return saturate(customData);
#else
	return 0.0;
#endif
}

float GetLightMode(MaterialParam material)
{
#if CUSTOM_ENABLE
	#if CUSTOM_ENABLE >= SHADINGMODELID_MASK
		#error Unsupported option Shading Material ID
	#endif
	#if EMISSIVE_ENABLE
		return any(saturate(material.emissive - EMISSIVE_EPSILON)) ? SHADINGMODELID_EMISSIVE : CUSTOM_ENABLE;
	#else
		return CUSTOM_ENABLE;
	#endif
#else
	return any(saturate(material.emissive - EMISSIVE_EPSILON)) ? SHADINGMODELID_EMISSIVE : SHADINGMODELID_DEFAULT;
#endif
}

#ifndef WIND_ENABLE
#	define WIND_ENABLE 0
#endif

#ifndef WIND_TYPE
#	define WIND_TYPE 0
#endif

#if WIND_ENABLE
float3 ComputeVegetationWindOffset(float3 localPos, float3 normal, float2 uv)
{
	float3 worldPos = mul(float4(localPos, 1.0f), matWorld).xyz;
	float3 windDir = normalize(windDirection);
	float t = time * windSpeed;

	// Spatial phase shift along wind travel
	float spatialPhase = dot(worldPos.xz, windDir.xz) * windFrequency;

#if WIND_TYPE == 1
	// Type 1: Grass / Ground vegetation (Anchored at base Y, quadratic deflection towards top)
	float heightMask = saturate(localPos.y * 0.25f + 0.1f);
	float mainGust = sin(t + spatialPhase) * cos(t * 0.73f + spatialPhase * 0.5f);
	float microGust = sin(t * 2.8f + dot(worldPos, float3(1.7, 0.5, 2.1))) * windTurbulence;
	float bend = (mainGust + microGust) * (heightMask * heightMask) * windStrength;
	return windDir * bend;

#elif WIND_TYPE == 2
	// Type 2: Hanging Vines & Ivy (Pendulum swing, anchored at top)
	float lengthMask = saturate(1.0f - uv.y);
	float pendulum = sin(t * 1.1f + spatialPhase) + sin(t * 2.3f + worldPos.y * 0.8f) * 0.35f;
	float flutter = sin(t * 4.5f + (uv.x + uv.y) * 16.0f) * (windTurbulence * 0.25f);
	float displacement = (pendulum + flutter) * lengthMask * windStrength;
	return (windDir * 0.85f + float3(0.0f, -abs(pendulum) * 0.15f, 0.0f)) * displacement;

#elif WIND_TYPE == 3
	// Type 3: Palm & Broad Fronds (Undulating flex + edge flap)
	float flexMask = saturate(uv.x + uv.y * 0.5f);
	float wave = sin(t * 1.4f + spatialPhase + worldPos.y * 0.5f);
	float edgeFlap = cos(t * 3.8f + (uv.x * 24.0f)) * windTurbulence;
	float displacement = (wave + edgeFlap) * flexMask * windStrength;
	return (windDir + normal * (edgeFlap * 0.5f)) * displacement;

#else
	// Type 0: Tree Foliage, Bushes, Canopy Leaves (Multi-octave sway + UV leaf tremble)
	float branchWave = sin(t + spatialPhase) + 0.5f * sin(t * 2.1f + worldPos.y * 0.35f);
	float leafFlutter = sin(t * 4.2f + (uv.x * 37.0f + uv.y * 53.0f)) * windTurbulence;
	float displacement = (branchWave * 0.75f + leafFlutter) * windStrength;
	
	// Add cross-wind swirl for organic motion
	float3 crossWind = cross(windDir, float3(0.0f, 1.0f, 0.0f));
	float swirl = cos(t * 1.7f + spatialPhase) * (windTurbulence * 0.35f);
	return (windDir * displacement) + (crossWind * (swirl * windStrength));
#endif
}
#endif

void MaterialVS(
	in float4 Position : POSITION, 
	in float3 Normal : NORMAL, 
	in float2 Texcoord1 : TEXCOORD0,
#if OCCLUSION_MAP_TYPE == 2 || OCCLUSION_MAP_TYPE == 3
	in float2 Texcoord2 : TEXCOORD1,
#endif
	out float3 oNormal   : TEXCOORD0,
	out float2 oTexcoord1 : TEXCOORD1,
#if OCCLUSION_MAP_TYPE == 2 || OCCLUSION_MAP_TYPE == 3
	out float2 oTexcoord2 : TEXCOORD2,
#endif
	out float4 oWorldPos  : TEXCOORD3,
	out float4 oPosition  : POSITION)
{
	oNormal = Normal;
	oTexcoord1 = Texcoord1;
#if OCCLUSION_MAP_TYPE == 2 || OCCLUSION_MAP_TYPE == 3
	oTexcoord2 = Texcoord2;
#endif

#if WIND_ENABLE
	float3 worldPos = mul(Position, matWorld).xyz;
	float3 windOffset = ComputeVegetationWindOffset(Position.xyz, Normal, Texcoord1);
	worldPos += windOffset;
	oPosition = mul(float4(worldPos, 1.0f), matViewProject);
	oWorldPos = float4(worldPos, oPosition.w);
#else
	oPosition = mul(Position, matWorldViewProject);
	oWorldPos = float4(Position.xyz, oPosition.w);
#endif
}

GbufferParam MaterialPS(
	in float3 normal   : TEXCOORD0,
	in float2 coord0   : TEXCOORD1,
#if OCCLUSION_MAP_TYPE == 2 || OCCLUSION_MAP_TYPE == 3
	in float2 coord1   : TEXCOORD2,
#endif
	in float4 worldPos : TEXCOORD3)
{
	normal = normalize(normal);

	// ponytail: perform early alpha clip before expensive POM raymarching
	float alpha = GetAlpha(coord0);
#if HASHED_ALPHA_TEST_ENABLE
	float hashedThreshold = HashedAlphaThreshold(worldPos.xyz, HASHED_ALPHA_SCALE);
	clip(alpha - hashedThreshold);
#else
	clip(alpha - ALPHA_THRESHOLD);
#endif
#if ALPHA_MAP_FROM == 2
	clip(-1);
#endif

#if PARALLAX_MAP_FROM
	#if PARALLAX_MAP_UV_FLIP
		coord0.y = 1 - coord0.y;
	#endif
	float3 viewdir = ParallaxOcclusionDirection(normal, worldPos.xyz, coord0 * parallaxMapLoopNum);
	float2 pomCoord = ParallaxOcclusionMap(ParallaxMapSamp, coord0 * parallaxMapLoopNum, viewdir, 15, parallaxMapScale);
	float pomHeight = GetParallaxOcclusionHeight(ParallaxMapSamp, pomCoord);
	float3 lightDirTangent = ParallaxOcclusionDirection(normal, worldPos.xyz + float3(0.0f, 10.0f, 0.0f), coord0 * parallaxMapLoopNum);
	float pomShadow = ParallaxSelfShadow(ParallaxMapSamp, pomCoord, normalize(lightDirTangent), pomHeight, parallaxMapScale, 6);
	coord0 = pomCoord;
	#if PARALLAX_MAP_UV_FLIP
		coord0.y = 1 - coord0.y;
	#endif
#else
	float pomShadow = 1.0f;
#endif

#if EYE_PARALLAX_ENABLE
	float3 eyeViewDir = normalize(CameraPosition - worldPos.xyz);
	float eyeCaustic = 0.0f, eyeLimbal = 1.0f;
	coord0 = ComputeCorneaIrisParallax(coord0, eyeViewDir, normal, EYE_IRIS_DEPTH, EYE_CORNEA_IOR, eyeCaustic, eyeLimbal);
#endif

	MaterialParam material;
	material.albedo = GetSubAlbedo(GetAlbedo(coord0, worldPos.xyz, normal), coord0);
#if EYE_PARALLAX_ENABLE
	material.albedo = material.albedo * eyeLimbal + material.albedo * (eyeCaustic * 0.35f);
#endif
	material.normal = GetNormal(normal, worldPos.xyz, coord0);
	material.smoothness = GetSmoothness(coord0);
	material.metalness = GetMetalness(coord0);
	material.specular = GetSpecular(coord0);
#if GLITTER_ENABLE
	float3 glitterV = normalize(CameraPosition - worldPos.xyz);
	float3 glitterL = mul(float3(0.0f, 1.0f, 0.5f), (float3x3)matView);
	float3 glitterH = normalize(glitterV + glitterL);
	float sparkle = ComputeMicroGlitterSparkle(worldPos.xyz, material.normal, glitterH, GLITTER_DENSITY, GLITTER_ROUGHNESS, GLITTER_INTENSITY);
	material.specular += sparkle * (1.0f - material.smoothness * 0.5f);
#endif
	material.customDataA = GetCustomDataA(coord0);
#if CUSTOM_ENABLE == 1 // SHADINGMODELID_SKIN
	float3 ddxP = ddx(worldPos.xyz);
	float3 ddyP = ddy(worldPos.xyz);
	float3 ddxN = ddx(normal); // normal is the geometric normal before normal map
	float3 ddyN = ddy(normal);
	float deltaP_sq = dot(ddxP, ddxP) + dot(ddyP, ddyP);
	float deltaN_sq = dot(ddxN, ddxN) + dot(ddyN, ddyN);
	float curvature = sqrt(deltaN_sq / (deltaP_sq + 1e-5f));
	material.customDataA = saturate(curvature * material.customDataA * 50.0f); // Multiply base parameter by screen-space curvature
#endif
	material.customDataB = GetCustomDataB(coord0);
	material.emissive = GetEmissiveColor(coord0);
	material.emissiveIntensity = GetEmissiveIntensity();
#if OCCLUSION_MAP_TYPE == 2 || OCCLUSION_MAP_TYPE == 3
	material.visibility = GetOcclusion(coord1) * pomShadow;
#else
	material.visibility = GetOcclusion(coord0) * pomShadow;
#endif
	material.lightModel = GetLightMode(material);
	material.alpha = 1;

	return EncodeGbuffer(material, worldPos.w);
}

GbufferParam Material2PS(
	in float3 normal   : TEXCOORD0,
	in float2 coord0   : TEXCOORD1,
#if OCCLUSION_MAP_TYPE == 2 || OCCLUSION_MAP_TYPE == 3
	in float2 coord1   : TEXCOORD2,
#endif
	in float4 worldPos : TEXCOORD3)
{
	normal = normalize(normal);

	// ponytail: perform early alpha clip before expensive POM raymarching
	float alpha = GetAlpha(coord0);
#if HASHED_ALPHA_TEST_ENABLE
	float hashedThreshold2 = HashedAlphaThreshold(worldPos.xyz, HASHED_ALPHA_SCALE);
	clip(alpha - hashedThreshold2);
#else
	clip(alpha - 0.01);
#endif

#if PARALLAX_MAP_FROM
	#if PARALLAX_MAP_UV_FLIP
		coord0.y = 1 - coord0.y;
	#endif
	float3 viewdir = ParallaxOcclusionDirection(normal, worldPos.xyz, coord0);
#if PARALLAX_MAP_TYPE
	float2 pomCoord2 = ParallaxOcclusionMap(ParallaxMapSamp, coord0 * parallaxMapLoopNum, viewdir, 15, parallaxMapScale);
	float pomHeight2 = GetParallaxOcclusionHeight(ParallaxMapSamp, pomCoord2);
	float3 lightDirTangent2 = ParallaxOcclusionDirection(normal, worldPos.xyz + float3(0.0f, 10.0f, 0.0f), coord0 * parallaxMapLoopNum);
	float pomShadow2 = ParallaxSelfShadow(ParallaxMapSamp, pomCoord2, normalize(lightDirTangent2), pomHeight2, parallaxMapScale, 6);
	coord0 = pomCoord2;
#else
	coord0 *= parallaxMapLoopNum;
	float pomShadow2 = 1.0f;
#endif
	#if PARALLAX_MAP_UV_FLIP
		coord0.y = 1 - coord0.y;
	#endif
#else
	float pomShadow2 = 1.0f;
#endif

#if EYE_PARALLAX_ENABLE
	float3 eyeViewDir2 = normalize(CameraPosition - worldPos.xyz);
	float eyeCaustic2 = 0.0f, eyeLimbal2 = 1.0f;
	coord0 = ComputeCorneaIrisParallax(coord0, eyeViewDir2, normal, EYE_IRIS_DEPTH, EYE_CORNEA_IOR, eyeCaustic2, eyeLimbal2);
#endif

	MaterialParam material;
	material.albedo = GetSubAlbedo(GetAlbedo(coord0, worldPos.xyz, normal), coord0);
#if EYE_PARALLAX_ENABLE
	material.albedo = material.albedo * eyeLimbal2 + material.albedo * (eyeCaustic2 * 0.35f);
#endif
	material.normal = GetNormal(normal, worldPos.xyz, coord0);
	material.smoothness = GetSmoothness(coord0);
	material.metalness = GetMetalness(coord0);
	material.specular = GetSpecular(coord0);
#if GLITTER_ENABLE
	float3 glitterV2 = normalize(CameraPosition - worldPos.xyz);
	float3 glitterL2 = mul(float3(0.0f, 1.0f, 0.5f), (float3x3)matView);
	float3 glitterH2 = normalize(glitterV2 + glitterL2);
	float sparkle2 = ComputeMicroGlitterSparkle(worldPos.xyz, material.normal, glitterH2, GLITTER_DENSITY, GLITTER_ROUGHNESS, GLITTER_INTENSITY);
	material.specular += sparkle2 * (1.0f - material.smoothness * 0.5f);
#endif
	material.customDataA = GetCustomDataA(coord0);
#if CUSTOM_ENABLE == 1 // SHADINGMODELID_SKIN
	float3 ddxP = ddx(worldPos.xyz);
	float3 ddyP = ddy(worldPos.xyz);
	float3 ddxN = ddx(normal);
	float3 ddyN = ddy(normal);
	float deltaP_sq = dot(ddxP, ddxP) + dot(ddyP, ddyP);
	float deltaN_sq = dot(ddxN, ddxN) + dot(ddyN, ddyN);
	float curvature = sqrt(deltaN_sq / (deltaP_sq + 1e-5f));
	material.customDataA = saturate(curvature * material.customDataA * 50.0f);
#endif
	material.customDataB = GetCustomDataB(coord0);
	material.emissive = GetEmissiveColor(coord0);
	material.emissiveIntensity = GetEmissiveIntensity();
#if OCCLUSION_MAP_TYPE == 2 || OCCLUSION_MAP_TYPE == 3
	material.visibility = GetOcclusion(coord1) * pomShadow2;
#else
	material.visibility = GetOcclusion(coord0) * pomShadow2;
#endif
	material.lightModel = GetLightMode(material);
#if HASHED_ALPHA_TEST_ENABLE
	material.alpha = alpha > hashedThreshold2 ? 0 : alpha;
#elif ALPHA_MAP_FROM == 2
	material.alpha = alpha;
#else
	material.alpha = alpha > ALPHA_THRESHOLD ? 0 : alpha;
#endif

	return EncodeGbuffer(material, worldPos.w);
}

#define OBJECT_TEC(name, mmdpass)\
	technique name<string MMDPass = mmdpass;\
	string Script =\
		"RenderColorTarget0=;"\
		"RenderColorTarget1=Gbuffer2RT;"\
		"RenderColorTarget2=Gbuffer3RT;"\
		"RenderColorTarget3=Gbuffer4RT;"\
		"Pass=DrawObject;"\
		"RenderColorTarget0=Gbuffer5RT;"\
		"RenderColorTarget1=Gbuffer6RT;"\
		"RenderColorTarget2=Gbuffer7RT;"\
		"RenderColorTarget3=Gbuffer8RT;"\
		"Pass=DrawAlphaObject;"\
	;>{\
		pass DrawObject {\
			AlphaTestEnable = false; AlphaBlendEnable = false;\
			VertexShader = compile vs_3_0 MaterialVS();\
			PixelShader  = compile ps_3_0 MaterialPS();\
		}\
		pass DrawAlphaObject {\
			AlphaTestEnable = false; AlphaBlendEnable = false;\
			VertexShader = compile vs_3_0 MaterialVS();\
			PixelShader  = compile ps_3_0 Material2PS();\
		}\
	}

OBJECT_TEC(MainTec0, "object")
OBJECT_TEC(MainTecBS0, "object_ss")

technique EdgeTec<string MMDPass = "edge";>{}
technique ShadowTech<string MMDPass = "shadow";>{}
technique ZplotTec<string MMDPass = "zplot";>{}