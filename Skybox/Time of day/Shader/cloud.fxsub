// ==============================================================================
// SA_DIRECTX 3.0 + UNITY URP DUAL-ENGINE VOLUMETRIC CLOUDS ARCHITECTURE
// MULTI-SCALE ORGANIC AREA FOOTPRINT VARIATION & HIGH-PERFORMANCE 3D SHAPING
// ==============================================================================

#define NUMS_SAMPLES_CLOUD 24
#define NUM_LIGHT_STEPS 3

// Multi-octave cloud textures
texture CloudMacroMap<string ResourceName = "shader/textures/clouds1.png";>; 
sampler CloudMacroMapSamp = sampler_state {
	texture = <CloudMacroMap>;
	MINFILTER = LINEAR; MAGFILTER = LINEAR; MIPFILTER = LINEAR;
	ADDRESSU = WRAP; ADDRESSV = WRAP;
};

texture CloudCoverMap<string ResourceName = "shader/textures/clouds2.png";>; 
sampler CloudCoverMapSamp = sampler_state {
	texture = <CloudCoverMap>;
	MINFILTER = LINEAR; MAGFILTER = LINEAR; MIPFILTER = LINEAR;
	ADDRESSU = WRAP; ADDRESSV = WRAP;
};

texture CloudDetailMap<string ResourceName = "shader/textures/clouds3.png";>; 
sampler CloudDetailMapSamp = sampler_state {
	texture = <CloudDetailMap>;
	MINFILTER = LINEAR; MAGFILTER = LINEAR; MIPFILTER = LINEAR;
	ADDRESSU = WRAP; ADDRESSV = WRAP;
};

// ==============================================================================
// FAST 3D NOISE (CONTINUOUS DUAL-SLICE Z-INTERPOLATION)
// ==============================================================================

float noise3D(in float3 p)
{
	float3 ip = floor(p);
	float3 fp = frac(p);
	fp = fp * fp * (3.0f - 2.0f * fp); // Hermite cubic
	
	float2 uv0 = (ip.xz + float2(37.0f, 17.0f) * ip.y) + fp.xz;
	float2 uv1 = uv0 + float2(37.0f, 17.0f);

	float n0 = tex2Dlod(CloudMacroMapSamp, float4((uv0 + 0.5f) / 256.0f, 0, 0)).r;
	float n1 = tex2Dlod(CloudMacroMapSamp, float4((uv1 + 0.5f) / 256.0f, 0, 0)).r;

	return lerp(n0, n1, fp.y);
}

float DensityRemap(float x, float a, float b, float c, float d)
{
	return saturate(((x - a) / max(b - a, 0.001f)) * (d - c) + c);
}

// ==============================================================================
// 3D VOLUMETRIC DENSITY EVALUATION (MULTI-SCALE AREA FOOTPRINT VARIATION)
// ==============================================================================

float EvaluateCloudDensity(ScatteringParams setting, float3 positionPS, out float cloudHeight)
{
	float r = length(positionPS - setting.earthCenter);
	cloudHeight = saturate((r - (setting.earthRadius + setting.cloudBottom)) / max(setting.cloudTop - setting.cloudBottom, 1.0f));

	// Natural cumulus vertical profile (flat base, high billowing dome)
	float hBase = smoothstep(0.0f, 0.08f, cloudHeight);
	float hTop  = smoothstep(1.0f, 0.60f, cloudHeight);
	float heightGradient = hBase * hTop;
	if (heightGradient <= 1e-4f) return 0.0f;

	// 1. Wind & Atmospheric Drift
	float3 p = positionPS + setting.clouddir;

	// 2. Global Multi-scale Weather Systems (Large fronts + local clusters)
	const float2x2 rotA = float2x2(0.8508f, -0.5255f, 0.5255f, 0.8508f);
	float2 uvWeather1 = (p.xz + setting.clouddir.xz * 0.15f) * 0.0000065f; // ~150 km front
	float2 uvWeather2 = mul(p.xz, rotA) * 0.000018f; // ~55 km cluster

	float weather1 = tex2Dlod(CloudCoverMapSamp, float4(uvWeather1, 0, 0)).r;
	float weather2 = tex2Dlod(CloudCoverMapSamp, float4(uvWeather2 + 0.35f, 0, 0)).r;
	float weatherField = weather1 * 0.62f + weather2 * 0.38f;

	// True weather thresholding: preserves natural clouds while creating large open sky voids
	float cov = saturate(setting.cloud);
	float weatherThreshold = 1.0f - cov * 0.92f - 0.04f;
	float coverageMask = saturate((weatherField - weatherThreshold) / max(1.0f - weatherThreshold, 0.01f));

	if (coverageMask <= 0.001f) return 0.0f;

	// 3. Multi-Scale 3D Base Shaping (Combines broad multi-km banks with medium bodies and small wisps)
	float3 shapePos = p * 0.00055f;
	float s0 = noise3D(shapePos); // 1.8 km macro structure
	float s1 = noise3D(shapePos * 2.35f + float3(0.31f, 0.73f, 0.17f)); // 750 m billow clumps
	float shapeNoise = s0 * 0.65f + s1 * 0.35f;

	// Variable footprint: dense centers form broad massive cloud banks, edges form small satellite clouds
	float densityPower = lerp(0.75f, 1.25f, coverageMask);
	float threshold = 1.0f - coverageMask * heightGradient * densityPower;
	float baseCloud = DensityRemap(shapeNoise, threshold, 1.0f, 0.0f, 1.0f);
	if (baseCloud <= 0.001f) return 0.0f;

	// 4. High-frequency 3D Micro-Erosion (vapor edge shredding)
	float erosionNoise = noise3D((p + setting.clouddir * 0.5f) * 0.0032f);

	float finalDensity = DensityRemap(baseCloud, erosionNoise * 0.45f, 1.0f, 0.0f, 1.0f);
	return finalDensity * 2.8f;
}

// Lightweight evaluation for shadow rays (Ultra-fast)
float EvaluateCloudDensityCheap(ScatteringParams setting, float3 positionPS)
{
	float r = length(positionPS - setting.earthCenter);
	float cloudHeight = saturate((r - (setting.earthRadius + setting.cloudBottom)) / max(setting.cloudTop - setting.cloudBottom, 1.0f));

	float heightGradient = smoothstep(0.0f, 0.08f, cloudHeight) * smoothstep(1.0f, 0.60f, cloudHeight);
	if (heightGradient <= 1e-4f) return 0.0f;

	float3 p = positionPS + setting.clouddir;
	float2 uvWeather = (p.xz + setting.clouddir.xz * 0.15f) * 0.0000065f;
	float weather1 = tex2Dlod(CloudCoverMapSamp, float4(uvWeather, 0, 0)).r;

	float cov = saturate(setting.cloud);
	float weatherThreshold = 1.0f - cov * 0.92f - 0.04f;
	float coverageMask = saturate((weather1 - weatherThreshold) / max(1.0f - weatherThreshold, 0.01f));

	return coverageMask * heightGradient * 2.2f;
}

float ComputeClound(ScatteringParams setting, float3 P)
{
	float cloudHeight;
	return EvaluateCloudDensity(setting, P, cloudHeight);
}

float HitCloudsTest(ScatteringParams setting, float3 eye, float3 V, float3 L)
{
	float2 outer = ComputeRaySphereIntersection(eye, V, setting.earthCenter, setting.earthRadius + setting.cloudTop);
	float2 inner = ComputeRaySphereIntersection(eye, V, setting.earthCenter, setting.earthRadius + setting.cloudBottom);
	if (inner.y > 0) outer.x = inner.y;
	float3 cloudsStart = eye + V * max(0, outer.x);
	float cloudHeight;
	return exp(-0.002f * EvaluateCloudDensity(setting, cloudsStart, cloudHeight));
}

// ==============================================================================
// ADVANCED LIGHTING: FROSTBITE MULTIPLE SCATTERING + HENYEY-GREENSTEIN
// ==============================================================================

float PowderEffect(float cloudDensity, float cosAngle)
{
	float powderEffect = 1.0f - exp(-cloudDensity * 4.0f);
	return lerp(1.0f, saturate(powderEffect * 2.0f), smoothstep(0.5f, -0.5f, cosAngle));
}

float HenyeyGreenstein(float g, float cosTheta)
{
	float g2 = g * g;
	return (1.0f - g2) / (4.0f * PI * pow(max(1.0f + g2 - 2.0f * g * cosTheta, 0.001f), 1.5f));
}

float3 EvaluateSunTransmittance(ScatteringParams setting, float3 positionPS, float3 sunDirection, float cosAngle)
{
	float cloudThickness = max(setting.cloudTop - setting.cloudBottom, 1.0f);
	float totalLightDistance = cloudThickness * 0.8f;
	float intervalSize = totalLightDistance / float(NUM_LIGHT_STEPS);
	
	float opticalDepth = 0.0f;
	
	[unroll]
	for (int j = 0; j < NUM_LIGHT_STEPS; j++)
	{
		float dist = intervalSize * (0.25f + j);
		float density = EvaluateCloudDensityCheap(setting, positionPS + sunDirection * dist);
		opticalDepth += density * 0.004f;
	}

	float3 extinction = intervalSize * opticalDepth;

	// Dual-lobe multi-scattering
	float phase0 = HenyeyGreenstein(0.7f, cosAngle) * 0.7f + HenyeyGreenstein(-0.2f, cosAngle) * 0.3f;
	float phase1 = HenyeyGreenstein(0.4f, cosAngle) * 0.7f + HenyeyGreenstein(-0.1f, cosAngle) * 0.3f;

	float3 transmittance = 0.0f;
	transmittance += exp(-extinction) * phase0;
	transmittance += exp(-extinction * 0.5f) * (phase1 * 0.5f);

	return transmittance;
}

// ==============================================================================
// VOLUMETRIC INTEGRATION
// ==============================================================================

void ComputeCloudsInsctrIntegral(ScatteringParams setting, float3 start, float3 end, float3 V, float3 L, inout float opticalDepth, inout float3 insctrMie)
{
	float totalDist = length(end - start);
	float stepLength = totalDist / float(NUMS_SAMPLES_CLOUD);
	float3 sampleStep = ((end - start) / totalDist) * stepLength;

	// Ray jittering to eliminate banding
	float randomJitter = frac(sin(dot(V.xyz, float3(12.9898f, 78.233f, 54.53f))) * 43758.5453123f);
	float3 currentPositionPS = start + sampleStep * randomJitter;

	float3 accumulatedScattering = 0.0f;
	float transmittance = 1.0f;
	float cosAngle = dot(V, L);

	[loop]
	for (int i = 0; i < NUMS_SAMPLES_CLOUD; ++i)
	{
		if (transmittance < 0.01f) break;

		float cloudHeight;
		float density = EvaluateCloudDensity(setting, currentPositionPS, cloudHeight);

		if (density > 0.001f)
		{
			float extinction = density * 0.0035f;
			float stepTransmittance = exp(-extinction * stepLength);

			float powderEffect = PowderEffect(density, cosAngle);
			float3 sunTransmittance = EvaluateSunTransmittance(setting, currentPositionPS, L, cosAngle);
			
			// Direct sun light contribution
			float3 sunLuminance = setting.sunRadiance * sunTransmittance * powderEffect * 1.65f;
			
			// Ambient probe lighting with cavity shadowing
			float3 ambientLit = float3(0.65f, 0.75f, 0.90f);
			float3 ambientShadow = float3(0.15f, 0.18f, 0.26f);
			float3 ambientLuminance = lerp(ambientShadow, ambientLit, smoothstep(0.0f, 0.7f, cloudHeight)) * (setting.sunRadiance * 0.20f);

			// Energy-conserving analytical integration
			accumulatedScattering += sunLuminance * (transmittance - transmittance * stepTransmittance);
			accumulatedScattering += ambientLuminance * (transmittance - transmittance * stepTransmittance);
			
			transmittance *= stepTransmittance;
			opticalDepth += extinction * stepLength;
		}

		currentPositionPS += sampleStep;
	}

	insctrMie = accumulatedScattering;
}

// ==============================================================================
// ATMOSPHERE & SKY INTEGRATION
// ==============================================================================

float4 ComputeCloudsInscattering(ScatteringParams setting, float3 eye, float3 V, float3 L)
{
	float3 insctrMie = 0.0;
	float3 insctrRayleigh = 0.0;
	float3 insctrOpticalLength = 1.0;
	bool intersectionTest = ComputeSkyboxChapman(setting, eye, V, L, insctrOpticalLength, insctrMie, insctrRayleigh);

	float phaseTheta = dot(V, -L);
	float phaseMie = ComputePhaseMie(phaseTheta, setting.mieG);
	float phaseRayleigh = ComputePhaseRayleigh(phaseTheta);
	float phaseNight = 1.0 - saturate(insctrOpticalLength.x * EPSILON);

	float3 insctrTotalMie = insctrMie * phaseMie;
	float3 insctrTotalRayleigh = insctrRayleigh * phaseRayleigh;
	float3 sky = (insctrTotalMie + insctrTotalRayleigh) * setting.sunRadiance;

#if ATM_LIMADARKENING_ENABLE
	float angle = saturate((1 - phaseTheta) * sqrt(abs(L.y)) * setting.sunRadius);
	float cosAngle = cos(angle * PI * 0.5);
	float3 limaDarkening = GetTransmittance(setting, -L, V);
	limaDarkening *= pow(cosAngle, float3(0.420, 0.503, 0.652)) * (1.0 - ((angle >= 0.9) ? smoothstep(0.9, 1.0, angle) : 0.0)) * intersectionTest;
	sky += limaDarkening;
#endif

#if ATM_CLOUD_ENABLE
	if (intersectionTest && setting.cloud > 0.005f)
	{
		float2 outer = ComputeRaySphereIntersection(eye, V, setting.earthCenter, setting.earthRadius + setting.cloudTop);
		float2 inner = ComputeRaySphereIntersection(eye, V, setting.earthCenter, setting.earthRadius + setting.cloudBottom);
		
		if (outer.y > 0.0) 
		{
			float tStart = max(0.0f, inner.y > 0.0f ? inner.y : outer.x);
			float tEnd = outer.y;
			if (inner.x > 0.0f) tEnd = min(tEnd, inner.x);

			if (tEnd > tStart)
			{
				float3 cloudsStart = eye + V * tStart;
				float3 cloudsEnd   = eye + V * tEnd;

				// Clamp march distance to preserve high sample density towards horizon
				float marchDist = min(length(cloudsEnd - cloudsStart), 28000.0f);
				cloudsEnd = cloudsStart + V * marchDist;

				float3 cloudsMie = 0.0f;
				float cloudsOpticalLength = 0.0f;
				ComputeCloudsInsctrIntegral(setting, cloudsStart, cloudsEnd, V, -L, cloudsOpticalLength, cloudsMie);

				// Aerial perspective
				float horizonFade = saturate(abs(V.y) * 8.0f + 0.2f);
				float cloudTransmittance = exp(-cloudsOpticalLength * 4.0f);
				sky = lerp(sky, sky * cloudTransmittance + cloudsMie, horizonFade);
			}
		}
	}
#endif

	float maxLum = max(sky.r, max(sky.g, sky.b));
	if (maxLum > 0.8f)
	{
		float mappedLum = 0.8f + 0.2f * (1.0f - exp(-(maxLum - 0.8f) * 1.25f));
		sky *= (mappedLum / maxLum);
	}

	return float4(sky, phaseNight * intersectionTest);
}