#define NUMS_SAMPLES_CLOUD 8

// Multi-octave cloud textures (ported from SA_DirectX 3.0 / Horizon Zero Dawn model)
texture CloudMacroMap<string ResourceName = "shader/textures/clouds1.png";>; 
sampler CloudMacroMapSamp = sampler_state {
	texture = <CloudMacroMap>;
	MINFILTER = LINEAR; MAGFILTER = LINEAR; MIPFILTER = LINEAR;
	ADDRESSU = WRAP; ADDRESSV = WRAP;
};

texture CloudCoverMap<string ResourceName = "shader/textures/clouds2.png";>; 
sampler CloudCoverMapSamp = sampler_state {
	texture = <CloudCoverMap>;
	MINFILTER = LINEAR; MAGFILTER = LINEAR; MIPFILTER = LINEAR;
	ADDRESSU = WRAP; ADDRESSV = WRAP;
};

texture CloudDetailMap<string ResourceName = "shader/textures/clouds3.png";>; 
sampler CloudDetailMapSamp = sampler_state {
	texture = <CloudDetailMap>;
	MINFILTER = LINEAR; MAGFILTER = LINEAR; MIPFILTER = LINEAR;
	ADDRESSU = WRAP; ADDRESSV = WRAP;
};

texture CloudBlueNoiseMap<string ResourceName = "shader/textures/BlueNoise.png";>; 
sampler CloudBlueNoiseMapSamp = sampler_state {
	texture = <CloudBlueNoiseMap>;
	MINFILTER = LINEAR; MAGFILTER = LINEAR; MIPFILTER = NONE;
	ADDRESSU = WRAP; ADDRESSV = WRAP;
};

/**
 * Dual-lobe Henyey-Greenstein phase function with strong forward scattering (Silver Lining).
 */
float ComputeCloudPhaseHG(float cosTheta)
{
	const float g1 = 0.82f;
	const float g2 = -0.22f;
	const float g1_2 = g1 * g1;
	const float g2_2 = g2 * g2;
	
	float hgForward  = (1.0f - g1_2) / (4.0f * PI * pow(max(1.0f + g1_2 - 2.0f * g1 * cosTheta, 0.001f), 1.5f));
	float hgBackward = (1.0f - g2_2) / (4.0f * PI * pow(max(1.0f + g2_2 - 2.0f * g2 * cosTheta, 0.001f), 1.5f));
	
	return lerp(hgBackward, hgForward, 0.70f);
}

/**
 * Beer-Powder Law transmission calculation:
 * Models direct optical extinction combined with forward multiple-scattering in dense water droplets.
 */
float ComputeBeerPowder(float opticalDepth, float stepDensity)
{
	float beer = exp(-opticalDepth);
	float powder = 1.0f - exp(-stepDensity * 2.5f);
	return 2.0f * beer * powder;
}

/**
 * Smooth coverage remap curve (Guerrilla Games / Decima Engine cloud density carving).
 */
float RemapCoverage(float shape, float coverage)
{
	float c = saturate((shape - (1.0f - coverage)) / max(coverage, 0.01f));
	return c * c * (3.0f - 2.0f * c);
}

/**
 * Samples cloud density on the hemispherical sky dome at a given normalized altitude layer h in [0, 1].
 */
float SampleDomeCloudDensity(ScatteringParams setting, float2 domeUV, float h, float2 windOffset)
{
	// Natural height profile: flat cloud base, voluminous middle billows, soft wispy top
	float heightGradient = smoothstep(0.0f, 0.18f, h) * smoothstep(1.0f, 0.55f, h);
	if (heightGradient <= 1e-4f) return 0.0f;

	// Height-dependent wind shear (upper clouds move faster)
	float2 layerWind = windOffset * (1.0f + h * 0.85f);
	float2 uv1 = domeUV * 0.18f + layerWind;
	float2 uv2 = domeUV * 0.42f + layerWind * 0.7f;
	float2 uv3 = domeUV * 0.95f + layerWind * 1.2f + float2(h * 0.12f, 0.0f);

	// Macro weather fronts (large majestic formations across the sky)
	float macro1 = tex2Dlod(CloudMacroMapSamp, float4(uv1, 0, 0)).r;
	float cover2 = tex2Dlod(CloudCoverMapSamp, float4(uv2, 0, 0)).r;
	float targetCoverage = saturate(macro1 * 0.75f + cover2 * 0.45f);

	// Mid-frequency billowing cumulus lobes
	float cumulusNoise = tex2Dlod(CloudDetailMapSamp, float4(uv3, 0, 0)).r;
	
	// Carve cloud shapes using coverage remapping
	float density = RemapCoverage(cumulusNoise, targetCoverage) * heightGradient;

	// Soft edge detail erosion (wispy billowing fringes)
	float microErosion = tex2Dlod(CloudDetailMapSamp, float4(uv2 * 2.5f, 0, 0)).g;
	density = saturate(density - microErosion * 0.20f * (1.0f - h * 0.5f));

	return density * (setting.cloud * 0.015f);
}

float ComputeClound(ScatteringParams setting, float3 P)
{
	float3 V = normalize(P - setting.earthCenter);
	float domeCompression = max(V.y, 0.06f) + 0.18f * (1.0f - max(V.y, 0.0f));
	float2 domeUV = V.xz / domeCompression;
	return SampleDomeCloudDensity(setting, domeUV, 0.5f, setting.clouddir.xz);
}

float HitCloudsTest(ScatteringParams setting, float3 eye, float3 V, float3 L)
{
	if (V.y <= 0.01f) return 1.0f;
	float domeCompression = max(V.y, 0.06f) + 0.18f * (1.0f - max(V.y, 0.0f));
	float2 domeUV = V.xz / domeCompression;
	float density = SampleDomeCloudDensity(setting, domeUV, 0.5f, setting.clouddir.xz);
	return exp(-density * 2.5f);
}

/**
 * Volumetric sky-dome raymarching across 8 spherical altitude slices.
 */
float4 ComputeCloudsInscattering(ScatteringParams setting, float3 eye, float3 V, float3 L)
{
	float3 insctrMie = 0.0;
	float3 insctrRayleigh = 0.0;
	float3 insctrOpticalLength = 1.0;
	bool intersectionTest = ComputeSkyboxChapman(setting, eye, V, L, insctrOpticalLength, insctrMie, insctrRayleigh);

	float phaseTheta = dot(V, -L);
	float phaseMie = ComputePhaseMie(phaseTheta, setting.mieG);
	float phaseRayleigh = ComputePhaseRayleigh(phaseTheta);
	float phaseNight = 1.0 - saturate(insctrOpticalLength.x * EPSILON);

	float3 insctrTotalMie = insctrMie * phaseMie;
	float3 insctrTotalRayleigh = insctrRayleigh * phaseRayleigh;

	float3 sky = (insctrTotalMie + insctrTotalRayleigh) * setting.sunRadiance;

#if ATM_LIMADARKENING_ENABLE
	float angle = saturate((1 - phaseTheta) * sqrt(abs(L.y)) * setting.sunRadius);
	float cosAngle = cos(angle * PI * 0.5);

	float3 limaDarkening = GetTransmittance(setting, -L, V);
	limaDarkening *= pow(cosAngle, float3(0.420, 0.503, 0.652)) * (1.0 - ((angle >= 0.9) ? smoothstep(0.9, 1.0, angle) : 0.0)) * intersectionTest;

	sky += limaDarkening;
#endif

#if ATM_CLOUD_ENABLE
	if (intersectionTest && V.y > 0.005f)
	{
		// Hemispherical planetary dome coordinates (Horizon Zero Dawn dome projection)
		// Smoothly compresses clouds towards the horizon to simulate spherical curvature without planar stretching
		float domeCompression = max(V.y, 0.05f) + 0.16f * (1.0f - max(V.y, 0.0f));
		float2 domeUV = V.xz / domeCompression;

		// Blue noise jittering to eliminate step banding
		float blueNoise = tex2Dlod(CloudBlueNoiseMapSamp, float4(domeUV * 0.25f, 0, 0)).r;

		float3 accumulatedCloudColor = 0.0f;
		float transmittance = 1.0f;
		float totalOpticalDepth = 0.0f;

		float cosSunAngle = dot(V, -L);
		float phaseCloudHG = ComputeCloudPhaseHG(cosSunAngle);

		float2 wind = setting.clouddir.xz;
		float2 sunOffsetUV = (-L.xz / max(-L.y + 0.35f, 0.3f)) * 0.045f;

		[unroll]
		for (int i = 0; i < NUMS_SAMPLES_CLOUD; ++i)
		{
			if (transmittance < 0.02f) break;

			float h = (float(i) + blueNoise * 0.8f) / float(NUMS_SAMPLES_CLOUD);
			float density = SampleDomeCloudDensity(setting, domeUV, h, wind);

			if (density > 0.002f)
			{
				float stepOpticalDepth = density * 0.85f;

				// Sun extinction probe (single tap offset toward sun)
				float sunProbeDensity = SampleDomeCloudDensity(setting, domeUV + sunOffsetUV * (1.0f - h * 0.6f), h + 0.15f, wind);
				float sunOpticalDepth = (density * 0.4f + sunProbeDensity * 0.6f) * 2.2f;

				// Direct sunlight with Beer-Powder multiple-scattering & Silver Lining
				float sunTransmission = ComputeBeerPowder(sunOpticalDepth, density);
				float3 directSun = sunTransmission * (phaseCloudHG * 0.28f) * setting.sunRadiance * float3(1.04f, 0.98f, 0.92f);

				// Ambient sky lighting (bright cyan skylight on top, deep navy/gray occlusion at base)
				float3 ambientSky = lerp(float3(0.30f, 0.38f, 0.50f), float3(0.72f, 0.82f, 0.98f), h) * (setting.sunRadiance * 0.14f);

				float3 stepRadiance = directSun + ambientSky;

				// Energy-conserving front-to-back blending
				float stepTransmittance = exp(-stepOpticalDepth);
				accumulatedCloudColor += stepRadiance * (transmittance * (1.0f - stepTransmittance));
				transmittance *= stepTransmittance;
				totalOpticalDepth += stepOpticalDepth;
			}
		}

		// Aerial perspective horizon atmospheric blending (clouds softly dissolve into atmospheric haze at horizon)
		float horizonFade = saturate(V.y * 10.0f);
		float cloudTransmittance = exp(-totalOpticalDepth * 2.0f);

		float3 finalSky = sky * cloudTransmittance + accumulatedCloudColor;
		sky = lerp(sky, finalSky, horizonFade);
	}
#endif

	return float4(sky, phaseNight * intersectionTest);
}