#define NUMS_SAMPLES_CLOUD 8

// Multi-octave cloud textures (ported from SA_DirectX 3.0 / AAA Cumulus Model)
texture CloudMacroMap<string ResourceName = "shader/textures/clouds1.png";>; 
sampler CloudMacroMapSamp = sampler_state {
	texture = <CloudMacroMap>;
	MINFILTER = LINEAR; MAGFILTER = LINEAR; MIPFILTER = LINEAR;
	ADDRESSU = WRAP; ADDRESSV = WRAP;
};

texture CloudCoverMap<string ResourceName = "shader/textures/clouds2.png";>; 
sampler CloudCoverMapSamp = sampler_state {
	texture = <CloudCoverMap>;
	MINFILTER = LINEAR; MAGFILTER = LINEAR; MIPFILTER = LINEAR;
	ADDRESSU = WRAP; ADDRESSV = WRAP;
};

texture CloudDetailMap<string ResourceName = "shader/textures/clouds3.png";>; 
sampler CloudDetailMapSamp = sampler_state {
	texture = <CloudDetailMap>;
	MINFILTER = LINEAR; MAGFILTER = LINEAR; MIPFILTER = LINEAR;
	ADDRESSU = WRAP; ADDRESSV = WRAP;
};

texture CloudBlueNoiseMap<string ResourceName = "shader/textures/BlueNoise.png";>; 
sampler CloudBlueNoiseMapSamp = sampler_state {
	texture = <CloudBlueNoiseMap>;
	MINFILTER = LINEAR; MAGFILTER = LINEAR; MIPFILTER = NONE;
	ADDRESSU = WRAP; ADDRESSV = WRAP;
};

float ComputeRayPlaneIntersection(float3 position, float3 viewdir, float3 n, float dist)
{
	float a = dot(n, viewdir);
	if (a > 0.0)
	{
		return -1;
	}
	else
	{
		float t = -(dot(position, n) + dist) / a;
		return t;
	}
}

/**
 * Dual-lobe Henyey-Greenstein phase function with strong forward scattering (Silver Lining).
 */
float ComputeCloudPhaseHG(float cosTheta)
{
	const float g1 = 0.82f;
	const float g2 = -0.25f;
	const float g1_2 = g1 * g1;
	const float g2_2 = g2 * g2;
	
	float hgForward  = (1.0f - g1_2) / (4.0f * PI * pow(max(1.0f + g1_2 - 2.0f * g1 * cosTheta, 0.001f), 1.5f));
	float hgBackward = (1.0f - g2_2) / (4.0f * PI * pow(max(1.0f + g2_2 - 2.0f * g2 * cosTheta, 0.001f), 1.5f));
	
	return lerp(hgBackward, hgForward, 0.70f);
}

/**
 * Beer-Powder Law transmission calculation:
 * Models direct optical extinction combined with forward multiple-scattering in dense water droplets.
 */
float ComputeBeerPowder(float opticalDepth, float stepDensity)
{
	float beer = exp(-opticalDepth);
	float powder = 1.0f - exp(-stepDensity * 2.5f);
	return 2.0f * beer * powder;
}

/**
 * Smooth coverage remap curve (Guerrilla Games / Schneider cloud density carving).
 */
float RemapCoverage(float shape, float coverage)
{
	float c = saturate((shape - (1.0f - coverage)) / max(coverage, 0.01f));
	return c * c * (3.0f - 2.0f * c);
}

/**
 * Computes volumetric cumulus cloud density using realistic broad-scale FBM carving.
 */
float ComputeCloudDensity(ScatteringParams setting, float3 P, out float cloudHeight)
{
	float atmoHeight = length(P - setting.earthCenter) - setting.earthRadius;
	cloudHeight = saturate((atmoHeight - setting.cloudBottom) / max(setting.cloudTop - setting.cloudBottom, 1.0f));

	// Natural height profile: flat cloud base, voluminous middle billows, soft wispy top
	float heightGradient = smoothstep(0.0f, 0.18f, cloudHeight) * smoothstep(1.0f, 0.60f, cloudHeight);
	if (heightGradient <= 1e-4f) return 0.0f;

	float3 P1 = P + setting.clouddir;
	float3 P2 = P + setting.clouddir * 0.6f;

	// Macro cloud coverage (large majestic formations spanning tens of kilometers)
	float macroShape = tex2Dlod(CloudMacroMapSamp, float4(P1.xz * 0.000008f, 0, 0)).r;
	float coverNoise = tex2Dlod(CloudCoverMapSamp, float4(P2.xz * 0.000015f, 0, 0)).r;
	float targetCoverage = saturate(macroShape * 0.7f + coverNoise * 0.4f);

	// Mid-frequency cumulus structure
	float cumulusNoise = tex2Dlod(CloudDetailMapSamp, float4((P1.xz + P.y * 0.2f) * 0.000028f, 0, 0)).r;
	
	// Carve cloud shapes using coverage remapping
	float density = RemapCoverage(cumulusNoise, targetCoverage);
	density *= heightGradient;

	// Soft edge detail erosion (wispy micro-eddies without bubbly tiling)
	float microErosion = tex2Dlod(CloudDetailMapSamp, float4(P2.xz * 0.000085f, 0, 0)).g;
	density = saturate(density - microErosion * 0.18f * (1.0f - cloudHeight));

	return density * setting.cloud;
}

float ComputeClound(ScatteringParams setting, float3 P)
{
	float cloudHeight;
	return ComputeCloudDensity(setting, P, cloudHeight);
}

float HitCloudsTest(ScatteringParams setting, float3 eye, float3 V, float3 L)
{
	float2 cloudsOuterIntersections = ComputeRaySphereIntersection(eye, V, setting.earthCenter, setting.earthRadius + setting.cloudTop);
	float2 cloudsInnerIntersections = ComputeRaySphereIntersection(eye, V, setting.earthCenter, setting.earthRadius + setting.cloudBottom);

	if (cloudsInnerIntersections.y > 0)
		cloudsOuterIntersections.x = cloudsInnerIntersections.y;

	float3 cloudsStart = eye + V * max(0, cloudsOuterIntersections.x);
	float cloudHeight;
	return exp(-0.002f * ComputeCloudDensity(setting, cloudsStart, cloudHeight));
}

/**
 * Fast & ultra-efficient volumetric raymarching (60+ FPS, zero slice banding, natural lighting).
 */
void ComputeCloudsInsctrIntegral(ScatteringParams setting, float3 start, float3 end, float3 V, float3 L, inout float opticalDepth, inout float3 insctrMie)
{
	float3 rayVec = end - start;
	float totalDist = length(rayVec);
	float3 rayDir = rayVec / totalDist;
	float stepLength = totalDist / float(NUMS_SAMPLES_CLOUD);
	float3 sampleStep = rayDir * stepLength;

	// Blue noise jittering to eliminate step banding
	float blueNoise = tex2Dlod(CloudBlueNoiseMapSamp, float4(start.xz * 0.0005f, 0, 0)).r;
	float3 samplePos = start + sampleStep * (0.2f + blueNoise * 0.8f);

	float3 accumulatedColor = 0.0f;
	float transmittance = 1.0f;

	float cosTheta = dot(V, L);
	float phaseHG = ComputeCloudPhaseHG(cosTheta);

	// Light sample offset vector towards sun
	float3 lightOffsetStep = L * (stepLength * 2.2f);

	[loop]
	for (int i = 0; i < NUMS_SAMPLES_CLOUD; ++i)
	{
		if (transmittance < 0.03f) break;

		float cloudHeight;
		float density = ComputeCloudDensity(setting, samplePos, cloudHeight);

		if (density > 0.001f)
		{
			float stepOpticalDepth = density * stepLength * 0.00075f;

			// Single-tap light extinction probe towards the sun (high performance, no nested raymarch)
			float lightHeight;
			float lightDensity = ComputeCloudDensity(setting, samplePos + lightOffsetStep, lightHeight);
			float lightOpticalDepth = (density * 0.4f + lightDensity * 0.6f) * (stepLength * 2.2f) * 0.00075f;

			// Direct sun transmission (Beer-Powder law) + silver lining
			float sunTransmission = ComputeBeerPowder(lightOpticalDepth, density);
			float3 directSun = sunTransmission * (phaseHG * 0.25f) * setting.sunRadiance * float3(1.02f, 0.98f, 0.94f);

			// Ambient skylight (cool ambient at base, bright dome on top, proportional to sun power)
			float3 ambientSky = lerp(float3(0.28f, 0.35f, 0.48f), float3(0.65f, 0.75f, 0.88f), cloudHeight) * (setting.sunRadiance * 0.12f);
			
			// Source radiance (intensive quantity, energy-conserving)
			float3 stepScattering = directSun + ambientSky;

			// Energy-conserving front-to-back compositing
			float stepTransmittance = exp(-stepOpticalDepth);
			accumulatedColor += stepScattering * (transmittance * (1.0f - stepTransmittance));
			transmittance *= stepTransmittance;
			opticalDepth += stepOpticalDepth;
		}

		samplePos += sampleStep;
	}

	insctrMie = accumulatedColor;
}

float4 ComputeCloudsInscattering(ScatteringParams setting, float3 eye, float3 V, float3 L)
{
	float3 insctrMie = 0.0;
	float3 insctrRayleigh = 0.0;
	float3 insctrOpticalLength = 1.0;
	bool intersectionTest = ComputeSkyboxChapman(setting, eye, V, L, insctrOpticalLength, insctrMie, insctrRayleigh);

	float phaseTheta = dot(V, -L);
	float phaseMie = ComputePhaseMie(phaseTheta, setting.mieG);
	float phaseRayleigh = ComputePhaseRayleigh(phaseTheta);
	float phaseNight = 1.0 - saturate(insctrOpticalLength.x * EPSILON);

	float3 insctrTotalMie = insctrMie * phaseMie;
	float3 insctrTotalRayleigh = insctrRayleigh * phaseRayleigh;

	float3 sky = (insctrTotalMie + insctrTotalRayleigh) * setting.sunRadiance;

#if ATM_LIMADARKENING_ENABLE
	float angle = saturate((1 - phaseTheta) * sqrt(abs(L.y)) * setting.sunRadius);
	float cosAngle = cos(angle * PI * 0.5);

	float3 limaDarkening = GetTransmittance(setting, -L, V);
	limaDarkening *= pow(cosAngle, float3(0.420, 0.503, 0.652)) * (1.0 - ((angle >= 0.9) ? smoothstep(0.9, 1.0, angle) : 0.0)) * intersectionTest;

	sky += limaDarkening;
#endif

#if ATM_CLOUD_ENABLE
	if (intersectionTest && V.y > 0.01f)
	{
		float2 cloudsOuterIntersections = ComputeRayPlaneIntersection(eye, V, float3(0,-1,0), setting.cloudTop);
		float2 cloudsInnerIntersections = ComputeRayPlaneIntersection(eye, V, float3(0,-1,0), setting.cloudBottom);

		if (cloudsInnerIntersections.y > 0)
			cloudsOuterIntersections.x = cloudsInnerIntersections.y;

		float3 cloudsStart = eye + V * max(0, cloudsOuterIntersections.x);
		float3 cloudsEnd = eye + V * cloudsOuterIntersections.y;

		float3 cloudsMie = 0.0;
		float cloudsOpticalLength = 0.0;
		ComputeCloudsInsctrIntegral(setting, cloudsStart, cloudsEnd, V, -L, cloudsOpticalLength, cloudsMie);

		// Aerial perspective horizon blending (clouds smoothly dissolve into horizon atmosphere)
		float horizonFade = saturate(V.y * 12.0f);
		float cloudTransmittance = exp(-cloudsOpticalLength * 4.0f);
		
		float3 finalSkyWithClouds = sky * cloudTransmittance + cloudsMie;
		sky = lerp(sky, finalSkyWithClouds, horizonFade);
	}
#endif

	return float4(sky, phaseNight * intersectionTest);
}