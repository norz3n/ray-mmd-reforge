#define NUMS_SAMPLES_CLOUD 8

// Multi-octave cloud textures (SA_DirectX 3.0 cloud model adapted for Ray-MMD)
texture CloudMacroMap<string ResourceName = "shader/textures/clouds1.png";>; 
sampler CloudMacroMapSamp = sampler_state {
	texture = <CloudMacroMap>;
	MINFILTER = LINEAR; MAGFILTER = LINEAR; MIPFILTER = LINEAR;
	ADDRESSU = WRAP; ADDRESSV = WRAP;
};

texture CloudCoverMap<string ResourceName = "shader/textures/clouds2.png";>; 
sampler CloudCoverMapSamp = sampler_state {
	texture = <CloudCoverMap>;
	MINFILTER = LINEAR; MAGFILTER = LINEAR; MIPFILTER = LINEAR;
	ADDRESSU = WRAP; ADDRESSV = WRAP;
};

texture CloudDetailMap<string ResourceName = "shader/textures/clouds3.png";>; 
sampler CloudDetailMapSamp = sampler_state {
	texture = <CloudDetailMap>;
	MINFILTER = LINEAR; MAGFILTER = LINEAR; MIPFILTER = LINEAR;
	ADDRESSU = WRAP; ADDRESSV = WRAP;
};

texture CloudBlueNoiseMap<string ResourceName = "shader/textures/BlueNoise.png";>; 
sampler CloudBlueNoiseMapSamp = sampler_state {
	texture = <CloudBlueNoiseMap>;
	MINFILTER = LINEAR; MAGFILTER = LINEAR; MIPFILTER = NONE;
	ADDRESSU = WRAP; ADDRESSV = WRAP;
};

float ComputeRayPlaneIntersection(float3 position, float3 viewdir, float3 n, float dist)
{
	float a = dot(n, viewdir);
	if (a > 0.0)
		return -1;
	float t = -(dot(position, n) + dist) / a;
	return t;
}

/**
 * Dual-lobe Henyey-Greenstein phase function with strong forward scattering (Silver Lining).
 */
float ComputeCloudPhaseHG(float cosTheta)
{
	const float g1 = 0.82f, g2 = -0.25f;
	const float g1_2 = g1 * g1, g2_2 = g2 * g2;
	float hgF = (1.0f - g1_2) / (4.0f * PI * pow(max(1.0f + g1_2 - 2.0f * g1 * cosTheta, 0.001f), 1.5f));
	float hgB = (1.0f - g2_2) / (4.0f * PI * pow(max(1.0f + g2_2 - 2.0f * g2 * cosTheta, 0.001f), 1.5f));
	return lerp(hgB, hgF, 0.70f);
}

/**
 * Beer-Powder Law: models multiple scattering in dense water droplets.
 * Makes clouds look bright white and luminous, not dark smoke.
 */
float ComputeBeerPowder(float opticalDepth, float density)
{
	return 2.0f * exp(-opticalDepth) * (1.0f - exp(-density * 2.5f));
}

/**
 * Single-octave micro-detail erosion for soft cloud edge variation.
 * A single smooth sample avoids the "sandblasted" look that multi-octave FBM with
 * negative coefficients creates, while still breaking up the perfectly smooth coverage mask.
 */
float CloudMicroDetail(float2 uv)
{
	return tex2Dlod(CloudDetailMapSamp, float4(uv, 0, 0)).r;
}

/**
 * Volumetric cumulus cloud density — adapted from SA_DirectX 3.0 cl2() model.
 *
 * Key techniques (matching Makarus / Boris Vorontsov approach):
 *   Stage 1: Large coverage mask with two layers scrolling in OPPOSITE directions for parallax.
 *   Stage 2: clouds1 * detail (multiplication, not remap) for cumulus billowing.
 *   Stage 3: pow() sharpening curve that varies with height (sharp base, soft top).
 *   Stage 4: FBM micro-erosion with negative coefficient for ragged realistic edges.
 */
float ComputeCloudDensity(ScatteringParams setting, float3 P, out float cloudHeight)
{
	float atmoHeight = length(P - setting.earthCenter) - setting.earthRadius;
	cloudHeight = saturate((atmoHeight - setting.cloudBottom) / max(setting.cloudTop - setting.cloudBottom, 1.0f));

	// Asymmetric cumulus profile (SA_DirectX signature):
	// Very sharp flat BASE (real cumulus condensation level), gradual rounded TOPS
	float hBase = smoothstep(0.0f, 0.05f, cloudHeight);  // sharp flat base
	float hTop  = smoothstep(1.0f, 0.50f, cloudHeight);  // soft rounded top
	float heightMask = hBase * hTop;
	if (heightMask <= 1e-4f) return 0.0f;

	// Two drift layers scrolling in opposite directions (SA_DirectX parallax trick)
	// p1: fast-drifting detail layer (like p1.xy -= cl_time*146 in SA_DirectX)
	float3 p1 = P + setting.clouddir * 1.20f;
	// p2: slow counter-drifting coverage layer (like p2.xy += cl_time*15 in SA_DirectX)
	float3 p2 = P + setting.clouddir * 0.18f;

	// STAGE 1: Large-scale coverage mask (SA_DirectX: SamplerNoise2 at 0.00005*9.99)
	// Provides the broad cloud presence regions
	float clouds1 = clamp((tex2Dlod(CloudCoverMapSamp,  float4(p2.xz * 0.0000047f, 0, 0)).r * 1.2f * 0.56f) * 0.45f, 0.0f, 0.35f);
	clouds1 *= heightMask;
	clouds1 = lerp(1.0f, clouds1, 0.85f); // 15% minimum presence: prevents hard cutoffs

	// STAGE 2: Billowy cumulus structure carved through the coverage mask.
	// setting.cloud [0..1] shifts the THRESHOLD: low = sparse clouds, high = overcast.
	// At 0.0: threshold=0.52 → very few noise values qualify → almost no clouds
	// At 0.5: threshold=0.28 → partly cloudy (SA_DirectX default)
	// At 1.0: threshold=0.04 → almost everywhere qualifies → solid overcast
	float coverageThreshold = lerp(0.52f, 0.04f, saturate(setting.cloud));
	float billowy = clamp((tex2Dlod(CloudDetailMapSamp, float4(p1.xz * 0.000021f, 0, 0)).r * 2.15f * 0.56f - coverageThreshold) * 0.8f, 0.0f, 0.35f);
	float clouds2 = clouds1 * billowy;
	clouds2 *= smoothstep(0.0f, 0.35f, cloudHeight) * smoothstep(1.0f, 0.50f, cloudHeight);

	// STAGE 3: Power-curve sharpening (SA_DirectX: pow(clouds2, 0.3+0.3*smoothstep(...)))
	// Low exponent at base = soft gradient transition; high exponent at top = crisp edge
	float sharpness = 0.30f + 0.28f * smoothstep(0.08f, 0.50f, cloudHeight);
	float sh = pow(max(clouds2, 0.0f), sharpness);
	if (sh <= 0.0f) return 0.0f;

	// STAGE 4: Soft micro-detail erosion — single sample, gentle subtraction.
	// No negative-coefficient FBM: that caused the "sandblasted" look.
	float2 microUV = p1.xz * 0.000048f;
	float microDetail = CloudMicroDetail(microUV);

	// Threshold: 5.0*sh maps low sh values to [0..1], microDetail softens the boundary
	return saturate(5.0f * sh - microDetail * 0.30f);
}

float ComputeClound(ScatteringParams setting, float3 P)
{
	float cloudHeight;
	return ComputeCloudDensity(setting, P, cloudHeight);
}

float HitCloudsTest(ScatteringParams setting, float3 eye, float3 V, float3 L)
{
	float2 outer = ComputeRaySphereIntersection(eye, V, setting.earthCenter, setting.earthRadius + setting.cloudTop);
	float2 inner = ComputeRaySphereIntersection(eye, V, setting.earthCenter, setting.earthRadius + setting.cloudBottom);
	if (inner.y > 0) outer.x = inner.y;
	float3 cloudsStart = eye + V * max(0, outer.x);
	float cloudHeight;
	return exp(-0.002f * ComputeCloudDensity(setting, cloudsStart, cloudHeight));
}

/**
 * Volumetric raymarching — Beer-Powder law + single-tap sun probe + ambient height gradient.
 */
void ComputeCloudsInsctrIntegral(ScatteringParams setting, float3 start, float3 end, float3 V, float3 L, inout float opticalDepth, inout float3 insctrMie)
{
	float3 rayVec = end - start;
	float totalDist = length(rayVec);
	float stepLength = totalDist / float(NUMS_SAMPLES_CLOUD);
	float3 sampleStep = (rayVec / totalDist) * stepLength;

	// Blue noise jitter to kill banding
	float blueNoise = tex2Dlod(CloudBlueNoiseMapSamp, float4(start.xz * 0.0005f, 0, 0)).r;
	float3 samplePos = start + sampleStep * (0.2f + blueNoise * 0.8f);

	float3 accumulatedColor = 0.0f;
	float transmittance = 1.0f;

	float cosTheta = dot(V, L);
	float phaseHG = ComputeCloudPhaseHG(cosTheta);
	float3 lightStep = L * (stepLength * 2.5f);

	[loop]
	for (int i = 0; i < NUMS_SAMPLES_CLOUD; ++i)
	{
		if (transmittance < 0.03f) break;

		float cloudHeight;
		float density = ComputeCloudDensity(setting, samplePos, cloudHeight);

		if (density > 0.001f)
		{
			float stepOpticalDepth = density * stepLength * 0.00075f;

			// Single-tap sun probe (no nested loop: high perf, low noise)
			float lh;
			float lightDensity = ComputeCloudDensity(setting, samplePos + lightStep, lh);
			float lightOptical = (density * 0.4f + lightDensity * 0.6f) * (stepLength * 2.5f) * 0.00075f;

			float sunTrans = ComputeBeerPowder(lightOptical, density);
			float3 directSun = sunTrans * (phaseHG * 0.25f) * setting.sunRadiance * float3(1.02f, 0.98f, 0.94f);

			// Height-dependent ambient: warm golden near base, cool blue-white dome on top
			float3 ambientSky = lerp(float3(0.28f, 0.35f, 0.48f), float3(0.65f, 0.75f, 0.88f), cloudHeight) * (setting.sunRadiance * 0.12f);

			float stepTransmittance = exp(-stepOpticalDepth);
			accumulatedColor += (directSun + ambientSky) * (transmittance * (1.0f - stepTransmittance));
			transmittance *= stepTransmittance;
			opticalDepth += stepOpticalDepth;
		}

		samplePos += sampleStep;
	}

	insctrMie = accumulatedColor;
}

float4 ComputeCloudsInscattering(ScatteringParams setting, float3 eye, float3 V, float3 L)
{
	float3 insctrMie = 0.0;
	float3 insctrRayleigh = 0.0;
	float3 insctrOpticalLength = 1.0;
	bool intersectionTest = ComputeSkyboxChapman(setting, eye, V, L, insctrOpticalLength, insctrMie, insctrRayleigh);

	float phaseTheta = dot(V, -L);
	float phaseMie = ComputePhaseMie(phaseTheta, setting.mieG);
	float phaseRayleigh = ComputePhaseRayleigh(phaseTheta);
	float phaseNight = 1.0 - saturate(insctrOpticalLength.x * EPSILON);

	float3 insctrTotalMie = insctrMie * phaseMie;
	float3 insctrTotalRayleigh = insctrRayleigh * phaseRayleigh;
	float3 sky = (insctrTotalMie + insctrTotalRayleigh) * setting.sunRadiance;

#if ATM_LIMADARKENING_ENABLE
	float angle = saturate((1 - phaseTheta) * sqrt(abs(L.y)) * setting.sunRadius);
	float cosAngle = cos(angle * PI * 0.5);
	float3 limaDarkening = GetTransmittance(setting, -L, V);
	limaDarkening *= pow(cosAngle, float3(0.420, 0.503, 0.652)) * (1.0 - ((angle >= 0.9) ? smoothstep(0.9, 1.0, angle) : 0.0)) * intersectionTest;
	sky += limaDarkening;
#endif

#if ATM_CLOUD_ENABLE
	if (intersectionTest && V.y > 0.01f)
	{
		float tOuter = ComputeRayPlaneIntersection(eye, V, float3(0,-1,0), setting.cloudTop);
		float tInner = ComputeRayPlaneIntersection(eye, V, float3(0,-1,0), setting.cloudBottom);
		if (tInner > 0) tOuter = tInner;

		float3 cloudsStart = eye + V * max(0, tOuter);
		float3 cloudsEnd   = eye + V * ComputeRayPlaneIntersection(eye, V, float3(0,1,0), -setting.cloudTop);

		// Clamp march distance to avoid infinitely long rays near horizon
		float marchDist = min(length(cloudsEnd - cloudsStart), setting.cloudTop * 2.5f);
		cloudsEnd = cloudsStart + V * marchDist;

		float3 cloudsMie = 0.0;
		float cloudsOpticalLength = 0.0;
		ComputeCloudsInsctrIntegral(setting, cloudsStart, cloudsEnd, V, -L, cloudsOpticalLength, cloudsMie);

		// Aerial perspective: clouds dissolve at horizon
		float horizonFade = saturate(V.y * 12.0f);
		float cloudTransmittance = exp(-cloudsOpticalLength * 4.0f);
		sky = lerp(sky, sky * cloudTransmittance + cloudsMie, horizonFade);
	}
#endif

	return float4(sky, phaseNight * intersectionTest);
}