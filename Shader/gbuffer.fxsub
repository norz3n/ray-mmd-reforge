#define SHADINGMODELID_DEFAULT    0
#define SHADINGMODELID_SKIN       1
#define SHADINGMODELID_EMISSIVE   2
#define SHADINGMODELID_ANISOTROPY 3
#define SHADINGMODELID_GLASS      4
#define SHADINGMODELID_CLOTH      5
#define SHADINGMODELID_CLEAR_COAT 6
#define SHADINGMODELID_SUBSURFACE 7
#define SHADINGMODELID_CEL        8
#define SHADINGMODELID_TONEBASED  9
#define SHADINGMODELID_MASK       10

// How much SSAO/HBAO (and sun-shadow softening) affects skin (0 = ignored,
// 1 = same as other materials).  Kept below 1 so skin keeps its soft SSS
// falloff, but high enough that contact shadows actually ground the figure.
#define SKIN_AO_STRENGTH          0.75
// Dermal reflectance range for GI (light skin ~30-45%, dark ~10-20%; melanin/hemoglobin absorption).
#define SKIN_GI_REFLECTANCE_DARK  0.15f
#define SKIN_GI_REFLECTANCE_LIGHT 0.42f
// Total skin diffuse response (Lambert + wrap + translucency + IBL back-light) is capped at
// BUDGET x incident irradiance. 1.0 = strict physical conservation (SSS only redistributes
// energy); >1.0 lets the brightest texture regions (blush, highlights) keep their punch for
// a more artistic glowing look, at the cost of skin possibly outshining white surfaces.
#define SKIN_SSS_ENERGY_BUDGET    1.40f
// SSGI brightness compensation: max +10% on reception, scaled by luminance (dim skin gets ~0,
// bright skin gets the full cap)
#define SKIN_GI_COMPENSATION      0.10f
// SSGI skin bounce suppression: skin throws off too much glow, damp its emitter
// contribution.  Applied before the mode-2 gather gain (PI*8), so the effective
// room bounce off skin is scale x PI x 8 x receiver response — keep the raw
// scale small enough that this reads as a faint dermal glow, not a light source.
#define SKIN_GI_EMISSION_SCALE    0.04f

#define MAX_FRACTIONAL_8_BIT       (255.0f / 256.0f)
#define TWO_BITS_EXTRACTION_FACTOR (3.0f + MAX_FRACTIONAL_8_BIT)

struct MaterialParam
{
	float3 normal;
	float3 albedo;
	float3 specular;
	float smoothness;
	float alpha;
	float visibility;
	float customDataA;
	float3 customDataB;
	float linearDepth;
	int lightModel;
};

struct GbufferParam
{
	float4 buffer1 : COLOR0;
	float4 buffer2 : COLOR1;
	float4 buffer3 : COLOR2;
	float4 buffer4 : COLOR3;
};

float3 EncodeNormal(float3 normal)
{
	float invP = rsqrt(max(-normal.z * 8.0f + 8.0f, 1e-6f));
	float2 enc = normal.xy * invP + 0.5f;
	float2 enc255 = enc * 255.0f;
	float2 residual = floor(frac(enc255) * 16.0f);
	return float3(floor(enc255), residual.x * 16.0f + residual.y) / 255.0f;
}

float3 DecodeNormal(float3 enc)
{
	float nz = floor(enc.z * 255) / 16;
	enc.xy += float2(floor(nz) / 16, frac(nz)) / 255;
	float2 fenc = enc.xy * 4 - 2;
	// Branchless validity clamp instead of the early-out return: this decoder runs
	// dozens of times per pixel inside the SSDO/SSGI blur loops, and corrupt
	// texels only occur on cleared/empty G-buffer pixels that consumers clip anyway.
	// dot() is never negative, so only the upper bound needs clamping.
	float f = min(dot(fenc, fenc), 10.0f);
	float g = sqrt(max(1.0f - f / 4.0f, 0.0f));
	float3 normal;
	normal.xy = fenc * g;
	normal.z = f / 2 - 1;
	return normal;
}

float3 EncodeNormalOctahedron(float3 normal)
{
	float2 enc = EncodeOctahedron(normal);
	float2 enc255 = enc * 255.0f;
	float2 residual = floor(frac(enc255) * 16.0f);
	return float3(floor(enc255), residual.x * 16.0f + residual.y) / 255.0f;
}

float3 DecodeNormalOctahedron(float3 enc)
{
	float nz = floor(enc.z * 255.0f) / 16.0f;
	enc.xy += float2(floor(nz) / 16.0f, frac(nz)) / 255.0f;
	return DecodeOctahedron(enc.xy);
}

float3 EncodeYcbcr(float3 col)
{
	col = sqrt(col);
	float3 encode;
	encode.x = dot(col.rgb, float3(0.299, 0.587, 0.114));
	encode.y = dot(col.rgb, float3(-0.1687, -0.3312, 0.5) * MIDPOINT_8_BIT) + MIDPOINT_8_BIT;
	encode.z = dot(col.rgb, float3(0.5, -0.4186, -0.0813) * MIDPOINT_8_BIT) + MIDPOINT_8_BIT;
	return encode;
}

float3 DecodeYcbcr(float3 YCbCr)
{
	YCbCr = float3(YCbCr.x, YCbCr.y / MIDPOINT_8_BIT - 1, YCbCr.z / MIDPOINT_8_BIT - 1);
	float R = YCbCr.x + 1.402 * YCbCr.z;
	float G = dot(float3( 1, -0.3441, -0.7141 ), YCbCr.xyz);
	float B = YCbCr.x + 1.772 * YCbCr.y;
	return pow2(float3(R, G, B));
}

// Dermal reflectance: authored MMD skin textures are near-white, but real skin reflects
// only 10-45% of visible light (melanin/hemoglobin absorption).
float3 ClampDermalAlbedo(float3 albedo)
{
	float luma = dot(albedo, float3(0.299f, 0.587f, 0.114f));
	return albedo * lerp(SKIN_GI_REFLECTANCE_DARK, SKIN_GI_REFLECTANCE_LIGHT, saturate((luma - 0.15f) / 0.55f)) / max(luma, 1e-4f);
}

void DecodeGbuffer(float4 buffer1, float4 buffer2, float4 buffer3, float4 buffer4, out MaterialParam material)
{
	material.albedo = buffer1.xyz;
	material.specular = buffer3.xyz;

	material.normal = DecodeNormal(buffer2.xyz);
	material.smoothness = buffer1.w;

	material.customDataA = buffer2.w;
	material.customDataB = 0;

	material.alpha = frac(buffer4.w) / MAX_FRACTIONAL_8_BIT;

	material.linearDepth = buffer4.x;
	material.visibility = buffer4.z;
	material.lightModel = (int)floor(buffer4.w);

	if (material.lightModel >= SHADINGMODELID_MASK)
		material.lightModel = SHADINGMODELID_DEFAULT;

	if (material.lightModel != SHADINGMODELID_DEFAULT)
	{
		material.specular = buffer3.x;
		material.customDataB = buffer3.yzw;
		if (material.lightModel == SHADINGMODELID_EMISSIVE)
			material.customDataA = buffer4.y;
	}

	// Dermal reflectance: authored MMD skin textures are near-white, but real skin reflects
	// only 10-45% of visible light (melanin/hemoglobin absorption). Clamping albedo once here
	// makes every downstream consumer (direct, IBL, SSS, GI emit/receive) physical.
	if (material.lightModel == SHADINGMODELID_SKIN || material.lightModel == SHADINGMODELID_SUBSURFACE)
		material.albedo = ClampDermalAlbedo(material.albedo);
}

float3 DecodeGBufferAlbedo(float4 buffer1)
{
	return buffer1.rgb;
}

float3 DecodeGBufferNormal(float4 buffer2)
{
	return DecodeNormal(buffer2.rgb);
}

int DecodeLightModel(float4 buffer4)
{
	int lightModel = (int)floor(buffer4.w);
	return lightModel;
}

float DecodeEmissiveIntensity(float4 buffer4)
{
	return buffer4.y;
}

float3 DecodeGBufferEmissive(float4 buffer3, float4 buffer4)
{
	int lightModel = DecodeLightModel(buffer4);
	if (lightModel != SHADINGMODELID_EMISSIVE)
		return 0;
	else
		return buffer3.yzw * DecodeEmissiveIntensity(buffer4);
}

float4 GetProjConstant()
{
	return float4(2, -2, -1, 1) * float2(matProjectInverse._11, matProjectInverse._22).xyxy / matProjectInverse._43;
}

float3 GetViewPosition(float4 projConstant, float2 coord, float depth)
{
	return float3(coord * projConstant.xy + projConstant.zw, 1) * depth;
}