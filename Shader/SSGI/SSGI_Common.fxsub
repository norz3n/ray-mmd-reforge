/**
 * Ray-MMD ReForge: Screen-Space Global Illumination (SSGI) Common Declarations
 *
 * Module: SSGI_Common.fxsub
 * Independent Diffuse Global Illumination & Radiance Gather Pipeline.
 * Provides quality constants, controller uniform bindings, and geometry decoding helpers.
 */

#ifndef RAY_MMD_SSGI_COMMON_FXSUB
#define RAY_MMD_SSGI_COMMON_FXSUB

#if GI_QUALITY == 1
#	define SSGI_RAY_COUNT 4
#	define SSGI_STEPS 12
#	define SSGI_RADIUS 16
#elif GI_QUALITY == 2
#	define SSGI_RAY_COUNT 8
#	define SSGI_STEPS 12
#	define SSGI_RADIUS 16
#elif GI_QUALITY == 3
#	define SSGI_RAY_COUNT 12
#	define SSGI_STEPS 14
#	define SSGI_RADIUS 16
#elif GI_QUALITY == 4
#	define SSGI_RAY_COUNT 20
#	define SSGI_STEPS 16
#	define SSGI_RADIUS 18
#else
#	define SSGI_RAY_COUNT 8
#	define SSGI_STEPS 12
#	define SSGI_RADIUS 16
#endif

// Compatibility alias for legacy passes
#define SSGI_ANGLES SSGI_RAY_COUNT

// Controller item bindings
float mSSGIIntensityPlus : CONTROLOBJECT < string name="ray_controller.pmx"; string item = "SSGI+"; >;
float mSSGIIntensityMinus : CONTROLOBJECT < string name="ray_controller.pmx"; string item = "SSGI-"; >;

// DebugController tuning knobs (all default to stock behavior at morph weight 0)
float mDbgSSGIEmissiveBoost : CONTROLOBJECT < string name="DebugController.pmx"; string item = "SSGIEmissiveBoost"; >;
float mDbgSSGIModeGain      : CONTROLOBJECT < string name="DebugController.pmx"; string item = "SSGIModeGain"; >;
float mDbgSSGISkyLight      : CONTROLOBJECT < string name="DebugController.pmx"; string item = "SSGISkyLight"; >;

/**
 * Fetches linear view-space depth for SSGI processing.
 */
inline float GetSSGILinearDepth(float2 uv)
{
	return tex2Dlod(Gbuffer8Map, float4(uv, 0.0f, 0.0f)).r;
}

/**
 * Decodes view-space surface normal for SSGI processing.
 */
inline float3 GetSSGINormal(float2 uv)
{
	return DecodeGBufferNormal(tex2Dlod(Gbuffer6Map, float4(uv, 0.0f, 0.0f)));
}

/**
 * Constructs an orthonormal tangent space basis (T, B, N) from unit normal N.
 * Implements Duff et al. (2017) branchless formulation for optimal SM 3.0 execution.
 */
inline void BuildOrthonormalBasis(in float3 N, out float3 T, out float3 B)
{
	float signZ = (N.z >= 0.0f) ? 1.0f : -1.0f;
	float a = -1.0f / (signZ + N.z);
	float b = N.x * N.y * a;
	T = float3(1.0f + signZ * N.x * N.x * a, signZ * b, -signZ * N.x);
	B = float3(b, signZ + N.y * N.y * a, -N.y);
}

/**
 * Low-discrepancy radical inverse base 2 (van der Corput sequence) in SM 3.0 float ALU.
 */
inline float Halton2(int index)
{
	float result = 0.0f;
	float f = 0.5f;
	[unroll]
	for (int i = 0; i < 5; ++i)
	{
		if (index <= 0) break;
		result += float(index % 2) * f;
		index /= 2;
		f *= 0.5f;
	}
	return result;
}

/**
 * Low-discrepancy radical inverse base 3 in SM 3.0 float ALU.
 */
inline float Halton3(int index)
{
	float result = 0.0f;
	float f = 1.0f / 3.0f;
	[unroll]
	for (int i = 0; i < 4; ++i)
	{
		if (index <= 0) break;
		result += float(index % 3) * f;
		index /= 3;
		f *= (1.0f / 3.0f);
	}
	return result;
}

/**
 * Analytical branchless scaling factor to clip a 2D ray step exactly to viewport margins.
 * Computes axis-aligned bounding intersection without divergence or shooting to infinity.
 */
inline float ClipRayToScreenEdge(float2 rayStart, float2 rayStep)
{
	float2 targetUV = lerp(0.002f, 0.998f, step(0.0f, rayStep));
	float2 clipAxes = abs(targetUV - rayStart) / (abs(rayStep) + 1e-7f);
	return saturate(min(clipAxes.x, clipAxes.y));
}

/**
 * Computes smooth bilateral thickness visibility weight for diffuse and emissive surfaces.
 * Rejects samples that penetrate deeper than geometry thickness to prevent light bleeding
 * through thin objects (fingers, hair, thin walls, or distant backgrounds behind emitters).
 */
inline float ComputeThicknessWeight(float zDiff, float viewZ, float distance, float stepLength = 0.0f, bool isEmissive = false)
{
	float dynamicThickness = max(0.08f, 0.04f + distance * 0.035f + stepLength * (isEmissive ? 1.50f : 0.40f));
	if (isEmissive)
		dynamicThickness = max(dynamicThickness, 0.35f);

	if (zDiff < -0.02f || zDiff > dynamicThickness)
		return 0.0f;
	float x = saturate(zDiff / dynamicThickness);
	return 1.0f - (x * x * (3.0f - 2.0f * x));
}

#endif // RAY_MMD_SSGI_COMMON_FXSUB
