/**
 * Ray-MMD ReForge: Screen-Space Global Illumination (SSGI) Raymarch & Radiance Gather
 *
 * Module: SSGI_Trace.fxsub
 * Independent Hierarchical Diffuse Raymarching & Radiance Integration Engine.
 * Gathers hemisphere indirect irradiance with staggered jitter from the full-resolution G-buffer.
 */

#ifndef RAY_MMD_SSGI_TRACE_FXSUB
#define RAY_MMD_SSGI_TRACE_FXSUB

#include "shader/SSGI/SSGI_Common.fxsub"
#include "shader/BilateralCommon.fxsub"

#if IBL_QUALITY
/**
 * Minimal 2-tap decode of the checkerboard-packed EnvLightMap.
 *
 * ibl.fxsub's DecodeYcbcr costs 5 taps plus chroma edge filtering and blew the
 * ps_3_0 temp register budget (X4505) when inlined into the gather loop.  The
 * env map is pre-blurred, so the edge filter is unnecessary here — only the
 * neighbouring pixel's interleaved chroma channel is required.
 */
float3 SampleSkyRadiance(float2 skyUv)
{
	float4 packed = tex2Dlod(EnvLightMapSamp, float4(skyUv, 0.0f, 0.0f));
	float4 neighbor = tex2Dlod(EnvLightMapSamp, float4(skyUv + float2(ViewportOffset2.x, 0.0f), 0.0f, 0.0f));
	// Checkerboard parity of the pixel: parities are equal iff (x+y) is even.
	// frac-based test avoids the fragile float == comparison of fmod(a)==fmod(b).
	bool pattern = (frac((skyUv.x * ViewportSize.x + skyUv.y * ViewportSize.y) * 0.5f) < 0.5f);
	float3 ycbcr = pattern ? float3(packed.rg, neighbor.g) : float3(packed.r, neighbor.g, packed.g);
	return DecodeYcbcr(ycbcr);
}
#endif

inline float SSGIEmissiveTapWeight(float2 uv, float zCenter, float depthTolerance)
{
	float4 g8 = tex2Dlod(Gbuffer8Map, float4(uv, 0.0f, 0.0f));
	float emissive = 1.0f - saturate(abs(floor(g8.a) - SHADINGMODELID_EMISSIVE));
	return emissive * BilateralDepthWeight(g8.r, zCenter, depthTolerance);
}

float3 SSGISampleStableEmissive(float2 uv, float zCenter, float3 centerColor, float stepProgress)
{
	float2 stepUv = ViewportOffset2 * lerp(2.0f, 5.0f, stepProgress);
	float depthTolerance = min(max(zCenter * 0.04f, 0.5f), 5.0f);

	float wCenter = 3.0f;
	float wR = SSGIEmissiveTapWeight(uv + float2(stepUv.x, 0.0f), zCenter, depthTolerance);
	float wL = SSGIEmissiveTapWeight(uv - float2(stepUv.x, 0.0f), zCenter, depthTolerance);
	float wU = SSGIEmissiveTapWeight(uv + float2(0.0f, stepUv.y), zCenter, depthTolerance);
	float wD = SSGIEmissiveTapWeight(uv - float2(0.0f, stepUv.y), zCenter, depthTolerance);
	float totalW = wCenter + wR + wL + wU + wD;

	float3 color = centerColor * wCenter;
	color += clamp(tex2Dlod(ShadingMapSamp, float4(uv + float2(stepUv.x, 0.0f), 0.0f, 0.0f)).rgb, 0.0f, 100.0f) * wR;
	color += clamp(tex2Dlod(ShadingMapSamp, float4(uv - float2(stepUv.x, 0.0f), 0.0f, 0.0f)).rgb, 0.0f, 100.0f) * wL;
	color += clamp(tex2Dlod(ShadingMapSamp, float4(uv + float2(0.0f, stepUv.y), 0.0f, 0.0f)).rgb, 0.0f, 100.0f) * wU;
	color += clamp(tex2Dlod(ShadingMapSamp, float4(uv - float2(0.0f, stepUv.y), 0.0f, 0.0f)).rgb, 0.0f, 100.0f) * wD;

	return color / max(totalW, 1e-5f);
}

/**
 * Screen-Space Global Illumination Radiance Integration Pixel Shader.
 */
float4 SSGIPassPS(in float4 uvCoord : TEXCOORD0, in float3 viewDir : TEXCOORD1) : COLOR
{
	float zOrigin = GetSSGILinearDepth(uvCoord.xy);
	if (!(zOrigin > 0.0f && zOrigin < 1000.0f))
		clip(-1);

	float4 projInfo = GetProjConstant();
	float3 nOrigin = GetSSGINormal(uvCoord.xy);
	float3 pOrigin = GetViewPosition(projInfo, uvCoord.xy, zOrigin);

	// Receiver shading model: skin receiving skin radiance keeps the full
	// albedo weighting (the emitter's dermal albedo is already baked into
	// ShadingMap), so a boosted SSGI still brightens skin.  Only skin ->
	// non-skin emission gets the bounce clamp below.
	int receiverModel = (int)floor(tex2Dlod(Gbuffer8Map, float4(uvCoord.xy, 0.0f, 0.0f)).a);
	bool receiverIsSkin = (receiverModel == SHADINGMODELID_SKIN || receiverModel == SHADINGMODELID_SUBSURFACE);

	// Adaptive world radius scaling (mode 1: focused bounce, mode 2: large room-scale gather)
	// Cone angle widens/narrows the gather cone; stock default (mSSGIConeAngleDefault = 0.5) keeps the radius unchanged
#if GI_ENABLE >= 2
	float maxWorldDistance = max(mSSGIScale * 75.0f, 5.0f);
	float projScale = max(abs(projInfo.x), 1e-4f);
	float screenRadius = clamp(maxWorldDistance / (zOrigin * projScale), 0.02f, 0.85f);
#else
	float maxWorldDistance = max(mSSGIScale * 35.0f, 2.0f);
	float projScale = max(abs(projInfo.x), 1e-4f);
	float screenRadius = clamp(maxWorldDistance / (zOrigin * projScale), 0.01f, 0.6f);
#endif
	screenRadius *= clamp(mSSGIConeAngle * 2.0f, 0.25f, 4.0f);

	float2 screenPixel = uvCoord.xy * ViewportSize;
#if AA_QUALITY == 6
	int frameCounter = (int)fmod(time * 60.0f, 16.0f);
#else
	int frameCounter = 0;
#endif
	// White-noise hash: isotropic decorrelation avoids directional banding
	float noiseAngle = frac(sin(dot(screenPixel + float(frameCounter) * 5.588238f, float2(127.1f, 311.7f))) * 43758.5453f);
	float noiseRadius = frac(sin(dot(screenPixel + float(frameCounter) * 5.588238f, float2(269.5f, 183.3f))) * 43758.5453f);

	// Stratified sector jitter: keeps angular coherence across adjacent pixels to prevent blotchy clumping
	float startAngle = noiseAngle * (PI_2 / float(SSGI_ANGLES));
	float3 totalGi = 0.0f;
	float minDistanceSq = max(mSSGIBias * mSSGIBias * 0.02f, 0.04f);

#if GI_ENABLE >= 2
	float giGain = PI * lerp(lerp(1.0f, 15.0f, mSSGIIntensityPlus), 0.0f, mSSGIIntensityMinus)
		* (8.0f * lerp(1.0f, 2.5f, mDbgSSGIModeGain));
#else
	float giGain = PI * lerp(lerp(1.0f, 3.0f, mSSGIIntensityPlus), 0.0f, mSSGIIntensityMinus)
		* (1.0f * lerp(1.0f, 3.0f, mDbgSSGIModeGain));
#endif
	// Gather gain at neutral user morphs — what SKIN_GI_EMISSION_SCALE was
	// calibrated against.  Skin bounce is clamped to this level no matter how
	// far the gain is pushed: skin may receive any amount of light but
	// re-emits only its dermal albedo, so the SSGI boost should fill the room,
	// not amplify the skin's own radiance.
	float giGainRef = PI * (1.0f * lerp(1.0f, 3.0f, mDbgSSGIModeGain))
		* ((GI_ENABLE >= 2) ? 8.0f : 1.0f);

	[loop]
	for (int a = 0; a < SSGI_ANGLES; ++a)
	{
		float theta = (float(a) / float(SSGI_ANGLES)) * PI_2 + startAngle;
		float2 direction = float2(cos(theta), sin(theta));
		float rayJitter = frac(noiseRadius + float(a) * 0.61803398875f);

		float3 rayColor = 0.0f;
		float rayOcc = 0.0f;
		float2 prevUv = uvCoord.xy;

		[loop]
		for (int s = 0; s < SSGI_STEPS; ++s)
		{
			// Linear-quadratic hybrid progression: equidistant spacing avoids skipping emitters while keeping near-field detail
			float stepProgress = (float(s) + rayJitter) / float(SSGI_STEPS);
			float stepDist = lerp(stepProgress, stepProgress * stepProgress, 0.25f);
			float2 currentUv = uvCoord.xy + direction * (screenRadius * stepDist);

			if (currentUv.x < 0.0f || currentUv.x > 1.0f || currentUv.y < 0.0f || currentUv.y > 1.0f)
				break;

			// Hi-Z depths are min-reduced over 2x2/4x4 pixels.  Reconstructing a
			// position from that depth at currentUv while reading its normal/color at
			// full resolution creates block-shaped false emitters on small receivers.
			// A fixed four-step gather is cheaper and coherent with one G-buffer tap.
			float4 g8 = tex2Dlod(Gbuffer8Map, float4(currentUv, 0.0f, 0.0f));
			float zSample = g8.r;

			if (zSample > 0.0f && zSample < 1000.0f)
			{
				float3 pSample = GetViewPosition(projInfo, currentUv, zSample);
				float3 diff = pSample - pOrigin;
				float distSq = dot(diff, diff);

				// Reject self-sampling (bias check)
				if (distSq > minDistanceSq)
				{
					float dist = sqrt(distSq);
					float3 lightVector = diff / dist;

					// Receiver cosine factor (strictly positive hemisphere prevents coplanar floor self-illumination rings)
					float NdotL = dot(nOrigin, lightVector);
					if (NdotL > 0.03f)
					{
						int shadingModel = (int)floor(g8.a);
						bool isEmissive = (shadingModel == SHADINGMODELID_EMISSIVE);
						bool isSkinEmitter = (shadingModel == SHADINGMODELID_SKIN || shadingModel == SHADINGMODELID_SUBSURFACE);

						// Emitter cosine factor (strictly Lambertian cosine emission prevents corner light accumulation)
						float3 nSample = GetSSGINormal(currentUv);
						float NsDotMinusL = dot(nSample, -lightVector);
						if (NsDotMinusL > 0.0f || isEmissive)
						{
							float emitterCosine = isEmissive ? saturate(NsDotMinusL * 0.5f + 0.5f) : saturate(NsDotMinusL);
							float geomFactor = saturate(NdotL) * emitterCosine;
							float distRatio = saturate(dist / maxWorldDistance);
							float fade = saturate(1.0f - distRatio);
							fade = fade * fade * (3.0f - 2.0f * fade);
						#if GI_ENABLE >= 2
							float falloffLinear = isEmissive ? 0.08f : 0.035f;
							float falloffQuad   = isEmissive ? 0.005f : 0.0f;
						#else
							float falloffLinear = isEmissive ? 0.15f : 0.35f;
							float falloffQuad   = isEmissive ? 0.02f : 0.0f;
						#endif
							float invDistFalloff = 1.0f / (1.0f + dist * falloffLinear + dist * dist * falloffQuad);
							// Near-field contact damping to prevent self-sampling texture ghosting on fine meshes
							float nearContactDamping = smoothstep(0.04f, 0.30f, dist);
							float atten = fade * invDistFalloff * (isEmissive ? smoothstep(0.01f, 0.15f, dist) : nearContactDamping);

							// Thickness and SSGI emitter visibility weighting
							float emitterVis = tex2Dlod(SSGIVisibilityMapSamp, float4(currentUv, 0.0f, 0.0f)).a;
							float thickWeight = isEmissive ? 1.0f : ComputeThicknessWeight(pSample.z - pOrigin.z, pOrigin.z, dist);
							float w = saturate(geomFactor * atten * thickWeight * emitterVis);

							if (w > 1e-3f)
							{
								float3 sampleColor = tex2Dlod(ShadingMapSamp, float4(currentUv, 0.0f, 0.0f)).rgb;
								// ShadingMap already contains emitter albedo (applied once in the SSSS
								// DESTCOLOR*SRC composite) - multiplying by an emitter-albedo ratio here
								// would double-count (Lo * rho_e). No extra weighting needed.
								sampleColor = clamp(sampleColor, 0.0f, 100.0f);

								if (isEmissive)
								{
									// 1-step bisection: refine hit towards leading edge of emitter for subpixel precision
									float2 midUv = (prevUv + currentUv) * 0.5f;
									float4 g8Mid = tex2Dlod(Gbuffer8Map, float4(midUv, 0.0f, 0.0f));
									if ((int)floor(g8Mid.a) == SHADINGMODELID_EMISSIVE)
									{
										currentUv = midUv;
										zSample = g8Mid.r;
									}

									sampleColor = SSGISampleStableEmissive(currentUv, zSample, sampleColor, stepProgress);
									float emissiveLuma = dot(sampleColor, float3(0.299f, 0.587f, 0.114f));
									float compressedLuma = emissiveLuma / (1.0f + emissiveLuma * 0.12f);
									sampleColor = sampleColor * (compressedLuma / max(emissiveLuma, 1e-4f)) * lerp(2.5f, 8.0f, mDbgSSGIEmissiveBoost);
								}
								else if (isSkinEmitter && !receiverIsSkin)
								{
									// Skin radiance overshoots in screen-space gathers (bright wide lobes);
									// suppress its bounce into the room, and clamp harder as the user's GI
									// gain rises above the calibrated reference so boosted SSGI never
									// amplifies skin beyond its dermal bounce albedo.  Skin receivers are
									// exempt: skin-to-skin light keeps its full albedo weighting so skin
									// still brightens with the boost.
									sampleColor *= SKIN_GI_EMISSION_SCALE * saturate(giGainRef / max(giGain, 1e-4f));
								}

								// Front-to-back ray accumulation
								float hitFactor = w * (1.0f - rayOcc);
								rayColor += sampleColor * hitFactor;
								rayOcc += hitFactor;

								if (rayOcc > 0.95f)
									break;
							}
						}
					}
				}
			}

			prevUv = currentUv;
		}

#if GI_ENABLE >= 2
		// Sky/background radiance fallback: if the ray escaped into open sky in this direction (Indirect mode only).
		// Uses the true reconstructed view-space direction to each sky tap instead of a synthetic screen-angle
		// field (which produced wave banding), and splits the contribution over two taps so residual
		// structure dissolves into grain that the bilateral blur removes.
		if (rayOcc < 0.85f)
		{
			[unroll]
			for (int t = 0; t < 4; ++t)
			{
				// Per-pixel jittered tap distances: a fixed tapT makes the reconstructed sky
				// direction a smooth screen-angle field (visible bands); jitter turns it into
				// grain that the bilateral blur removes.  Four taps keep a small bright sky
				// keyhole (a window) from collapsing into a single hard streak.
				float tapT = lerp(0.30f, 0.95f, frac(rayJitter * 1.61803398875f + float(t) * 0.265f));
				float2 skyUv = uvCoord.xy + direction * (screenRadius * tapT);
				if (skyUv.x >= 0.0f && skyUv.x <= 1.0f && skyUv.y >= 0.0f && skyUv.y <= 1.0f)
				{
					float skyDepth = GetSSGILinearDepth(skyUv);
					if (skyDepth <= 1e-4f)
					{
						float3 pSky = GetViewPosition(projInfo, skyUv, maxWorldDistance);
						float3 skyDir = normalize(pSky - pOrigin);
						float NdotSky = saturate(dot(nOrigin, skyDir));
						if (NdotSky > 0.0f)
						{
#if IBL_QUALITY
							// EnvLightMap is the HDR screen-space projection of the environment
							// alone (its DefaultEffect hides all geometry), so a background pixel
							// holds the true sky radiance for that direction — unlike the
							// tonemapped LDR scene background in ScnSamp.
							float3 skyColor = SampleSkyRadiance(skyUv);
#else
							float3 skyColor = srgb2linear(tex2Dlod(ScnSamp, float4(skyUv, 0.0f, 0.0f)).rgb);
#endif
							// Total over 4 taps: NdotSky x lerp(0.30, 1.00, SkyLight) x (1-rayOcc) —
							// the old 0.15/(2 taps) weighting was ~0.03 after occlusion and the sky
							// effectively never participated in the gather.
							float skyWeight = NdotSky * lerp(0.30f, 1.00f, mDbgSSGISkyLight) * (1.0f - rayOcc) / 4.0f;
							rayColor += clamp(skyColor, 0.0f, 10.0f) * skyWeight;
						}
					}
				}
			}
		}
#endif

		totalGi += rayColor;
	}

	float3 finalGi = (totalGi / float(SSGI_ANGLES)) * giGain;

	return float4(clamp(finalGi, 0.0f, 100.0f), 1.0f);
}

#endif // RAY_MMD_SSGI_TRACE_FXSUB
