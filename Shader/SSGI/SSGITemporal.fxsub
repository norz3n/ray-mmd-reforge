#ifndef RAY_MMD_SSGI_TEMPORAL_FXSUB
#define RAY_MMD_SSGI_TEMPORAL_FXSUB

struct SSGITemporalOutput
{
	float4 color0 : COLOR0;
	float4 color1 : COLOR1;
};

SSGITemporalOutput SSGITemporalPS(
	in float2 uvCoord : TEXCOORD0,
	in float3 viewDir : TEXCOORD1,
	uniform sampler source,
	uniform sampler history)
{
	SSGITemporalOutput output;
	
	float3 currColor = tex2Dlod(source, float4(uvCoord, 0.0f, 0.0f)).rgb;
	
	float zCenter = GetSSGILinearDepth(uvCoord);
	if (!(zCenter > 0.0f && zCenter < 1000.0f))
	{
		output.color0 = float4(currColor, 0.0f);
		output.color1 = float4(currColor, zCenter);
		return output;
	}

	float4 projInfo = GetProjConstant();
	float3 pCenter = GetViewPosition(projInfo, uvCoord, zCenter);
	float3 worldPosition = mul(float4(pCenter, 1.0f), matViewInverse).xyz;

	float4x4 matViewProjectPrev = GetPrevViewProject();
	float4 prevClipPos = mul(float4(worldPosition, 1.0f), matViewProjectPrev);
	float2 prevUV = (prevClipPos.xy / max(prevClipPos.w, 1e-5f)) * float2(0.5f, -0.5f) + 0.5f;

	if (any(prevUV < 0.0f) || any(prevUV > 1.0f))
	{
		output.color0 = float4(currColor, 0.0f);
		output.color1 = float4(currColor, zCenter);
		return output;
	}

	float4 histData = tex2Dlod(history, float4(prevUV, 0.0f, 0.0f));
	float3 historyColor = histData.rgb;
	float prevDepth = histData.a;

	float expectedPrevZ = prevClipPos.w;
	float depthDiff = abs(prevDepth - expectedPrevZ) / max(expectedPrevZ, 1e-3f);
	float depthReject = saturate(depthDiff * 8.0f);

	float3 curNormal = GetSSGINormal(uvCoord);
	float3 prevNormal = GetSSGINormal(prevUV);
	float normalDiff = saturate((1.0f - saturate(dot(curNormal, prevNormal))) * 4.0f);

	float rejectWeight = max(depthReject, normalDiff);

	// Motion-adaptive responsiveness: calculate screen-space pixel displacement from camera motion
	float2 pixelMotion = (uvCoord - prevUV) * ViewportSize;
	float motionLen = length(pixelMotion);
	float motionWeight = saturate(motionLen * 0.05f);

	// In static scenes: baseAlpha = 0.05 (95% history). During fast motion: alpha scales up to 0.35 to eliminate ghost trails
	float baseAlpha = lerp(0.05f, 0.35f, motionWeight);
	float alpha = lerp(baseAlpha, 1.0f, rejectWeight);

	// Variance Clipping to prevent view-dependent lighting ghosting
	float2 tapStep = ViewportOffset2;
	float3 m1 = currColor;
	float3 m2 = currColor * currColor;
	float3 minColor = currColor;
	float3 maxColor = currColor;

	[unroll]
	for (int i = -1; i <= 1; ++i)
	{
		[unroll]
		for (int j = -1; j <= 1; ++j)
		{
			if (i != 0 || j != 0)
			{
				float3 neighbor = tex2Dlod(source, float4(uvCoord + float2(i, j) * tapStep, 0.0f, 0.0f)).rgb;
				m1 += neighbor;
				m2 += neighbor * neighbor;
				minColor = min(minColor, neighbor);
				maxColor = max(maxColor, neighbor);
			}
		}
	}
	
	float3 mu = m1 / 9.0f;
	float3 sigma = sqrt(abs(m2 / 9.0f - mu * mu));
	// Tighten variance box under fast motion to aggressively eliminate ghosting
	float gamma = lerp(1.25f, 0.75f, motionWeight);
	float3 boxMin = max(mu - gamma * sigma, minColor);
	float3 boxMax = min(mu + gamma * sigma, maxColor);

	historyColor = clamp(historyColor, boxMin, boxMax);

	float3 denoised = lerp(historyColor, currColor, alpha);

	output.color0 = float4(denoised, 0.0f);
	output.color1 = float4(denoised, zCenter);
	return output;
}

#endif
