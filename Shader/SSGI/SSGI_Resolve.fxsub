/**
 * Ray-MMD ReForge: Screen-Space Global Illumination (SSGI) Resolve & Composite
 *
 * Module: SSGI_Resolve.fxsub
 * Independent PBR Diffuse Multi-Bounce Composite & Material Response Pass.
 * Applies energy-conserving multi-bounce interreflection, shading model modulation, and occlusion weighting.
 */

#ifndef RAY_MMD_SSGI_RESOLVE_FXSUB
#define RAY_MMD_SSGI_RESOLVE_FXSUB

#include "shader/SSGI/SSGI_Common.fxsub"

/**
 * Composites denoised indirect GI irradiance with material albedo, BRDF shading models, and occlusion.
 */
float4 SSGIFinalCombinePS(in float2 uvCoord : TEXCOORD0, in float3 viewDir : TEXCOORD1) : COLOR
{
	float zCenter = GetSSGILinearDepth(uvCoord);
	MaterialParam mat;
	DecodeGbuffer(
		tex2Dlod(Gbuffer5Map, float4(uvCoord, 0.0f, 0.0f)),
		tex2Dlod(Gbuffer6Map, float4(uvCoord, 0.0f, 0.0f)),
		tex2Dlod(Gbuffer7Map, float4(uvCoord, 0.0f, 0.0f)),
		tex2Dlod(Gbuffer8Map, float4(uvCoord, 0.0f, 0.0f)),
		mat);

	float3 rawGi = tex2Dlod(SSGIMapSampTemp, float4(uvCoord, 0.0f, 0.0f)).rgb;
	rawGi = clamp(rawGi, 0.0f, 100.0f);

	// Pre-albedo gathered irradiance, reused below as a local radiance field for indirect specular
	float3 gatherIrradiance = rawGi;

#if SSDO_QUALITY > 0
	float rawAO = tex2Dlod(SSDOMapSamp, float4(uvCoord, 0.0f, 0.0f)).w;
	float occlusion = (mat.lightModel == SHADINGMODELID_GLASS) ? 1.0f : rawAO;
#if GI_ENABLE >= 2
	// Multi-bounce occlusion response: indirect diffuse light in concave corners is exponentially absorbed (AO^2),
	// allowing SSAO/HBAO to deeply and naturally darken crevices without being washed out by room GI.
	occlusion = occlusion * occlusion;
#endif
#else
	float occlusion = 1.0f;
#endif

	bool isSkin = (mat.lightModel == SHADINGMODELID_SKIN || mat.lightModel == SHADINGMODELID_SUBSURFACE);
	if (isSkin)
	{
		occlusion = lerp(1.0f, occlusion, SKIN_AO_STRENGTH);
	}

	float3 camDir = normalize(viewDir);
	float NdV = saturate(dot(mat.normal, camDir));

	[branch]
	if (isSkin)
	{
		// Dermal absorption: the dermal albedo clamp in DecodeGbuffer already caps how
		// much light skin reflects (the "small percent"), so reception must stay
		// near-linear like every other surface — a stronger Reinhard coefficient here
		// saturated skin under SSGI+ and cancelled the boost entirely.
		rawGi = (rawGi / (1.0f + rawGi * 0.05f)) * mat.albedo;
		// Brightness compensation: recover the photometric loss, capped at +10%
		rawGi *= 1.0f + SKIN_GI_COMPENSATION * saturate(dot(rawGi, float3(0.299f, 0.587f, 0.114f)));
	}
	else if (mat.lightModel == SHADINGMODELID_GLASS)
	{
		rawGi *= max(0.02f, mat.albedo) * (1.0f - saturate(pow(1.0f - NdV, 5.0f))) * mat.alpha;
	}
	else if (mat.lightModel == SHADINGMODELID_CLOTH)
	{
		rawGi *= mat.albedo + mat.customDataB * (pow(1.0f - NdV, 4.0f) * mat.customDataA);
	}
	else if (mat.lightModel == SHADINGMODELID_CLEAR_COAT)
	{
		rawGi *= mat.albedo * (1.0f - mat.customDataA * (0.04f + 0.96f * pow(1.0f - NdV, 5.0f)));
	}
	else
	{
		// CEL/TONEBASED included: no luma quantization here - bounced GI is
		// dim (luma ~0.05-0.15) and a coarse step ladder zeroed it entirely,
		// which read as "SSGI does nothing on toon materials". The double
		// bilateral blur already keeps GI low-frequency enough not to smear
		// the cel bands; the flat shadow fill comes from the ramp itself
		rawGi = (rawGi / (1.0f + rawGi * 0.05f)) * mat.albedo;
	}

#if GI_ENABLE >= 2
	float3 multiBounce = isSkin ? 0.95f : (1.0f + (mat.albedo * 1.85f) / max(1.0f - mat.albedo * 0.6f, 0.1f));
	rawGi *= multiBounce;
#endif

#if SSGI_SPECULAR_GI
	// Rough specular indirect: Fresnel(F0)-weighted slice of the gathered irradiance.
	// Fades out on mirror-smooth surfaces (SSR covers those) and is skipped for skin/glass/emissive/cloth models.
	float3 specGi = 0.0f;
	if (!isSkin && mat.lightModel != SHADINGMODELID_GLASS && mat.lightModel != SHADINGMODELID_EMISSIVE && mat.lightModel != SHADINGMODELID_CLOTH)
	{
		float3 F = mat.specular + (1.0f - mat.specular) * pow(1.0f - NdV, 5.0f);
		float roughWeight = saturate(1.0f - mat.smoothness * 1.25f);
		specGi = gatherIrradiance * F * (roughWeight * 0.5f);
	}
#endif

	float receiverVis = tex2Dlod(SSGIVisibilityMapSamp, float4(uvCoord, 0.0f, 0.0f)).a;
#if SSGI_SPECULAR_GI
	return float4(clamp((rawGi + specGi) * mSSGIIntensity * occlusion * receiverVis, 0.0f, 100.0f), 0.0f);
#else
	return float4(clamp(rawGi * mSSGIIntensity * occlusion * receiverVis, 0.0f, 100.0f), 0.0f);
#endif
}

#endif // RAY_MMD_SSGI_RESOLVE_FXSUB
