/**
 * Ray-MMD ReForge: Screen-Space Global Illumination (SSGI) Resolve & Composite
 *
 * Module: SSGI_Resolve.fxsub
 * Independent PBR Diffuse Multi-Bounce Composite & Material Response Pass.
 * Applies energy-conserving multi-bounce interreflection, shading model modulation, and occlusion weighting.
 */

#ifndef RAY_MMD_SSGI_RESOLVE_FXSUB
#define RAY_MMD_SSGI_RESOLVE_FXSUB

#include "shader/SSGI/SSGI_Common.fxsub"

/**
 * Composites denoised indirect GI irradiance with material albedo, BRDF shading models, and occlusion.
 */
float4 SSGIFinalCombinePS(in float2 uvCoord : TEXCOORD0, in float3 viewDir : TEXCOORD1) : COLOR
{
	MaterialParam mat;
	DecodeGbuffer(
		tex2Dlod(Gbuffer5Map, float4(uvCoord, 0.0f, 0.0f)),
		tex2Dlod(Gbuffer6Map, float4(uvCoord, 0.0f, 0.0f)),
		tex2Dlod(Gbuffer7Map, float4(uvCoord, 0.0f, 0.0f)),
		tex2Dlod(Gbuffer8Map, float4(uvCoord, 0.0f, 0.0f)),
		mat);

	float3 rawGi = tex2Dlod(SSGIMapSamp, float4(uvCoord, 0.0f, 0.0f)).rgb;
	rawGi = clamp(rawGi, 0.0f, 100.0f);

#if SSDO_QUALITY > 0
	float occlusion = min((mat.lightModel == SHADINGMODELID_GLASS) ? 1.0f : tex2Dlod(SSDOMapSamp, float4(uvCoord, 0.0f, 0.0f)).w, mat.visibility);
#else
	float occlusion = mat.visibility;
#endif

	float3 camDir = normalize(viewDir);
	float NdV = saturate(dot(mat.normal, camDir));

	[branch]
	if (mat.lightModel == SHADINGMODELID_SKIN || mat.lightModel == SHADINGMODELID_SUBSURFACE)
	{
		// Photometric soft-knee compression: lifts dark shadows while softly capping bright hotspots
		rawGi = (rawGi / (1.0f + rawGi * 0.28f)) * (mat.albedo * 0.90f);
	}
	else if (mat.lightModel == SHADINGMODELID_GLASS)
	{
		rawGi *= max(0.02f, mat.albedo) * (1.0f - saturate(pow(1.0f - NdV, 5.0f))) * mat.alpha;
	}
	else if (mat.lightModel == SHADINGMODELID_CLOTH)
	{
		rawGi *= mat.albedo + mat.customDataB * (pow(1.0f - NdV, 4.0f) * mat.customDataA);
	}
	else if (mat.lightModel == SHADINGMODELID_CLEAR_COAT)
	{
		rawGi *= mat.albedo * (1.0f - mat.customDataA * (0.04f + 0.96f * pow(1.0f - NdV, 5.0f)));
	}
	else if (mat.lightModel == SHADINGMODELID_CEL || mat.lightModel == SHADINGMODELID_TONEBASED)
	{
		float luma = dot(rawGi, float3(0.299f, 0.587f, 0.114f));
		rawGi = (luma > 1e-4f) ? rawGi * ((floor(luma * 4.0f + 0.5f) / 4.0f) / max(luma, 1e-4f)) * mat.albedo : rawGi * mat.albedo;
	}
	else
	{
		rawGi = (rawGi / (1.0f + rawGi * 0.18f)) * mat.albedo;
	}

#if GI_ENABLE >= 2
	bool isSkin = (mat.lightModel == SHADINGMODELID_SKIN || mat.lightModel == SHADINGMODELID_SUBSURFACE);
	float3 multiBounce = isSkin ? 1.15f : (1.0f + (mat.albedo * 1.25f) / max(1.0f - mat.albedo * 0.5f, 0.15f));
	rawGi *= multiBounce;
#endif

	float receiverVis = tex2Dlod(SSGIVisibilityMapSamp, float4(uvCoord, 0.0f, 0.0f)).a;
	return float4(clamp(rawGi * mSSGIIntensity * occlusion * receiverVis, 0.0f, 100.0f), 0.0f);
}

#endif // RAY_MMD_SSGI_RESOLVE_FXSUB
