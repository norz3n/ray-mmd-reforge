// Texture-space SSS field: UV-wrapped sun irradiance of opaque skin, rendered
// by the material stage into the model's texture space and convolved here with
// the Christensen-Burley profile (WRAP addressing keeps the diffusion seamless
// across the UV atlas border and around island edges).
#if SSSS_QUALITY && SSSS_TEXSPACE
shared texture SSSUVLightMap : RENDERCOLORTARGET<
	float2 ViewportRatio = {1.0, 1.0};
	string Format = "A16B16G16R16F";
>;
shared texture SSSUVLightTemp : RENDERCOLORTARGET<
	float2 ViewportRatio = {1.0, 1.0};
	string Format = "A16B16G16R16F";
>;
shared texture SSSUVAlbedoMap : RENDERCOLORTARGET<
	float2 ViewportRatio = {1.0, 1.0};
	string Format = "A8R8G8B8";
>;
sampler SSSUVLightMapSamp = sampler_state {
	texture = <SSSUVLightMap>;
	MinFilter = LINEAR; MagFilter = LINEAR; MipFilter = NONE;
	AddressU = CLAMP; AddressV = CLAMP;
};
sampler SSSUVLightMapSampTemp = sampler_state {
	texture = <SSSUVLightTemp>;
	MinFilter = LINEAR; MagFilter = LINEAR; MipFilter = NONE;
	AddressU = CLAMP; AddressV = CLAMP;
};
sampler SSSUVAlbedoMapSamp = sampler_state {
	texture = <SSSUVAlbedoMap>;
	MinFilter = LINEAR; MagFilter = LINEAR; MipFilter = NONE;
	AddressU = CLAMP; AddressV = CLAMP;
};
#endif
