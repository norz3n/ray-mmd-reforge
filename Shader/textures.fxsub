sampler ShadingMapTemp2Samp = sampler_state {
	texture = <ShadingMapTemp2>;
	MinFilter = LINEAR; MagFilter = LINEAR; MipFilter = NONE;
	AddressU = CLAMP; AddressV = CLAMP;
};
sampler ShadingMapTempPointSamp = sampler_state {
	texture = <ShadingMapTemp>;
	MinFilter = POINT; MagFilter = POINT; MipFilter = NONE;
	AddressU = CLAMP; AddressV = CLAMP;
};
sampler ShadingMapTempSpecularSamp = sampler_state {
	texture = <ShadingMapTempSpecular>;
	MinFilter = POINT; MagFilter = POINT; MipFilter = NONE;
	AddressU = CLAMP; AddressV = CLAMP;
};
#if SSDO_QUALITY > 0 && (IBL_QUALITY || SUN_LIGHT_ENABLE)
shared texture SSDOMap : RENDERCOLORTARGET<
	float2 ViewportRatio = {1.0, 1.0};
	bool AntiAlias = false;
	string Format = "A8R8G8B8";
>;
texture SSDOMapTemp : RENDERCOLORTARGET<
	float2 ViewportRatio = {1.0, 1.0};
	bool AntiAlias = false;
	string Format = "A8R8G8B8";
>;
sampler SSDOMapSamp = sampler_state {
	texture = <SSDOMap>;
	MinFilter = LINEAR; MagFilter = LINEAR; MipFilter = NONE;
	AddressU = CLAMP;  AddressV = CLAMP;
};
sampler SSDOMapSampTemp = sampler_state {
	texture = <SSDOMapTemp>;
	MinFilter = LINEAR; MagFilter = LINEAR; MipFilter = NONE;
	AddressU = CLAMP;  AddressV = CLAMP;
};

#if AO_TEMPORAL_DENOISE
texture SSDOMapHistory : RENDERCOLORTARGET<
	float2 ViewportRatio = {1.0, 1.0};
	bool AntiAlias = false;
	string Format = "A8R8G8B8";
>;
sampler SSDOMapHistorySamp = sampler_state {
	texture = <SSDOMapHistory>;
	MinFilter = LINEAR; MagFilter = LINEAR; MipFilter = NONE;
	AddressU = CLAMP;  AddressV = CLAMP;
};
#endif
#endif

#if GI_ENABLE > 0
shared texture SSGIMap : RENDERCOLORTARGET<
	float2 ViewportRatio = {1.0, 1.0};
	bool AntiAlias = false;
	string Format = "A16B16G16R16F";
	float4 ClearColor = {0, 0, 0, 0};
>;
texture SSGIMapTemp : RENDERCOLORTARGET<
	float2 ViewportRatio = {1.0, 1.0};
	bool AntiAlias = false;
	string Format = "A16B16G16R16F";
	float4 ClearColor = {0, 0, 0, 0};
>;
sampler SSGIMapSamp = sampler_state {
	texture = <SSGIMap>;
	MinFilter = LINEAR; MagFilter = LINEAR; MipFilter = NONE;
	AddressU = CLAMP;  AddressV = CLAMP;
};
sampler SSGIMapSampTemp = sampler_state {
	texture = <SSGIMapTemp>;
	MinFilter = LINEAR; MagFilter = LINEAR; MipFilter = NONE;
	AddressU = CLAMP;  AddressV = CLAMP;
};
texture SSGIMapHistory : RENDERCOLORTARGET<
	float2 ViewportRatio = {1.0, 1.0};
	bool AntiAlias = false;
	string Format = "A16B16G16R16F";
	float4 ClearColor = {0, 0, 0, 0};
>;
sampler SSGIMapHistorySamp = sampler_state {
	texture = <SSGIMapHistory>;
	MinFilter = LINEAR; MagFilter = LINEAR; MipFilter = NONE;
	AddressU = CLAMP;  AddressV = CLAMP;
};
#endif
