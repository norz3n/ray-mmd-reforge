#include "../ray.conf"
#include "../shader/common.fxsub"

/**
 * Ray-MMD ReForge: SSR Reflect-Source Visibility
 *
 * Fills SSRReflectMap: how strongly each material is allowed to appear in OTHER
 * materials' screen-space reflections. SSRVisibility.fxsub is the receiver side
 * (how much a surface reflects); this pass gates the reflected scene content at
 * the SSR trace hit point instead.
 *
 * Logic mirrors SSRVisibility.fxsub: the pass writes the preset constant only
 * (0.0 = hidden, 1.0 = fully visible). Material/texture alpha is deliberately
 * NOT applied here — the radiance stored in ShadingMap is already alpha-weighted
 * by rendering, so scaling again would double-fade sheer materials (sheer
 * tights, hair tips) out of reflections. Suppression is purely preset-driven
 * via the "SSR reflect visibility N.fx" material tab files.
 */
#if SSR_REFLECT_VISIBILITY_ENABLE
void ReflectObjectVS(
	in float4 Position : POSITION,
	in float2 Texcoord : TEXCOORD0,
	out float2 oTexcoord : TEXCOORD0,
	out float4 oPosition : POSITION)
{
	oTexcoord = Texcoord;
	oPosition = mul(Position, matViewProject);
}

float4 ReflectObjectPS(float2 coord : TEXCOORD0) : COLOR
{
	return float4(reflectVisibility, reflectVisibility, reflectVisibility, reflectVisibility);
}

technique ReflectTec<string MMDPass = "object";>
{
	pass DrawObject {
		AlphaTestEnable = false; AlphaBlendEnable = false;
		VertexShader = compile vs_3_0 ReflectObjectVS();
		PixelShader  = compile ps_3_0 ReflectObjectPS();
	}
}

technique ReflectTecBS<string MMDPass = "object_ss";>
{
	pass DrawObject {
		AlphaTestEnable = false; AlphaBlendEnable = false;
		VertexShader = compile vs_3_0 ReflectObjectVS();
		PixelShader  = compile ps_3_0 ReflectObjectPS();
	}
}
#else
technique ReflectTec<string MMDPass = "object";>{}
technique ReflectTecBS<string MMDPass = "object_ss";>{}
#endif

technique EdgeTec<string MMDPass = "edge";>{}
technique ShadowTec<string MMDPass = "shadow";>{}
technique ZplotTec<string MMDPass = "zplot";>{}
