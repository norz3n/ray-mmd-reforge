
#if SUN_LIGHT_ENABLE
float3 ComputeSunIntensity(float zenithAngleCos, float EE = 10)
{
	float steepness = 1.5;
	float cutoffAngle = PI / 1.95;
	return EE * saturate(1.0f - exp(-((cutoffAngle - acos(zenithAngleCos)) / steepness))) / PI;
}

#if WATER_CAUSTICS_ENABLE
/**
 * Analytical Screen-Space Directional Water Caustics.
 *
 * Back-projects submerged scene fragments along SunDirection to the water surface plane.
 * Evaluates the light deflection Jacobian matrix det(J) = det(I - d * (n - 1) * H)
 * from the Hessian curvature tensor of dual-scale Gerstner wave harmonics.
 * Focus lines (det(J) -> 0) form physical caustic networks (Wallace / Renou area ratio).
 *
 * Includes:
 * - Multi-harmonic Gerstner wave curvature and Jacobian determinant calculation.
 * - Tri-band chromatic dispersion (wavelength-dependent focal divergence for R/G/B).
 * - Exponential Beer-Lambert depth absorption (denser absorption of red wavelengths in water).
 * - Direct solar shadow gating from ShadowMapSamp.
 *
 * @param worldPos      Reconstructed fragment position in World Space.
 * @param normalVS      Surface normal in View Space.
 * @param shadow        Sun shadow factor (0 = full shadow, 1 = unshadowed).
 * @param lightColor    Incident direct sun irradiance.
 * @return Spectral caustics radiance to be added to diffuse lighting.
 */
float3 ComputeWaterCaustics(float3 worldPos, float3 normalVS, float shadow, float3 lightColor)
{
	if (mCausticsIntensity <= 1e-4f || shadow <= 1e-3f)
		return 0;

	float depth = mWaterHeight - worldPos.y;
	if (depth <= 0.01f)
		return 0;

	float sunCos = -SunDirection.y;
	if (sunCos <= 0.02f)
		return 0;

	float3 L = mul(-SunDirection, (float3x3)matView);
	float NdotL = saturate(dot(normalVS, L));
	if (NdotL <= 1e-4f)
		return 0;

	// Back-project ray along sunlight direction to water surface plane
	float tSun = depth / sunCos;
	float3 waterHitWS = worldPos - SunDirection * tSun;

	// 4 harmonic wave octaves with irrational directional offsets to eliminate periodicity
	static const float2 WAVE_DIR[4] = {
		float2( 0.8660f,  0.5000f),
		float2(-0.4384f,  0.8988f),
		float2( 0.3126f, -0.9499f),
		float2(-0.8090f, -0.5878f)
	};
	static const float WAVE_FREQ[4]  = { 1.10f, 1.85f, 2.70f, 4.10f };
	static const float WAVE_SPEED[4] = { 1.20f, 1.55f, 2.05f, 2.45f };
	static const float WAVE_AMP[4]   = { 0.055f, 0.030f, 0.015f, 0.007f };

	float2 uv = waterHitWS.xz * mCausticsFreqScale;

	float Hxx = 0.0f;
	float Hzz = 0.0f;
	float Hxz = 0.0f;

	[unroll]
	for (int i = 0; i < 4; ++i)
	{
		float phase = dot(uv, WAVE_DIR[i]) * WAVE_FREQ[i] + time * (WAVE_SPEED[i] * mCausticsSpeedScale);
		float s = sin(phase);
		float k2A = WAVE_AMP[i] * (WAVE_FREQ[i] * WAVE_FREQ[i]);

		Hxx -= k2A * (WAVE_DIR[i].x * WAVE_DIR[i].x) * s;
		Hzz -= k2A * (WAVE_DIR[i].y * WAVE_DIR[i].y) * s;
		Hxz -= k2A * (WAVE_DIR[i].x * WAVE_DIR[i].y) * s;
	}

	// Physical water refractance dispersion coefficients (n - 1) for R, G, B wavelengths
	static const float3 ETA_DISP_BASE = float3(0.331f, 0.333f, 0.338f);
	float3 etaDisp = lerp(float3(0.333f, 0.333f, 0.333f), ETA_DISP_BASE, mCausticsDispScale);
	float effDepth = clamp(depth, 0.05f, 30.0f);

	float3 causticColor = 0;

	[unroll]
	for (int c = 0; c < 3; ++c)
	{
		float alpha = effDepth * etaDisp[c];
		float Jxx = 1.0f - alpha * Hxx;
		float Jzz = 1.0f - alpha * Hzz;
		float Jxz = -alpha * Hxz;
		float detJ = Jxx * Jzz - Jxz * Jxz;

		// Regularized flux concentration with finite sun angular disc damping
		float flux = 1.0f / sqrt(detJ * detJ + 0.09f);
		float sharp = saturate(flux - 0.75f);
		causticColor[c] = pow(sharp, 2.2f) * 2.8f;
	}

	// Beer-Lambert physical water absorption (preferential red attenuation)
	static const float3 WATER_ABSORPTION = float3(0.30f, 0.07f, 0.02f);
	float waterPath = depth / max(sunCos, 0.1f);
	float3 transmittance = exp(-WATER_ABSORPTION * waterPath);

	return causticColor * transmittance * lightColor * (shadow * NdotL * mCausticsIntensity);
}
#endif

void ShadingMaterial(MaterialParam material, float3 V, float3 L, float2 coord, out float3 diffuse, out float3 specular)
{
	float shadow = 1;
#if SUN_SHADOW_QUALITY
	shadow = tex2Dlod(ShadowMapSamp, float4(coord, 0, 0)).r;
#endif

#if SSDO_QUALITY
	float3 bentNormal = tex2Dlod(SSDOMapSamp, float4(coord, 0, 0)).xyz * 2 - 1;
	float ssdo = pow(saturate(1.0f - dot(bentNormal, L) * 0.85f), max(mSSDOScale, 0.1f));
	bool isSkin = (material.lightModel == SHADINGMODELID_SKIN || material.lightModel == SHADINGMODELID_SUBSURFACE);
	// Toon ramps drive their terminator from the geometry shadow alone;
	// screen-space AO would smear the band edges
	bool isToonMat = (material.lightModel == SHADINGMODELID_CEL || material.lightModel == SHADINGMODELID_TONEBASED);
	shadow *= isSkin ? lerp(1.0f, ssdo, SKIN_AO_STRENGTH) : (isToonMat ? 1.0f : lerp(1.0f, ssdo, 0.85f));
#endif

	float3 lightColor = SunColor * mSunIntensity * any(material.visibility);
#if SUN_LIGHT_ENABLE == 2
 	lightColor *= ComputeSunIntensity(dot(float3(0,1,0), -SunDirection));
#endif

#if TOON_ENABLE
	float2x3 energy = SurfaceEnergy(material, material.normal, L, V, shadow);
#else
	float2x3 energy = SurfaceEnergy(material, material.normal, L, V, min(shadow, saturate(dot(material.normal, L) * 4)));
#endif
	float3 subsurface = SubsurfaceShading(material, material.normal, L, V, coord);

	bool isSkinMat = (material.lightModel == SHADINGMODELID_SKIN || material.lightModel == SHADINGMODELID_SUBSURFACE);
	diffuse = (energy[0] + subsurface * (isSkinMat ? lerp(1.0f, shadow, SKIN_AO_STRENGTH) : shadow)) * lightColor;

#if WATER_CAUSTICS_ENABLE
	if (material.lightModel != SHADINGMODELID_GLASS)
	{
		float4 projConstant = GetProjConstant();
		float3 posVS = GetViewPosition(projConstant, coord, material.linearDepth);
		float3 posWS = mul(float4(posVS, 1.0f), matViewInverse).xyz;
		diffuse += ComputeWaterCaustics(posWS, material.normal, shadow, lightColor);
	}
#endif

	// Energy-budget cap: Lambert + additive SSS (wrap/translucency) may not exceed the incident
	// sun irradiance — dermal reflectance is applied once later, so any excess here would make
	// skin outshine white surfaces and turn it into a GI emitter brighter than its albedo allows
	if (isSkinMat)
	{
		float3 budget = max(lightColor * SKIN_SSS_ENERGY_BUDGET, 1e-5f);
		diffuse *= budget / max(diffuse, budget);
	}

	specular = energy[1] * lightColor;

#if SUN_SHADOW_QUALITY
	// Toon ramps encode their own shadow color (customDataB); MMD's shadow
	// tint on top would double-darken and shift the band hue
	if (material.lightModel != SHADINGMODELID_CEL && material.lightModel != SHADINGMODELID_TONEBASED)
		diffuse += mColorShadowSunP * (1 - shadow);
#endif
}
#endif

void ShadingImageBasedLighting(sampler source, MaterialParam material, float4 screenPosition, float2 coord, float3 V, float3 L, out float3 diffuse, out float3 specular)
{
#if IBL_QUALITY
	DecodeYcbcr(source, coord, screenPosition, ViewportOffset2, diffuse, specular);

#if SSDO_QUALITY
	float4 ssdoData = tex2Dlod(SSDOMapSamp, float4(coord, 0, 0));
	bool isEmissiveOrGlass = (material.lightModel == SHADINGMODELID_GLASS || material.lightModel == SHADINGMODELID_EMISSIVE);
	float ssao = isEmissiveOrGlass ? 1.0f : ssdoData.w;
	ssao = min(ssao, material.visibility);
	bool isSkin = (material.lightModel == SHADINGMODELID_SKIN || material.lightModel == SHADINGMODELID_SUBSURFACE);
	float skinAO = lerp(1.0f, ssao, SKIN_AO_STRENGTH);

	// Jimenez Multi-Bounce inter-reflection color preservation
	float3 aBounce = 2.0404f * material.albedo - 0.3324f;
	float3 bBounce = -4.7951f * material.albedo + 0.6417f;
	float3 cBounce = 2.7552f * material.albedo + 0.6903f;
	float effectiveAOValue = isSkin ? skinAO : ssao;
	float3 coloredAO = max(effectiveAOValue, ((effectiveAOValue * aBounce + bBounce) * effectiveAOValue + cBounce) * effectiveAOValue);

	diffuse *= isEmissiveOrGlass ? 1.0f : coloredAO;

	float3 bentNormal = normalize(ssdoData.xyz * 2.0f - 1.0f);
	float3 R = EnvironmentReflect(material.normal, V);
	float roughness = max(SmoothnessToRoughness(material.smoothness), 0.001f);
	float NdotV = abs(dot(material.normal, V)) + 1e-5f;
	float baseSpecOcc = ComputeSpecularOcclusion(NdotV, isSkin ? skinAO : ssao, material.smoothness);
	float dirSpecOcc = ComputeDirectionalSpecularOcclusion(R, bentNormal, isSkin ? skinAO : ssao, roughness);
	
	// Jimenez / Frostbite Ground-Truth Specular Occlusion (GTSO)
	float effectiveAO = isSkin ? skinAO : ssao;
	float gtso = saturate(pow(NdotV + effectiveAO, roughness * roughness) - 1.0f + effectiveAO);
	float specOcc = min(lerp(baseSpecOcc, max(baseSpecOcc * 0.5f, dirSpecOcc), saturate(roughness * 2.5f)), gtso);
	specular *= isSkin ? lerp(1.0f, specOcc, SKIN_AO_STRENGTH) : specOcc;
#else
	bool isSkin = (material.lightModel == SHADINGMODELID_SKIN || material.lightModel == SHADINGMODELID_SUBSURFACE);
	float vis = isSkin ? lerp(1.0f, material.visibility, 0.5f) : material.visibility;
	diffuse *= vis;
	specular *= ComputeSpecularOcclusion(abs(dot(material.normal, V)) + 1e-5, vis, material.smoothness);
#endif

	float shadow = 1;
	float envShadow = (material.lightModel == SHADINGMODELID_GLASS) ? 0 : mSunShadowVM;

#if SUN_LIGHT_ENABLE && SUN_SHADOW_QUALITY
	float shadowDepth = tex2Dlod(ShadowMapSamp, float4(coord, 0, 0)).r;
	shadowDepth = min(shadowDepth, saturate(dot(material.normal, L) * 3));
	shadow = lerp(shadow, shadowDepth, envShadow);
#endif

	diffuse *= shadow;
	specular *= shadow * shadow * shadow;

#if TOON_ENABLE
	if (material.lightModel == SHADINGMODELID_CEL || material.lightModel == SHADINGMODELID_TONEBASED)
	{
		float luma = dot(diffuse, float3(0.299f, 0.587f, 0.114f));
		diffuse *= floor(luma * 2.0f + 0.5f) / max(luma * 2.0f, 1e-4f);
	}
#endif
#endif
}

void ShadingOpacityPS(
	in float2 coord: TEXCOORD0, 
	in float3 viewdir: TEXCOORD1, 
	in float4 screenPosition : SV_Position,
	out float4 oColor0 : COLOR0,
	out float4 oColor1 : COLOR1)
{
	float4 MRT4 = tex2Dlod(Gbuffer4Map, float4(coord, 0, 0));
	clip(MRT4.x - 1e-5);

	float4 MRT1 = tex2Dlod(Gbuffer1Map, float4(coord, 0, 0));
	float4 MRT2 = tex2Dlod(Gbuffer2Map, float4(coord, 0, 0));
	float4 MRT3 = tex2Dlod(Gbuffer3Map, float4(coord, 0, 0));

	MaterialParam material;
	DecodeGbuffer(MRT1, MRT2, MRT3, MRT4, material);

	float3 V = normalize(viewdir);
	float3 L = mul(-SunDirection, (float3x3)matView);

	float3 diffuse = 0;
	float3 specular = 0;

#if MULTI_LIGHT_ENABLE
	float4 light = tex2Dlod(LightMapSamp, float4(coord, 0, 0));
	diffuse += light.rgb;
	specular += tex2Dlod(LightSpecMapSamp, float4(coord, 0, 0)).rgb;
#endif

#if SUN_LIGHT_ENABLE
	float3 sunDiffuse, sunSpecular;
	ShadingMaterial(material, V, L, coord, sunDiffuse, sunSpecular);
	diffuse += sunDiffuse;
	specular += sunSpecular;
#endif

#if IBL_QUALITY
	float3 iblDiffuse, iblSpecular;
	ShadingImageBasedLighting(EnvLightMapSamp, material, screenPosition, coord, V, L, iblDiffuse, iblSpecular);
	diffuse += iblDiffuse;
	specular += iblSpecular;
#endif

#if SSSS_QUALITY // Fix white edge
	float lightModel = DecodeLightModel(MRT4);
	material.linearDepth *= any(lightModel == SHADINGMODELID_SKIN || lightModel == SHADINGMODELID_SUBSURFACE);

	oColor0 = float4(diffuse, material.linearDepth);
	oColor1 = float4(specular, 0);
#else
	oColor0 = float4(diffuse * material.albedo + specular, material.linearDepth);
	oColor1 = 0;
#endif
}

float4 ShadingOpacityAlbedoPS(in float2 coord: TEXCOORD0) : COLOR
{
	float4 MRT1 = tex2Dlod(Gbuffer1Map, float4(coord, 0, 0));
	float3 albedo = DecodeGBufferAlbedo(MRT1);

	// The SSSS composite multiplies all lighting by this albedo (DESTCOLOR * SRC blend),
	// so skin must be dermal-clamped here too or the clamp in DecodeGbuffer is bypassed
	int lightModel = DecodeLightModel(tex2Dlod(Gbuffer8Map, float4(coord, 0, 0)));
	if (lightModel == SHADINGMODELID_SKIN || lightModel == SHADINGMODELID_SUBSURFACE)
		albedo = ClampDermalAlbedo(albedo);

	return float4(albedo, 0);
}

float4 ShadingOpacitySpecularPS(in float2 coord: TEXCOORD0) : COLOR
{
	float3 specular = tex2Dlod(ShadingMapTempSpecularSamp, float4(coord, 0, 0)).rgb;
	return float4(specular, 0);
}

#if GLASS_REFRACTION
/**
 * Newton's Method Screen-Space Refraction Solver.
 * Based on: "Ultrafast Screen-Space Refractions and Caustics via Newton's Method"
 *           Chase Mayer, Ulf Assarsson, Erik Sintorn (JCGT 2026).
 *           https://jcgt.org/published/0015/01/03/
 *
 * Formulates ray-surface intersection as a scalar root-finding problem along the
 * refracted ray: F(x) = depth(ray(s)) - depth(Gbuffer(x)) = 0.
 * Solving via local tangent planes is algebraically equivalent to Newton's method
 * with quadratic convergence, resolving intersections in 3-4 steps without the
 * heavy traversal overhead of hierarchical Hi-Z DDA raymarching.
 *
 * @param originVS      Ray origin on transparent surface in View Space.
 * @param rayDirVS     Normalized refracted ray direction in View Space.
 * @param startUV      Screen UV of the refractive surface fragment (seed p0).
 * @param surfaceDepth Linear depth of the refractive surface fragment.
 * @param projConstant Precomputed projection constant from GetProjConstant().
 * @param outHitUV     Output refined screen UV coordinates.
 * @return True if convergence succeeded within pixel error tolerance.
 */
bool NewtonRefractionTrace(
	float3 originVS,
	float3 rayDirVS,
	float2 startUV,
	float surfaceDepth,
	float4 projConstant,
	out float2 outHitUV)
{
	static const int NUM_NEWTON_ITERATIONS = 4;
	static const float MAX_PIXEL_ERROR_SQ = 4.0f; // 2 pixels error tolerance (Section 2.2)
	static const float MIN_PLANE_DENOM = 1e-4f;
	static const float DEPTH_BIAS = 1e-2f;

	float2 currentUV = startUV;
	outHitUV = startUV;

	[unroll]
	for (int i = 0; i < NUM_NEWTON_ITERATIONS; ++i)
	{
		// 1. Sample background depth behind the transparent surface (Gbuffer4Map.r is linear depth)
		float bgDepth = tex2Dlod(Gbuffer4Map, float4(currentUV, 0.0f, 0.0f)).r;

		// 2. Decode background normal in view space
		float3 bgNormal = DecodeNormal(tex2Dlod(Gbuffer2Map, float4(currentUV, 0.0f, 0.0f)).xyz);

		// 3. Reconstruct background view-space position
		float3 bgPosVS = GetViewPosition(projConstant, currentUV, bgDepth);

		// 4. Intersect refracted ray with local tangent plane: (x - bgPosVS) . bgNormal = 0
		float denom = dot(rayDirVS, bgNormal);
		if (abs(denom) < MIN_PLANE_DENOM)
			break;

		float t = dot(bgPosVS - originVS, bgNormal) / denom;
		if (t <= 0.0f)
			break;

		// 5. Compute intersection point along the ray
		float3 intersectPosVS = originVS + rayDirVS * t;

		// 6. Project intersection point to screen-space UV coordinates
		float4 clip = mul(float4(intersectPosVS, 1.0f), matProject);
		if (clip.w <= 0.0f)
			break;

		float2 nextUV = (clip.xy / clip.w) * float2(0.5f, -0.5f) + 0.5f;

		// 7. Bounds check (Section 2.2)
		if (any(nextUV < 0.0f) || any(nextUV > 1.0f))
			break;

		currentUV = nextUV;
	}

	// Validation heuristics (Mayer et al. 2026, Section 2.2):
	// Ensure coordinates remain within screen bounds and candidate lies behind front surface
	if (any(currentUV < 0.0f) || any(currentUV > 1.0f))
		return false;

	float finalBgDepth = tex2Dlod(Gbuffer4Map, float4(currentUV, 0.0f, 0.0f)).r;
	if (finalBgDepth <= surfaceDepth + DEPTH_BIAS)
		return false;

	// Consistency test: verify candidate G-buffer point lies close to the refracted ray
	float3 finalPosVS = GetViewPosition(projConstant, currentUV, finalBgDepth);
	float tClosest = max(0.0f, dot(finalPosVS - originVS, rayDirVS));
	float3 closestRayPosVS = originVS + rayDirVS * tClosest;

	float4 closestClip = mul(float4(closestRayPosVS, 1.0f), matProject);
	if (closestClip.w <= 0.0f)
		return false;

	float2 closestUV = (closestClip.xy / closestClip.w) * float2(0.5f, -0.5f) + 0.5f;
	float2 pixelError = (closestUV - currentUV) * ViewportSize;

	if (dot(pixelError, pixelError) > MAX_PIXEL_ERROR_SQ)
		return false;

	outHitUV = currentUV;
	return true;
}
#endif

float4 ShadingTransparentPS(
	in float2 coord: TEXCOORD0, 
	in float3 viewdir: TEXCOORD1, 
	in float4 screenPosition : SV_Position) : COLOR
{
	float4 MRT8 = tex2Dlod(Gbuffer8Map, float4(coord, 0, 0));
	clip(MRT8.x - 1e-5);

	float4 MRT5 = tex2Dlod(Gbuffer5Map, float4(coord, 0, 0));
	float4 MRT6 = tex2Dlod(Gbuffer6Map, float4(coord, 0, 0));
	float4 MRT7 = tex2Dlod(Gbuffer7Map, float4(coord, 0, 0));

	MaterialParam material;
	DecodeGbuffer(MRT5, MRT6, MRT7, MRT8, material);

	float3 V = normalize(viewdir);
	float3 L = mul(-SunDirection, (float3x3)matView);

	float3 lighting = 0;

#if MULTI_LIGHT_ENABLE
	lighting += tex2Dlod(LightAlphaMapSamp, float4(coord, 0, 0)).rgb;
#endif

#if SUN_LIGHT_ENABLE
	float3 diffuse, specular;
	ShadingMaterial(material, V, L, coord, diffuse, specular);
	lighting += (material.lightModel == SHADINGMODELID_GLASS ? 0.0f : diffuse * material.albedo) + specular;
#endif

#if IBL_QUALITY
	float3 iblDiffuse, iblSpecular;
	ShadingImageBasedLighting(EnvLightAlphaMapSamp, material, screenPosition, coord, V, L, iblDiffuse, iblSpecular);
	lighting += (material.lightModel == SHADINGMODELID_GLASS ? 0.0f : iblDiffuse * material.albedo) + iblSpecular;
#endif

	// Water presets set customDataA == 0 (physical water IOR = 1.333, eta = 1 / 1.333 ≈ 0.75f).
	// Glass presets set customDataA > 0 (typical glass IOR = 1.45-1.52, eta ≈ 0.69f).
	float eta = (material.customDataA > 0.01f) ? 0.69f : 0.75f;
	float refrMultiplier = (material.customDataA > 0.01f) ? material.customDataA : 0.8f;
	float2 ior = (material.lightModel != SHADINGMODELID_GLASS) ? 0 : mul(material.normal, (float3x3)matViewInverse).xy * (refrMultiplier * 0.003f);
	float3 prefilteredRefract;

	if (material.lightModel == SHADINGMODELID_GLASS)
	{
		float glassRoughness = saturate(1.0f - material.smoothness);
		float2 iorR = ior * 0.90f;
		float2 iorG = ior * 1.00f;
		float2 iorB = ior * 1.10f;

		float3 bgR = tex2Dlod(ShadingMapTempPointSamp, float4(coord + iorR, 0, 0)).rgb;
		float3 bgG = tex2Dlod(ShadingMapTempPointSamp, float4(coord + iorG, 0, 0)).rgb;
		float3 bgB = tex2Dlod(ShadingMapTempPointSamp, float4(coord + iorB, 0, 0)).rgb;

		bgR = any(bgR) ? bgR : srgb2linear(tex2Dlod(ScnSamp, float4(coord + iorR, 0, 0)).rgb);
		bgG = any(bgG) ? bgG : srgb2linear(tex2Dlod(ScnSamp, float4(coord + iorG, 0, 0)).rgb);
		bgB = any(bgB) ? bgB : srgb2linear(tex2Dlod(ScnSamp, float4(coord + iorB, 0, 0)).rgb);

		prefilteredRefract = float3(bgR.r, bgG.g, bgB.b);

		// Rough glass transmittance multi-tap diffusion blur
		if (glassRoughness > 0.01f)
		{
			float blurRadius = glassRoughness * 0.018f;
			float2 o1 = float2(0.7071f, 0.7071f) * blurRadius;
			float2 o2 = float2(-0.7071f, 0.7071f) * blurRadius;
			float3 blurBg = prefilteredRefract * 0.36f;
			blurBg += tex2Dlod(ShadingMapTempPointSamp, float4(coord + ior + o1, 0, 0)).rgb * 0.16f;
			blurBg += tex2Dlod(ShadingMapTempPointSamp, float4(coord + ior - o1, 0, 0)).rgb * 0.16f;
			blurBg += tex2Dlod(ShadingMapTempPointSamp, float4(coord + ior + o2, 0, 0)).rgb * 0.16f;
			blurBg += tex2Dlod(ShadingMapTempPointSamp, float4(coord + ior - o2, 0, 0)).rgb * 0.16f;
			prefilteredRefract = blurBg;
		}

#if GLASS_REFRACTION
		// Newton's Method Screen-Space Refraction (Mayer et al. 2026, JCGT).
		// Solves root finding along the refracted ray with quadratic convergence in 3-4 steps.
		// Directly queries 1:1 G-buffer without hierarchical Hi-Z DDA raymarching overhead.
		float4 projConstant = GetProjConstant();
		float3 posVS = viewdir * (material.linearDepth / viewdir.z);
		float3 refractDir = refract(-V, material.normal, eta);
		if (dot(refractDir, refractDir) > 1e-4f)
		{
			float3 refrOrigin = posVS + refractDir * (mSSROffset * 2.0f);
			float2 hitUV;
			if (NewtonRefractionTrace(refrOrigin, refractDir, coord, material.linearDepth, projConstant, hitUV))
			{
				float2 deltaUV = hitUV - coord;
				float2 uvR = coord + deltaUV * 0.95f;
				float2 uvG = hitUV;
				float2 uvB = coord + deltaUV * 1.05f;

				float3 tracedR = tex2Dlod(ShadingMapTempPointSamp, float4(uvR, 0, 0)).rgb;
				float3 tracedG = tex2Dlod(ShadingMapTempPointSamp, float4(uvG, 0, 0)).rgb;
				float3 tracedB = tex2Dlod(ShadingMapTempPointSamp, float4(uvB, 0, 0)).rgb;

				tracedR = any(tracedR) ? tracedR : srgb2linear(tex2Dlod(ScnSamp, float4(uvR, 0, 0)).rgb);
				tracedG = any(tracedG) ? tracedG : srgb2linear(tex2Dlod(ScnSamp, float4(uvG, 0, 0)).rgb);
				tracedB = any(tracedB) ? tracedB : srgb2linear(tex2Dlod(ScnSamp, float4(uvB, 0, 0)).rgb);

				float3 tracedBg = float3(tracedR.r, tracedG.g, tracedB.b);
				prefilteredRefract = lerp(tracedBg, prefilteredRefract, glassRoughness * 0.5f);
			}
		}
#endif

		float3 dielectricColor = max(0.02, material.albedo);
		float3 trans = lerp(material.specular, 1.0, (1 - saturate(dot(normalize((L + V) / 2), -L))));
		float3 fresnel = FresnelSchlickGlass(material.normal, V, material.smoothness, material.specular);

		lighting = lerp(prefilteredRefract * dielectricColor, lighting, fresnel * material.alpha);
		lighting += material.customDataA * material.customDataB * trans * saturate(dot(material.normal, -L));
	}
	else
	{
		prefilteredRefract = tex2Dlod(ShadingMapTempPointSamp, float4(coord + ior, 0, 0)).rgb;
		prefilteredRefract += srgb2linear(tex2Dlod(ScnSamp, float4(coord + ior, 0, 0)).rgb);
		lighting = lerp(prefilteredRefract * (1 - material.alpha), lighting, material.alpha);
	}

#if FOG_ENABLE
	if (material.lightModel != SHADINGMODELID_GLASS)
	{
		float4 fog = tex2Dlod(FogMapSamp, float4(coord, 0, 0));
		lighting *= exp(-fog.a);
		lighting += fog.rgb;
	}
#endif

	if (material.lightModel != SHADINGMODELID_GLASS)
	{
		float4 MRT3 = tex2Dlod(Gbuffer3Map, float4(coord, 0, 0));
		float4 MRT4 = tex2Dlod(Gbuffer4Map, float4(coord, 0, 0));

		float3 emissive0 = DecodeGBufferEmissive(MRT3, MRT4);
		float3 emissive1 = material.customDataB * material.customDataA * any(material.lightModel == SHADINGMODELID_EMISSIVE);

		lighting += lerp(emissive0, emissive1, MRT8.a) * lerp(1.0, float3(0.6,0.45,0.25), pow(1.0 - saturate(dot(material.normal, V)), 2.5));
	}

#if OUTLINE_QUALITY
	#if OUTLINE_QUALITY == 1
		float4 edge = tex2Dlod(OutlineMapSamp, float4(coord, 0, 0));
	#elif OUTLINE_QUALITY == 2
		float4 edge = tex2Dlod(OutlineTempMapSamp, float4(coord, 0, 0));
	#elif OUTLINE_QUALITY == 3
		float2 offset = 1.0 / (ViewportSize * 2.0);
		coord -= ViewportOffset;
		float4 edge1 = tex2Dlod(OutlineMapSamp, float4(coord, 0, 0));
		float4 edge2 = tex2Dlod(OutlineMapSamp, float4(coord + float2(offset.x, 0), 0, 0));
		float4 edge3 = tex2Dlod(OutlineMapSamp, float4(coord + float2(0, offset.y), 0, 0));
		float4 edge4 = tex2Dlod(OutlineMapSamp, float4(coord + offset, 0, 0));
		float4 edge = (edge1 + edge2 + edge3 + edge4) * 0.25;
	#endif
	lighting = lerp(lighting, edge.rgb, edge.a);
#endif

	return float4(lighting, material.linearDepth);
}