/**
 * Ray-MMD ReForge: Screen-Space Reflections (SSR) Ray Tracing Pass
 *
 * Module: SSR_Trace.fxsub
 * Screen-space ray tracing accelerated by the hierarchical depth pyramid in
 * SSR_HiZ.fxsub: reflected rays walk a min/max depth atlas instead of stepping
 * the full-resolution depth buffer, skipping whole cell blocks per iteration.
 */

#ifndef RAY_MMD_SSR_TRACE_FXSUB
#define RAY_MMD_SSR_TRACE_FXSUB

#include "shader/SSR/SSR_Common.fxsub"

// Discarded debug output of the production trace call (the instrumented
// tracer always reports its stats; the production path ignores them).
static float4 sTraceStats = 0.0f;

/**
 * Confidence of a resolved SSR hit, in [0, 1]. Composed of four independent
 * fade factors:
 *   - Travel fade: reflections that consume the whole ray budget carry no
 *     information about what was actually hit, so they ramp down to zero over
 *     the final stretch of the budget (mSSRFadeStart defines the ramp start).
 *   - Angle fade: rays leaving nearly parallel to the surface stretch across
 *     many screen cells and accumulate the most Hi-Z error.
 *   - Depth fade: beyond half of mSSRRangeMax the scene depth buffer becomes
 *     too coarse for reliable parallax, so far background rays dissolve.
 *   - Facing test: a hit on a surface turned away from the incoming ray is a
 *     silhouette artifact, not a real reflector.
 * A low-confidence hit is not discarded; the resolve pass blends it into the
 * environment/IBL specular, so fading smoothly avoids visible seams.
 */
float SSR_HitConfidence(
	in float3 rayOriginVS,
	in float3 hitPosVS,
	in float traceDistance,
	in float2 hitUV,
	in float3 reflectRayVS,
	in MaterialParam surfaceMat)
{
	float travelDist = length(hitPosVS - rayOriginVS);
	float travelFade = 1.0f - smoothstep(traceDistance * mSSRFadeStart, traceDistance, travelDist);

	// Backward ray fade: rays reflecting back toward the camera plane (reflectRayVS.z < 0)
	// smoothly fade out. Rays traveling forward into the scene (reflectRayVS.z >= 0) retain 100% confidence.
	float angleFade = smoothstep(-0.35f, 0.0f, reflectRayVS.z);

	float depthFade = 1.0f - smoothstep(mSSRRangeMax * 0.5f, mSSRRangeMax, surfaceMat.linearDepth);

	// Front-facing normal test on the hit surface: removes backface/silhouette streaks
	float3 hitNormal = DecodeGBufferNormal(tex2Dlod(Gbuffer6Map, float4(hitUV, 0.0f, 0.0f)));
	float facingFade = smoothstep(0.0f, 0.15f, dot(hitNormal, -reflectRayVS));

	return travelFade * angleFade * depthFade * facingFade;
}

float4 SSR_TracePS(in float4 coord : TEXCOORD0, in float3 viewdir : TEXCOORD1) : COLOR
{
	float receiverVis = tex2Dlod(SSRMapSamp, float4(coord.xy, 0.0f, 0.0f)).a;
	clip(receiverVis - 1e-4f);

	float4 gbuffDepth = tex2Dlod(Gbuffer8Map, float4(coord.xy, 0.0f, 0.0f));
	clip(gbuffDepth.r - 1e-5f);

	float4 gbuffAlbedo = tex2Dlod(Gbuffer5Map, float4(coord.xy, 0.0f, 0.0f));
	clip(gbuffAlbedo.a - 0.05f);

	float4 gbuffNormal   = tex2Dlod(Gbuffer6Map, float4(coord.xy, 0.0f, 0.0f));
	float4 gbuffSpecular = tex2Dlod(Gbuffer7Map, float4(coord.xy, 0.0f, 0.0f));

	MaterialParam surfaceMat;
	DecodeGbuffer(gbuffAlbedo, gbuffNormal, gbuffSpecular, gbuffDepth, surfaceMat);

	float3 specularAlbedo = surfaceMat.albedo + surfaceMat.specular;
	clip(sum(specularAlbedo) - 1e-5f);

	float3 viewVector = normalize(viewdir);
	float3 positionVS = viewdir * (surfaceMat.linearDepth / viewdir.z);
	float3 reflectRayVS = normalize(reflect(-viewVector, surfaceMat.normal));

	// Reflected ray must point into upper hemisphere of surface
	float NdotR = dot(reflectRayVS, surfaceMat.normal);
	clip(NdotR - 1e-4f);

	float NdotV = saturate(dot(viewVector, surfaceMat.normal));
	float traceDistance = mSSRRangeScale * (max(100.0f, mSSRRangeMax - surfaceMat.linearDepth) + surfaceMat.linearDepth);

	float normalBias = 0.05f + mSSROffset * 0.15f * (1.0f - NdotR);
	float directionBias = 0.05f + mSSROffset * 0.1f;
	float3 rayOriginVS = positionVS + surfaceMat.normal * normalBias + reflectRayVS * directionBias;

#if SSR_HIZ_DEBUG
	// Trace diagnostics (HiZTrace slider): repaints every receiver pixel with
	// the tracer's verdict instead of the reflection. Read through the usual
	// blur/resolve chain, so colors are approximate but regionally distinct:
	//   green→teal  hit (brighter = finer pyramid level; teal = fallback hit)
	//   red         iteration budget exhausted
	//   yellow      ray left the screen / spent its range before a crossing
	//   purple      pre-abort (origin behind the near plane, degenerate ray)
	if (mHiZDebugTrace > 0.5f)
	{
		float2 dbgUV = 0.0f;
		float3 dbgPos = 0.0f;
		float4 dbg = 0.0f;
		bool dbgHit = SSR_HiZTrace(
			rayOriginVS, reflectRayVS, traceDistance, mSSRThickness, surfaceMat.normal, dbgUV, dbgPos, dbg);

		if (dbgHit)
			return float4(0.1f, 1.0f, 0.25f, 1.0f);
		if (dbg.x < 0.0f)
			return float4(0.6f, 0.0f, 1.0f, 1.0f);
		if (dbg.x >= (float)SSR_HZB_ITERATIONS - 4.5f)
			return float4(1.0f, 0.05f, 0.05f, 1.0f);
		return float4(1.0f, 1.0f, 0.1f, 1.0f);
	}
#endif

	float2 hitUV = 0.0f;
	float3 hitPosVS = 0.0f;
	bool hit = SSR_HiZTrace(
		rayOriginVS,
		reflectRayVS,
		traceDistance,
		mSSRThickness,
		surfaceMat.normal,
		hitUV,
		hitPosVS,
		sTraceStats);

	if (!hit)
		return 0.0f;

	float confidence = SSR_HitConfidence(
		rayOriginVS, hitPosVS, traceDistance, hitUV, reflectRayVS, surfaceMat);


	// Self-reflection suppression (SSRSelfMap): flagged materials never bounce
	// SSR between each other (skin/hair self-smudging on face close-ups), while
	// still reflecting and being reflected by unflagged materials. Fires only
	// when both the receiver pixel and the hit pixel carry the flag.
	float selfReceiver = tex2Dlod(SSRSelfMapSamp, float4(coord.xy, 0.0f, 0.0f)).a;
	float selfHit = tex2Dlod(SSRSelfMapSamp, float4(hitUV, 0.0f, 0.0f)).a;
	confidence *= 1.0f - selfReceiver * selfHit;

	// Source-side reflect visibility (SSRReflectMap): how strongly the hit surface
	// itself is allowed to appear in this reflection. Scaled into both radiance and
	// confidence so fully hidden materials fall back to the env/IBL specular cleanly.
	float reflectVis = tex2Dlod(SSRReflectMapSamp, float4(hitUV, 0.0f, 0.0f)).a;

	// Bilinear sampling at the hit: smooth, continuous, anti-aliased reflection radiance
	float4 hitRadiance = tex2Dlod(ShadingMapSamp, float4(hitUV, 0.0f, 0.0f));

	// FP16 radiance buffer: reject NaN/Inf/negative garbage from long or
	// numerically degenerate rays instead of rendering it as gray/white blobs.
	// The half-float ceiling matches the render target format; NaN fails every
	// comparison, so the single validity predicate covers all three cases.
	static const float kHalfFloatMax = 65504.0f;
	bool radianceValid = all(!isnan(hitRadiance.rgb))
		&& all(hitRadiance.rgb >= 0.0f)
		&& all(hitRadiance.rgb <= kHalfFloatMax);
	hitRadiance.rgb = radianceValid ? hitRadiance.rgb : 0.0f;

	return float4(hitRadiance.rgb, 1.0f) * (confidence * reflectVis);
}

#endif // RAY_MMD_SSR_TRACE_FXSUB
