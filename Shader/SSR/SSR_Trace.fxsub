/**
 * Ray-MMD ReForge: Screen-Space Reflections (SSR) Ray Tracing Pass
 *
 * Module: SSR_Trace.fxsub
 * Fully independent Screen-Space Raymarching engine with polynomial step distribution
 * and subpixel binary refinement search. Completely untied from Hi-Z pyramid.
 */

#ifndef RAY_MMD_SSR_TRACE_FXSUB
#define RAY_MMD_SSR_TRACE_FXSUB

#include "shader/SSR/SSR_Common.fxsub"


inline float SSR_ComputeScreenWindow(float2 uv, float edgeMargin)
{
	float2 edgeDist = min(uv, 1.0f - uv);
	float2 windowFactor = smoothstep(0.0f, edgeMargin, edgeDist);
	return windowFactor.x * windowFactor.y;
}

inline float SSR_RayLinearZ(float ndcZ)
{
	float projDenom = ndcZ - matProject[2][2];
	projDenom = abs(projDenom) < 1e-7f ? sign(projDenom) * 1e-7f : projDenom;
	return matProject[3][2] / projDenom;
}

float4 SSR_TracePS(in float4 coord : TEXCOORD0, in float3 viewdir : TEXCOORD1) : COLOR
{
	float4 gbuffDepth = tex2Dlod(Gbuffer8Map, float4(coord.xy, 0.0f, 0.0f));
	clip(gbuffDepth.r - 1e-5f);

	float4 gbuffAlbedo = tex2Dlod(Gbuffer5Map, float4(coord.xy, 0.0f, 0.0f));
	clip(gbuffAlbedo.a - 0.05f);

	float4 gbuffNormal   = tex2Dlod(Gbuffer6Map, float4(coord.xy, 0.0f, 0.0f));
	float4 gbuffSpecular = tex2Dlod(Gbuffer7Map, float4(coord.xy, 0.0f, 0.0f));

	MaterialParam surfaceMat;
	DecodeGbuffer(gbuffAlbedo, gbuffNormal, gbuffSpecular, gbuffDepth, surfaceMat);

	float3 specularAlbedo = surfaceMat.albedo + surfaceMat.specular;
	clip(sum(specularAlbedo) - 1e-5f);

	float3 viewVector = normalize(viewdir);
	float3 positionVS = viewdir * (surfaceMat.linearDepth / viewdir.z);
	float3 reflectRayVS = normalize(reflect(-viewVector, surfaceMat.normal));
	float facingAngle = dot(reflectRayVS, -viewVector);
	clip(facingAngle - 1e-5f);

	float NdotV = saturate(dot(viewVector, surfaceMat.normal));
	float traceDistance = mSSRRangeScale * (max(100.0f, mSSRRangeMax - surfaceMat.linearDepth) + surfaceMat.linearDepth);

	float normalBias = mSSROffset * 0.15f * (1.0f - NdotV);
	float3 rayOriginVS = positionVS + surfaceMat.normal * normalBias;

	// Project endpoints into screen space [0, 1]
	float4 startClip = mul(float4(rayOriginVS, 1.0f), matProject);
	float3 startSS = (startClip.xyz / max(startClip.w, 1e-4f)) * float3(0.5f, -0.5f, 1.0f) + float3(0.5f, 0.5f, 0.0f);

	float4 endClip = mul(float4(positionVS + reflectRayVS * traceDistance, 1.0f), matProject);
	float3 endSS = (endClip.xyz / max(endClip.w, 1e-4f)) * float3(0.5f, -0.5f, 1.0f) + float3(0.5f, 0.5f, 0.0f);

	float3 rayDelta = endSS - startSS;
	if (length(rayDelta.xy * ViewportSize) < 1.0f)
		clip(-1);

	float maxAllowedThickness = mSSRThickness * (1.2f + positionVS.z * 0.04f);

#if AA_QUALITY == 6
	int frameCounter = (int)fmod(time * 60.0f, 16.0f);
#else
	int frameCounter = 0;
#endif
	float jitter = InterleavedGradientNoise(coord.xy * ViewportSize, frameCounter);

	float3 prevSS = startSS;
	float3 hitSS = 0.0f;
	float hitProgress = 0.0f;
	bool hitFound = false;

	// Dense polynomial step progression: guarantees smooth, clean, noise-free reflection surfaces
	[loop]
	for (int i = 1; i <= SSR_MAX_RAY_STEPS; ++i)
	{
		float t = pow(float(i) / float(SSR_MAX_RAY_STEPS), 1.25f);
		float3 currentSS = startSS + t * rayDelta;

		if (currentSS.x < 0.0f || currentSS.x > 1.0f || currentSS.y < 0.0f || currentSS.y > 1.0f)
			break;

		float sceneLinearZ = tex2Dlod(Gbuffer8Map, float4(currentSS.xy, 0.0f, 0.0f)).r;
		if (sceneLinearZ >= 0.01f && sceneLinearZ < 90000.0f)
		{
			float rayLinearZ = SSR_RayLinearZ(currentSS.z);
			float depthDiff = rayLinearZ - sceneLinearZ;

			if (depthDiff >= -0.05f && depthDiff <= maxAllowedThickness)
			{
				// Subpixel Binary Refinement Search
				float3 p0 = prevSS;
				float3 p1 = currentSS;

				[unroll]
				for (int b = 0; b < SSR_BINARY_STEPS; ++b)
				{
					float3 pm = (p0 + p1) * 0.5f;
					float sampleZ = tex2Dlod(Gbuffer8Map, float4(pm.xy, 0.0f, 0.0f)).r;
					float testRayZ = SSR_RayLinearZ(pm.z);

					if (testRayZ >= sampleZ)
						p1 = pm;
					else
						p0 = pm;
				}

				float finalSceneZ = tex2Dlod(Gbuffer8Map, float4(p1.xy, 0.0f, 0.0f)).r;
				float finalRayZ = SSR_RayLinearZ(p1.z);
				float finalDiff = finalRayZ - finalSceneZ;

				if (finalDiff >= -0.1f && finalDiff <= maxAllowedThickness)
				{
					hitFound = true;
					hitSS = p1;
					hitProgress = t;
					break;
				}
			}
		}

		prevSS = currentSS;
	}

	if (!hitFound)
		clip(-1);

	// Screen-edge vignetting (clean 3% margin: preserves wide reflections near frame boundaries)
	float sourceWindow = SSR_ComputeScreenWindow(coord.xy, 0.03f);
	float hitTargetWindow = SSR_ComputeScreenWindow(hitSS.xy, 0.03f);
	float edgeVignette = sourceWindow * hitTargetWindow;
	float distanceFalloff = 1.0f - pow(saturate(hitProgress), 4.0f);

	// Hit normal alignment: allows curved surface normals (legs/arms) while eliminating backface streaking
	float3 hitNormal = DecodeGBufferNormal(tex2Dlod(Gbuffer6Map, float4(hitSS.xy, 0.0f, 0.0f)));
	float hitFacing = smoothstep(-0.50f, 0.05f, dot(hitNormal, -reflectRayVS));

	float confidence = edgeVignette * distanceFalloff * saturate(facingAngle) * hitFacing;

	float4 hitRadiance = tex2Dlod(ShadingMapSamp, float4(hitSS.xy, 0.0f, 0.0f));
	return float4(hitRadiance.rgb, 1.0f) * confidence;
}

#endif // RAY_MMD_SSR_TRACE_FXSUB
