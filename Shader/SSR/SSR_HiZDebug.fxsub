/**
 * Ray-MMD ReForge: SSR Hi-Z Atlas Debug Overlay
 *
 * Module: SSR_HiZDebug.fxsub
 * Fullscreen visualization of the Hi-Z depth atlas, drawn as the very last
 * pass of the main technique (over the final frame). Controlled by morph
 * sliders of HiZDebugController.pmx:
 *   HiZAtlas  - master toggle (0 = overlay off, screen untouched)
 *   HiZAll    - show the packed atlas as-is (mip bands as stacked strips)
 *   HiZBand1..8 - stretch a single pyramid band to the full screen, with
 *                 cell-boundary grid lines and empty-cell highlighting
 *
 * Reading the image:
 *   magenta        - empty (sky) or never-written atlas texels
 *   dark red→white - linear view depth rising (near→far)
 *   white grid     - cell boundaries; on non-power-of-two viewports the last
 *                   column stretches wide (the folded tail slab)
 */

#ifndef RAY_MMD_SSR_HIZ_DEBUG_FXSUB
#define RAY_MMD_SSR_HIZ_DEBUG_FXSUB

float4 SSR_HiZDebugPS(in float4 coord : TEXCOORD0) : COLOR
{
	clip(mHiZDebugAtlas - 0.5f);

	float2 lohi = 0.0f;
	float2 cellFrac = 0.0f;

	if (mHiZDebugAll > 0.5f)
	{
		lohi = tex2Dlod(SSRHiZAtlasSamp, float4(coord.xy, 0.0f, 0.0f)).xy;
	}
	else
	{
		float band = mHiZDebugBand1 * 1.0f + mHiZDebugBand2 * 2.0f + mHiZDebugBand3 * 3.0f
			+ mHiZDebugBand4 * 4.0f + mHiZDebugBand5 * 5.0f + mHiZDebugBand6 * 6.0f
			+ mHiZDebugBand7 * 7.0f + mHiZDebugBand8 * 8.0f;
		int level = (int)clamp(band + 0.5f, 1.0f, 8.0f);

		float2 levelSize = kSSRHiZLevelSize[level - 1];
		float2 atlasUV = (coord.xy * levelSize + kSSRHiZRowOffset[level - 1]) * kSSRHiZInvScreen;
		lohi = tex2Dlod(SSRHiZAtlasSamp, float4(atlasUV, 0.0f, 0.0f)).xy;
		cellFrac = frac(coord.xy * levelSize);
	}

	// Empty (sky) or never-written texel: the exact failure signature of
	// atlas cells the combine pass never filled.
	if (lohi.x <= SSR_HZB_EMPTY_DEPTH)
		return float4(1.0f, 0.0f, 1.0f, 1.0f);

	float z = lohi.x;
	float3 heat = float3(saturate(z / 300.0f), saturate(z / 900.0f), saturate(z / 2000.0f));

	// Cell-boundary grid: brightens the first few percent of each cell so the
	// last (tail-folded) column's true width is directly visible.
	float grid = max(step(cellFrac.x, 0.05f), step(cellFrac.y, 0.05f));
	heat = lerp(heat, float3(1.0f, 1.0f, 1.0f), grid * 0.6f);

	return float4(heat, 1.0f);
}

#endif // RAY_MMD_SSR_HIZ_DEBUG_FXSUB
