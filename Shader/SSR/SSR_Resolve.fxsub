/**
 * Ray-MMD ReForge: Screen-Space Reflections (SSR) Resolve & PBR Composite
 *
 * Module: SSR_Resolve.fxsub
 * Roughness-aware multi-scale prefiltered radiance resolve (Karis 2013 / Unreal Engine 4 Split-Sum BRDF).
 * Reconstructs pre-filtered reflection radiance across continuous roughness LOD and applies Split-Sum PBR BRDF.
 */

#ifndef RAY_MMD_SSR_RESOLVE_FXSUB
#define RAY_MMD_SSR_RESOLVE_FXSUB

#include "shader/SSR/SSR_Common.fxsub"

/**
 * Resolves pre-filtered radiance across continuous roughness LOD levels and applies PBR Fresnel.
 */
float4 SSR_ResolvePS(in float2 coord : TEXCOORD0, in float3 viewdir : TEXCOORD1) : COLOR
{
	float4 gbuffAlbedo   = tex2Dlod(Gbuffer5Map, float4(coord, 0.0f, 0.0f));
	float4 gbuffNormal   = tex2Dlod(Gbuffer6Map, float4(coord, 0.0f, 0.0f));
	float4 gbuffSpecular = tex2Dlod(Gbuffer7Map, float4(coord, 0.0f, 0.0f));
	float4 gbuffDepth    = tex2Dlod(Gbuffer8Map, float4(coord, 0.0f, 0.0f));

	MaterialParam surfaceMat;
	DecodeGbuffer(gbuffAlbedo, gbuffNormal, gbuffSpecular, gbuffDepth, surfaceMat);

	// Surface glossiness and continuous roughness LOD mapping (0 = mirror full-res, 3 = diffuse blur)
	float gloss = saturate(surfaceMat.smoothness + mSSRSmoothness * 0.5f);
	float roughness = saturate(1.0f - gloss);
	float lod = pow(roughness, 2.0f) * 3.0f;

	float4 refl0 = tex2Dlod(SSRLightX1Samp, float4(coord, 0.0f, 0.0f));
	float4 refl1 = tex2Dlod(SSRLightX2Samp, float4(coord, 0.0f, 0.0f));
	float4 refl2 = tex2Dlod(SSRLightX3Samp, float4(coord, 0.0f, 0.0f));
	float4 refl3 = tex2Dlod(SSRLightX4Samp, float4(coord, 0.0f, 0.0f));

	float4 blendedReflection = 0.0f;
	[flatten]
	if (lod <= 1e-4f)
		blendedReflection = refl0;
	else if (lod <= 1.0f)
		blendedReflection = lerp(refl0, refl1, smoothstep(0.0f, 1.0f, lod));
	else if (lod <= 2.0f)
		blendedReflection = lerp(refl1, refl2, smoothstep(0.0f, 1.0f, lod - 1.0f));
	else
		blendedReflection = lerp(refl2, refl3, smoothstep(0.0f, 1.0f, lod - 2.0f));

	float3 normalVS = surfaceMat.normal;
	float3 viewVector = normalize(viewdir);
	float3 specularF0 = surfaceMat.specular;

	float NdotV = abs(dot(normalVS, viewVector));

	// Split-sum environmental specular BRDF (Karis / Unreal Engine 4 PBR)
	float3 pbrSpecularColor = EnvironmentSpecularUnreal4(NdotV, gloss, specularF0);

	// User intensity modulation, material visibility & Fresnel factor
	float receiverVis = tex2Dlod(SSRMapSamp, float4(coord, 0.0f, 0.0f)).a;
	float intensityScale = mSSRBrightness * receiverVis;
	float fresnelWeight = lerp(luminance(pbrSpecularColor), 1.0f, saturate(mSSRFresnel));

	return float4(blendedReflection.rgb * pbrSpecularColor * intensityScale, blendedReflection.a * fresnelWeight);
}

#endif // RAY_MMD_SSR_RESOLVE_FXSUB
