/*
 * PostProcessOcclusionHBAO.fxsub - Hybrid Horizon-Based Screen-Space Directional Occlusion
 *
 * Based on dendewaLAB (Ray-LAB 1.5.2) HBAO architecture.
 * Extended for Ray-MMD Reforge with Horizon Elevation Clipping, Temporal Jittering,
 * and Normal-Plane Distance Bilateral Filtering.
 *
 * Reference: dendewaLAB (Ray-LAB 1.5.2 by dendewa)
 */

#if SSDO_QUALITY == 1
#	define HBAO_DIRECTION_COUNT 4
#	define HBAO_SAMPLER_COUNT 4
#	define SSDO_BLUR_RADIUS 6
#elif SSDO_QUALITY == 2
#	define HBAO_DIRECTION_COUNT 6
#	define HBAO_SAMPLER_COUNT 8
#	define SSDO_BLUR_RADIUS 6
#elif SSDO_QUALITY == 3
#	define HBAO_DIRECTION_COUNT 8
#	define HBAO_SAMPLER_COUNT 8
#	define SSDO_BLUR_RADIUS 6
#elif SSDO_QUALITY == 4
#	define HBAO_DIRECTION_COUNT 8
#	define HBAO_SAMPLER_COUNT 8
#	define SSDO_BLUR_RADIUS 6
#elif SSDO_QUALITY == 5
#	define HBAO_DIRECTION_COUNT 12
#	define HBAO_SAMPLER_COUNT 12
#	define SSDO_BLUR_RADIUS 6
#elif SSDO_QUALITY == 6
#	define HBAO_DIRECTION_COUNT 16
#	define HBAO_SAMPLER_COUNT 16
#	define SSDO_BLUR_RADIUS 6
#else
#	define HBAO_DIRECTION_COUNT 0
#	define HBAO_SAMPLER_COUNT 0
#	define SSDO_BLUR_RADIUS 0
#endif

float linearizeDepth(float2 uv)
{
	return tex2Dlod(Gbuffer8Map, float4(uv, 0, 0)).r;
}

float linearizeDepthLod(float2 uv, int lod)
{
#if defined(RAY_MMD_HIZ_TRAVERSAL_FXSUB)
	return HiZ_SampleDepthAtMip(uv, lod);
#else
	return tex2Dlod(Gbuffer8Map, float4(uv, 0, 0)).r;
#endif
}

float3 GetNormal(float2 uv)
{
	float4 MRT6 = tex2Dlod(Gbuffer6Map, float4(uv, 0, 0));
	return DecodeGBufferNormal(MRT6);
}

float3 ComputeViewSpacePosition(float2 uv, float linearEyeDepth)
{
	return GetViewPosition(GetProjConstant(), uv, linearEyeDepth);
}

float Falloff(float distanceSquare, float maxRadius)
{
	float negInvRadius2 = -1.0 / (maxRadius * maxRadius);
	return distanceSquare * negInvRadius2 + 1.0;
}

float AODepthContinuityWeight(float depthDelta, float viewDepth, float rayLength)
{
	float vd = abs(viewDepth);
	float baseThickness = 1.2 + vd * 0.012;
	float rayThickness = rayLength * 0.24;
	float thickness = max(0.6, baseThickness + rayThickness);
	return 1.0 - smoothstep(thickness * 0.65, thickness, depthDelta);
}

float AORangePropagationWeight(float rayLength, float localRadius)
{
	float t = saturate(rayLength / max(localRadius, 1e-3));
	float w = 1.0 - smoothstep(0.45, 1.0, t);
	return pow(saturate(w), 1.35);
}

float AONearDistanceBoost(float rayLength, float localRadius)
{
	float t = saturate(rayLength / max(localRadius, 1e-3));
	return lerp(1.35, 0.9, smoothstep(0.0, 1.0, t));
}

float4 HorizonOcclusion(
	float2 uv,
	float3 viewNormal,
	float3 viewPosition,
	float2 direction,
	float  maxRadius,
	float  jitter,
	float  bias,
	float4 projConstant)
{
	float2 sampleStepDelta = direction * maxRadius / HBAO_SAMPLER_COUNT;
	float2 sampleDirection = direction + frac(jitter) * sampleStepDelta;
	float2 sampleTexelSize = ViewportOffset.xy * (ViewportSize.y / 1080);

	float4 sampleOcclusion = 0.0f;
	float maxHorizonSin = 0.0f;

	[unroll]
	for (int s = 0; s < HBAO_SAMPLER_COUNT; ++s)
	{
		float2 sampleOffset = mad(sampleDirection, sampleTexelSize, uv);
		sampleDirection += sampleStepDelta;

		float depth;
	#if defined(RAY_MMD_HIZ_TRAVERSAL_FXSUB)
		if (s < 4)
			depth = tex2Dlod(Gbuffer8Map, float4(sampleOffset + ViewportOffset, 0, 0)).r;
		else if (s < 8)
			depth = tex2Dlod(ZBufferMipmap1Samp, float4(sampleOffset + ViewportOffset, 0, 0)).r;
		else
			depth = tex2Dlod(ZBufferMipmap2Samp, float4(sampleOffset + ViewportOffset, 0, 0)).r;
	#else
		depth = tex2Dlod(Gbuffer8Map, float4(sampleOffset + ViewportOffset, 0, 0)).r;
	#endif

		float3 samplePosition = GetViewPosition(projConstant, sampleOffset, depth);
		float3 sampleDir = samplePosition - viewPosition;
		float sampleLength2 = dot(sampleDir, sampleDir);
		float sampleLengthInv = rsqrt(sampleLength2);
		float sampleLength = sampleLength2 * sampleLengthInv;
		sampleDir *= sampleLengthInv;

		float sampleAngle = dot(sampleDir, viewNormal);
		float sampleFalloff = Falloff(sampleLength2, maxRadius);
		float depthDelta = abs(samplePosition.z - viewPosition.z);
		float depthWeight = AODepthContinuityWeight(depthDelta, viewPosition.z, sampleLength);
		float rangeWeight = AORangePropagationWeight(sampleLength, maxRadius);
		float nearBoost = AONearDistanceBoost(sampleLength, maxRadius);

		float horizonMask = (sampleAngle > maxHorizonSin) ? 1.0f : 0.0f;
		maxHorizonSin = max(maxHorizonSin, sampleAngle);

		float sh = saturate(sampleAngle - bias) * saturate(sampleFalloff) * depthWeight * rangeWeight * nearBoost * horizonMask;
		sampleOcclusion.w += sh;
		sampleOcclusion.xyz += sh * sampleDir;
	}

	return sampleOcclusion;
}

float4 ScreenSpaceDirOccPassVS(
	in float4 Position : POSITION,
	in float4 Texcoord : TEXCOORD,
	out float4 oTexcoord0 : TEXCOORD0) : POSITION
{
	oTexcoord0.xy = Texcoord.xy + ViewportOffset;
	oTexcoord0.zw = Texcoord.xy * ViewportSize;
	return Position;
}

float4 ScreenSpaceDirOccPassPS(in float4 uv : TEXCOORD0, in float2 screen : SV_POSITION) : COLOR
{
	float4 projConstant = GetProjConstant();
	float maxRadius = lerp(lerp(20.0, 60.0, mSSAORadiusP), 2.0, mSSAORadiusM);

	float2 samplePixel = screen / ViewportSize;
	float3 sampleNormal = GetNormal(uv.xy);
	float3 samplePosition = GetViewPosition(projConstant, samplePixel, linearizeDepth(uv.xy));
	int frameCounter = (int)fmod(time * 60.0, 16.0);
	float2 sampleRandom = float2(InterleavedGradientNoise(screen, frameCounter), PseudoRandom(screen + frameCounter));

	float alpha = PI_2 / HBAO_DIRECTION_COUNT;
	float maxRadiusPixels = 0.1f * ViewportSize.y;
	float radius = clamp(maxRadius * log2(max(samplePosition.z, 1.001f)) * atan(matProject._m11), HBAO_SAMPLER_COUNT, maxRadiusPixels);

	float4 occlusion = 0;

	// Precalculate the rotation step outside the loop
	float sinAlpha, cosAlpha;
	sincos(alpha, sinAlpha, cosAlpha);

	// Calculate the starting direction (with spatial jittering) outside the loop
	float startAngle = alpha * sampleRandom.x;
	float2 direction;
	sincos(startAngle, direction.y, direction.x);

	[loop]
	for (int d = 0; d < HBAO_DIRECTION_COUNT; ++d)
	{
		occlusion += HorizonOcclusion(samplePixel, sampleNormal, samplePosition, direction, radius, sampleRandom.y, mAmbientOcclusionBias, projConstant);

		// Rotate direction vector iteratively using a 2D rotation matrix (2 mad operations instead of cos/sin)
		direction = float2(
			direction.x * cosAlpha - direction.y * sinAlpha,
			direction.x * sinAlpha + direction.y * cosAlpha
		);
	}

	occlusion *= (1.0f / (HBAO_SAMPLER_COUNT * HBAO_DIRECTION_COUNT));
	occlusion.xyz = mad((occlusion.xyz * 2.2), 0.5, 0.5);

	occlusion.w = occlusion.w * tex2Dlod(SSAOMapSamp, float4(uv.xy, 0, 0)).a;
	occlusion.w = 1.0 - occlusion.w;
	occlusion.w = pow(saturate(occlusion.w), mSSAOScale);

	return occlusion;
}

float4 ScreenSpaceDirOccBlurPS(
	in float2 uv : TEXCOORD0,
	in float3 viewdir : TEXCOORD1,
	uniform sampler source,
	uniform float2 offset) : COLOR
{
	float4 projConstant = GetProjConstant();
	float center_d = linearizeDepth(uv);

	float total_w = 1.0f;
	float4 total_c = tex2Dlod(source, float4(uv, 0, 0));

	float3 normal = GetNormal(uv);
	float3 center_pos = GetViewPosition(projConstant, uv, center_d);

	float angle = pow2(saturate(dot(normal, normalize(viewdir))));

	float blurSigma = SSDO_BLUR_RADIUS * 0.5f;
	float blurFalloff = 1.0f / (2.0f * blurSigma * blurSigma);

	float2 offset1 = uv + offset;
	float2 offset2 = uv - offset;

	[unroll]
	for (int r = 1; r < SSDO_BLUR_RADIUS; ++r)
	{
		float2 depth = float2(linearizeDepth(offset1), linearizeDepth(offset2));
		float3 pos1 = GetViewPosition(projConstant, offset1, depth.x);
		float3 pos2 = GetViewPosition(projConstant, offset2, depth.y);

		float planeDist1 = abs(dot(normal, pos1 - center_pos));
		float planeDist2 = abs(dot(normal, pos2 - center_pos));

		float2 weight = exp2(-r * r * blurFalloff - pow2(float2(planeDist1, planeDist2) * mAmbientOcclusionBilateralSharpness));

		weight.x *= saturate(dot(GetNormal(offset1), normal));
		weight.y *= saturate(dot(GetNormal(offset2), normal));

		total_c += tex2Dlod(source, float4(offset1, 0, 0)) * weight.x;
		total_c += tex2Dlod(source, float4(offset2, 0, 0)) * weight.y;

		total_w += sum(weight);

		offset1 += offset;
		offset2 -= offset;
	}

	return total_c / total_w;
}
