/*
 * PostProcessOcclusionHBAO.fxsub - Hybrid Horizon-Based Screen-Space Directional Occlusion
 *
 * Based on dendewaLAB (Ray-LAB 1.5.2) HBAO architecture.
 * Extended for Ray-MMD Reforge with Horizon Elevation Clipping, Temporal Jittering,
 * Perspective-Correct Screen Radii, and Normal-Plane Distance Bilateral Filtering.
 *
 * Reference: dendewaLAB (Ray-LAB 1.5.2 by dendewa)
 */

#if SSDO_QUALITY == 1
#	define HBAO_DIRECTION_COUNT 4
#	define HBAO_SAMPLER_COUNT 4
#	define SSDO_BLUR_RADIUS 6
#elif SSDO_QUALITY == 2
#	define HBAO_DIRECTION_COUNT 6
#	define HBAO_SAMPLER_COUNT 8
#	define SSDO_BLUR_RADIUS 6
#elif SSDO_QUALITY == 3
#	define HBAO_DIRECTION_COUNT 8
#	define HBAO_SAMPLER_COUNT 8
#	define SSDO_BLUR_RADIUS 6
#elif SSDO_QUALITY == 4
#	define HBAO_DIRECTION_COUNT 8
#	define HBAO_SAMPLER_COUNT 8
#	define SSDO_BLUR_RADIUS 6
#elif SSDO_QUALITY == 5
#	define HBAO_DIRECTION_COUNT 12
#	define HBAO_SAMPLER_COUNT 12
#	define SSDO_BLUR_RADIUS 6
#elif SSDO_QUALITY == 6
#	define HBAO_DIRECTION_COUNT 16
#	define HBAO_SAMPLER_COUNT 16
#	define SSDO_BLUR_RADIUS 6
#else
#	define HBAO_DIRECTION_COUNT 0
#	define HBAO_SAMPLER_COUNT 0
#	define SSDO_BLUR_RADIUS 0
#endif

float linearizeDepth(float2 uv)
{
	return tex2Dlod(Gbuffer8Map, float4(uv, 0, 0)).r;
}

float3 GetNormal(float2 uv)
{
	float4 MRT6 = tex2Dlod(Gbuffer6Map, float4(uv, 0, 0));
	return DecodeGBufferNormal(MRT6);
}

float Falloff(float distanceSquare, float maxRadius)
{
	float negInvRadius2 = -1.0 / (maxRadius * maxRadius);
	return saturate(distanceSquare * negInvRadius2 + 1.0);
}

float AODepthContinuityWeight(float depthDelta, float viewDepth, float rayLength)
{
	float vd = abs(viewDepth);
	float baseThickness = 1.2 + vd * 0.012;
	float rayThickness = rayLength * 0.24;
	float thickness = max(0.6, baseThickness + rayThickness);
	return 1.0 - smoothstep(thickness * 0.65, thickness, depthDelta);
}

float AORangePropagationWeight(float rayLength, float localRadius)
{
	float t = saturate(rayLength / max(localRadius, 1e-3));
	float w = 1.0 - smoothstep(0.45, 1.0, t);
	return pow(saturate(w), 1.35);
}

float AONearDistanceBoost(float rayLength, float localRadius)
{
	float t = saturate(rayLength / max(localRadius, 1e-3));
	return lerp(1.35, 0.9, smoothstep(0.0, 1.0, t));
}

float4 HorizonOcclusion(
	float2 uv,
	float3 viewNormal,
	float3 viewPosition,
	float2 direction,
	float  pixelRadius,
	float  worldRadius,
	float  jitter,
	float  bias,
	float4 projConstant)
{
	// Step delta in UV space scaled strictly by pixel size (independent of resolution distortion)
	float stepPixel = pixelRadius / (float)HBAO_SAMPLER_COUNT;
	float2 stepUV = direction * (stepPixel * ViewportOffset2);

	float4 sampleOcclusion = 0.0f;
	float maxHorizonSin = bias;

	[unroll]
	for (int s = 0; s < HBAO_SAMPLER_COUNT; ++s)
	{
		// Jitter sample positions along the ray; +0.25 offset prevents self-occlusion at the origin
		float stepIndex = (float)s + frac(jitter) + 0.25f;
		float2 sampleOffset = uv + stepUV * stepIndex;

		float depth = tex2Dlod(Gbuffer8Map, float4(sampleOffset, 0, 0)).r;

		float3 samplePosition = GetViewPosition(projConstant, sampleOffset, depth);
		float3 sampleDir = samplePosition - viewPosition;
		float sampleLength2 = dot(sampleDir, sampleDir);
		float sampleLengthInv = rsqrt(max(sampleLength2, 1e-6f));
		float sampleLength = sampleLength2 * sampleLengthInv;
		sampleDir *= sampleLengthInv;

		// Sample elevation angle above tangent plane (sine of horizon elevation)
		float sampleAngle = dot(sampleDir, viewNormal);
		float sampleFalloff = Falloff(sampleLength2, worldRadius);
		float depthDelta = abs(samplePosition.z - viewPosition.z);
		float depthWeight = AODepthContinuityWeight(depthDelta, viewPosition.z, sampleLength);
		float rangeWeight = AORangePropagationWeight(sampleLength, worldRadius);
		float nearBoost = AONearDistanceBoost(sampleLength, worldRadius);

		// Reject background/sky samples (depth == 0)
		float depthValid = step(1e-4f, depth);

		// Monotonic incremental horizon integration
		float deltaSin = saturate(sampleAngle - maxHorizonSin);
		maxHorizonSin = max(maxHorizonSin, sampleAngle * depthValid);

		float sh = deltaSin * sampleFalloff * depthWeight * rangeWeight * nearBoost * depthValid;
		sampleOcclusion.w += sh;
		sampleOcclusion.xyz += sh * sampleDir;
	}

	return sampleOcclusion;
}

float4 ScreenSpaceDirOccPassVS(
	in float4 Position : POSITION,
	in float4 Texcoord : TEXCOORD,
	out float4 oTexcoord0 : TEXCOORD0) : POSITION
{
	oTexcoord0.xy = Texcoord.xy + ViewportOffset;
	oTexcoord0.zw = Texcoord.xy * ViewportSize;
	return Position;
}

float4 ScreenSpaceDirOccPassPS(in float4 uv : TEXCOORD0, in float2 screen : SV_POSITION) : COLOR
{
	float centerDepth = linearizeDepth(uv.xy);

	// Early out for background/sky pixels to save ALU and texture bandwidth
	if (centerDepth <= 1e-4f)
	{
		return float4(0.5f, 0.5f, 0.5f, 1.0f);
	}

	float4 projConstant = GetProjConstant();
	float maxRadius = lerp(lerp(20.0, 60.0, mSSAORadiusP), 2.0, mSSAORadiusM);

	float2 samplePixel = uv.xy;
	float3 sampleNormal = GetNormal(uv.xy);
	float3 samplePosition = GetViewPosition(projConstant, samplePixel, centerDepth);

#if AA_QUALITY == 6 || HBAO_TEMPORAL_DENOISE
	int frameCounter = (int)fmod(time * 60.0, 16.0);
#else
	int frameCounter = 0;
#endif
	float2 sampleRandom = float2(InterleavedGradientNoise(screen, frameCounter), PseudoRandom(screen + frameCounter));

	float alpha = PI_2 / HBAO_DIRECTION_COUNT;
	float maxRadiusPixels = mAmbientOcclusionMaxRadiusPixelPercentage * ViewportSize.y;

	// Perspective-correct screen-space radius projection: Radius_px = (R_world * projScale) / Z
	float projScale = ViewportSize.y * 0.5f * matProject._m11;
	float radiusPixels = clamp((maxRadius * projScale) / max(samplePosition.z, 0.1f), (float)HBAO_SAMPLER_COUNT, maxRadiusPixels);

	float4 occlusion = 0.0f;

	// Precalculate the rotation step outside the loop
	float sinAlpha, cosAlpha;
	sincos(alpha, sinAlpha, cosAlpha);

	// Calculate the starting direction (with spatial jittering) outside the loop
	float startAngle = alpha * sampleRandom.x;
	float2 direction;
	sincos(startAngle, direction.y, direction.x);

	[loop]
	for (int d = 0; d < HBAO_DIRECTION_COUNT; ++d)
	{
		occlusion += HorizonOcclusion(
			samplePixel,
			sampleNormal,
			samplePosition,
			direction,
			radiusPixels,
			maxRadius,
			sampleRandom.y,
			mAmbientOcclusionBias,
			projConstant);

		// Rotate direction vector iteratively using a 2D rotation matrix (2 mad operations instead of cos/sin)
		direction = float2(
			direction.x * cosAlpha - direction.y * sinAlpha,
			direction.x * sinAlpha + direction.y * cosAlpha
		);
	}

	occlusion *= (1.0f / (float)HBAO_DIRECTION_COUNT);
	occlusion.xyz = mad((occlusion.xyz * 2.2f), 0.5f, 0.5f);

	occlusion.w = occlusion.w * tex2Dlod(SSAOMapSamp, float4(uv.xy, 0, 0)).a;
	occlusion.w = 1.0f - occlusion.w;
	occlusion.w = pow(saturate(occlusion.w), mSSAOScale);

	return occlusion;
}

float4 ScreenSpaceDirOccBlurPS(
	in float2 uv : TEXCOORD0,
	in float3 viewdir : TEXCOORD1,
	uniform sampler source,
	uniform float2 offset) : COLOR
{
	float center_d = linearizeDepth(uv);
	if (center_d <= 1e-4f)
	{
		return float4(0.5f, 0.5f, 0.5f, 1.0f);
	}

	float4 projConstant = GetProjConstant();
	float total_w = 1.0f;
	float4 total_c = tex2Dlod(source, float4(uv, 0, 0));

	float3 normal = GetNormal(uv);
	float3 center_pos = GetViewPosition(projConstant, uv, center_d);

	float blurSigma = SSDO_BLUR_RADIUS * 0.5f;
	float blurFalloff = 1.0f / (2.0f * blurSigma * blurSigma);

	float2 offset1 = uv + offset;
	float2 offset2 = uv - offset;

	[unroll]
	for (int r = 1; r < SSDO_BLUR_RADIUS; ++r)
	{
		float2 depth = float2(linearizeDepth(offset1), linearizeDepth(offset2));
		float3 pos1 = GetViewPosition(projConstant, offset1, depth.x);
		float3 pos2 = GetViewPosition(projConstant, offset2, depth.y);

		float planeDist1 = abs(dot(normal, pos1 - center_pos));
		float planeDist2 = abs(dot(normal, pos2 - center_pos));

		// Bilateral weight combining Gaussian spatial falloff and normal-plane distance
		float2 weight = exp2(-r * r * (blurFalloff * 1.442695f) - pow2(float2(planeDist1, planeDist2) * mAmbientOcclusionBilateralSharpness));

		weight.x *= saturate(dot(GetNormal(offset1), normal));
		weight.y *= saturate(dot(GetNormal(offset2), normal));

		// Reject background/sky pixels (depth == 0) — they have SSDO.w = 1.0
		// and bleed into object edges, causing a bright halo visible in SSR.
		weight.x *= (depth.x > 1e-4f) ? 1.0f : 0.0f;
		weight.y *= (depth.y > 1e-4f) ? 1.0f : 0.0f;

		total_c += tex2Dlod(source, float4(offset1, 0, 0)) * weight.x;
		total_c += tex2Dlod(source, float4(offset2, 0, 0)) * weight.y;

		total_w += sum(weight);

		offset1 += offset;
		offset2 -= offset;
	}

	return total_c / total_w;
}

#if HBAO_TEMPORAL_DENOISE
float4 SSDOTemporalDenoisePS(in float2 uv : TEXCOORD0) : COLOR
{
	float curDepth = linearizeDepth(uv);
	float4 curAO = tex2Dlod(SSDOMapSamp, float4(uv, 0, 0));

	if (curDepth > 999.0f || curDepth <= 1e-4f)
	{
		return curAO;
	}

	float4 projInfo = GetProjConstant();
	float3 viewPosition = GetViewPosition(projInfo, uv, curDepth);
	float3 worldPosition = mul(float4(viewPosition, 1.0), matViewInverse).xyz;

	float4x4 matViewProjectPrev = GetPrevViewProject();
	float4 prevClipPos = mul(float4(worldPosition, 1.0), matViewProjectPrev);
	float2 prevUV = (prevClipPos.xy / max(prevClipPos.w, 1e-5)) * float2(0.5, -0.5) + 0.5;

	if (any(prevUV < 0.0f) || any(prevUV > 1.0f))
	{
		return curAO;
	}

	float prevDepth = linearizeDepth(prevUV);
	if (abs(prevDepth - curDepth) > max(0.2f, curDepth * 0.06f))
	{
		return curAO;
	}

	float4 historyAO = tex2Dlod(SSDOMapHistorySamp, float4(prevUV, 0, 0));

	// 3x3 Neighborhood Box Clamping
	float2 texelSize = ViewportOffset2;
	float4 minAO = curAO;
	float4 maxAO = curAO;

	[unroll]
	for (int x = -1; x <= 1; ++x)
	{
		[unroll]
		for (int y = -1; y <= 1; ++y)
		{
			if (x != 0 || y != 0)
			{
				float4 sampleNeighbor = tex2Dlod(SSDOMapSamp, float4(uv + float2(x, y) * texelSize, 0, 0));
				minAO = min(minAO, sampleNeighbor);
				maxAO = max(maxAO, sampleNeighbor);
			}
		}
	}

	float4 boxMargin = (maxAO - minAO) * 0.25f;
	historyAO = clamp(historyAO, minAO - boxMargin, maxAO + boxMargin);

	return lerp(curAO, historyAO, 0.85f);
}

float4 SSDOCopyTemporalPS(in float2 uv : TEXCOORD0) : COLOR
{
	return tex2Dlod(SSDOMapSampTemp, float4(uv, 0, 0));
}
#endif
