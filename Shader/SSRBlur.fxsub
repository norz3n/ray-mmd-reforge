#include "../ray.conf"
#include "../shader/common.fxsub"

/**
 * Ray-MMD ReForge: SSR Receiver Blur Mask
 *
 * Fills SSRBlurMap: controls selective roughness/blur boost for screen-space
 * reflections on specific materials and subsets.
 *
 * Preset value range: 0.0 (default, material's own PBR roughness only) to
 * 1.0 (forces maximum roughness pyramid LOD 3 / diffuse blur).
 * Supports diffuse texture alpha clipping for cutout/masked geometry.
 */
#if SSR_BLUR_ENABLE
#if SSR_BLUR_ALPHA_MAP_ENABLE
texture DiffuseMap: MATERIALTEXTURE;
sampler DiffuseMapSamp = sampler_state {
	texture = <DiffuseMap>;
	MinFilter = POINT; MagFilter = POINT; MipFilter = POINT;
	ADDRESSU = WRAP; ADDRESSV = WRAP;
};
#endif

void BlurObjectVS(
	in float4 Position : POSITION,
	in float2 Texcoord : TEXCOORD0,
	out float2 oTexcoord : TEXCOORD0,
	out float4 oPosition : POSITION)
{
	oTexcoord = Texcoord;
	oPosition = mul(Position, matViewProject);
}

float4 BlurObjectPS(float2 coord : TEXCOORD0) : COLOR
{
#if SSR_BLUR_ALPHA_ENABLE
	clip(!opadd - 0.001f);
	float alpha = MaterialDiffuse.a;
#if SSR_BLUR_ALPHA_MAP_ENABLE
	if (use_texture) alpha *= tex2D(DiffuseMapSamp, coord).a;
#endif
	clip(alpha - 0.01);
#endif

	return float4(blurAmount, blurAmount, blurAmount, blurAmount);
}

#define OBJECT_TEC(name, mmdpass)\
	technique name<string MMDPass = mmdpass;\
	>{\
		pass DrawObject {\
			AlphaTestEnable = false; AlphaBlendEnable = false;\
			VertexShader = compile vs_3_0 BlurObjectVS();\
			PixelShader  = compile ps_3_0 BlurObjectPS();\
		}\
	}

OBJECT_TEC(BlurTec, "object")
OBJECT_TEC(BlurTecBS, "object_ss")
#else
technique BlurTec<string MMDPass = "object";>{}
technique BlurTecBS<string MMDPass = "object_ss";>{}
#endif

technique EdgeTec<string MMDPass = "edge";>{}
technique ShadowTec<string MMDPass = "shadow";>{}
technique ZplotTec<string MMDPass = "zplot";>{}
