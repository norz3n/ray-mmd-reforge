float ComputeSpecularMicroOcclusion(float f0)
{
	return saturate(dot(f0, 0.33333h) * 50);
}

float ComputeSpecularMicroOcclusion(float3 f0)
{
	return saturate(dot(f0, 0.33333h) * 50);
}

float fresnelSchlick(float f0, float f9, float vh)
{
	return lerp(f0, f9, pow5(1 - vh));
}

float3 fresnelSchlick(float3 f0, float3 f9, float vh)
{
	return lerp(f0, f9, pow5(1 - vh));
}

// Fresnel model selection: 0 = Schlick (classic), 1 = Adobe F82.
// NOTE: the knob is a #define (not a float knob) because it swaps the actual
// fresnel kernel; default keeps the legacy Schlick look so existing materials
// and presets are unchanged.
#ifndef BRDF_FRESNEL_TYPE
#define BRDF_FRESNEL_TYPE 0
#endif

/**
 * [Kutz et al. 2021, "Novel aspects of the Adobe Standard Material", Sec. 2.3]
 * Anchors the fresnel curve at F0 (normal incidence) and F82 (82 deg, f82 here).
 * Unlike pure Schlick, the curve can dip BETWEEN the two anchors mid-range,
 * which preserves hue variation of colored speculars (metals, coated fabrics,
 * iridescent films) instead of washing out to lerp(F0, F90). Constants are
 * pre-folded for CosThetaMax = 1/7; code matches the paper's correct
 * implementation, not the (buggy) printed formulas.
 */
float3 fresnelSchlickAdobeF82(float3 f0, float3 f82, float vh)
{
	const float Fc = pow5(1 - vh);
	const float K = 49.0 / 46656.0;
	float3 b = (K - K * f82) * (7776.0 + 9031.0 * f0);
	return saturate(f0 + Fc * ((1 - f0) - b * (vh - vh * vh)));
}

float3 fresnelSchlickF(float3 f0, float3 f90, float vh)
{
#if BRDF_FRESNEL_TYPE == 1
	return fresnelSchlickAdobeF82(f0, f90, vh);
#else
	return fresnelSchlick(f0, f90, vh);
#endif
}

float ComputeAmbientMicroOcclusion(float nl, float ao)
{
	float aperture = 2.0 * ao;
	float shadow = saturate(abs(nl) + aperture - 1.0);
	return shadow;
}

// ---------------------------------------------------------------------------
// Skin / subsurface: artist-facing knobs ported from UE ShadingModels.ush
// ---------------------------------------------------------------------------

// SSS toolchain is the UE ShadingModels.ush artist path only (SubsurfaceBxDF
// cheat: WrappedDiffuse + BackScatter + InScatter + HSV-luminance-preserving
// hue-shifted transmission). The pre-integrated Jimenez LUT polynomial and the
// Penner translucency add have been removed.

// Authorable dual-lobe skin specular (cf. SubsurfaceProfileCommon.ush: the two
// lobe widths and the mix are profile data, not hard constants). Defaults
// reproduce the previous DualLobeSkinSpecular behavior exactly.
#ifndef SKIN_SPEC_LOBE0_SCALE
#define SKIN_SPEC_LOBE0_SCALE 1.15
#endif
#ifndef SKIN_SPEC_LOBE0_ADD
#define SKIN_SPEC_LOBE0_ADD 0.05
#endif
#ifndef SKIN_SPEC_LOBE1_SCALE
#define SKIN_SPEC_LOBE1_SCALE 0.35
#endif
#ifndef SKIN_SPEC_LOBE1_ADD
#define SKIN_SPEC_LOBE1_ADD 0.02
#endif
#ifndef SKIN_SPEC_LOBE0_MIX
#define SKIN_SPEC_LOBE0_MIX 0.70
#endif
#ifndef SKIN_SPEC_LOBE1_MIX
#define SKIN_SPEC_LOBE1_MIX 0.30
#endif

// Henyey-Greenstein anisotropy "g" of the forward-scattering backlit lobe
// (scattering distribution). 0 = isotropic, closer to 1 = narrow electric
// glow through thin features (ears, nose). UE skin profiles use ~0.6-0.8.
#ifndef SKIN_BACKLIT_G
#define SKIN_BACKLIT_G 0.76
#endif

// IOR of the skin dielectric used to refract V into the medium (UE
// TransmissionParams.OneOverIOR = 1/IOR).
#ifndef SKIN_BACKLIT_IOR
#define SKIN_BACKLIT_IOR 1.4
#endif

// Backlit lobe strength (0 = off, default preserved look).
#ifndef SKIN_BACKLIT_STRENGTH
#define SKIN_BACKLIT_STRENGTH 0
#endif

// Global mean-free-path multiplier: >1 pushes SSS light deeper (wider wraps,
// longer penetration), <1 shrinks it.
#ifndef SKIN_SSS_MFP_SCALE
#define SKIN_SSS_MFP_SCALE 1.0
#endif

// [ColorSpace.ush, Sam Hocevar / Inigo Quilez]
float3 HUE2LinearRGB(float h)
{
	float r = abs(h * 6 - 3) - 1;
	float g = 2 - abs(h * 6 - 2);
	float b = 2 - abs(h * 6 - 4);
	return saturate(float3(r, g, b));
}

float3 HSV2LinearRGB(float3 hsv)
{
	float3 rgb = HUE2LinearRGB(hsv.x);
	return ((rgb - 1) * hsv.y + 1) * hsv.z;
}

float3 RGB2HCV(float3 rgb)
{
	// Based on work by Sam Hocevar and Emil Persson
	float4 p = (rgb.g < rgb.b) ? float4(rgb.bg, -1.0f, 2.0f / 3.0f) : float4(rgb.gb, 0.0f, -1.0f / 3.0f);
	float4 q = (rgb.r < p.x) ? float4(p.xyw, rgb.r) : float4(rgb.r, p.yzx);
	float chroma = q.x - min(q.w, q.y);
	float hue = abs((q.w - q.y) / (6.0f * chroma + 1e-10f) + q.z);
	return float3(hue, chroma, q.x);
}

float3 LinearRGB2HSV(float3 rgb)
{
	float3 hcv = RGB2HCV(rgb);
	float s = hcv.y / (hcv.z + 1e-10f);
	return float3(hcv.x, s, hcv.z);
}

// [ParticipatingMediaCommon.ush] Beer-Lambert conversion. Thickness in
// "normalized meters" so SKIN_SSS_MFP_SCALE becomes the artist MFP knob.
#define SKIN_MIN_TRANSMITTANCE 1e-3f

float3 TransmittanceToExtinction(float3 transmittanceColor, float thickness)
{
	return -log(clamp(transmittanceColor, SKIN_MIN_TRANSMITTANCE, 1.0f)) / thickness;
}

float3 ExtinctionToTransmittance(float3 extinction, float thickness)
{
	return exp(-extinction * thickness);
}

// [ShadingModels.ush:738-744] Hue-shift the transmittance color while keeping
// its luminance intact: swap HSV value channel for the authored color's,
// converting only chroma. This is what removes the "patchy brightness" of
// albedo-driven SSS while retaining hue variety across the terminator.
float3 HueShiftTransmittance(float3 transmittanceColor, float3 authoredColor)
{
	float3 rawHueHSV = LinearRGB2HSV(transmittanceColor);
	float3 authoredHSV = LinearRGB2HSV(authoredColor);
	// Keep the hue/chroma of the extinguished color, take the luminance (V) of
	// the authored transmittance color
	return HSV2LinearRGB(float3(rawHueHSV.x, rawHueHSV.y, authoredHSV.z));
}

// [ShadingModels.ush:568 ApproximateHG] Henyey-Greenstein phase, artist form
float ApproximateHG(float cosTheta, float g)
{
	float g2 = g * g;
	float gcos2 = 1.0f - (g * cosTheta);
	gcos2 *= gcos2;
	return 0.5f * (1.0f - g2) / max(1e-5f, gcos2);
}

/**
 * [ShadingModels.ush:716 SubsurfaceBxDF] The classic UE artist cheat SSS:
 *   - WrappedDiffuse with (w=1/3, n=1.5): normal-dependence of the SSS lobe is
 *     one authored scalar (material.customDataA: 0 = none, 1 = strong).
 *   - BackScatter scales AO-based micro-occlusion against the wrapped normal
 *     contribution, putting a subtle glow into skin creases.
 *   - InScatter: view-dependent forward-scatter glow (dot(L, -V)^12).
 *   - Transmission color from Beer-Lambert extinction of the authored
 *     transmittance (customDataB), hue-shifted with the luminance preserved.
 */
float3 SubsurfaceShadingCheatSkin(MaterialParam material, float3 N, float3 L, float3 V, float ao, float shadow)
{
	float opacity = saturate(material.customDataA);
	float3 sssColor = material.customDataB;

	float nl = dot(N, L);

	// Wrap around lighting (simplified version, w = 0.5/1.5, n = 1.5)
	const float wrappedDiffuse = pow(saturate(madd(nl, 1.0f / 1.5f, 0.5f / 1.5f)), 1.5f) * (2.5f / 1.5f);
	const float normalContribution = lerp(1.0f, wrappedDiffuse, opacity);

	// AO-scaled back-scatter glow that lives in creases / shadowed skin
	const float backScatter = ao * normalContribution * shadow / (PI * 2);

	// View-dependent thin-feature transmission glow (shadow must not multiply:
	// the point of InScatter is to light faces backlit through the mesh)
	const float inScatter = pow(saturate(dot(L, -V)), 12.0f) * lerp(3.0f, 0.1f, opacity);

	// Beer-Lambert extinction -> transmittance at 1 normalized meter, then the
	// luminance-preserving hue shift (keeps chroma variety, no Y-shift)
	const float3 extinction = TransmittanceToExtinction(sssColor, 1.0f) / SKIN_SSS_MFP_SCALE;
	const float3 transColor = ExtinctionToTransmittance(extinction, 1.0f);
	const float3 hueShifted = HueShiftTransmittance(transColor, sssColor);

	const float transmittance = saturate(1.0f - saturate(dot(N, L)));
	return lerp(backScatter, 1.0f, inScatter) * lerp(hueShifted, sssColor, shadow) * (PI * 2) * transmittance * saturate(opacity);
}

/**
 * [ShadingModels.ush:652-663] Physically-motivated backlit glow: HG phase
 * evaluated at the REFRACTED view direction inside the dielectric, so the
 * glow narrows around the exact through-body direction (ears, fingers).
 */
float3 SubsurfaceShadingBacklitGlow(MaterialParam material, float3 N, float3 L, float3 V)
{
	float3 refracV = refract(V, -N, 1.0f / SKIN_BACKLIT_IOR);
	if (dot(refracV, refracV) < 1e-4f)
		return 0;
	float phase = ApproximateHG(dot(-L, refracV), SKIN_BACKLIT_G);
	// Gate into the past-light hemisphere: the glow only exists when light hits
	// the back of the feature
	return material.customDataB * material.albedo * (phase * SKIN_BACKLIT_STRENGTH * saturate(-dot(N, L) + 0.1f));
}

float BurleyBRDF(float nl, float nv, float vh, float roughness)
{
	float energyBias = 0.5 * roughness;
	float energyFactor = lerp(1, 1 / 1.51, roughness);

	float Fd90 = energyBias + 2.0 * vh * vh * roughness;
	float FdV = lerp(1, Fd90, pow5(1 - max(nv, 0.1)));
	float FdL = lerp(1, Fd90, pow5(1 - nl));

	return FdV * FdL * energyFactor;
}

float OrenNayarBRDF(float nl, float nv, float lv, float roughness)
{
	float m2 = roughness * roughness;

	float s = lv - nl * nv;
	float t = (s <= 0.0) ? 1 : max(max(nl, nv), 1e-6);
	float A = 1.0 / (1.0 + (0.5 - 2.0 / (3.0 * PI)) * m2);
	float B = m2 * A;

	return max(0, A + B * (s / t));
}

#ifndef DIFFUSE_BRDF_TYPE
#define DIFFUSE_BRDF_TYPE 1
#endif

// Energy-preserving Oren-Nayar (EON) BRDF (Portsmouth, Kutz, Hill, JCGT 2025)
// Closed-form analytical energy compensation for rough diffuse microfacets.
static const float EON_CONSTANT1_FON = 0.5f - 2.0f / (3.0f * PI);        // ~0.287797f
static const float EON_CONSTANT2_FON = 2.0f / 3.0f - 28.0f / (15.0f * PI); // ~0.073238f

/**
 * 4th-order polynomial approximation of the Fujii Oren-Nayar directional albedo E_FON(mu, r).
 * Avoids transcendental acos/sqrt operations from the exact formulation while maintaining <0.3% error.
 *
 * @param mu Cosine of incident or outgoing angle (dot(N, L) or dot(N, V))
 * @param r  Surface roughness in range [0, 1]
 * @return Directional albedo ratio for single-scattering normalization
 */
float E_FON_approx(float mu, float r, float AF)
{
	float mucomp = 1.0f - mu;
	const float g1 =  0.0571085289f;
	const float g2 =  0.491881867f;
	const float g3 = -0.332181442f;
	const float g4 =  0.0714429953f;
	float GoverPi = mucomp * (g1 + mucomp * (g2 + mucomp * (g3 + mucomp * g4)));
	return (1.0f + r * GoverPi) * AF;
}

float E_FON_approx(float mu, float r)
{
	float AF = 1.0f / (1.0f + EON_CONSTANT1_FON * r);
	return E_FON_approx(mu, r, AF);
}

/**
 * Evaluates Energy-preserving Oren-Nayar (EON) diffuse BRDF.
 * Evaluated with single-scattering albedo rho = 1.0 to integrate into ray-mmd's deferred lighting
 * pipeline where texture albedo is modulated downstream. Under rho = 1.0, the multiple-scattering
 * albedo rho_ms analytically reduces to 1.0, eliminating costly vector math and hue shifts.
 *
 * @param nl        Clamped cosine of angle between normal and light direction
 * @param nv        Cosine of angle between normal and view direction
 * @param lv        Dot product between light and view directions (unclamped [-1, 1])
 * @param roughness Surface roughness in range [0, 1]
 * @return Normalized diffuse reflectance factor (Lambert = 1.0 when roughness = 0)
 */
float EonBRDF(float nl, float nv, float lv, float roughness)
{
	float s = lv - nl * nv;
	float sovertF = (s > 0.0f) ? (s / max(max(nl, nv), 1e-5f)) : s;

	float AF = 1.0f / (1.0f + EON_CONSTANT1_FON * roughness);
	float f_ss = AF * (1.0f + roughness * sovertF);

	float EFo = E_FON_approx(nv, roughness, AF);
	float EFi = E_FON_approx(nl, roughness, AF);
	float avgEF = AF * (1.0f + EON_CONSTANT2_FON * roughness);

	// Multi-scattering lobe compensation to ensure directional albedo integrates to 1.0
	float f_ms = max(1e-5f, 1.0f - EFo) * max(1e-5f, 1.0f - EFi) / max(1e-5f, 1.0f - avgEF);

	return max(0.0f, f_ss + f_ms);
}

/**
 * Evaluates diffuse surface reflectance according to configured DIFFUSE_BRDF_TYPE.
 *
 * @param N         Surface normal vector
 * @param L         Incident light direction vector
 * @param V         Outgoing view direction vector
 * @param roughness Surface roughness [0, 1]
 * @return Normalized diffuse BRDF response factor
 */
float DiffuseBRDF(float3 N, float3 L, float3 V, float roughness)
{
	float nl = saturate(dot(N, L));
	float nv = max(abs(dot(N, V)), 1e-5f);

#if (DIFFUSE_BRDF_TYPE == 1)
	float lv = dot(L, V);
	return EonBRDF(nl, nv, lv, roughness);
#else
	float3 H = normalize(V + L);
	float vh = saturate(dot(V, H));
	return BurleyBRDF(nl, nv, vh, roughness);
#endif
}

// Rim knobs are floats, so they can't gate a preprocessor #if; defaults keep
// old ray.confs (no knob) compiling, the compiler folds the constant branch
#ifndef TOON_RIM_STRENGTH
#define TOON_RIM_STRENGTH 0
#endif
#ifndef TOON_RIM_POWER
#define TOON_RIM_POWER 2.5
#endif

float3 ToonBasedShading(float nl, float vh, float nv, float3 shadowColor, float3 specular, float shadow, float roughness, float hardness)
{
	float Fd90 = (0.5 + 2.0 * vh * vh) * roughness;
	float FdV = lerp(1, Fd90, pow5(1 - max(nv, 0.1)));

	float3 f0 = specular;
	float3 f90 = ComputeSpecularMicroOcclusion(f0);
	float3 fresnel = fresnelSchlick(f0, f90, vh);

	float litFactor = saturate(nl * hardness + 1 - hardness) * shadow;

	// Jashin rim: silhouette boost folded in before the ramp so it inherits the bands
	litFactor += (TOON_RIM_STRENGTH > 0) ? pow(saturate(1 - nv), TOON_RIM_POWER) * TOON_RIM_STRENGTH : 0;

	return lerp(shadowColor, 1.0, litFactor) * (1  - fresnel);
}

#if TOON_ENABLE
// Hue rotation via YIQ: chroma rotates, luminance stays put
float3 ShiftToonHue(float3 c, float degrees)
{
	float a = radians(degrees);
	float s = sin(a), co = cos(a);
	float y = dot(c, float3(0.299f, 0.587f, 0.114f));
	float i = dot(c, float3(0.5959f, -0.2746f, -0.3213f));
	float q = dot(c, float3(0.2115f, -0.5227f, 0.3112f));
	float i2 = i * co - q * s;
	q = i * s + q * co;
	i = i2;
	return saturate(float3(
		y + 0.956f * i + 0.619f * q,
		y - 0.272f * i - 0.647f * q,
		y - 1.106f * i - 1.703f * q));
}

// Community-toon shadow grading, one place for every knob:
// self-power fallback (Jashin) -> low-saturation auto-tint (M4Toon2) ->
// mul/add/hue grade (PAToon2/M4Toon2) -> warm push (T_ToonShader skin mode)
float3 ToonShadowGrade(float3 shadowColor, float3 albedo)
{
	if (TOON_SELF_POWER_SHADOW > 0 && all(shadowColor < 1e-4))
		shadowColor = pow(saturate(albedo - 0.01f), TOON_SELF_POWER_SHADOW);

	float sat = max(max(albedo.r, albedo.g), albedo.b) - min(min(albedo.r, albedo.g), albedo.b);
	if (sat <= TOON_AUTOTINT_THRESHOLD && any(TOON_AUTOTINT_COLOR))
	{
		float3 tinted = saturate(shadowColor * TOON_AUTOTINT_COLOR);
		shadowColor = lerp(shadowColor, tinted, (1 - sat) * TOON_AUTOTINT_STRENGTH);
	}

	shadowColor = shadowColor * TOON_SHADOW_MUL + TOON_SHADOW_ADD;

	if (TOON_SHADOW_HUE != 0)
		shadowColor = ShiftToonHue(shadowColor, TOON_SHADOW_HUE);

	if (TOON_SHADOW_WARMTH > 0)
	{
		float w = TOON_SHADOW_WARMTH;
		float3 warm = float3(1.0f + 0.30f * w, 1.0f - 0.10f * w, 1.0f - 0.35f * w);
		float luma = dot(shadowColor, float3(0.299f, 0.587f, 0.114f));
		// scale back so only the chroma moves, not the brightness
		shadowColor *= warm * (luma / max(dot(warm * shadowColor, float3(0.299f, 0.587f, 0.114f)), 1e-4f));
	}

	return saturate(shadowColor);
}
#endif

float3 CelShading(float nl, float vh, float nv, float3 shadowColor, float3 specular, float shadow, float roughness, float threshold)
{
	// Hardened shadow: soft PCF/contact-shadow gradients would smear the band
	// edges; anime ramps need a crisp geometric terminator
	shadow = smoothstep(0.35f, 0.65f, shadow);
	float halfLambert = nl * 0.5f + 0.5f;
	float litFactor = halfLambert * shadow;

	litFactor += (TOON_RIM_STRENGTH > 0) ? pow(saturate(1 - nv), TOON_RIM_POWER) * TOON_RIM_STRENGTH : 0;

	// Anti-aliased 2-band anime shadow ramp with soft secondary core shadow
	float band1 = smoothstep(threshold - 0.02f, threshold + 0.02f, litFactor);
	float band2 = smoothstep(threshold * 0.5f - 0.015f, threshold * 0.5f + 0.015f, litFactor);

	// Half-strength core shadow: squaring a saturated shadow color doubles its
	// chroma and reads as burnt; 50% keeps the depth cue without the fry
	float3 deepShadow = lerp(shadowColor, shadowColor * shadowColor, 0.5f);
	float3 midShadow = shadowColor;

	float3 celRamp = lerp(deepShadow, midShadow, band2);
	celRamp = lerp(celRamp, 1.0f, band1);

	// Fresnel attenuation, matching ToonBasedShading
	float3 f0 = specular;
	float3 f90 = ComputeSpecularMicroOcclusion(f0);
	return celRamp * (1.0f - fresnelSchlick(f0, f90, vh));
}

float3 SpecularBRDF_Blinn(float nh, float nl, float vh, float nv, float smoothness, float3 specular, float NormalizationFactor)
{
	float alpha = exp2(10 * smoothness + 1);
	float D = ((alpha + 2) / 8) * pow(nh, alpha) * NormalizationFactor;
	return D;
}

float3 SpecularBRDF_GGX(float nh, float nl, float vh, float nv, float roughness, float3 specular, float NormalizationFactor)
{
	float m2 = roughness * roughness;
	float spec = (nh * m2 - nh) * nh + 1.0f;
	spec = m2 / (spec * spec) * NormalizationFactor;

	float k = 1.0f - roughness;
	float G = nl * (nv * k + roughness) + nv * (nl * k + roughness);
	spec *= 0.5f / G;

	float3 f0 = specular;
	float3 f90 = ComputeSpecularMicroOcclusion(f0);
	float3 fresnel = fresnelSchlickF(f0, f90, vh);

	// Multi-scattering energy compensation for rough microfacets (Turquin 2018 / Fdez-Aguera)
	float3 energyCompensation = 1.0f + f0 * (roughness * (1.0f - roughness) * 0.65f);

	return fresnel * spec * energyCompensation;
}

/**
 * [Lazarov 2013, "Getting More Physical in Call of Duty: Black Ops II"]
 * Analytical polynomial approximation for the Environment BRDF split-sum DFG integral.
 * Dual-polynomial curve fit for directional albedo scale and bias.
 *
 * @param roughness Linear perceptual surface roughness [0, 1]
 * @param NoV       Cosine of angle between surface normal and view direction
 * @return float2   (Scale, Bias) factors for specular color and F90 reflectance
 */
float2 EnvBRDFApproxLazarov(float roughness, float NoV)
{
	const float4 c0 = { -1.0f, -0.0275f, -0.572f, 0.022f };
	const float4 c1 = { 1.0f, 0.0425f, 1.04f, -0.04f };
	float4 r = roughness * c0 + c1;
	float a004 = min(r.x * r.x, exp2(-9.28f * NoV)) * r.x + r.y;
	return float2(-1.04f, 1.04f) * a004 + r.zw;
}

float3 EnvBRDFApprox(float3 specularColor, float roughness, float NoV)
{
	float2 AB = EnvBRDFApproxLazarov(roughness, NoV);
	float3 f90 = ComputeSpecularMicroOcclusion(specularColor);
	return specularColor * AB.x + f90 * AB.y;
}

/**
 * Analytical energy transfer for ultra-rough microfacets (roughness > 0.95).
 * As microfacets reach extreme roughness, specular scattering degenerates into
 * diffuse-like hemispherically scattered light. Returns the directional albedo
 * transfer factor (0.45 * factor) to add into diffuse and damps specular to
 * eliminate microfacet highlights and shimmering on matte materials.
 */
float EnergyPreservingFullyRough(inout float3 specular, float roughness)
{
	float fullyRoughFactor = saturate((roughness - 0.95f) * 20.0f);
	specular *= (1.0f - fullyRoughFactor);
	return 0.45f * fullyRoughFactor;
}

// Angular radius of the "sphere light" used by SphereMaxNoH for highlight
// softening / geometric anti-aliasing. float knob -> runtime branch, the
// compiler folds the constant case; 0 (default) = exact point/area light H,
// i.e. legacy behavior.
#ifndef SPEC_LIGHT_SIN_ALPHA
#define SPEC_LIGHT_SIN_ALPHA 0
#endif

#if SUN_SPECULAR_DISK_ENABLE
#	define EFFECTIVE_SPEC_SIN_ALPHA max(SPEC_LIGHT_SIN_ALPHA, mSunAngularRadius)
#else
#	define EFFECTIVE_SPEC_SIN_ALPHA SPEC_LIGHT_SIN_ALPHA
#endif

/**
 * [de Carpentier 2017, "Decima Engine: Advances in Lighting and AA"]
 * Specular highlight softening for sphere/area-like lights: picks the largest
 * NoH over the light's solid angle so the GGX lobe covers the whole visible
 * region of the light instead of a single direction's half-vector. This kills
 * the "far too small, shimmery highlight" artifact of analytic point-ish
 * lighting on smooth materials and acts as specular geometric AA.
 * SinAlpha = sin(asin(lightAngularRadius)); 0 disables (point-light behavior).
 * nl is the unclamped dot(N,L), vl the unclamped dot(V,L).
 */
void SphereMaxNoH(inout float nl, inout float vl, float nv, float SinAlpha, inout float nh, inout float vh)
{
	if (SinAlpha > 0)
	{
		float CosAlpha = sqrt(1 - pow2(SinAlpha));

		float RoL = 2 * nl * nv - vl;
		if (RoL >= CosAlpha)
		{
			// The whole sphere is "front" of the half-vector region
			nh = 1;
			vh = abs(nv);
		}
		else
		{
			float rInvLengthT = SinAlpha * rsqrt(1 - RoL * RoL);
			float NoTr = rInvLengthT * (nv - RoL * nl);
			float VoTr = rInvLengthT * (2 * nv * nv - 1 - RoL * vl);

			// Newton iteration (UE default bNewtonIteration = true):
			// refined projection of the largest-NoH point using
			// dot(cross(N,L), V) = sqrt(saturate(...))
			float NxLoV = sqrt(saturate(1 - pow2(nl) - pow2(nv) - pow2(vl) + 2 * nl * nv * vl));

			float NoBr = rInvLengthT * NxLoV;
			float VoBr = rInvLengthT * NxLoV * 2 * nv;

			float NoLVTr_n = nl * CosAlpha + nv + NoTr;	// A
			float VoLVTr_n = vl * CosAlpha + 1 + VoTr;	// B

			float p = NoBr * VoLVTr_n;
			float q = NoLVTr_n * VoLVTr_n;
			float s = VoBr * NoLVTr_n;

			float xNum = q * (-0.5f * p + 0.25f * VoBr * NoLVTr_n);
			float xDenom = p * p + s * (s - 2 * p) + NoLVTr_n * ((nl * CosAlpha + nv) * pow2(VoLVTr_n) + q * (-0.5f * (VoLVTr_n + vl * CosAlpha) - 0.5f));
			float TwoX1 = 2 * xNum / (pow2(xDenom) + pow2(xNum));

			float SinTheta = TwoX1 * xDenom;
			float CosTheta = 1 - TwoX1 * xNum;

			// Newton-refined projections of the largest-NoH point
			NoTr = CosTheta * NoTr + SinTheta * NoBr;
			VoTr = CosTheta * VoTr + SinTheta * VoBr;

			// L re-projected onto the sphere: dot(N, L*CosAlpha + T*SinAlpha)
			nl = nl * CosAlpha + NoTr;
			vl = vl * CosAlpha + VoTr;

			float InvLenH = rsqrt(2 + 2 * vl);
			nh = saturate((nl + nv) * InvLenH);
			vh = saturate(InvLenH + InvLenH * vl);
		}
	}
}

float3 DualLobeSkinSpecular(float nh, float nl, float vh, float nv, float roughness, float3 specular, float normalizeFactor)
{
	// Dual-lobe GGX model for organic skin (cf. Jimenez et al. 2015):
	// Lobe 1 (Base Dermal Layer): Broad, matte lobe representing subsurface reflection and micro-porosity
	// Lobe 2 (Epidermal / Sebum Layer): Tight, sharper specular representing skin moisture and lipid coating
	float r1 = saturate(roughness * SKIN_SPEC_LOBE0_SCALE + SKIN_SPEC_LOBE0_ADD);
	float r2 = saturate(roughness * SKIN_SPEC_LOBE1_SCALE + SKIN_SPEC_LOBE1_ADD);

	float m1 = r1 * r1;
	float d1 = (nh * m1 - nh) * nh + 1.0f;
	float D1 = m1 / (d1 * d1);

	float m2 = r2 * r2;
	float d2 = (nh * m2 - nh) * nh + 1.0f;
	float D2 = m2 / (d2 * d2);

	float D = (D1 * SKIN_SPEC_LOBE0_MIX + D2 * SKIN_SPEC_LOBE1_MIX) * normalizeFactor;

	// Average roughness for Smith masking-shadowing evaluation (single Vis replaces duplicate evaluations)
	float avgR = r1 * SKIN_SPEC_LOBE0_MIX + r2 * SKIN_SPEC_LOBE1_MIX;
	float k = 1.0f - avgR;
	float G = nl * (nv * k + avgR) + nv * (nl * k + avgR);
	float spec = D * (0.5f / G);

	float3 f0 = specular;
	float3 f90 = ComputeSpecularMicroOcclusion(f0);
	float3 fresnel = fresnelSchlickF(f0, f90, vh);

	float3 energyCompensation = 1.0f + f0 * (avgR * (1.0f - avgR) * 0.65f);

	return fresnel * spec * energyCompensation;
}

float3 SpecularBRDF_GGXAniso(float3 N, float3 H, float nh, float nl, float vh, float nv, float3 specular, float3 albedo, float roughness, float anisotropic, float3 shift, float NormalizationFactor)
{
	// World-up tangent frame; fall back to X axis near poles
	float3 up = (abs(N.y) > 0.99f) ? float3(1, 0, 0) : float3(0, 1, 0);
	float3 T = normalize(cross(N, up));
	float3 B = normalize(cross(N, T));

	// Tangent rotation via shift.r (angle in turns / radians)
	if (abs(shift.r) > 1e-4f)
	{
		float angle = shift.r * 6.2831853f;
		float sinA, cosA;
		sincos(angle, sinA, cosA);
		float3 rotatedT = T * cosA + B * sinA;
		B = -T * sinA + B * cosA;
		T = rotatedT;
	}

	float aspect = sqrt(max(1.0f - anisotropic * 0.9f, 0.01f));
	float ax = max(roughness / aspect, 0.001f);
	float ay = max(roughness * aspect, 0.001f);

	bool isHair = any(shift.gb > 0.001f);

	if (isHair)
	{
		// Primary highlight (R lobe - shifted towards root)
		float3 H_shift1 = normalize(H + N * (shift.g * 0.1f));
		float d1 = pow2(dot(T, H_shift1) / ax) + pow2(dot(B, H_shift1) / ay) + nh * nh;
		float spec1 = (1.0f / (ax * ay * max(d1 * d1, 1e-6f))) * NormalizationFactor;

		// Secondary highlight (TRT lobe - transmission bounce shifted towards tip, tinted by hair albedo)
		float3 H_shift2 = normalize(H - N * (shift.b * 0.15f + 0.08f));
		float r2 = saturate(roughness * 1.4f + 0.1f);
		float ax2 = max(r2 / aspect, 0.001f);
		float ay2 = max(r2 * aspect, 0.001f);
		float d2 = pow2(dot(T, H_shift2) / ax2) + pow2(dot(B, H_shift2) / ay2) + nh * nh;
		float spec2 = (1.0f / (ax2 * ay2 * max(d2 * d2, 1e-6f))) * NormalizationFactor;

		float k = 1.0f - roughness;
		float G = 0.5f / (nl * (nv * k + roughness) + nv * (nl * k + roughness));
		spec1 *= G;
		spec2 *= G;

		float3 f0 = specular;
		float3 fresnel = fresnelSchlick(f0, 1.0f, vh);

		return (spec1 * fresnel) + (spec2 * albedo * 0.45f * fresnel);
	}
	else
	{
		// Standard Heitz / Burley Anisotropic GGX microfacet distribution
		float dotTH = dot(T, H);
		float dotBH = dot(B, H);
		float d = pow2(dotTH / ax) + pow2(dotBH / ay) + nh * nh;
		float D = (1.0f / (PI * ax * ay * max(d * d, 1e-6f))) * NormalizationFactor;

		// Smith anisotropic separable visibility function: V = G / (4 * nl * nv)
		float lambdaV = nl * length(float3(ax * dot(T, H), ay * dot(B, H), nv));
		float lambdaL = nv * length(float3(ax * dot(T, H), ay * dot(B, H), nl));
		float V = 0.5f / max(lambdaV + lambdaL, 1e-5f);

		float3 f0 = specular;
		float3 f90 = ComputeSpecularMicroOcclusion(f0);
		float3 fresnel = fresnelSchlickF(f0, f90, vh);

		// Multi-scattering energy compensation for anisotropic surfaces
		float3 energyCompensation = 1.0f + f0 * (roughness * (1.0f - roughness) * 0.65f);

		return D * V * fresnel * energyCompensation;
	}
}

// Cloth visibility model: 0 = Neubelt/Pettineo (cheap, default), 1 = full
// Estevez & Kulla exponential fit. The fit costs 2x exp + a pow fit but gives
// a noticeably better grazing-angle sheen falloff; off by default because
// cloth shading runs in every lighting pass.
#ifndef BRDF_CLOTH_VIS_CHARLIE
#define BRDF_CLOTH_VIS_CHARLIE 0
#endif

// [Estevez and Kulla 2017, "Production Friendly Microfacet Sheen BRDF"]
float Vis_Charlie_L(float x, float r)
{
	r = saturate(r);
	r = 1.0f - (1.0f - r) * (1.0f - r);

	float a = lerp(25.3245f, 21.5473f, r);
	float b = lerp(3.32435f, 3.82987f, r);
	float c = lerp(0.16801f, 0.19823f, r);
	float d = lerp(-1.27393f, -1.97760f, r);
	float e = lerp(-4.85967f, -4.32054f, r);

	return a / ((1 + b * pow(x, c)) + d * x + e);
}

float Vis_Charlie(float roughness, float nv, float nl)
{
	// Remap x away from poles with the mirrored fit to avoid its singularity
	float VisV = nv < 0.5f ? exp(Vis_Charlie_L(nv, roughness)) : exp(2 * Vis_Charlie_L(0.5f, roughness) - Vis_Charlie_L(1 - nv, roughness));
	float VisL = nl < 0.5f ? exp(Vis_Charlie_L(nl, roughness)) : exp(2 * Vis_Charlie_L(0.5f, roughness) - Vis_Charlie_L(1 - nl, roughness));

	return 1.0f / ((1 + VisV + VisL) * (4 * nv * nl));
}

/**
 * Charlie Sheen BRDF for cloth, fabric, silk, velvet, and microfibers (Estevez & Kulla 2017 / Sony Pictures Imageworks).
 * Evaluates the Charlie microfacet distribution function D_Charlie with Neubelt shadow-masking term V_Neubelt,
 * microfiber grazing-angle rim fuzz, and energy-conserving directional albedo scaling.
 *
 * @param material Material parameters.
 * @param nh Dot product of normal and half vector.
 * @param nl Dot product of normal and light vector.
 * @param vh Dot product of view and half vector.
 * @param nv Dot product of normal and view vector.
 * @param roughness Filtered surface roughness.
 * @param normalizeFactor Normalization constant.
 * @param albedoScaling Output diffuse attenuation factor for energy conservation.
 * @return Evaluated cloth/sheen specular color.
 */
float3 ClothShading(MaterialParam material, float nh, float nl, float vh, float nv, float roughness, float normalizeFactor, out float albedoScaling)
{
	float clampedSheenRoughness = max(roughness, 1e-4f);
	float invAlpha = 1.0f / clampedSheenRoughness;
	
	float cos2h = nh * nh;
	float sin2h = max(1.0f - cos2h, 0.0078125f);
	
	// Charlie distribution: D(h) = (2 + 1/alpha) * sin(h)^(1/alpha) / (2 * PI)
	float D_Charlie = (2.0f + invAlpha) * pow(sin2h, invAlpha * 0.5f) * InvPIE * 0.5f;
	
	// [ Estevez & Kulla 2017 / Neubelt & Pettineo ] Visibility model
	// Neubelt & Pettineo term with grazing singularity guard
	float denominator = 4.0f * (nl + nv - nl * nv) + 0.05f;
	float V_Neubelt = 1.0f / denominator;
#if BRDF_CLOTH_VIS_CHARLIE == 1
	// Full-fit visibility: better grazing sheen than the Neubelt approximation
	V_Neubelt = Vis_Charlie(clampedSheenRoughness, nv, nl);
#endif
	
	// Fallback to albedo-tinted sheen if customDataB is unassigned
	float3 sheenColor = any(material.customDataB > 1e-4f) ? material.customDataB : lerp(float3(1.0f, 1.0f, 1.0f), material.albedo, 0.45f);
	float3 sheenTerm = sheenColor * (D_Charlie * V_Neubelt);
	
	// Microfiber rim fuzz scattering (for velvet, cotton, wool)
	float fuzzRim = pow5(1.0f - nv) * saturate(nl + 0.2f);
	float3 fuzzTerm = sheenColor * (fuzzRim * 0.4f * saturate(roughness * 2.0f));
	
	float r2 = pow2(clampedSheenRoughness);
	float isSmooth = step(clampedSheenRoughness, 0.25f);
	
	float a = lerp(
		-8.48f * r2 + 14.3f * clampedSheenRoughness - 9.95f,
		-339.2f * r2 + 161.4f * clampedSheenRoughness - 25.9f,
		isSmooth
	);
	
	float b = lerp(
		1.97f * r2 - 3.27f * clampedSheenRoughness + 0.72f,
		44.0f * r2 - 23.7f * clampedSheenRoughness + 3.26f,
		isSmooth
	);
	
	float correction = lerp(0.1f * (clampedSheenRoughness - 0.25f), 0.0f, isSmooth);
	float directionalAlbedo = saturate(exp2(a * nv + b) + correction);
	
	float maxSheenColor = max3(sheenColor);
	albedoScaling = saturate(1.0f - maxSheenColor * directionalAlbedo);
	
	float3 specBase = SpecularBRDF_GGX(nh, nl, vh, nv, roughness, material.specular, normalizeFactor);
	return (specBase * albedoScaling) + sheenTerm + fuzzTerm;
}

float4 SpecularBRDF_ClearCoat(float nh, float nl, float vh, float nv, float roughness, float specular, float NormalizationFactor)
{
	float m2 = roughness * roughness;
	float spec = (nh * m2 - nh) * nh + 1;
	spec = m2 / (spec * spec) * NormalizationFactor;

	float G = (4 * vh * vh + 1e-5);
	spec /= G;

	float fresnel = fresnelSchlick(specular, 1.0, vh);
	return float4(spec, spec, spec, fresnel);
}

// Physically-Based Thin-Film Wave Interference (Airy spectral equations approximation)
// Computes multi-spectral constructive/destructive phase interference for thin dielectric films
float3 ThinFilmIridescence(float nv, float filmThickness = 380.0f, float filmIOR = 1.45f)
{
	// Snell's law refraction angle inside thin dielectric film
	float sinTheta2_sq = (1.0f - nv * nv) / max(filmIOR * filmIOR, 1.01f);
	float cosTheta2 = sqrt(max(1.0f - sinTheta2_sq, 0.0f));

	// Optical path difference (OPD) in nanometers
	float opd = 2.0f * filmIOR * filmThickness * cosTheta2;

	// Multi-spectral phase shift for standard RGB primary wavelengths (Red: 650nm, Green: 532nm, Blue: 450nm)
	const float3 wavelength = float3(650.0f, 532.0f, 450.0f);
	float3 phi = (2.0f * PI * opd) / wavelength;

	// Cosine wave interference envelope
	float3 interference = 0.5f + 0.5f * cos(phi);
	return saturate(interference);
}

// Polynomial approximation of refraction blend factor for normal component of VoH with fixed Eta (1/1.5):
float RefractBlendClearCoatApprox(float vh)
{
	return (0.63f - 0.22f * vh) * vh - 0.745f;
}

float3 ClearCoatShading(MaterialParam material, float nh, float nl, float vh, float nv, float roughness, float normalizeFactor, out float albedoScaling)
{
	float clearcoatRoughness = max(SmoothnessToRoughness(material.customDataA), 0.001);
	
	// ClearCoat top layer has fixed IOR 1.5 (F0 = 0.04)
	float4 spec2 = SpecularBRDF_ClearCoat(nh, nl, vh, nv, clearcoatRoughness, 0.04, normalizeFactor);
	float clearCoatFresnel = spec2.a;
	float3 clearCoatSpecular = spec2.rgb;

	// Thin-Film / Pearlescent Iridescence via customDataB (customDataB.x: strength, customDataB.y: optical thickness)
	float iridStrength = saturate(material.customDataB.x);
	[branch]
	if (iridStrength > 0.001f)
	{
		float filmThickness = material.customDataB.y > 0.0f ? material.customDataB.y * 800.0f : 380.0f;
		float3 iridColor = ThinFilmIridescence(nv, filmThickness, 1.45f);
		clearCoatSpecular = lerp(clearCoatSpecular, clearCoatSpecular * iridColor * 2.2f, iridStrength);
	}
	
	// Analytical refraction through clearcoat (Eta = 1.0 / 1.5):
	// propagates angle deflection to substrate without tracing secondary rays
	float refFactor = RefractBlendClearCoatApprox(vh);
	float refProj = refFactor * nh;
	float nv_bottom = clamp(0.6667f * nv - refProj, 0.001f, 1.0f);
	float nl_bottom = clamp(0.6667f * nl - refProj, 0.001f, 1.0f);
	float vh_bottom = saturate(0.6667f * vh - refFactor);

	// Thin-layer Beer-Lambert optical transmission through clearcoat
	float thinDistance = (rcp(nv_bottom) + rcp(nl_bottom));
	float3 transmission = exp(-0.06f * max(thinDistance - 2.0f, 0.0f));

	// Light that penetrates the clearcoat is attenuated by (1 - Fc)^2 on entry and exit
	float attenuation = 1.0f - clearCoatFresnel;
	albedoScaling = attenuation * attenuation;
	
	float3 specBase = SpecularBRDF_GGX(nh, nl_bottom, vh_bottom, nv_bottom, roughness, material.specular, normalizeFactor);
	
	// Base specular is attenuated and absorbed. Clearcoat specular is added on top.
	return (specBase * albedoScaling * transmission) + clearCoatSpecular;
}

/**
 * [Steve McAuley 2011, "Energy-conserving wrapped diffuse" / Henyey-Greenstein forward phase]
 * Two-sided wrapped transmission for thin geometry (foliage, leaves, paper, cloth).
 */
float3 SubsurfaceShadingTwoSided(MaterialParam material, float3 N, float3 L, float3 V)
{
	float wrapNoL = saturate((-dot(N, L) + 0.5f) / 2.25f);
	float voL = dot(V, L);

#if SUN_BACKLIGHT_TRANSLUCENCY
	// Physical Henyey-Greenstein forward phase function for solar transmission:
	// Light passing through thin translucent media scatters preferentially forward (-V . L -> 1)
	float g = mSunBacklightAnisotropy;
	float g2 = g * g;
	float cosTheta = saturate(-voL);
	float denom = 1.0f + g2 - 2.0f * g * cosTheta;
	float hgPhase = (1.0f - g2) / (4.0f * PI * pow(max(denom, 0.01f), 1.5f));
	float scatter = hgPhase * 2.0f;
#else
	float m2 = 0.36f; // roughness ~0.6
	float nh = saturate(-voL);
	float d = (nh * m2 - nh) * nh + 1.0f;
	float scatter = m2 / (PI * d * d);
#endif

	float3 transColor = any(material.customDataB > 1e-4f) ? material.customDataB : material.albedo;
	return transColor * (wrapNoL * scatter * saturate(material.customDataA));
}

/**
 * Analytical Eye Iris Caustic (Jimenez 2014 / Eye BxDF).
 * Evaluates focused illumination on the iris opposite the incident light.
 *
 * @param irisNormal    Normal of the iris / pupil plane.
 * @param causticNormal Concave-curved normal focusing light across the iris.
 * @param L             Incident light direction.
 * @return float        Caustic irradiance multiplier.
 */
float EyeIrisCaustic(float3 irisNormal, float3 causticNormal, float3 L)
{
	float irisNoL = saturate(dot(irisNormal, L));
	float power = lerp(12.0f, 1.0f, irisNoL);
	return 0.8f + 0.2f * (power + 1.0f) * pow(saturate(dot(causticNormal, L)), power);
}

/**
 * Translucency add dispatch:
 * SKIN receives the multilayer dermal/epidermal response + backlit glow.
 * SUBSURFACE receives Steve McAuley two-sided wrapped transmission (foliage/leaves/cloth/paper).
 */
float3 SubsurfaceShading(MaterialParam material, float3 N, float3 L, float3 V, float2 coord = float2(0, 0), float ao = 1.0f, float shadow = 1.0f)
{
	[branch]
	if (material.lightModel == SHADINGMODELID_SKIN)
		return SubsurfaceShadingCheatSkin(material, N, L, V, ao, shadow) + SubsurfaceShadingBacklitGlow(material, N, L, V);
	else if (material.lightModel == SHADINGMODELID_SUBSURFACE)
		return SubsurfaceShadingTwoSided(material, N, L, V);
	else
		return 0;
}

float2x3 SurfaceEnergy(MaterialParam material, float3 N, float3 L, float3 V, float shadow, float normalizeFactor = 1.0)
{
	float nl = dot(N, L);
	bool isSkin = (material.lightModel == SHADINGMODELID_SKIN || material.lightModel == SHADINGMODELID_SUBSURFACE);

#if TOON_ENABLE
	// Half-Lambert cel ramps and skin wrap are defined into shadow;
	// only standard PBR hard-terminates at nl <= 0
	if (nl <= (isSkin ? -0.55f : 0.0f) && material.lightModel != SHADINGMODELID_CEL)
		return (float2x3)0;
#else
	if (nl <= (isSkin ? -0.55f : 0.0f))
		return (float2x3)0;
#endif

	float nv = abs(dot(N, V)) + 1e-5h;
	float lv = dot(L, V);

	// Scalar half-vector evaluation (Karis 2013 / microfacet geometric invariant):
	// evaluates NoH and VoH analytically without 3D vector normalization since |V|=1 and |L|=1
	float InvLenH = rsqrt(2.0f + 2.0f * lv);
	float nh = saturate((nl + nv) * InvLenH);
	float vh = saturate(InvLenH + InvLenH * lv);

	// [de Carpentier 2017] Optional sphere-light highlight softening / specular
	// AA; identity no-op when EFFECTIVE_SPEC_SIN_ALPHA = 0 (constant-folded)
	SphereMaxNoH(nl, lv, nv, EFFECTIVE_SPEC_SIN_ALPHA, nh, vh);

	float3 H = (material.lightModel == SHADINGMODELID_ANISOTROPY) ? ((V + L) * InvLenH) : 0;

	float roughness = max(SmoothnessToRoughness(material.smoothness), 0.001);
	roughness = FilterGeometricRoughness(roughness, N);
	float occlusion = ComputeAmbientMicroOcclusion(saturate(nl), material.visibility) * shadow;

	float diffuseOcclusion = isSkin ? lerp(1.0f, occlusion, SKIN_AO_STRENGTH) : occlusion;

#if TOON_ENABLE
	float3 diffuse = 0;

	[branch]
	if (material.lightModel == SHADINGMODELID_CEL || material.lightModel == SHADINGMODELID_TONEBASED)
	{
		float3 toonShadow = ToonShadowGrade(material.customDataB, material.albedo);

		if (material.lightModel == SHADINGMODELID_CEL)
			// Terminator driven by the (hardened) geometry shadow only - AO must not
			// shift the band edges, the ramp's own shadow colors carry the shading
			diffuse = CelShading(nl, vh, nv, toonShadow, material.specular, shadow, roughness, material.customDataA);
		else
			// Same as CEL: terminator from the geometry shadow only, AO must not shift the ramp edge
			diffuse = ToonBasedShading(nl, vh, nv, toonShadow, material.specular, shadow, roughness, material.customDataA);
	}
	else
	{
		diffuse = DiffuseBRDF(N, L, V, roughness) * max(nl, 0.0f) * diffuseOcclusion;
	}
#else
	float3 diffuse = DiffuseBRDF(N, L, V, roughness) * max(nl, 0.0f) * diffuseOcclusion;
#endif

	float3 specular = 0;
	float albedoScaling = 1.0f;

	[branch]
	if (isSkin)
		specular = DualLobeSkinSpecular(nh, nl, vh, nv, roughness, material.specular, normalizeFactor);
	else if (material.lightModel == SHADINGMODELID_CLOTH)
		specular = ClothShading(material, nh, nl, vh, nv, roughness, normalizeFactor, albedoScaling);
	else if (material.lightModel == SHADINGMODELID_CLEAR_COAT)
		specular = ClearCoatShading(material, nh, nl, vh, nv, roughness, normalizeFactor, albedoScaling);
	else if (material.lightModel == SHADINGMODELID_GLASS)
		specular = SpecularBRDF_Blinn(nh, nl, vh, nv, material.smoothness, material.specular, normalizeFactor);
	else if (material.lightModel == SHADINGMODELID_ANISOTROPY)
		specular = SpecularBRDF_GGXAniso(N, H, nh, nl, vh, nv, material.specular, material.albedo, roughness, material.customDataA, material.customDataB, normalizeFactor);
	else
	{
		specular = SpecularBRDF_GGX(nh, nl, vh, nv, roughness, material.specular, normalizeFactor);
		diffuse += material.specular * EnergyPreservingFullyRough(specular, roughness);
	}

#if TOON_ENABLE
	// Stepped anime highlight: gate the GGX lobe into a crisp band keyed to the
	// cel threshold so cel materials don't wear soft PBR speculars
	if (material.lightModel == SHADINGMODELID_CEL)
		specular *= smoothstep(material.customDataA - 0.05f, material.customDataA, nh);
#endif

	// saturate(nl): the cel path can reach here with nl <= 0 (back-side deep
	// shadow band) and must not pick up negative specular
	return float2x3(diffuse * albedoScaling, specular * saturate(nl) * (isSkin ? lerp(1.0f, occlusion, SKIN_AO_STRENGTH) : occlusion));
}

float4 SurfaceEnergy(MaterialParam material, float3 N, float3 Ld, float3 Ls, float3 V, float normalizeFactor = 1.0)
{
	float nl2 = dot(N, Ld);
	if (nl2 <= 0.0f)
		return (float4)0;

	float nlUnclamped = dot(N, Ls);
	float vl = dot(Ls, V);
	float nv = abs(dot(N, V)) + 1e-5h;

	// Scalar half-vector evaluation without 3D vector normalization
	float InvLenH = rsqrt(2.0f + 2.0f * vl);
	float nh  = saturate((nlUnclamped + nv) * InvLenH);
	float nl  = saturate(nlUnclamped);
	float vh  = saturate(InvLenH + InvLenH * vl);

	// [de Carpentier 2017] Optional sphere/area-light highlight softening;
	// shaped by the specular direction Ls and a no-op when the knob is 0
	SphereMaxNoH(nlUnclamped, vl, nv, EFFECTIVE_SPEC_SIN_ALPHA, nh, vh);
	// Adopt the re-projected NoL (no-op when the knob is 0)
	nl = saturate(max(nl, nlUnclamped));

	float3 H = (material.lightModel == SHADINGMODELID_ANISOTROPY) ? ((V + Ls) * InvLenH) : 0;

	float roughness = max(SmoothnessToRoughness(material.smoothness), 0.001);
	roughness = FilterGeometricRoughness(roughness, N);
	float diffuse = DiffuseBRDF(N, Ld, V, roughness);
	float shadow = ComputeAmbientMicroOcclusion(nl2, material.visibility);
	bool isSkin = (material.lightModel == SHADINGMODELID_SKIN || material.lightModel == SHADINGMODELID_SUBSURFACE);
	float skinShadow = isSkin ? lerp(1.0f, shadow, SKIN_AO_STRENGTH) : shadow;

	float3 specular = 0;
	float albedoScaling = 1.0f;

	[branch]
	if (isSkin)
		specular = DualLobeSkinSpecular(nh, nl, vh, nv, roughness, material.specular, normalizeFactor);
	else if (material.lightModel == SHADINGMODELID_CLOTH)
		specular = ClothShading(material, nh, nl, vh, nv, roughness, normalizeFactor, albedoScaling);
	else if (material.lightModel == SHADINGMODELID_CLEAR_COAT)
		specular = ClearCoatShading(material, nh, nl, vh, nv, roughness, normalizeFactor, albedoScaling);
	else if (material.lightModel == SHADINGMODELID_GLASS)
		specular = SpecularBRDF_Blinn(nh, nl, vh, nv, material.smoothness, material.specular, normalizeFactor);
	else if (material.lightModel == SHADINGMODELID_ANISOTROPY)
		specular = SpecularBRDF_GGXAniso(N, H, nh, nl, vh, nv, material.specular, material.albedo, roughness, material.customDataA, material.customDataB, normalizeFactor);
	else
	{
		specular = SpecularBRDF_GGX(nh, nl, vh, nv, roughness, material.specular, normalizeFactor);
		diffuse += dot(material.specular, 0.33333f) * EnergyPreservingFullyRough(specular, roughness);
	}

	return float4(diffuse * albedoScaling, specular) * nl2 * skinShadow;
}