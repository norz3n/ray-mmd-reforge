float ComputeSpecularMicroOcclusion(float f0)
{
	return saturate(dot(f0, 0.33333h) * 50);
}

float ComputeSpecularMicroOcclusion(float3 f0)
{
	return saturate(dot(f0, 0.33333h) * 50);
}

float fresnelSchlick(float f0, float f9, float vh)
{
	return lerp(f0, f9, pow5(1 - vh));
}

float3 fresnelSchlick(float3 f0, float3 f9, float vh)
{
	return lerp(f0, f9, pow5(1 - vh));
}

float ComputeAmbientMicroOcclusion(float nl, float ao)
{
	float aperture = 2.0 * ao;
	float shadow = saturate(abs(nl) + aperture - 1.0);
	return shadow;
}

float3 SubsurfaceShadingPennerSkin(MaterialParam material, float3 N, float3 L)
{
	float nl = dot(N, L);

	float pndl = saturate( nl);
	float nndl = saturate(-nl);

	float ir = material.customDataA;
	float brdf = pndl;
	float3 sss = material.customDataB * pow2(1.0 - pndl) * pow(1.0-nndl,3.0 / (ir + 0.001)) * saturate(ir - 0.04);

	return sss;
}

float3 SubsurfaceTranslucency(MaterialParam material, float3 N, float3 L, float3 V)
{
	float nl = dot(N, L);
	if (nl > 0.25f) return 0; // Only activate when light is penetrating from behind the surface

	// Subsurface transmission for thin organic features (ears, nose, fingers under backlight)
	// Physically-modeled forward scattering lobe (Heyney-Greenstein phase approximation)
	float3 distortedL = normalize(L + N * 0.28f);
	float vdotL = saturate(dot(V, -distortedL));
	float forwardScatter = pow(vdotL, 9.0f) * 2.5f;

	// Wide diffuse transmission wrap across backward hemisphere
	float wrapScatter = saturate((-nl + 0.35f) / 1.35f) * 0.65f;

	// Multi-spectral flesh transmission (red wavelength penetrates deep into dermis/subcutis)
	float3 spectralTrans = float3(1.0f, 0.36f, 0.10f) * material.customDataB;

	// Thickness/Curvature-dependent exponential extinction
	float curvature = max(material.customDataA, 0.01f);
	float opticalDensity = exp(-curvature * 2.8f);

	return spectralTrans * ((forwardScatter + wrapScatter) * opticalDensity * 0.6f);
}

float3 SubsurfaceShadingPreIntegratedSkin(MaterialParam material, float3 N, float3 L)
{
	float ndotl = dot(N, L);
	float curvature = material.customDataA;
	float scatter = saturate(curvature * 2.5f);
	
	float3 wrap = float3(0.6f, 0.2f, 0.05f) * scatter;
	float3 ndotl_wrap = saturate((ndotl + wrap) / (1.0f + wrap));
	float3 scatter_profile = ndotl_wrap * ndotl_wrap;
	
	float3 energy_normalization = 1.0f / (1.0f + wrap * 0.5f);
	float edge_mask = saturate(1.0f - abs(ndotl));
	float3 blood_scatter = float3(0.3f, 0.0f, 0.0f) * edge_mask * scatter * energy_normalization;
	
	float3 brdf = (scatter_profile * energy_normalization) + blood_scatter;
	return material.customDataB * brdf;
}

float BurleyBRDF(float nl, float nv, float vh, float roughness)
{
	float energyBias = 0.5 * roughness;
	float energyFactor = lerp(1, 1 / 1.51, roughness);

	float Fd90 = energyBias + 2.0 * vh * vh * roughness;
	float FdV = lerp(1, Fd90, pow5(1 - max(nv, 0.1)));
	float FdL = lerp(1, Fd90, pow5(1 - nl));

	return FdV * FdL * energyFactor;
}

float OrenNayarBRDF(float nl, float nv, float lv, float roughness)
{
	float m2 = roughness * roughness;

	float s = lv - nl * nv;
	float t = (s <= 0.0) ? 1 : max(max(nl, nv), 1e-6);
	float A = 1.0 / (1.0 + (0.5 - 2.0 / (3.0 * PI)) * m2);
	float B = m2 * A;

	return max(0, A + B * (s / t));
}

float DiffuseBRDF(float3 N, float3 L, float3 V, float roughness)
{
	float3 H = normalize(V + L);

	float nl = saturate(dot(N, L));
	float vh = saturate(dot(V, H));
	float nv = abs(dot(N, V));

	return BurleyBRDF(nl, nv, vh, roughness);
}

float3 ToonBasedShading(float nl, float vh, float nv, float3 shadowColor, float3 specular, float shadow, float roughness, float hardness)
{
	float Fd90 = (0.5 + 2.0 * vh * vh) * roughness;
	float FdV = lerp(1, Fd90, pow5(1 - max(nv, 0.1)));

	float3 f0 = specular;
	float3 f90 = ComputeSpecularMicroOcclusion(f0);
	float3 fresnel = fresnelSchlick(f0, f90, vh);

	return lerp(shadowColor, 1.0, saturate(nl * hardness + 1 - hardness) * shadow) * (1  - fresnel);
}

float3 CelShading(float nl, float vh, float nv, float3 shadowColor, float3 specular, float shadow, float roughness, float threshold)
{
	float halfLambert = nl * 0.5f + 0.5f;
	float litFactor = halfLambert * shadow;
	
	// Anti-aliased 2-band anime shadow ramp with soft secondary core shadow
	float band1 = smoothstep(threshold - 0.035f, threshold + 0.035f, litFactor);
	float band2 = smoothstep(threshold * 0.5f - 0.025f, threshold * 0.5f + 0.025f, litFactor);
	
	float3 deepShadow = shadowColor * shadowColor;
	float3 midShadow = shadowColor;
	
	float3 celRamp = lerp(deepShadow, midShadow, band2);
	celRamp = lerp(celRamp, 1.0f, band1);

	return celRamp;
}

float3 SpecularBRDF_Blinn(float nh, float nl, float vh, float nv, float smoothness, float3 specular, float NormalizationFactor)
{
	float alpha = exp2(10 * smoothness + 1);
	float D = ((alpha + 2) / 8) * pow(nh, alpha) * NormalizationFactor;
	return D;
}

float3 SpecularBRDF_GGX(float nh, float nl, float vh, float nv, float roughness, float3 specular, float NormalizationFactor)
{
	float m2 = roughness * roughness;
	float spec = (nh * m2 - nh) * nh + 1.0f;
	spec = m2 / (spec * spec) * NormalizationFactor;

	float k = 1.0f - roughness;
	float G = nl * (nv * k + roughness) + nv * (nl * k + roughness);
	spec *= 0.5f / G;

	float3 f0 = specular;
	float3 f90 = ComputeSpecularMicroOcclusion(f0);
	float3 fresnel = fresnelSchlick(f0, f90, vh);

	return fresnel * spec;
}

float3 DualLobeSkinSpecular(float nh, float nl, float vh, float nv, float roughness, float3 specular, float normalizeFactor)
{
	// Dual-lobe GGX model for organic skin:
	// Lobe 1 (Base Dermal Layer): Broad, matte lobe representing subsurface reflection and micro-porosity
	// Lobe 2 (Epidermal / Sebum Layer): Tight, sharper specular representing skin moisture and lipid coating
	float r1 = saturate(roughness * 1.15f + 0.05f);
	float r2 = saturate(roughness * 0.35f + 0.02f);
	float3 lobe1 = SpecularBRDF_GGX(nh, nl, vh, nv, r1, specular, normalizeFactor);
	float3 lobe2 = SpecularBRDF_GGX(nh, nl, vh, nv, r2, specular, normalizeFactor);
	return lobe1 * 0.70f + lobe2 * 0.30f;
}

float3 SpecularBRDF_GGXAniso(float3 N, float3 H, float nh, float nl, float vh, float nv, float3 specular, float3 albedo, float roughness, float anisotropic, float3 shift, float NormalizationFactor)
{
	float3 T = normalize(cross(N, float3(0,1,0)) + N * shift.r);
	float3 B = normalize(cross(N, T));

	float aspect = rsqrt(1.0f - anisotropic * 0.9f);
	float ax = 1.0f / (roughness * aspect);
	float ay = aspect / roughness;

	// Primary highlight (R lobe - shifted towards root)
	float3 H_shift1 = normalize(H + N * (shift.g * 0.1f));
	float spec1 = pow2(dot(T, H_shift1) * ax) + pow2(dot(B, H_shift1) * ay) + nh * nh;
	spec1 = (ax * ay) / (spec1 * spec1) * NormalizationFactor;

	// Secondary highlight (TRT lobe - transmission bounce shifted towards tip, tinted by hair albedo)
	float3 H_shift2 = normalize(H - N * (shift.b * 0.15f + 0.08f));
	float r2 = saturate(roughness * 1.4f + 0.1f);
	float ax2 = 1.0f / (r2 * aspect);
	float ay2 = aspect / r2;
	float spec2 = pow2(dot(T, H_shift2) * ax2) + pow2(dot(B, H_shift2) * ay2) + nh * nh;
	spec2 = (ax2 * ay2) / (spec2 * spec2) * NormalizationFactor;

	float k = 1.0f - roughness;
	float G = 0.5f / (nl * (nv * k + roughness) + nv * (nl * k + roughness));
	spec1 *= G;
	spec2 *= G;

	float3 f0 = specular;
	float3 fresnel = fresnelSchlick(f0, 1.0f, vh);

	return (spec1 * fresnel) + (spec2 * albedo * 0.45f * fresnel);
}

#define pow2(x) ((x) * (x))

float3 ClothShading(MaterialParam material, float nh, float nl, float vh, float nv, float roughness, float normalizeFactor, out float albedoScaling)
{
	float clampedSheenRoughness = max(roughness, 1e-4f);
	float invAlpha = 1.0f / clampedSheenRoughness;
	
	float cos2h = nh * nh;
	float sin2h = max(1.0f - cos2h, 0.0078125f);
	
	float D_Charlie = (2.0f + invAlpha) * pow(sin2h, invAlpha * 0.5f) * 0.159154943f;
	
	// 0.05f epsilon prevents mathematical explosion (singularity) at grazing angles!
	float denominator = 4.0f * (nl + nv - nl * nv) + 0.05f;
	float V_Neubelt = 1.0f / denominator;
	
	float3 sheenColor = material.customDataB;
	float3 sheenTerm = sheenColor * (D_Charlie * V_Neubelt);
	
	// Microfiber rim fuzz scattering (for velvet, cotton, wool)
	float fuzzRim = pow5(1.0f - nv) * saturate(nl + 0.2f);
	float3 fuzzTerm = sheenColor * (fuzzRim * 0.4f * saturate(roughness * 2.0f));
	
	float r2 = pow2(clampedSheenRoughness);
	float isSmooth = step(clampedSheenRoughness, 0.25f);
	
	float a = lerp(
		-8.48f * r2 + 14.3f * clampedSheenRoughness - 9.95f,
		-339.2f * r2 + 161.4f * clampedSheenRoughness - 25.9f,
		isSmooth
	);
	
	float b = lerp(
		1.97f * r2 - 3.27f * clampedSheenRoughness + 0.72f,
		44.0f * r2 - 23.7f * clampedSheenRoughness + 3.26f,
		isSmooth
	);
	
	float correction = lerp(0.1f * (clampedSheenRoughness - 0.25f), 0.0f, isSmooth);
	float directionalAlbedo = saturate(exp2(a * nv + b) + correction);
	
	float maxSheenColor = max(sheenColor.r, max(sheenColor.g, sheenColor.b));
	albedoScaling = saturate(1.0f - maxSheenColor * directionalAlbedo);
	
	float3 specBase = SpecularBRDF_GGX(nh, nl, vh, nv, roughness, material.specular, normalizeFactor);
	return (specBase * albedoScaling) + sheenTerm + fuzzTerm;
}

float4 SpecularBRDF_ClearCoat(float nh, float nl, float vh, float nv, float roughness, float specular, float NormalizationFactor)
{
	float m2 = roughness * roughness;
	float spec = (nh * m2 - nh) * nh + 1;
	spec = m2 / (spec * spec) * NormalizationFactor;

	float G = (4 * vh * vh + 1e-5);
	spec /= G;

	float fresnel = fresnelSchlick(specular, 1.0, vh);
	return float4(spec, spec, spec, fresnel);
}

float3 ClearCoatShading(MaterialParam material, float nh, float nl, float vh, float nv, float roughness, float normalizeFactor, out float albedoScaling)
{
	float clearcoatRoughness = max(SmoothnessToRoughness(material.customDataA), 0.001);
	
	// ClearCoat layer has fixed IOR 1.5 (F0 = 0.04)
	float4 spec2 = SpecularBRDF_ClearCoat(nh, nl, vh, nv, clearcoatRoughness, 0.04, normalizeFactor);
	float clearCoatFresnel = spec2.a;
	float3 clearCoatSpecular = spec2.rgb;
	
	// Light that penetrates the clearcoat is attenuated by (1 - Fc)
	float attenuation = 1.0f - clearCoatFresnel;
	albedoScaling = attenuation * attenuation;
	
	float3 specBase = SpecularBRDF_GGX(nh, nl, vh, nv, roughness, material.specular, normalizeFactor);
	
	// Base specular is attenuated both on the way in and out. Clearcoat specular is added on top.
	return (specBase * albedoScaling) + clearCoatSpecular;
}

float3 SubsurfaceShading(MaterialParam material, float3 N, float3 L, float3 V)
{
	[branch]
	if (material.lightModel == SHADINGMODELID_SKIN || material.lightModel == SHADINGMODELID_SUBSURFACE)
	{
		float3 forwardSSS = SubsurfaceShadingPennerSkin(material, N, L);
		float3 transmittance = SubsurfaceTranslucency(material, N, L, V);
		return forwardSSS + transmittance;
	}
	else
		return 0;
}

float2x3 SurfaceEnergy(MaterialParam material, float3 N, float3 L, float3 V, float shadow, float normalizeFactor = 1.0)
{
	float nl = dot(N, L);
	if (nl <= 0.0f)
		return (float2x3)0;

	float3 H = normalize(V + L);

	float nh = saturate(dot(N, H));
	float vh = saturate(dot(V, H));
	float nv = abs(dot(N, V)) + 1e-5h;
	float lv = saturate(dot(L, V));

	float roughness = max(SmoothnessToRoughness(material.smoothness), 0.001);
	float occlusion = ComputeAmbientMicroOcclusion(nl, material.visibility) * shadow;

#if TOON_ENABLE
	float3 diffuse = 0;

	[branch]
	if (material.lightModel == SHADINGMODELID_CEL)
		diffuse = CelShading(nl, vh, nv, material.customDataB, material.specular, occlusion, roughness, material.customDataA);
	else if (material.lightModel == SHADINGMODELID_TONEBASED)
		diffuse = ToonBasedShading(nl, vh, nv, material.customDataB, material.specular, material.visibility * shadow, roughness, material.customDataA);
	else
		diffuse = BurleyBRDF(nl, nv, vh, roughness) * nl * occlusion;
#else
	float3 diffuse = BurleyBRDF(nl, nv, vh, roughness) * nl * occlusion;
#endif

	float3 specular = 0;
	float albedoScaling = 1.0f;

	[branch]
	if (material.lightModel == SHADINGMODELID_SKIN || material.lightModel == SHADINGMODELID_SUBSURFACE)
		specular = DualLobeSkinSpecular(nh, nl, vh, nv, roughness, material.specular, normalizeFactor);
	else if (material.lightModel == SHADINGMODELID_CLOTH)
		specular = ClothShading(material, nh, nl, vh, nv, roughness, normalizeFactor, albedoScaling);
	else if (material.lightModel == SHADINGMODELID_CLEAR_COAT)
		specular = ClearCoatShading(material, nh, nl, vh, nv, roughness, normalizeFactor, albedoScaling);
	else if (material.lightModel == SHADINGMODELID_GLASS)
		specular = SpecularBRDF_Blinn(nh, nl, vh, nv, material.smoothness, material.specular, normalizeFactor);
	else if (material.lightModel == SHADINGMODELID_ANISOTROPY)
		specular = SpecularBRDF_GGXAniso(N, H, nh, nl, vh, nv, material.specular, material.albedo, roughness, material.customDataA, material.customDataB, normalizeFactor);
	else
		specular = SpecularBRDF_GGX(nh, nl, vh, nv, roughness, material.specular, normalizeFactor);

	return float2x3(diffuse * albedoScaling, specular * nl * occlusion);
}

float4 SurfaceEnergy(MaterialParam material, float3 N, float3 Ld, float3 Ls, float3 V, float normalizeFactor = 1.0)
{
	float nl2 = dot(N, Ld);
	if (nl2 <= 0.0f)
		return (float4)0;

	float3 H = normalize(V + Ls);

	float nh  = saturate(dot(N, H));
	float nl  = saturate(dot(N, Ls));
	float vh  = saturate(dot(V, H));
	float nv  = abs(dot(N, V)) + 1e-5h;

	float roughness = max(SmoothnessToRoughness(material.smoothness), 0.001);
	float diffuse = DiffuseBRDF(N, Ld, V, roughness);
	float shadow = ComputeAmbientMicroOcclusion(nl2, material.visibility);

	float3 specular = 0;
	float albedoScaling = 1.0f;

	[branch]
	if (material.lightModel == SHADINGMODELID_SKIN || material.lightModel == SHADINGMODELID_SUBSURFACE)
		specular = DualLobeSkinSpecular(nh, nl, vh, nv, roughness, material.specular, normalizeFactor);
	else if (material.lightModel == SHADINGMODELID_CLOTH)
		specular = ClothShading(material, nh, nl, vh, nv, roughness, normalizeFactor, albedoScaling);
	else if (material.lightModel == SHADINGMODELID_CLEAR_COAT)
		specular = ClearCoatShading(material, nh, nl, vh, nv, roughness, normalizeFactor, albedoScaling);
	else if (material.lightModel == SHADINGMODELID_GLASS)
		specular = SpecularBRDF_Blinn(nh, nl, vh, nv, material.smoothness, material.specular, normalizeFactor);
	else if (material.lightModel == SHADINGMODELID_ANISOTROPY)
		specular = SpecularBRDF_GGXAniso(N, H, nh, nl, vh, nv, material.specular, material.albedo, roughness, material.customDataA, material.customDataB, normalizeFactor);
	else
		specular = SpecularBRDF_GGX(nh, nl, vh, nv, roughness, material.specular, normalizeFactor);

	return float4(diffuse * albedoScaling, specular) * nl2 * shadow;
}