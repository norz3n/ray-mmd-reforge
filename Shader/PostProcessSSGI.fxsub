////////////////////////////////////////////////////////////////////////////////////////////////
//
//  Screen-Space Global Illumination
//
////////////////////////////////////////////////////////////////////////////////////////////////

#if GI_QUALITY == 1
#	define SSGI_ANGLES 4
#	define SSGI_STEPS 4
#	define SSGI_RADIUS 4
#elif GI_QUALITY == 2
#	define SSGI_ANGLES 6
#	define SSGI_STEPS 4
#	define SSGI_RADIUS 6
#elif GI_QUALITY == 3
#	define SSGI_ANGLES 8
#	define SSGI_STEPS 4
#	define SSGI_RADIUS 6
#elif GI_QUALITY == 4
#	define SSGI_ANGLES 6
#	define SSGI_STEPS 8
#	define SSGI_RADIUS 8
#elif GI_QUALITY == 5
#	define SSGI_ANGLES 8
#	define SSGI_STEPS 8
#	define SSGI_RADIUS 8
#elif GI_QUALITY == 6
#	define SSGI_ANGLES 10
#	define SSGI_STEPS 10
#	define SSGI_RADIUS 10
#elif GI_QUALITY == 7
#	define SSGI_ANGLES 12
#	define SSGI_STEPS 10
#	define SSGI_RADIUS 12
#else
#	define SSGI_ANGLES 6
#	define SSGI_STEPS 5
#	define SSGI_RADIUS 6
#endif

float mSSGIIntensityPlus : CONTROLOBJECT < string name="ray_controller.pmx"; string item = "SSGI+"; >;
float mSSGIIntensityMinus : CONTROLOBJECT < string name="ray_controller.pmx"; string item = "SSGI-"; >;

inline float GetSSGILinearDepth(float2 uv)
{
	return tex2Dlod(Gbuffer8Map, float4(uv, 0, 0)).r;
}

inline float3 GetSSGINormal(float2 uv)
{
	return DecodeGBufferNormal(tex2Dlod(Gbuffer6Map, float4(uv, 0, 0)));
}

inline float ComputeThicknessWeight(float zDiff, float viewZ, float distance)
{
	float dynamicThickness = max(0.6f, 1.2f + viewZ * 0.02f + distance * 0.12f);
	float x = saturate(abs(zDiff) / dynamicThickness);
	return 1.0f - (x * x * (3.0f - 2.0f * x));
}

float4 SSGIPassPS(in float4 uvCoord : TEXCOORD0, in float3 viewDir : TEXCOORD1) : COLOR
{
	float zOrigin = GetSSGILinearDepth(uvCoord.xy);
	if (!(zOrigin > 0.0f && zOrigin < 1000.0f)) clip(-1);

	float4 projInfo = GetProjConstant();
	float3 nOrigin = GetSSGINormal(uvCoord.xy);
	float3 pOrigin = GetViewPosition(projInfo, uvCoord.xy, zOrigin);

	// World radius for large-scale / world-wide gather (scaled by mSSGIScale)
	float maxWorldDistance = max(mSSGIScale * 35.0f, 2.0f);
	
	// Perspective screen-space search radius in UV units
	float projScale = max(abs(projInfo.x), 1e-4f);
	float screenRadius = clamp(maxWorldDistance / (zOrigin * projScale), 0.01f, 0.6f);

	float2 screenPixel = uvCoord.xy * ViewportSize;
	float noiseAngle = InterleavedGradientNoise(screenPixel);
	float noiseRadius = frac(noiseAngle * 5.588238f + (screenPixel.x + screenPixel.y * 5.588238f) * 0.61803398875f);

	float startAngle = noiseAngle * PI_2;
	float stepOffset = noiseRadius;

	float3 totalGi = 0.0f;
	float minDistanceSq = max(mSSGIBias * mSSGIBias * 0.02f, 0.001f);
	
	[loop]
	for (int a = 0; a < SSGI_ANGLES; ++a)
	{
		float theta = (float(a) / float(SSGI_ANGLES)) * PI_2 + startAngle;
		float2 direction = float2(cos(theta), sin(theta));
		float rayJitter = frac(noiseRadius + float(a) * 0.61803398875f);

		float3 rayColor = 0.0f;
		float rayOcc = 0.0f;

		[loop]
		for (int s = 0; s < SSGI_STEPS; ++s)
		{
			// Staggered per-ray step progression completely dissolves concentric ring bands
			float stepProgress = (float(s) + rayJitter) / float(SSGI_STEPS);
			float stepDist = stepProgress * stepProgress;
			float2 currentUv = uvCoord.xy + direction * (screenRadius * stepDist);

			if (currentUv.x < 0.0f || currentUv.x > 1.0f || currentUv.y < 0.0f || currentUv.y > 1.0f) break;

			float zSample = GetSSGILinearDepth(currentUv);
			if (zSample > 0.0f && zSample < 1000.0f)
			{
				float3 pSample = GetViewPosition(projInfo, currentUv, zSample);
				float3 diff = pSample - pOrigin;
				float distSq = dot(diff, diff);
				
				// Reject self-sampling (bias check)
				if (distSq > minDistanceSq)
				{
					float dist = sqrt(distSq);
					float3 lightVector = diff / dist;
					
					// Receiver cosine factor
					float NdotL = dot(nOrigin, lightVector);
					if (NdotL > 0.0f)
					{
						int shadingModel = (int)floor(tex2Dlod(Gbuffer8Map, float4(currentUv, 0, 0)).a);
						bool isEmissive = (shadingModel == SHADINGMODELID_EMISSIVE);

						// Emitter cosine factor (sample must face the receiver, or be an active omnidirectional emissive light source)
						float3 nSample = GetSSGINormal(currentUv);
						float NsDotMinusL = dot(nSample, -lightVector);
						if (NsDotMinusL > -0.15f || isEmissive)
						{
							float geomFactor = saturate(NdotL) * (isEmissive ? 1.0f : saturate(NsDotMinusL * 0.85f + 0.15f));
							
							// Distance attenuation with smooth window cutoff & physical inverse falloff
							float distRatio = saturate(dist / maxWorldDistance);
							float fade = 1.0f - distRatio * distRatio;
						#if GI_ENABLE >= 2
							// Mode 2 (Indirect Lighting): Wider reach across the room for UE5-style indirect diffuse bounce
							float falloffRate = isEmissive ? 0.05f : 0.16f;
						#else
							// Mode 1 (Accent): Focused local bounce & emissive accents
							float falloffRate = isEmissive ? 0.08f : 0.35f;
						#endif
							float invDistFalloff = 1.0f / (1.0f + dist * falloffRate);
							float atten = (fade * fade) * invDistFalloff;
							
							// Thickness visibility weighting
							float thickWeight = isEmissive ? 1.0f : ComputeThicknessWeight(pSample.z - pOrigin.z, pOrigin.z, dist);
							float w = saturate(geomFactor * atten * thickWeight);
							
							if (w > 1e-3f)
							{
								float3 sampleColor = tex2Dlod(ShadingMapSamp, float4(currentUv, 0, 0)).rgb;
								sampleColor = clamp(sampleColor, 0.0f, 100.0f);
								
								if (isEmissive)
								{
									sampleColor *= 4.0f;
								}
								
								// Front-to-back ray accumulation
								float hitFactor = w * (1.0f - rayOcc);
								rayColor += sampleColor * hitFactor;
								rayOcc += hitFactor;
								
								if (rayOcc > 0.95f) break;
							}
						}
					}
				}
			}
		}
		
		totalGi += rayColor;
	}

	float intensityMultiplier = lerp(lerp(1.0f, 3.0f, mSSGIIntensityPlus), 0.0f, mSSGIIntensityMinus);
#if GI_ENABLE >= 2
	float modeMultiplier = 2.4f; // Strong room-filling indirect bounce for Mode 2 (UE5 Indirect)
#else
	float modeMultiplier = 1.0f; // Subtle accent bounce for Mode 1 (Accent)
#endif
	float3 finalGi = (totalGi / float(SSGI_ANGLES)) * (PI * intensityMultiplier * modeMultiplier);
	
	return float4(clamp(finalGi, 0.0f, 100.0f), 1.0f);
}

float4 SSGIBlurPS(in float2 uvCoord : TEXCOORD0, in float3 viewDir : TEXCOORD1, uniform sampler source, uniform float stepSize) : COLOR
{
	float zCenter = GetSSGILinearDepth(uvCoord);
	if (!(zCenter > 0.0f && zCenter < 1000.0f)) return float4(0, 0, 0, 0);

	float4 projInfo = GetProjConstant();
	float3 nCenter = GetSSGINormal(uvCoord);
	float3 pCenter = GetViewPosition(projInfo, uvCoord, zCenter);

	float4 cCenter = tex2Dlod(source, float4(uvCoord, 0, 0));
	cCenter = clamp(cCenter, 0.0f, 100.0f);
	
	float2 blurDir = stepSize < 2.0f ? float2(ViewportOffset2.x, 0.0f) : float2(0.0f, ViewportOffset2.y);
	float planeThreshold = max(zCenter * 0.04f, 0.25f);
	
	float totalW = 1.0f;
	float4 totalC = cCenter;

	[unroll]
	for (int i = 1; i <= SSGI_RADIUS; ++i)
	{
		float2 shift = blurDir * (float)i;
		float2 uvA = uvCoord + shift;
		float2 uvB = uvCoord - shift;

		float zA = GetSSGILinearDepth(uvA);
		float zB = GetSSGILinearDepth(uvB);
		zA = (zA > 0.0f && zA < 1000.0f) ? zA : (zCenter + 10000.0f);
		zB = (zB > 0.0f && zB < 1000.0f) ? zB : (zCenter + 10000.0f);

		float3 pA = GetViewPosition(projInfo, uvA, zA);
		float3 pB = GetViewPosition(projInfo, uvB, zB);

		float planeDistA = abs(dot(nCenter, pA - pCenter));
		float planeDistB = abs(dot(nCenter, pB - pCenter));

		float depthWeightA = saturate(1.0f - planeDistA / planeThreshold);
		float depthWeightB = saturate(1.0f - planeDistB / planeThreshold);

		float3 nA = GetSSGINormal(uvA);
		float3 nB = GetSSGINormal(uvB);

		float normalWeightA = saturate(dot(nA, nCenter));
		float normalWeightB = saturate(dot(nB, nCenter));

		float spatialWeight = exp(-i * i * 0.025f);

		float wA = spatialWeight * depthWeightA * (normalWeightA * normalWeightA);
		float wB = spatialWeight * depthWeightB * (normalWeightB * normalWeightB);

		totalC += clamp(tex2Dlod(source, float4(uvA, 0, 0)), 0.0f, 100.0f) * wA;
		totalC += clamp(tex2Dlod(source, float4(uvB, 0, 0)), 0.0f, 100.0f) * wB;
		totalW += wA + wB;
	}

	return clamp(totalC / max(totalW, 1e-5f), 0.0f, 100.0f);
}

float4 SSGIFinalCombinePS(in float2 uvCoord : TEXCOORD0, in float3 viewDir : TEXCOORD1) : COLOR
{
	MaterialParam mat;
	DecodeGbuffer(tex2Dlod(Gbuffer5Map, float4(uvCoord, 0, 0)), tex2Dlod(Gbuffer6Map, float4(uvCoord, 0, 0)), tex2Dlod(Gbuffer7Map, float4(uvCoord, 0, 0)), tex2Dlod(Gbuffer8Map, float4(uvCoord, 0, 0)), mat);

	float3 rawGi = tex2Dlod(SSGIMapSamp, float4(uvCoord, 0, 0)).rgb;
	rawGi = clamp(rawGi, 0.0f, 100.0f);
	
#if SSDO_QUALITY > 0
	float occlusion = min((mat.lightModel == SHADINGMODELID_GLASS) ? 1.0f : tex2Dlod(SSDOMapSamp, float4(uvCoord, 0, 0)).w, mat.visibility);
#else
	float occlusion = mat.visibility;
#endif

	float3 camDir = normalize(viewDir);
	float NdV = saturate(dot(mat.normal, camDir));
	
	[branch]
	if (mat.lightModel == SHADINGMODELID_SKIN || mat.lightModel == SHADINGMODELID_SUBSURFACE)
	{
		rawGi *= mat.albedo;
	}
	else if (mat.lightModel == SHADINGMODELID_GLASS)
	{
		rawGi *= max(0.02f, mat.albedo) * (1.0f - saturate(pow(1.0f - NdV, 5.0f))) * mat.alpha;
	}
	else if (mat.lightModel == SHADINGMODELID_CLOTH)
	{
		rawGi *= mat.albedo + mat.customDataB * (pow(1.0f - NdV, 4.0f) * mat.customDataA);
	}
	else if (mat.lightModel == SHADINGMODELID_CLEAR_COAT)
	{
		rawGi *= mat.albedo * (1.0f - mat.customDataA * (0.04f + 0.96f * pow(1.0f - NdV, 5.0f)));
	}
	else if (mat.lightModel == SHADINGMODELID_CEL || mat.lightModel == SHADINGMODELID_TONEBASED)
	{
		float luma = dot(rawGi, float3(0.299f, 0.587f, 0.114f));
		rawGi = (luma > 1e-4f) ? rawGi * ((floor(luma * 4.0f + 0.5f) / 4.0f) / max(luma, 1e-4f)) * mat.albedo : rawGi * mat.albedo;
	}
	else
	{
		rawGi *= mat.albedo;
	}

#if GI_ENABLE >= 2
	// UE5 Lumen Multi-Bounce Diffuse Radiance (Jimenez multi-scattering approximation)
	// Compensates for secondary and tertiary ambient bounces between surfaces, filling shadows with rich colored light
	float3 multiBounce = 1.0f + (mat.albedo * 1.5f) / max(1.0f - mat.albedo * 0.7f, 0.15f);
	rawGi *= multiBounce;
	return float4(clamp(rawGi * mSSGIIntensity * lerp(occlusion, 1.0f, 0.45f), 0.0f, 100.0f), 0.0f);
#else
	return float4(clamp(rawGi * mSSGIIntensity * occlusion, 0.0f, 100.0f), 0.0f);
#endif
}
