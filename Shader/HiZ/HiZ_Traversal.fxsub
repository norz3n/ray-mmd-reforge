/**
 * Ray-MMD ReForge: Hierarchical Z-Buffer (Hi-Z) Ray Traversal Engine
 *
 * Module: HiZ_Traversal.fxsub
 * Independent screen-space hierarchical ray traversal implementation.
 * Based on published techniques (Uludag 2014, McGuire 2014, Karis 2013).
 */

#ifndef RAY_MMD_HIZ_TRAVERSAL_FXSUB
#define RAY_MMD_HIZ_TRAVERSAL_FXSUB

// NOTE: MME resolves #include relative to the main .fx file, not this .fxsub,
// so this module does not include HiZ_Common.fxsub itself — the consumer must
// include HiZ_Common.fxsub (root-relative "shader/HiZ/" or "../../../shader/HiZ/")
// before this file. HiZ_Main.fxsub establishes that order.

static const int kMaxMipLevel = 9;

/**
 * Result structure containing rich geometric and confidence metrics for screen-space ray hits.
 */
struct HiZTraceResult
{
	bool isHit;
	float hitProgress;
	float2 hitUV;
	float3 hitPosVS;
	float depthError;
	int hitMip;
	float confidence;
};

/**
 * Samples conservative minimum scene linear depth from the Hi-Z pyramid at mip level k.
 * Uses constant lookup tables for branch-free atlas offset and dimension resolution.
 *
 * @param uv Normalized viewport coordinates [0, 1].
 * @param level Hierarchy mip level (0 = full-res GBuffer, 1..10 = downsampled levels).
 * @return Conservative minimum linear view-space depth.
 */
float HiZ_SampleDepthAtMip(float2 uv, int level)
{
	if (level <= 0)
	{
		return tex2Dlod(Gbuffer8Map, float4(uv, 0.0f, 0.0f)).r;
	}
	else if (level == 1)
	{
		float2 cellCoord = (floor(uv * kHiZMip1Size) + 0.5f) / kHiZMip1Size;
		return tex2Dlod(ZBufferMipmap1Samp, float4(cellCoord, 0.0f, 0.0f)).r;
	}

	// Branch-free atlas lookup via constant array
	float2 levelSize = kAllMipDimensions[level];
	float2 atlasOffset = kAtlasOffsets[level];
	float2 sampleUV = (floor(uv * levelSize) + 0.5f) / ViewportSize + atlasOffset;
	return tex2Dlod(ZBufferMipmapSamp, float4(sampleUV, 0.0f, 0.0f)).r;
}

/**
 * Reconstructs linear view-space depth from a screen-space NDC z coordinate.
 */
inline float HiZ_RayLinearZ(float ndcZ)
{
	float projDenom = ndcZ - matProject[2][2];
	projDenom = abs(projDenom) < 1e-7f ? sign(projDenom) * 1e-7f : projDenom;
	return matProject[3][2] / projDenom;
}

/**
 * Confirms a hit at mip 0 or advances the ray past the current cell.
 *
 * @param rayLinearZ Linear view-space depth of the ray at the test point.
 * @param minSceneLinearZ Conservative minimum scene depth of the current cell.
 * @param tNext Parametric t just past the current cell boundary.
 * @param hitSS Screen-space position of the candidate hit.
 * @return True when a hit was confirmed (traversal must break).
 */
bool HiZ_ConfirmOrAdvance(
	float rayLinearZ,
	float minSceneLinearZ,
	float negTolerance,
	float surfaceThickness,
	float tCurrent,
	float tNext,
	float3 hitSS,
	inout float currentT,
	inout int currentMip,
	inout HiZTraceResult result)
{
	if (currentMip == 0)
	{
		float depthDiff = rayLinearZ - minSceneLinearZ;
		float maxAllowedThickness = surfaceThickness * (1.2f + minSceneLinearZ * 0.035f);
		if (depthDiff >= negTolerance && depthDiff <= maxAllowedThickness)
		{
			result.isHit = true;
			result.hitProgress = tCurrent;
			result.hitUV = hitSS.xy;
			result.depthError = max(depthDiff, 0.0f);
			result.hitMip = 0;
			float penetration = max(depthDiff, 0.0f) / max(maxAllowedThickness, 1e-4f);
			result.confidence = pow2(saturate(1.0f - penetration));
			return true;
		}

		currentT = tNext;
		currentMip = min(currentMip + 1, kMaxMipLevel);
	}
	else
	{
		--currentMip;
	}
	return false;
}

/**
 * Computes parametric distance t along the ray to the exit boundary plane of the current 2D cell.
 *
 * @param startSS Ray origin in normalized screen space [0, 1].
 * @param rayDelta Ray total direction/extent vector in screen space.
 * @param cellCoord Integer coordinate of the cell within the mip grid.
 * @param mipDim Grid resolution at the current mip level.
 * @param stepSign Component-wise march direction (+1 or -1).
 * @return Parametric progress t at which ray leaves the 2D cell.
 */
float IntersectCellBoundary(float3 begin, float3 delta, float2 cellId, float2 levelSize, float2 crossStep, float2 crossOffset) 
{
	float2 cell = (cellId + crossStep) / levelSize + crossOffset;
	float kx = cell.x - begin.x;
	float ky = cell.y - begin.y;
	float k = 0.0f;

	float ax = abs(delta.x);
	float ay = abs(delta.y);

	[flatten]
	if (ax <= 1e-5f && ay > 1e-5f)
		k = ky / delta.y;
	else if (ax > 1e-5f && ay <= 1e-5f)
		k = kx / delta.x;
	else if (ax > 1e-5f && ay > 1e-5f)
		k = min(kx / delta.x, ky / delta.y);

	return k;
}

/**
 * Hierarchical Screen-Space Raymarcher.
 * Traverses conservative Hi-Z pyramid using multi-level cell stepping and depth confirmation.
 *
 * @param maxIterations Traversal loop iteration bound.
 * @param startMip Initial mip level to start ray traversal.
 * @param startPosVS Ray origin in view space.
 * @param rayDirVS Normalized ray direction in view space.
 * @param maxTraceDist Maximum trace distance in view units.
 * @param normalBias Normal-offset bias to eliminate self-intersection.
 * @param surfaceThickness Allowed geometric thickness interval for positive hit confirmation.
 * @return Structured trace result containing hit status, coordinates, and error metrics.
 */
HiZTraceResult HiZ_TraceRayDetailed(
	int maxIterations,
	int startMip,
	float3 startPosVS,
	float3 rayDirVS,
	float maxTraceDist,
	float normalBias,
	float surfaceThickness)
{
	HiZTraceResult result;
	result.isHit = false;
	result.hitProgress = 0.0f;
	result.hitUV = 0.0f;
	result.hitPosVS = 0.0f;
	result.depthError = 0.0f;
	result.hitMip = 0;
	result.confidence = 0.0f;

	// Clip ray against near camera plane in view-space to eliminate homogeneous division artifacts (W <= 0)
	float effectiveTraceDist = maxTraceDist;
	static const float kRayNearPlaneZ = 0.05f;
	if (rayDirVS.z < -1e-6f)
	{
		float maxDistToNear = (kRayNearPlaneZ - startPosVS.z) / rayDirVS.z;
		if (maxDistToNear > 0.0f)
			effectiveTraceDist = min(effectiveTraceDist, maxDistToNear);
	}

	// Project view-space ray endpoints into normalized screen space [0, 1]
	float4 startClip = mul(float4(startPosVS, 1.0f), matProject);
	float3 startSS = (startClip.xyz / max(startClip.w, 1e-4f)) * float3(0.5f, -0.5f, 1.0f) + float3(0.5f, 0.5f, 0.0f);

	float4 endClip = mul(float4(startPosVS + rayDirVS * effectiveTraceDist, 1.0f), matProject);
	float3 endSS = (endClip.xyz / max(endClip.w, 1e-4f)) * float3(0.5f, -0.5f, 1.0f) + float3(0.5f, 0.5f, 0.0f);

	float3 begin = startSS;
	float3 end = endSS;
	float3 delta = end - begin;
	float k = 0.0f;

	float2 crossStep = sign(delta.xy);
	float2 crossOffset = crossStep * (0.005f / ViewportSize);
	crossStep = saturate(crossStep);

	int level = 0;
	static const int maxLevel = 9;

	[loop]
	for (int it = 0; it < maxIterations && level >= 0 && k < 1.0f; ++it)
	{
		float3 ray = begin + k * delta;
		if (any(floor(ray.xy) != 0.0f)) break;

		float2 levelSize = ViewportSize / exp2(level);
		int2 cellId = floor(ray.xy * levelSize);

		float linearZ = matProject[3][2] / (ray.z - matProject[2][2]);
		float linearMinZ = HiZ_SampleDepthAtMip(ray.xy, level);
		float minZ = matProject[2][2] + matProject[3][2] / linearMinZ;
		float t = k;

		if (delta.z > 0.0f)
		{
			float deltaZ = minZ - ray.z;
			t = (deltaZ > 0.0f) ? (t + deltaZ / delta.z) : t;

			float3 temp = begin + t * delta;
			int2 newCellId = floor(temp.xy * levelSize);

			if (cellId.x != newCellId.x || cellId.y != newCellId.y)
			{
				t = IntersectCellBoundary(begin, delta, cellId, levelSize, crossStep, crossOffset);
				level += 2;
			}
			else
			{
				if (level <= 1 && abs(linearZ - linearMinZ) >= surfaceThickness)
				{
					t = IntersectCellBoundary(begin, delta, cellId, levelSize, crossStep, crossOffset);
					level += 1;
				}
			}
		}
		else if (ray.z < minZ)
		{
			t = IntersectCellBoundary(begin, delta, cellId, levelSize, crossStep, crossOffset);
			level += 2;
		}

		k = t;
		--level;
		level = min(maxLevel, level);
	}

	if (level < 0)
	{
		result.isHit = true;
		result.hitProgress = k;
		float3 hitSS = begin + k * delta;
		result.hitUV = hitSS.xy;
		result.hitMip = 0;
		result.confidence = 1.0f;

		float3 hitNDC = (hitSS - float3(0.5f, 0.5f, 0.0f)) * float3(2.0f, -2.0f, 1.0f);
		float4 hitClip = float4(0.0f, 0.0f, 0.0f, matProject[3][2] / (hitNDC.z - matProject[2][2]));
		hitClip.xyz = hitNDC * hitClip.w;
		result.hitPosVS = mul(hitClip, matProjectInverse).xyz;
	}

	return result;
}

/**
 * HiZ_TraceRay legacy-compatible interface.
 *
 * @param maxIterations Traversal loop bound.
 * @param startPosVS Ray starting position in view space.
 * @param rayDirVS Unit ray direction in view space.
 * @param maxTraceDist Maximum ray travel distance in view units.
 * @param traceConfig 3D vector: (x = normal bias offset, y = surface thickness, z = unused).
 * @param hitProgress Output parametric progress t in [0, 1].
 * @param hitUV Output screen-space texture coordinates of intersection.
 * @param hitPosVS Output view-space coordinates of intersection.
 * @return True if valid geometric intersection within thickness was found.
 */
bool HiZ_TraceRay(
	int maxIterations,
	float3 startPosVS,
	float3 rayDirVS,
	float maxTraceDist,
	float3 traceConfig,
	out float hitProgress,
	out float2 hitUV,
	out float3 hitPosVS)
{
	HiZTraceResult res = HiZ_TraceRayDetailed(maxIterations, 0, startPosVS, rayDirVS, maxTraceDist, traceConfig.x, traceConfig.y);
	hitProgress = res.hitProgress;
	hitUV = res.hitUV;
	hitPosVS = res.hitPosVS;
	return res.isHit;
}

/**
 * HiZ_TraceRay convenience overload (without progress t).
 */
bool HiZ_TraceRay(
	int maxIterations,
	float3 startPosVS,
	float3 rayDirVS,
	float maxTraceDist,
	float3 traceConfig,
	out float2 hitUV,
	out float3 hitPosVS)
{
	float hitT = 0.0f;
	return HiZ_TraceRay(maxIterations, startPosVS, rayDirVS, maxTraceDist, traceConfig, hitT, hitUV, hitPosVS);
}

/**
 * HiZ_TraceRay convenience overload (UV only).
 */
bool HiZ_TraceRay(
	int maxIterations,
	float3 startPosVS,
	float3 rayDirVS,
	float maxTraceDist,
	float3 traceConfig,
	out float2 hitUV)
{
	float3 hitPosVS = 0.0f;
	return HiZ_TraceRay(maxIterations, startPosVS, rayDirVS, maxTraceDist, traceConfig, hitUV, hitPosVS);
}

#endif // RAY_MMD_HIZ_TRAVERSAL_FXSUB
