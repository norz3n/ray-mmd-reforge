/**
 * Ray-MMD ReForge: Hierarchical Z-Buffer (Hi-Z) Conservative Pyramid Construction
 *
 * Module: HiZ_Build.fxsub
 * Conservative minimum-depth hierarchy builder.
 * Builds conservative minimum-depth mip pyramid via 2x2 box reduction (Uludag 2014, McGuire 2014).
 */

#ifndef RAY_MMD_HIZ_BUILD_FXSUB
#define RAY_MMD_HIZ_BUILD_FXSUB

#include "shader/HiZ/HiZ_Common.fxsub"

/**
 * Builds Mip Level 1 from full-resolution linear view depth.
 */
float4 HiZ_BuildMip1_PS(in float2 pos : VPOS, in float2 coord : TEXCOORD0, uniform sampler source) : COLOR
{
	float2 offset = ViewportOffset * 0.5f;

	float d00 = tex2Dlod(source, float4(coord + float2(-offset.x, -offset.y), 0.0f, 0.0f)).r;
	float d01 = tex2Dlod(source, float4(coord + float2(-offset.x,  offset.y), 0.0f, 0.0f)).r;
	float d10 = tex2Dlod(source, float4(coord + float2( offset.x, -offset.y), 0.0f, 0.0f)).r;
	float d11 = tex2Dlod(source, float4(coord + float2( offset.x,  offset.y), 0.0f, 0.0f)).r;

	float minDepth = min(min(d00, d01), min(d10, d11));
	return float4(minDepth, minDepth, minDepth, 1.0f);
}

/**
 * Recursively downsamples Level (N-1) to Level N using conservative 4-tap min reduction.
 */
float4 HiZ_BuildMipN_PS(
	in float2 pos : VPOS,
	in float2 coord : TEXCOORD0,
	uniform sampler source,
	uniform float2 targetLevelSize,
	uniform float2 sourceLevelSize) : COLOR
{
	float2 offset = 0.5f / sourceLevelSize;

	float d00 = tex2Dlod(source, float4(coord + float2(-offset.x, -offset.y), 0.0f, 0.0f)).r;
	float d01 = tex2Dlod(source, float4(coord + float2(-offset.x,  offset.y), 0.0f, 0.0f)).r;
	float d10 = tex2Dlod(source, float4(coord + float2( offset.x, -offset.y), 0.0f, 0.0f)).r;
	float d11 = tex2Dlod(source, float4(coord + float2( offset.x,  offset.y), 0.0f, 0.0f)).r;

	float minDepth = min(min(d00, d01), min(d10, d11));
	return float4(minDepth, minDepth, minDepth, 1.0f);
}

/**
 * Checks whether UV coordinate lies inside a 2D bounding rectangle [x, y, width, height].
 */
inline bool HiZ_IsInsideRect(float2 uv, float4 rect)
{
	return (uv.x >= rect.x && uv.x < (rect.x + rect.z) &&
	        uv.y >= rect.y && uv.y < (rect.y + rect.w));
}

/**
 * Consolidates Mip levels 2 through 10 into a unified depth atlas.
 */
float4 HiZ_CombineAtlas_PS(in float2 coord : TEXCOORD0) : COLOR
{
	float depthValue = 0.0f;

	[flatten]
	if (HiZ_IsInsideRect(coord, kAtlasMip2Rect))
		depthValue = tex2Dlod(ZBufferMipmap2Samp, float4((coord - kAtlasMip2Rect.xy) / kAtlasMip2Rect.zw, 0.0f, 0.0f)).r;
	else if (HiZ_IsInsideRect(coord, kAtlasMip3Rect))
		depthValue = tex2Dlod(ZBufferMipmap3Samp, float4((coord - kAtlasMip3Rect.xy) / kAtlasMip3Rect.zw, 0.0f, 0.0f)).r;
	else if (HiZ_IsInsideRect(coord, kAtlasMip4Rect))
		depthValue = tex2Dlod(ZBufferMipmap4Samp, float4((coord - kAtlasMip4Rect.xy) / kAtlasMip4Rect.zw, 0.0f, 0.0f)).r;
	else if (HiZ_IsInsideRect(coord, kAtlasMip5Rect))
		depthValue = tex2Dlod(ZBufferMipmap5Samp, float4((coord - kAtlasMip5Rect.xy) / kAtlasMip5Rect.zw, 0.0f, 0.0f)).r;
	else if (HiZ_IsInsideRect(coord, kAtlasMip6Rect))
		depthValue = tex2Dlod(ZBufferMipmap6Samp, float4((coord - kAtlasMip6Rect.xy) / kAtlasMip6Rect.zw, 0.0f, 0.0f)).r;
	else if (HiZ_IsInsideRect(coord, kAtlasMip7Rect))
		depthValue = tex2Dlod(ZBufferMipmap7Samp, float4((coord - kAtlasMip7Rect.xy) / kAtlasMip7Rect.zw, 0.0f, 0.0f)).r;
	else if (HiZ_IsInsideRect(coord, kAtlasMip8Rect))
		depthValue = tex2Dlod(ZBufferMipmap8Samp, float4((coord - kAtlasMip8Rect.xy) / kAtlasMip8Rect.zw, 0.0f, 0.0f)).r;
	else if (HiZ_IsInsideRect(coord, kAtlasMip9Rect))
		depthValue = tex2Dlod(ZBufferMipmap9Samp, float4((coord - kAtlasMip9Rect.xy) / kAtlasMip9Rect.zw, 0.0f, 0.0f)).r;
	else if (HiZ_IsInsideRect(coord, kAtlasMip10Rect))
		depthValue = tex2Dlod(ZBufferMipmap10Samp, float4((coord - kAtlasMip10Rect.xy) / kAtlasMip10Rect.zw, 0.0f, 0.0f)).r;

	return float4(depthValue, depthValue, depthValue, 1.0f);
}

#endif // RAY_MMD_HIZ_BUILD_FXSUB
