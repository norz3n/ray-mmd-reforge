#ifndef CONTACT_QUALITY
#	ifdef CONTACT_SHADOW_QUALITY
#		define CONTACT_QUALITY CONTACT_SHADOW_QUALITY
#	else
#		define CONTACT_QUALITY 2
#	endif
#endif

#if CONTACT_QUALITY == 1
#	define CONTACT_SAMPLER_COUNT 32
#elif CONTACT_QUALITY == 2
#	define CONTACT_SAMPLER_COUNT 64
#elif CONTACT_QUALITY >= 3
#	define CONTACT_SAMPLER_COUNT 128
#else
#	define CONTACT_SAMPLER_COUNT 32
#endif

texture ConstantShadowMap : RENDERCOLORTARGET<float2 ViewportRatio = {1.0, 1.0}; string Format = "L8";>;
sampler ConstantShadowMapSamp = sampler_state 
{ 
	texture = <ConstantShadowMap>; 
	MinFilter = LINEAR; MagFilter = LINEAR; MipFilter = NONE; 
	AddressU = CLAMP; AddressV = CLAMP;
};

float TraceScreenSpaceShadow(float3 viewPos, float3 shadingNormal, float3 lightDirVS, float maxDistance, float jitter)
{
	float nDotL = dot(shadingNormal, lightDirVS);
	if (nDotL <= 0.0f) return 1.0f;
	
	float terminatorFade = smoothstep(0.0f, 0.15f, nDotL);

	float slopeScale = 1.0f - saturate(nDotL);
	float appliedBias = 0.05f + (0.05f * slopeScale * 4.0f);
	viewPos += shadingNormal * appliedBias;

	float rayStep = 1.0f / (float)CONTACT_SAMPLER_COUNT;
	// Use a constant 0.5f offset instead of noisy jitter for smooth results with SMAA
	float raySampleTime = rayStep * 1.5f;

	float4 rayStartClip = mul(float4(viewPos, 1.0f), matProject);
	float4 rayEndClip = mul(float4(viewPos + lightDirVS * maxDistance, 1.0f), matProject);

	float2 rayStartUV = rayStartClip.xy / rayStartClip.w * float2(0.5f, -0.5f) + 0.5f;
	float2 rayEndUV = rayEndClip.xy / rayEndClip.w * float2(0.5f, -0.5f) + 0.5f;
	
	float3 rayStartUVz = float3(rayStartUV, viewPos.z);
	float3 rayStepUVz = float3(rayEndUV - rayStartUV, (viewPos + lightDirVS * maxDistance).z - viewPos.z);

	float compareTolerance = maxDistance * rayStep * 2.0f;
	float firstHitTime = -1.0f;

	[loop]
	for (int i = 0; i < CONTACT_SAMPLER_COUNT; i++)
	{
		float3 sampleUVz = rayStartUVz + rayStepUVz * raySampleTime;

		if (sampleUVz.x < 0.0f || sampleUVz.x > 1.0f || sampleUVz.y < 0.0f || sampleUVz.y > 1.0f) {
			break;
		}

		float rawDepth = tex2Dlod(Gbuffer8Map, float4(sampleUVz.xy, 0, 0)).r;
		float sampleDepthVS = abs(rawDepth);
		float sampleDepthDiff = sampleDepthVS - sampleUVz.z;

		bool hit = abs(sampleDepthDiff + compareTolerance) < compareTolerance;

		if (hit)
		{
			firstHitTime = raySampleTime;
			break;
		}
		
		raySampleTime += rayStep;
	}

	float occlusion = 0.0f;
	if (firstHitTime >= 0.0f)
	{
		// Fade out based on distance to simulate soft shadow (penumbra)
		float fade = saturate(1.0f - firstHitTime * 1.5f);
		occlusion = fade * fade;
	}

	return 1.0f - occlusion * terminatorFade;
}

float4 ConstantShadowPS(in float4 coord : TEXCOORD0, in float3 viewdir : TEXCOORD1) : COLOR 
{
	float4 MRT0 = tex2Dlod(Gbuffer5Map, float4(coord.xy, 0, 0));
	float4 MRT1 = tex2Dlod(Gbuffer6Map, float4(coord.xy, 0, 0));
	float4 MRT2 = tex2Dlod(Gbuffer7Map, float4(coord.xy, 0, 0));
	float4 MRT3 = tex2Dlod(Gbuffer8Map, float4(coord.xy, 0, 0));

	MaterialParam material;
	DecodeGbuffer(MRT0, MRT1, MRT2, MRT3, material);

	clip(material.visibility - 1e-5);

	float3 view = normalize(viewdir);
	float3 viewPosition = view * material.linearDepth / view.z;
	float3 L = mul(-SunDirection, (float3x3)matView);

	float sampleDistance = 0.1;
	sampleDistance *= material.linearDepth;

	return TraceScreenSpaceShadow(viewPosition, material.normal, L, sampleDistance, InterleavedGradientNoise(coord.zw * ViewportSize));
}

float GetContactShadow(float3 viewPosition, float3 shadingNormal, float3 L, float2 screenCoord, float linearDepth)
{
	float sampleDistance = 0.05 * min(linearDepth, 50.0);
	float jitter = InterleavedGradientNoise(screenCoord * ViewportSize);
	float shadow = TraceScreenSpaceShadow(viewPosition, shadingNormal, L, sampleDistance, jitter);
	float fade = saturate(1.0 - linearDepth / 300.0);
	return lerp(1.0, shadow, fade);
}