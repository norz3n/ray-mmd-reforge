#ifndef CONTACT_QUALITY
#	ifdef CONTACT_SHADOW_QUALITY
#		define CONTACT_QUALITY CONTACT_SHADOW_QUALITY
#	else
#		define CONTACT_QUALITY 2
#	endif
#endif

#if CONTACT_QUALITY == 1
#	define CONTACT_SAMPLER_COUNT 32
#elif CONTACT_QUALITY == 2
#	define CONTACT_SAMPLER_COUNT 64
#elif CONTACT_QUALITY >= 3
#	define CONTACT_SAMPLER_COUNT 128
#else
#	define CONTACT_SAMPLER_COUNT 32
#endif

texture ConstantShadowMap : RENDERCOLORTARGET<float2 ViewportRatio = {1.0, 1.0}; string Format = "L8";>;
sampler ConstantShadowMapSamp = sampler_state 
{ 
	texture = <ConstantShadowMap>; 
	MinFilter = LINEAR; MagFilter = LINEAR; MipFilter = NONE; 
	AddressU = CLAMP; AddressV = CLAMP;
};

bool TraceScreenSpaceShadow(float3 viewPosition, float3 L, float maxDistance, float jitter)
{
	float4 startPosition = float4(viewPosition, 1);
	float4 startScreenPos = mul(startPosition, matProject);

	float4 endPosition = float4(viewPosition + L * maxDistance, 1);
	float4 endScreenPos = mul(endPosition, matProject);

	// ponytail: early discard for rays extending beyond screen boundaries
	float2 borderCheck = abs(endScreenPos.xy / max(1e-5, endScreenPos.w) * 2.0 - 1.0) - 1.0;
	if (borderCheck.x > 0.0 || borderCheck.y > 0.0)
		return 1;

	startScreenPos.xy = startScreenPos.xy * float2(0.5, -0.5) + 0.5 * startScreenPos.w;
	endScreenPos.xy = endScreenPos.xy * float2(0.5, -0.5) + 0.5 * endScreenPos.w;

	float4 deltaScreenPos = endScreenPos - startScreenPos;

	float stepSize = 1.0 / CONTACT_SAMPLER_COUNT;
	float stepLength = jitter * stepSize + stepSize;

	float bestLen = 0;
	float compareTolerance = maxDistance / (CONTACT_SAMPLER_COUNT * 2.0);

	float4 sampleStep = deltaScreenPos * stepSize;
	float4 curPos = startScreenPos + deltaScreenPos * stepLength;

	// ponytail: iterative vector addition replaces expensive 4D matrix/vector multiplies per step
	[loop]
	for (int i = 0; i < CONTACT_SAMPLER_COUNT; i += 4)
	{
		float4 samplePos1 = curPos;
		float4 samplePos2 = curPos + sampleStep;
		float4 samplePos3 = curPos + sampleStep * 2;
		float4 samplePos4 = curPos + sampleStep * 3;
		float4 samplePosZ = float4(samplePos1.w, samplePos2.w, samplePos3.w, samplePos4.w);

		float4 sampleDepth;
		sampleDepth.r = tex2Dlod(Gbuffer8Map, float4(samplePos1.xy / samplePos1.w, 0, 0)).r;
		sampleDepth.g = tex2Dlod(Gbuffer8Map, float4(samplePos2.xy / samplePos2.w, 0, 0)).r;
		sampleDepth.b = tex2Dlod(Gbuffer8Map, float4(samplePos3.xy / samplePos3.w, 0, 0)).r;
		sampleDepth.a = tex2Dlod(Gbuffer8Map, float4(samplePos4.xy / samplePos4.w, 0, 0)).r;

		float4 depthDiff = samplePosZ - abs(sampleDepth);

		bool4 hit = abs(depthDiff + compareTolerance) < compareTolerance;
		if (any(hit))
		{
			bestLen = 1;
			break;
		}

		curPos += sampleStep * 4;
	}

	return bestLen > 0 ? 0 : 1;
}

float4 ConstantShadowPS(in float4 coord : TEXCOORD0, in float3 viewdir : TEXCOORD1) : COLOR 
{
	float4 MRT0 = tex2Dlod(Gbuffer5Map, float4(coord.xy, 0, 0));
	float4 MRT1 = tex2Dlod(Gbuffer6Map, float4(coord.xy, 0, 0));
	float4 MRT2 = tex2Dlod(Gbuffer7Map, float4(coord.xy, 0, 0));
	float4 MRT3 = tex2Dlod(Gbuffer8Map, float4(coord.xy, 0, 0));

	MaterialParam material;
	DecodeGbuffer(MRT0, MRT1, MRT2, MRT3, material);

	clip(material.visibility - 1e-5);

	float3 view = normalize(viewdir);
	float3 viewPosition = view * material.linearDepth / view.z;
	float3 L = mul(-SunDirection, (float3x3)matView);

	float sampleDistance = 0.1;
	sampleDistance *= material.linearDepth;

	return TraceScreenSpaceShadow(viewPosition, L, sampleDistance, InterleavedGradientNoise(coord.zw * ViewportSize));
}

float GetContactShadow(float3 viewPosition, float3 L, float2 screenCoord, float linearDepth)
{
	float sampleDistance = 0.05 * min(linearDepth, 50.0);
	float jitter = InterleavedGradientNoise(screenCoord * ViewportSize);
	float shadow = float(TraceScreenSpaceShadow(viewPosition, L, sampleDistance, jitter));
	float fade = saturate(1.0 - linearDepth / 300.0);
	return lerp(1.0, shadow, fade);
}