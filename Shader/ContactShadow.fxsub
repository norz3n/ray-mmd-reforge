#ifndef RAY_MMD_CONTACT_SHADOW_FXSUB
#define RAY_MMD_CONTACT_SHADOW_FXSUB

#ifndef CONTACT_QUALITY
#	ifdef CONTACT_SHADOW_QUALITY
#		define CONTACT_QUALITY CONTACT_SHADOW_QUALITY
#	else
#		define CONTACT_QUALITY 2
#	endif
#endif

#if CONTACT_QUALITY <= 1
#	define CONTACT_SHADOW_HIZ_LOOP_COUNT 16
#elif CONTACT_QUALITY == 2
#	define CONTACT_SHADOW_HIZ_LOOP_COUNT 24
#else
#	define CONTACT_SHADOW_HIZ_LOOP_COUNT 32
#endif

/**
 * Reconstructs geometric normal vector from screen-space view position partial derivatives.
 */
float3 ContactShadowGeometricNormal(float3 tangentX, float3 tangentY, float3 shadingNormal)
{
	float3 geometricNormal = cross(tangentY, tangentX);
	float normalLengthSquared = dot(geometricNormal, geometricNormal);

	if (normalLengthSquared > 1e-10f)
		geometricNormal *= rsqrt(normalLengthSquared);
	else
		geometricNormal = shadingNormal;

	return geometricNormal * (dot(geometricNormal, shadingNormal) < 0.0f ? -1.0f : 1.0f);
}

/**
 * Traces a directional screen-space ray towards the light source to compute micro-occlusion.
 *
 * @param viewPosition Ray starting point in view space.
 * @param shadingNormal Surface shading normal vector.
 * @param lightDirectionVS Direction vector towards the light in view space.
 * @param maxDistance Maximum shadow ray travel distance.
 * @param jitter Stochastic dither value for TAA accumulation.
 * @return Shadow visibility scalar in [0, 1] (1 = unshadowed, 0 = fully occluded).
 */
float TraceScreenSpaceShadow(
	float3 viewPosition,
	float3 shadingNormal,
	float3 lightDirectionVS,
	float maxDistance,
	float jitter)
{
	float3 viewPositionDx = ddx(viewPosition);
	float3 viewPositionDy = ddy(viewPosition);
	float3 geometricNormal = ContactShadowGeometricNormal(viewPositionDx, viewPositionDy, shadingNormal);
	float pixelFootprint = max(length(viewPositionDx), length(viewPositionDy));

	if (pixelFootprint > 0.1f)
	{
		geometricNormal = shadingNormal;
		pixelFootprint = 0.005f;
	}

	float3 lightDirection = normalize(lightDirectionVS);
	float shadingNdotL = dot(shadingNormal, lightDirection);
	float geometricNdotL = dot(geometricNormal, lightDirection);

	if (shadingNdotL <= 0.0f || geometricNdotL <= 0.0f || maxDistance <= 0.0f)
		return 1.0f;

	// Dual-hemisphere terminator fade to eliminate low-poly shadow silhouette acne
	float shadingTerminatorFade = smoothstep(0.0f, 0.15f, shadingNdotL);
	float geometricTerminatorFade = smoothstep(0.0f, 0.12f, geometricNdotL);
	float terminatorFade = shadingTerminatorFade * geometricTerminatorFade;

	// Slope-scaled normal bias for self-intersection mitigation
	float slopeScale = 1.0f - saturate(min(shadingNdotL, geometricNdotL));
	float normalBias = max(0.0035f, pixelFootprint * 0.75f) * (1.0f + 3.0f * slopeScale);
	float3 rayOrigin = viewPosition + geometricNormal * normalBias;

	// Physical shadow occluder thickness threshold
	float thickness = max(maxDistance * 0.25f, normalBias * 2.5f);

	// Perform hierarchical screen-space raymarch towards light
	HiZTraceResult traceHit = HiZ_TraceRayDetailed(
		CONTACT_SHADOW_HIZ_LOOP_COUNT,
		rayOrigin,
		lightDirection,
		maxDistance,
		normalBias,
		thickness);

	if (traceHit.isHit)
	{
		// Distance falloff along the contact ray
		float distanceFade = 1.0f - smoothstep(0.65f, 1.0f, traceHit.hitProgress);
		float occlusion = traceHit.confidence * terminatorFade * distanceFade;
		return 1.0f - occlusion;
	}

	return 1.0f;
}

/**
 * Public interface for evaluating contact shadows in lighting passes.
 *
 * @param viewPosition Reconstructed pixel position in view space.
 * @param shadingNormal Pixel surface normal vector.
 * @param L Unit direction vector towards light source in view space.
 * @param screenCoord Viewport coordinates of current pixel [0, 1].
 * @param linearDepth Positive linear view-space depth.
 * @return Contact shadow multiplier factor.
 */
float GetContactShadow(
	float3 viewPosition,
	float3 shadingNormal,
	float3 L,
	float2 screenCoord,
	float linearDepth)
{
	if (linearDepth > 40.0f)
		return 1.0f;

	// Distance-adaptive shadow length: tighter micro-shadows near camera
	float maxDistance = min(0.6f, max(0.025f, linearDepth * 0.018f));
	float jitter = InterleavedGradientNoise(screenCoord * ViewportSize);

	return TraceScreenSpaceShadow(viewPosition, shadingNormal, L, maxDistance, jitter);
}

#endif // RAY_MMD_CONTACT_SHADOW_FXSUB
