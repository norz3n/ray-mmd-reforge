
float4 PostProcessMotionBlurPS(in float2 uv : TEXCOORD0) : COLOR
{
	float linearDepth = tex2Dlod(Gbuffer8Map, float4(uv, 0, 0)).r;
	
	// If it's the skybox/background, don't motion blur (or blur based on camera rotation only)
	if (linearDepth > 999.0f)
	{
		return tex2Dlod(TAAHistoryMapSamp, float4(uv, 0, 0));
	}

	float4 projInfo = GetProjConstant();
	float3 viewPosition = GetViewPosition(projInfo, uv, linearDepth);
	float3 worldPosition = mul(float4(viewPosition, 1.0), matViewInverse).xyz;

	float4x4 matViewProjectPrev = GetPrevViewProject();
	float4 prevClipPos = mul(float4(worldPosition, 1.0), matViewProjectPrev);
	float2 prevUV = (prevClipPos.xy / max(prevClipPos.w, 1e-5)) * float2(0.5, -0.5) + 0.5;

	float2 velocity = uv - prevUV;
	
	// Clamp velocity to prevent massive smearing during teleports/camera cuts
	float maxVelocity = 0.05f; // 5% of screen width
	float velocityLen = length(velocity);
	if (velocityLen > maxVelocity)
	{
		velocity = velocity * (maxVelocity / velocityLen);
	}
	
	// 12-tap linear motion blur
	int numSamples = 12;
	float3 color = 0.0f;
	
	// Scale velocity by shutter speed (e.g. 0.5 = 180 degree shutter)
	float shutterSpeed = 0.7f;
	velocity *= shutterSpeed;

	for (int i = 0; i < numSamples; i++)
	{
		float offset = (float(i) / float(numSamples - 1)) - 0.5f;
		float2 sampleUV = uv + velocity * offset;
		color += tex2Dlod(TAAHistoryMapSamp, float4(sampleUV, 0, 0)).rgb;
	}
	
	color /= float(numSamples);

	return float4(color, 1.0f);
}