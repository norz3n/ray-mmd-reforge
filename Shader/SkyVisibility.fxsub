#ifndef _SKY_VISIBILITY_FXSUB_
#define _SKY_VISIBILITY_FXSUB_

#if SKY_VISIBILITY_ENABLE

/*
 * Top-Down Sky Visibility / Heightfield Ambient Occlusion (Snowdrop Engine / GDC 2016)
 *
 * Computes long-range macro ambient occlusion from large overhead structures
 * (bridges, roofs, canopies, tunnels) preventing outdoor skylight / ambient IBL
 * from leaking into covered spaces.
 *
 * @param worldPos    World-space receiver position (meters)
 * @param worldNormal World-space surface normal
 * @return Sky visibility factor in [mSkyVisibilityMinFloor, 1.0] (1.0 = open sky, minFloor = deeply occluded interior)
 */
float ComputeSkyVisibility(float3 worldPos, float3 worldNormal)
{
	float texelSize = mSkyVisibilityRange / (float)SKY_VISIBILITY_MAP_SIZE;
	float2 mapCenter = floor(CameraPosition.xz / texelSize) * texelSize;
	float2 offset = worldPos.xz - mapCenter;

	float2 uv;
	uv.x = offset.x / mSkyVisibilityRange + 0.5f;
	uv.y = -offset.y / mSkyVisibilityRange + 0.5f;

	// Boundary check: outside coverage area, assume fully unoccluded
	if (any(uv < 0.001f) || any(uv > 0.999f))
		return 1.0f;

	float4 centerData = tex2Dlod(SkyVisibilityMapSamp, float4(uv, 0, 0));

	static const float2 sSkyVisDirs[8] = {
		float2( 1.0f,  0.0f),
		float2(-1.0f,  0.0f),
		float2( 0.0f,  1.0f),
		float2( 0.0f, -1.0f),
		float2( 0.70710678f,  0.70710678f),
		float2(-0.70710678f,  0.70710678f),
		float2( 0.70710678f, -0.70710678f),
		float2(-0.70710678f, -0.70710678f)
	};

#if SKY_VISIBILITY_ENABLE == 1
	// Fast mode: 4 cardinal directions, 2 distance steps
	const int NUM_DIRS = 4;
	const int NUM_STEPS = 2;
	static const float sSkyVisRadii[2] = { 1.5f, 10.0f };
#else
	// High / Cinematic mode: 8 directions (cardinal + diagonal), 3 distance steps
	const int NUM_DIRS = 8;
	const int NUM_STEPS = 3;
	static const float sSkyVisRadii[3] = { 1.2f, 5.5f, 20.0f };
#endif

	// Direct overhead occlusion: test if receiver sits underneath a roof
	float directOverheadOcc = 0.0f;
	if (centerData.a > 0.5f && centerData.r > worldPos.y + 0.2f)
	{
		float overheadDelta = min(centerData.r - worldPos.y, mSkyVisibilityMaxHeight);
		directOverheadOcc = saturate(overheadDelta / (overheadDelta + 1.5f));
	}

	float totalOcclusion = 0.0f;
	float totalWeight = 0.0f;

	[unroll]
	for (int d = 0; d < NUM_DIRS; ++d)
	{
		float2 dir = sSkyVisDirs[d];
		// Normal-oriented directional weighting: cosine lobe in horizontal plane + upward hemisphere
		float NdotD = dot(worldNormal.xz, dir);
		float dirWeight = saturate(worldNormal.y * 0.5f + 0.5f + NdotD * 0.5f);

		float maxSinTheta = directOverheadOcc * 0.92f;

		[unroll]
		for (int s = 0; s < NUM_STEPS; ++s)
		{
			float r = sSkyVisRadii[s];
			float2 sampleUV = uv + float2(dir.x, -dir.y) * (r / mSkyVisibilityRange);
			if (all(sampleUV >= 0.0f) && all(sampleUV <= 1.0f))
			{
				float4 sData = tex2Dlod(SkyVisibilityMapSamp, float4(sampleUV, 0, 0));
				if (sData.a > 0.5f)
				{
					float dh = sData.r - worldPos.y;
					if (dh > 0.2f)
					{
						dh = min(dh, mSkyVisibilityMaxHeight);
						float sinTheta = dh / sqrt(dh * dh + r * r);
						maxSinTheta = max(maxSinTheta, sinTheta);
					}
				}
			}
		}

		totalOcclusion += maxSinTheta * dirWeight;
		totalWeight += dirWeight;
	}

	float avgOcclusion = totalOcclusion / max(totalWeight, 1e-4f);

	// Downward-facing surfaces (ceilings, undersides) naturally receive minimal skylight
	float downPenalty = saturate(worldNormal.y * 0.75f + 0.75f);
	avgOcclusion = 1.0f - (1.0f - avgOcclusion) * downPenalty;

	// Controller morph adjustments
	float strength = mSkyVisibilityIntensity;
#if defined(SKY_VIS_CONTROLLER_AVAILABLE)
	strength += mSkyVisibilityP * 2.0f;
	strength *= saturate(1.0f - mSkyVisibilityM);
#endif

	float skyVis = saturate(1.0f - avgOcclusion * strength);
	return max(mSkyVisibilityMinFloor, skyVis);
}

#endif // SKY_VISIBILITY_ENABLE

#endif // _SKY_VISIBILITY_FXSUB_
