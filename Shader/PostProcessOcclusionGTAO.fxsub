/*
 * PostProcessOcclusionGTAO.fxsub - Ground-Truth Ambient Occlusion (XeGTAO)
 *
 * Based on Intel XeGTAO / Jorge Jimenez (Activision) Ground-Truth Ambient Occlusion.
 * Features:
 * - Cosine-weighted analytical horizon integration per slice with projective normal weighting
 * - Exact directional bent normal accumulation (Jimenez 2016 / XeGTAO Algorithm 2)
 * - Depth-aware thickness heuristic falloff preventing character silhouette halos
 * - Slope-compensated bilateral cross-filtering with scale-invariant depth & normal rejection
 * - Temporal reprojection denoiser with neighborhood box clamping
 */

#if SSDO_QUALITY == 1
#	define GTAO_SLICE_COUNT 2
#	define GTAO_STEPS_PER_SLICE 4
#	define SSDO_BLUR_RADIUS 4
#elif SSDO_QUALITY == 2
#	define GTAO_SLICE_COUNT 3
#	define GTAO_STEPS_PER_SLICE 4
#	define SSDO_BLUR_RADIUS 6
#elif SSDO_QUALITY == 3
#	define GTAO_SLICE_COUNT 4
#	define GTAO_STEPS_PER_SLICE 6
#	define SSDO_BLUR_RADIUS 6
#elif SSDO_QUALITY == 4
#	define GTAO_SLICE_COUNT 6
#	define GTAO_STEPS_PER_SLICE 6
#	define SSDO_BLUR_RADIUS 6
#elif SSDO_QUALITY == 5
#	define GTAO_SLICE_COUNT 8
#	define GTAO_STEPS_PER_SLICE 8
#	define SSDO_BLUR_RADIUS 6
#elif SSDO_QUALITY == 6
#	define GTAO_SLICE_COUNT 12
#	define GTAO_STEPS_PER_SLICE 8
#	define SSDO_BLUR_RADIUS 6
#else
#	define GTAO_SLICE_COUNT 3
#	define GTAO_STEPS_PER_SLICE 4
#	define SSDO_BLUR_RADIUS 6
#endif

#ifndef HALF_PI
#	define HALF_PI 1.57079632679f
#endif

#define XE_GTAO_DEFAULT_RADIUS_MULTIPLIER          1.457f
#define XE_GTAO_DEFAULT_FALLOFF_RANGE              0.615f
#define XE_GTAO_DEFAULT_SAMPLE_DISTRIBUTION_POWER  2.0f
#define XE_GTAO_DEFAULT_THIN_OCCLUDER_COMPENSATION 0.35f

float linearizeDepth(float2 uv)
{
	return tex2Dlod(Gbuffer8Map, float4(uv, 0, 0)).r;
}

float3 GetNormal(float2 uv)
{
	float4 MRT6 = tex2Dlod(Gbuffer6Map, float4(uv, 0, 0));
	return DecodeGBufferNormal(MRT6);
}

// Builds rotation matrix from (0,0,-1) to viewVec [Jimenez 2016 / XeGTAO]
float3x3 XeGTAO_RotFromToMatrix(float3 from, float3 to)
{
	float e = dot(from, to);
	float f = abs(e);
	if (f > 0.9997f)
	{
		return float3x3(1, 0, 0, 0, 1, 0, 0, 0, 1);
	}
	float3 v = cross(from, to);
	float h = 1.0f / (1.0f + e);
	float hvx = h * v.x;
	float hvz = h * v.z;
	float hvxy = hvx * v.y;
	float hvxz = hvx * v.z;
	float hvyz = hvz * v.y;

	float3x3 mtx;
	mtx[0] = float3(e + hvx * v.x, hvxy - v.z, hvxz + v.y);
	mtx[1] = float3(hvxy + v.z, e + h * v.y * v.y, hvyz - v.x);
	mtx[2] = float3(hvxz - v.y, hvyz + v.x, e + hvz * v.z);
	return mtx;
}

float4 ScreenSpaceDirOccPassVS(
	in float4 Position : POSITION,
	in float4 Texcoord : TEXCOORD,
	out float4 oTexcoord0 : TEXCOORD0) : POSITION
{
	oTexcoord0.xy = Texcoord.xy + ViewportOffset;
	oTexcoord0.zw = Texcoord.xy * ViewportSize;
	return Position;
}

float4 ScreenSpaceDirOccPassPS(in float4 uv : TEXCOORD0, in float2 screen : SV_POSITION) : COLOR
{
	float centerDepth = linearizeDepth(uv.xy);

	// Early out for background/sky pixels
	if (centerDepth <= 1e-4f)
	{
		return float4(0.5f, 0.5f, 0.5f, 1.0f);
	}

	float4 projConstant = GetProjConstant();
	float3 vPos = GetViewPosition(projConstant, uv.xy, centerDepth);
	float3 viewNormal = GetNormal(uv.xy);
	float3 viewVec = normalize(-vPos);

	// Stabilize silhouette grazing-angle normals to prevent sign-flipping and terminator black speckles
	viewNormal = normalize(viewNormal + max(0.0f, 0.08f - dot(viewNormal, viewVec)) * viewVec);

	// Calibrated world-space radius for MMD scale (character height ~15-20 units)
	float baseRadius = lerp(lerp(1.5f, 3.5f, mSSAORadiusP), 0.5f, mSSAORadiusM);
	float effectRadius = baseRadius;

	float projScale = ViewportSize.y * 0.5f * matProject._m11;
	float maxRadiusPixels = mAmbientOcclusionMaxRadiusPixelPercentage * ViewportSize.y;
	float screenspaceRadius = clamp((effectRadius * projScale) / max(centerDepth, 0.1f), (float)GTAO_STEPS_PER_SLICE, maxRadiusPixels);

	// Avoid sampling center pixel / acne
	const float pixelTooCloseThreshold = 1.3f;
	float minS = pixelTooCloseThreshold / max(screenspaceRadius, 1e-4f);

#if AA_QUALITY == 6 || AO_TEMPORAL_DENOISE
	int frameCounter = (int)fmod(time * 60.0f, 16.0f);
#else
	int frameCounter = 0;
#endif
	float2 sampleRandom = float2(InterleavedGradientNoise(screen, frameCounter), PseudoRandom(screen + frameCounter));
	float noiseSlice = sampleRandom.x;
	float noiseSample = sampleRandom.y;

	float totalVisibility = 0.0f;
	float3 bentNormalAcc = 0.0f;
	float sliceAngleStep = PI / (float)GTAO_SLICE_COUNT;

	float maxThickness = max(0.35f, effectRadius * 0.25f);
	float maxBehind = effectRadius * 0.75f;

	[loop]
	for (int i = 0; i < GTAO_SLICE_COUNT; ++i)
	{
		float phi = (float(i) + noiseSlice) * sliceAngleStep;
		float cosPhi = cos(phi);
		float sinPhi = sin(phi);

		float2 omega = float2(cosPhi, -sinPhi) * screenspaceRadius;
		float3 directionVec = float3(cosPhi, sinPhi, 0.0f);

		// XeGTAO slice plane projection (orthoDirectionVec & axisVec)
		float3 orthoDirectionVec = directionVec - dot(directionVec, viewVec) * viewVec;
		float3 axisVec = normalize(cross(orthoDirectionVec, viewVec));
		float3 projectedNormalVec = viewNormal - axisVec * dot(viewNormal, axisVec);

		float projLength = length(projectedNormalVec);
		if (projLength < 1e-4f)
			continue;

		float dotOrtho = dot(orthoDirectionVec, projectedNormalVec);
		float signNorm = (abs(dotOrtho) > 1e-4f) ? sign(dotOrtho) : 0.0f;
		float cosNorm = saturate(dot(projectedNormalVec, viewVec) / projLength);
		float n = signNorm * acos(cosNorm);

		// Tangent plane lower horizon cosine bounds (zero occlusion)
		float lowHorizonCos0 = cos(n + HALF_PI);
		float lowHorizonCos1 = cos(n - HALF_PI);

		float horizonCos0 = lowHorizonCos0;
		float horizonCos1 = lowHorizonCos1;

		[unroll]
		for (int j = 0; j < GTAO_STEPS_PER_SLICE; ++j)
		{
			// Low-discrepancy R1 sequence noise per step
			float stepBaseNoise = float(i + j * GTAO_STEPS_PER_SLICE) * 0.6180339887498948482f;
			float stepNoise = frac(noiseSample + stepBaseNoise);

			float s = (float(j) + stepNoise) / (float)GTAO_STEPS_PER_SLICE;
			s = pow(s, XE_GTAO_DEFAULT_SAMPLE_DISTRIBUTION_POWER) + minS;

			float2 sampleOffset = s * omega * ViewportOffset2;
			float2 sampleScreenPos0 = uv.xy + sampleOffset;
			float2 sampleScreenPos1 = uv.xy - sampleOffset;

			float depth0 = linearizeDepth(sampleScreenPos0);
			float depth1 = linearizeDepth(sampleScreenPos1);

			// Positive direction (+dir)
			if (depth0 > 1e-4f)
			{
				float3 samplePos0 = GetViewPosition(projConstant, sampleScreenPos0, depth0);
				float3 sampleDelta0 = samplePos0 - vPos;
				float sampleDist0 = length(sampleDelta0);

				if (sampleDist0 > 1e-4f && sampleDist0 < effectRadius)
				{
					float3 sampleHorizonVec0 = sampleDelta0 / sampleDist0;
					float falloffWeight0 = saturate(1.0f - (sampleDist0 / effectRadius) * (sampleDist0 / effectRadius));

					// Strict thickness heuristic: ignore foreground/background objects separated in depth (eliminates dark halos)
					float distInFront0 = max(0.0f, -sampleDelta0.z);
					float thicknessWeight0 = saturate(1.0f - max(0.0f, distInFront0 - maxThickness * 0.2f) / maxThickness);
					float distBehind0 = max(0.0f, sampleDelta0.z);
					float behindWeight0 = saturate(1.0f - distBehind0 / maxBehind);

					float weight0 = falloffWeight0 * thicknessWeight0 * behindWeight0;

					float shc0 = dot(sampleHorizonVec0, viewVec);
					shc0 = lerp(lowHorizonCos0, shc0, weight0);
					horizonCos0 = max(horizonCos0, shc0);
				}
			}

			// Negative direction (-dir)
			if (depth1 > 1e-4f)
			{
				float3 samplePos1 = GetViewPosition(projConstant, sampleScreenPos1, depth1);
				float3 sampleDelta1 = samplePos1 - vPos;
				float sampleDist1 = length(sampleDelta1);

				if (sampleDist1 > 1e-4f && sampleDist1 < effectRadius)
				{
					float3 sampleHorizonVec1 = sampleDelta1 / sampleDist1;
					float falloffWeight1 = saturate(1.0f - (sampleDist1 / effectRadius) * (sampleDist1 / effectRadius));

					// Strict thickness heuristic: ignore foreground/background objects separated in depth (eliminates dark halos)
					float distInFront1 = max(0.0f, -sampleDelta1.z);
					float thicknessWeight1 = saturate(1.0f - max(0.0f, distInFront1 - maxThickness * 0.2f) / maxThickness);
					float distBehind1 = max(0.0f, sampleDelta1.z);
					float behindWeight1 = saturate(1.0f - distBehind1 / maxBehind);

					float weight1 = falloffWeight1 * thicknessWeight1 * behindWeight1;

					float shc1 = dot(sampleHorizonVec1, viewVec);
					shc1 = lerp(lowHorizonCos1, shc1, weight1);
					horizonCos1 = max(horizonCos1, shc1);
				}
			}
		}

		// Grazing angle over-darkening compensation fudge [XeGTAO]
		projLength = lerp(projLength, 1.0f, 0.05f);

		horizonCos0 = clamp(horizonCos0, -1.0f, 1.0f);
		horizonCos1 = clamp(horizonCos1, -1.0f, 1.0f);

		float h0 = -acos(horizonCos1);
		float h1 =  acos(horizonCos0);

		// Clamp horizon angles to tangent plane to prevent overshoot
		h0 = n + clamp(h0 - n, -HALF_PI, HALF_PI);
		h1 = n + clamp(h1 - n, -HALF_PI, HALF_PI);

		// XeGTAO / Jimenez analytical slice visibility integral
		float iarc0 = (cosNorm + 2.0f * h0 * sin(n) - cos(2.0f * h0 - n)) * 0.25f;
		float iarc1 = (cosNorm + 2.0f * h1 * sin(n) - cos(2.0f * h1 - n)) * 0.25f;
		float localVisibility = projLength * (iarc0 + iarc1);
		totalVisibility += localVisibility;

		// Exact analytical bent normal integral [Jimenez 2016 / XeGTAO Algorithm 2]
		float t0 = (6.0f * sin(h0 - n) - sin(3.0f * h0 - n) + 6.0f * sin(h1 - n) - sin(3.0f * h1 - n) + 16.0f * sin(n) - 3.0f * (sin(h0 + n) + sin(h1 + n))) * (1.0f / 12.0f);
		float t1 = (-cos(3.0f * h0 - n) - cos(3.0f * h1 - n) + 8.0f * cos(n) - 3.0f * (cos(h0 + n) + cos(h1 + n))) * (1.0f / 12.0f);
		float3 localBentNormal = float3(directionVec.x * t0, directionVec.y * t0, -t1);

		float3x3 rotMat = XeGTAO_RotFromToMatrix(float3(0.0f, 0.0f, -1.0f), viewVec);
		bentNormalAcc += mul(rotMat, localBentNormal) * projLength;
	}

	totalVisibility /= (float)GTAO_SLICE_COUNT;
	totalVisibility = clamp(totalVisibility, 0.03f, 1.0f);

	if (length(bentNormalAcc) > 1e-4f)
		bentNormalAcc = normalize(bentNormalAcc);
	else
		bentNormalAcc = viewNormal;

	// Modulate AO by material-level SSAOVisibility mask: 0.0 means 0% AO (100% visible)
	float ssaoMask = tex2Dlod(SSAOMapSamp, float4(uv.xy, 0, 0)).a;
	totalVisibility = lerp(1.0f, totalVisibility, ssaoMask);

	float4 occlusion;
	occlusion.xyz = bentNormalAcc * 0.5f + 0.5f;
	occlusion.w = lerp(1.0f, pow(totalVisibility, max(mSSAOScale, 1e-3f)), step(1e-4f, mSSAOScale));

	return occlusion;
}

float4 ScreenSpaceDirOccBlurPS(
	in float2 uv : TEXCOORD0,
	in float3 viewdir : TEXCOORD1,
	uniform sampler source,
	uniform float2 offset) : COLOR
{
	float centerDepth = linearizeDepth(uv);
	if (centerDepth <= 1e-4f)
	{
		return float4(0.5f, 0.5f, 0.5f, 1.0f);
	}

	float4 projConstant = GetProjConstant();
	float3 centerNormal = GetNormal(uv);
	float4 centerColor = tex2Dlod(source, float4(uv, 0, 0));
	float totalWeight = 1.0f;
	float4 totalColor = centerColor;

	// Scale-invariant depth tolerance for smooth surface reconstruction without edge bleeding
	float depthTolerance = max(centerDepth * 0.035f, 0.015f);

	float blurSigma = SSDO_BLUR_RADIUS * 0.5f;
	float spatialFalloff = 1.0f / (2.0f * blurSigma * blurSigma);

	[unroll]
	for (int r = 1; r <= SSDO_BLUR_RADIUS; ++r)
	{
		float spatialWeight = exp(-float(r * r) * spatialFalloff);
		float2 uvOffset = offset * (float)r;

		// --- Forward tap (+r) ---
		float2 uvP = uv + uvOffset;
		float depthP = linearizeDepth(uvP);
		if (depthP > 1e-4f)
		{
			float3 normP = GetNormal(uvP);
			float depthDeltaP = abs(depthP - centerDepth);
			float depthWeightP = exp(-pow2(depthDeltaP / depthTolerance));
			float normalWeightP = saturate(dot(centerNormal, normP));

			float wP = spatialWeight * depthWeightP * normalWeightP;
			totalColor += tex2Dlod(source, float4(uvP, 0, 0)) * wP;
			totalWeight += wP;
		}

		// --- Backward tap (-r) ---
		float2 uvM = uv - uvOffset;
		float depthM = linearizeDepth(uvM);
		if (depthM > 1e-4f)
		{
			float3 normM = GetNormal(uvM);
			float depthDeltaM = abs(depthM - centerDepth);
			float depthWeightM = exp(-pow2(depthDeltaM / depthTolerance));
			float normalWeightM = saturate(dot(centerNormal, normM));

			float wM = spatialWeight * depthWeightM * normalWeightM;
			totalColor += tex2Dlod(source, float4(uvM, 0, 0)) * wM;
			totalWeight += wM;
		}
	}

	float4 blurred = totalColor / totalWeight;
	if (length(blurred.xyz * 2.0f - 1.0f) > 1e-4f)
	{
		blurred.xyz = normalize(blurred.xyz * 2.0f - 1.0f) * 0.5f + 0.5f;
	}
	return blurred;
}

#if AO_TEMPORAL_DENOISE
struct SSDOTemporalOutput
{
	float4 color0 : COLOR0;
	float4 color1 : COLOR1;
};

SSDOTemporalOutput SSDOTemporalDenoisePS(in float2 uv : TEXCOORD0)
{
	SSDOTemporalOutput output;
	float curDepth = linearizeDepth(uv);
	float4 curAO = tex2Dlod(SSDOMapSamp, float4(uv, 0, 0));

	if (curDepth > 999.0f || curDepth <= 1e-4f)
	{
		output.color0 = curAO;
		output.color1 = curAO;
		return output;
	}

	float4 projInfo = GetProjConstant();
	float3 viewPosition = GetViewPosition(projInfo, uv, curDepth);
	float3 worldPosition = mul(float4(viewPosition, 1.0), matViewInverse).xyz;

	float4x4 matViewProjectPrev = GetPrevViewProject();
	float4 prevClipPos = mul(float4(worldPosition, 1.0), matViewProjectPrev);
	float2 prevUV = (prevClipPos.xy / max(prevClipPos.w, 1e-5)) * float2(0.5, -0.5) + 0.5;

	if (any(prevUV < 0.0f) || any(prevUV > 1.0f))
	{
		output.color0 = curAO;
		output.color1 = curAO;
		return output;
	}

	float prevDepth = linearizeDepth(prevUV);
	if (abs(prevDepth - curDepth) > max(0.15f, curDepth * 0.04f))
	{
		output.color0 = curAO;
		output.color1 = curAO;
		return output;
	}

	float4 historyAO = tex2Dlod(SSDOMapHistorySamp, float4(prevUV, 0, 0));

	// 3x3 Neighborhood Box Clamping
	float2 texelSize = ViewportOffset2;
	float4 minAO = curAO;
	float4 maxAO = curAO;

	[unroll]
	for (int x = -1; x <= 1; ++x)
	{
		[unroll]
		for (int y = -1; y <= 1; ++y)
		{
			if (x != 0 || y != 0)
			{
				float4 sampleNeighbor = tex2Dlod(SSDOMapSamp, float4(uv + float2(x, y) * texelSize, 0, 0));
				minAO = min(minAO, sampleNeighbor);
				maxAO = max(maxAO, sampleNeighbor);
			}
		}
	}

	float4 boxMargin = (maxAO - minAO) * 0.25f;
	historyAO = clamp(historyAO, minAO - boxMargin, maxAO + boxMargin);

	float4 denoised = lerp(curAO, historyAO, 0.85f);
	output.color0 = denoised;
	output.color1 = denoised;
	return output;
}

float4 SSDOCopyTemporalPS(in float2 uv : TEXCOORD0) : COLOR
{
	return tex2Dlod(SSDOMapSampTemp, float4(uv, 0, 0));
}
#endif

