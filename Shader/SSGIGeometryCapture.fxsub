////////////////////////////////////////////////////////////////////////////////////////////////
//
//  Ray-MMD SSGI Geometry Capture
//  
//  Captures all scene geometry into a 2D-sliced atlas texture for use by the
//  Screen-Space Voxel GI cone tracer. Each atlas slice represents a depth layer
//  of the scene, packed into a 2D texture for D3D9/DX9 compatibility.
//
//  Output packing (A8R8G8B8):
//    RGB = surface albedo (MaterialDiffuse * DiffuseTexture)
//    A   = emissive flag (1.0 = emissive/additive, 0.0 = normal surface)
//
//  Reference Architecture & Algorithms:
//  - D3D9 2D Sliced Atlas Volume Math: ikeno (ikVXGI)
//
////////////////////////////////////////////////////////////////////////////////////////////////

// Voxel Grid Parameters
#ifndef VOXEL_SIZE_SQRT
#	define VOXEL_SIZE_SQRT 8
#endif

#define VOXEL_SIZE (VOXEL_SIZE_SQRT * VOXEL_SIZE_SQRT) // 64x64x64 Voxel Volume
#define GRID_SIZE 0.5
#define INV_GRID_SIZE (1.0 / GRID_SIZE)

// ---- Object shader code (VS/PS + texture) ----
// Only compiled when included from SSGIGeometryCapture.fx (object context),
// NOT when included from PostProcessVXGI.fxsub (post-processing context).
#ifdef SSGI_CAPTURE_OBJECT_SHADER

texture DiffuseMap: MATERIALTEXTURE;
sampler DiffuseMapSamp = sampler_state {
	texture = <DiffuseMap>;
	MinFilter = LINEAR; MagFilter = LINEAR; MipFilter = LINEAR;
	AddressU = WRAP; AddressV = WRAP;
};

struct SSGICaptureVertexInput {
	float4 Pos    : POSITION;
	float3 Normal : NORMAL;
	float2 Tex    : TEXCOORD0;
};

struct SSGICaptureVertexOutput {
	float4 Pos      : POSITION;
	float3 Normal   : TEXCOORD0;
	float2 Tex      : TEXCOORD1;
	float3 WorldPos : TEXCOORD3;
};

SSGICaptureVertexOutput SSGICaptureVS(SSGICaptureVertexInput IN)
{
	SSGICaptureVertexOutput Out;
	float4 worldPos = mul(IN.Pos, matWorld);
	Out.WorldPos = worldPos.xyz;
	Out.Normal = normalize(mul(IN.Normal, (float3x3)matWorld));
	Out.Tex = IN.Tex;

	// Project into atlas slice space
	Out.Pos = mul(worldPos, matViewProject);
	return Out;
}

float4 SSGICapturePS(SSGICaptureVertexOutput IN) : COLOR0
{
	// Start with MMD material diffuse color
	float3 albedo = MaterialDiffuse.rgb;
	float  alpha  = MaterialDiffuse.a;

	// Sample object texture if available
	if (use_texture)
	{
		float4 texColor = tex2D(DiffuseMapSamp, IN.Tex);
		albedo *= texColor.rgb;
		alpha  *= texColor.a;
	}

	// Discard fully transparent fragments
	clip(alpha - 0.01);

	// Detect emissive / additive-blended objects (light sources in MMD)
	float emissiveFlag = opadd ? 1.0 : 0.0;

	return float4(albedo, emissiveFlag);
}

#endif // SSGI_CAPTURE_OBJECT_SHADER

// ---- Utility functions (available in both object and post-processing contexts) ----

// Pack world position into normalized [0..1] atlas UV coordinate
void SSGIPackPosition(float3 worldPos, float3 gridCenter, out float3 voxelUV)
{
	float3 localPos = (worldPos - gridCenter) * INV_GRID_SIZE + (VOXEL_SIZE * 0.5);
	voxelUV = saturate(localPos / VOXEL_SIZE);
}

// Sample from the 2D-sliced geometry atlas with trilinear interpolation across depth slices
float4 SSGISampleAtlas(sampler2D atlasSampler, float3 voxelCoord)
{
	float zSlice = clamp(voxelCoord.z * (VOXEL_SIZE - 1), 0, VOXEL_SIZE - 1);
	float zFloor = floor(zSlice);
	float zFrac = frac(zSlice);

	float2 sliceGrid1 = float2(fmod(zFloor, VOXEL_SIZE_SQRT), floor(zFloor / VOXEL_SIZE_SQRT));
	float2 uv1 = (sliceGrid1 + voxelCoord.xy) / VOXEL_SIZE_SQRT;

	float2 sliceGrid2 = float2(fmod(zFloor + 1.0, VOXEL_SIZE_SQRT), floor((zFloor + 1.0) / VOXEL_SIZE_SQRT));
	float2 uv2 = (sliceGrid2 + voxelCoord.xy) / VOXEL_SIZE_SQRT;

	float4 sample1 = tex2Dlod(atlasSampler, float4(uv1, 0, 0));
	float4 sample2 = tex2Dlod(atlasSampler, float4(uv2, 0, 0));

	return lerp(sample1, sample2, zFrac);
}
