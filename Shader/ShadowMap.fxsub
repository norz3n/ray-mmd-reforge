static const float kInvWeightSum[4] = {
	0.1201636f, // 25 samples (cascade 0)
	0.1341286f, // 16 samples (cascade 1)
	0.1855560f, // 9 samples  (cascade 2)
	0.3420866f  // 4 samples  (cascade 3)
};

/**
 * Standard uniform PCF shadow filtering for legacy/fallback mode.
 *
 * @param source Shadow map texture sampler.
 * @param coord UV coordinate in shadow map.
 * @param radius Base filter radius in UV space.
 * @param receiverDepth Linear light-space depth of receiver surface.
 * @param noise Screen-space pseudo-random noise for sample jittering.
 * @param cascadeIndex Index of active cascade (0 to 3).
 * @return Shadow factor (0 = occluded, 1 = unoccluded).
 */
float ShadowPCF(sampler source, float2 coord, float radius, float receiverDepth, float noise, int cascadeIndex)
{
	float shadow = 0.0;
	
	// Gentle cascade scaling to preserve smooth anti-aliasing across all cascades
	float cascadeScale = 1.0 / (1.0 + cascadeIndex * 0.2f);
	float finalRadius = radius * cascadeScale;

	float2 rot;
	sincos(noise * PI_2, rot.y, rot.x);
	float2x2 rotMat = float2x2(rot.x, -rot.y, rot.y, rot.x);

	int sampleCount = (cascadeIndex == 0) ? 25 : ((cascadeIndex == 1) ? 16 : ((cascadeIndex == 2) ? 9 : 4));

	[loop]
	for (int i = 0; i < sampleCount; i++)
	{
		float2 vogel = mul(kVogelDisk25[i].xy, rotMat);
		float2 pos = coord + vogel * finalRadius;
		
		float zMap = tex2Dlod(source, float4(pos, 0, 0)).r;
		float sampleShadow = 1.0f;
		[flatten]
		if (zMap > 1e-5)
		{
			float diff = receiverDepth - zMap;
			sampleShadow = (diff <= 0.0f) ? 1.0f : saturate(exp(-20.0f * diff));
		}
		
		shadow += sampleShadow * kVogelDisk25[i].z;
	}
	
	return shadow * kInvWeightSum[cascadeIndex];
}

#if SUN_SHADOW_PCSS_ENABLE
/**
 * Searches the shadow map around the receiver UV for occluding geometry.
 *
 * @param source Shadow map texture sampler.
 * @param coord UV coordinate in shadow map.
 * @param searchRadius UV radius to search for blockers.
 * @param receiverDepth Linear light-space depth of the receiver surface.
 * @param rotMat 2D rotation matrix for jittering sample offsets.
 * @param minBlockerDist Minimum distance to consider a sample a distinct occluder (rejects self-curvature).
 * @param blockerSamples Number of samples to evaluate.
 * @return float2(averageBlockerDepth, blockerCount).
 */
float2 FindBlocker(sampler source, float2 coord, float searchRadius, float receiverDepth, float2x2 rotMat, float minBlockerDist, int blockerSamples)
{
	float blockerSum = 0.0f;
	float blockerCount = 0.0f;

	[loop]
	for (int i = 0; i < blockerSamples; i++)
	{
		float2 offset = mul(kVogelBlockerDisk[i].xy, rotMat) * searchRadius;
		float2 sampleCoord = coord + offset;
		float sampleDepth = tex2Dlod(source, float4(sampleCoord, 0, 0)).r;

		[flatten]
		if (sampleDepth > 1e-5)
		{
			float dist = receiverDepth - sampleDepth;
			[flatten]
			if (dist > minBlockerDist)
			{
				blockerSum += sampleDepth;
				blockerCount += 1.0f;
			}
		}
	}

	return float2(blockerSum / max(1.0f, blockerCount), blockerCount);
}

/**
 * Calculates Percentage-Closer Soft Shadows with contact-hardening penumbra.
 *
 * @param source Shadow map texture sampler for the active cascade.
 * @param coord UV coordinate in the shadow map.
 * @param receiverDepth Linear light-space depth of the receiver surface.
 * @param noise Screen-space pseudo-random noise for sample jittering.
 * @param minBlockerDist Minimum distance threshold to filter self-samples.
 * @param normalBias Surface normal bias (1.0 at grazing angle, 0.0 facing sun).
 * @param cascadeIndex Index of the active cascade (0 to 3).
 * @return Filtered shadow visibility factor (0 = full shadow, 1 = fully lit).
 */
float ShadowPCSS(sampler source, float2 coord, float receiverDepth, float noise, float minBlockerDist, float normalBias, int cascadeIndex)
{
	float2 rot;
	sincos(noise * PI_2, rot.y, rot.x);
	float2x2 rotMat = float2x2(rot.x, -rot.y, rot.y, rot.x);

	// Cascade-specific scale: world units to UV space
	float cascadeCropScale = lightCropParams[cascadeIndex].x * 0.5f;

	// Scale sample counts for distant cascades to maximize performance
	int blockerSamples = SUN_BLOCKER_SAMPLES;
	int filterSamples = SUN_FILTER_SAMPLES;
	if (cascadeIndex == 1)
	{
		blockerSamples = min(SUN_BLOCKER_SAMPLES, 16);
		filterSamples = min(SUN_FILTER_SAMPLES, 25);
	}
	else if (cascadeIndex == 2)
	{
		blockerSamples = min(SUN_BLOCKER_SAMPLES, 12);
		filterSamples = min(SUN_FILTER_SAMPLES, 16);
	}
	else if (cascadeIndex >= 3)
	{
		blockerSamples = min(SUN_BLOCKER_SAMPLES, 8);
		filterSamples = min(SUN_FILTER_SAMPLES, 12);
	}

	// Graze angle mitigation: shrink search/filter radius to avoid sampling background and causing light leaks (ESM noise)
	float grazeScale = saturate(1.0f - normalBias * normalBias);

	// STEP 1: Blocker Search
	float searchRadiusWorld = mSunPCSSBlockerSearchScale * (10.0f * mSunLightSize);
	float searchRadiusUV = searchRadiusWorld * cascadeCropScale;
	searchRadiusUV = clamp(searchRadiusUV, 3.0f / float(SHADOW_MAP_SIZE), 0.08f);
	searchRadiusUV *= max(grazeScale, 0.2f); // Keep a small minimum search radius

	float2 blocker = FindBlocker(source, coord, searchRadiusUV, receiverDepth, rotMat, minBlockerDist, blockerSamples);
	float avgBlockerDepth = blocker.x;
	float blockerCount = blocker.y;

	[branch]
	if (blockerCount < 0.5f)
	{
		return 1.0f; // No occluders in search area -> fully lit early exit
	}

	// STEP 2: Penumbra Size Estimation
	float blockerDistance = max(0.0f, receiverDepth - avgBlockerDepth);
	float penumbraWorld = blockerDistance * mSunLightSize;
	float filterRadiusUV = penumbraWorld * cascadeCropScale;

	float minFilterUV = mSunPCSSMinFilterRadius / float(SHADOW_MAP_SIZE);
	float maxFilterUV = (mSunPCSSMaxFilterRadius / float(SHADOW_MAP_SIZE)) * (1.0f / (1.0f + cascadeIndex * 0.25f));
	filterRadiusUV = clamp(filterRadiusUV, minFilterUV, maxFilterUV);
	filterRadiusUV *= grazeScale; // Shrink penumbra at grazing angles

	// STEP 3: Percentage-Closer Filtering (PCF)
	float shadow = 0.0f;
	float totalWeight = 0.0f;

	[loop]
	for (int i = 0; i < filterSamples; i++)
	{
		float2 offset = mul(kVogelFilterDisk[i].xy, rotMat) * filterRadiusUV;
		float2 pos = coord + offset;

		float zMap = tex2Dlod(source, float4(pos, 0, 0)).r;
		float sampleShadow = 1.0f;
		[flatten]
		if (zMap > 1e-5)
		{
			float diff = receiverDepth - zMap;
			sampleShadow = (diff <= 0.0f) ? 1.0f : saturate(exp(-20.0f * diff));
		}

		shadow += sampleShadow * kVogelFilterDisk[i].z;
		totalWeight += kVogelFilterDisk[i].z;
	}

	return shadow / totalWeight;
}
#endif

float ShadingShadow(MaterialParam material, float3 viewPosition)
{
	float3 L = mul(-SunDirection, (float3x3)matView);
	float cosTheta = dot(material.normal, L);

	// Terminator cutoff: surfaces facing away from sunlight are in full self-shadow
	float terminator = saturate(cosTheta * 12.0f);
	[branch]
	if (terminator <= 0.0f)
	{
		return 0.0f;
	}

	float normalBias = saturate(1.0f - saturate(cosTheta));

	float4 proj = mul(float4(viewPosition, 1), matLightProjectFromCameraView);

	float4 lightPPos01 = proj.xyxy * float4(lightCropParams[0].xy, lightCropParams[1].xy) + float4(lightCropParams[0].zw, lightCropParams[1].zw);
	float4 lightPPos23 = proj.xyxy * float4(lightCropParams[2].xy, lightCropParams[3].xy) + float4(lightCropParams[2].zw, lightCropParams[3].zw);

	float4 lightCoord01 = PosToCoord(lightPPos01);
	float4 lightCoord23 = PosToCoord(lightPPos23);

	float4 lightPPos0 = float4(lightCoord01.xy, min2(float2(1, 1) - abs(lightPPos01.xy)), 0);
	float4 lightPPos1 = float4(lightCoord01.zw, min2(float2(1, 1) - abs(lightPPos01.zw)), 1);
	float4 lightPPos2 = float4(lightCoord23.xy, min2(float2(1, 1) - abs(lightPPos23.xy)), 2);
	float4 lightPPos3 = float4(lightCoord23.zw, min2(float2(1, 1) - abs(lightPPos23.zw)), 3);

	float4 coord = lightPPos3;
	if (lightPPos2.z > 0) { coord = lightPPos2; }
	if (lightPPos1.z > 0) { coord = lightPPos1; }
	if (lightPPos0.z > 0) { coord = lightPPos0; }
	clip(coord.z);

	float depthSlope = ShadowSlopeScaledBias(proj.z / mPSSMDepthZMax) * mPSSMDepthZMax;
	float receiverDepth = dot(float4(viewPosition, 1), matLightViewFromCameraView._13_23_33_43);
	float baseBias = (material.linearDepth + depthSlope * (1.0f + normalBias * 2.0f)) * 0.0035f + max(0.0f, material.linearDepth - 100.0f) * 0.007f;
	receiverDepth -= baseBias;

	coord.xy += 0.5 / float(SHADOW_MAP_SIZE);

	float shadow = 0;
	float noise = InterleavedGradientNoise(coord.xy * SHADOW_MAP_SIZE);

#if SUN_SHADOW_PCSS_ENABLE
	// receiverDepth is already biased by baseBias to account for surface curvature/slope,
	// so any sample closer to the light (dist > 0) is a genuine occluder.
	float minBlockerDist = 0.0f;

	[branch]
	if (coord.w == 0)
	{
		clip(tex2Dlod(PSSM1Samp, float4(coord.xy, 0, 0)).r - 1e-5);
		shadow = ShadowPCSS(PSSM1Samp, coord.xy, receiverDepth, noise, minBlockerDist, normalBias, 0);
	}
	else if (coord.w == 1)
	{
		clip(tex2Dlod(PSSM2Samp, float4(coord.xy, 0, 0)).r - 1e-5);
		shadow = ShadowPCSS(PSSM2Samp, coord.xy, receiverDepth, noise, minBlockerDist, normalBias, 1);
	}
	else if (coord.w == 2)
	{
		clip(tex2Dlod(PSSM3Samp, float4(coord.xy, 0, 0)).r - 1e-5);
		shadow = ShadowPCSS(PSSM3Samp, coord.xy, receiverDepth, noise, minBlockerDist, normalBias, 2);
	}
	else
	{
		clip(tex2Dlod(PSSM4Samp, float4(coord.xy, 0, 0)).r - 1e-5);
		shadow = ShadowPCSS(PSSM4Samp, coord.xy, receiverDepth, noise, minBlockerDist, normalBias, 3);
	}
#else
	float radius = 3.0 / float(SHADOW_MAP_SIZE);
	[branch]
	if (coord.w == 0)
	{
		clip(tex2Dlod(PSSM1Samp, float4(coord.xy, 0, 0)).r - 1e-5);
		shadow = ShadowPCF(PSSM1Samp, coord.xy, radius, receiverDepth, noise, 0);
	}
	else if (coord.w == 1)
	{
		clip(tex2Dlod(PSSM2Samp, float4(coord.xy, 0, 0)).r - 1e-5);
		shadow = ShadowPCF(PSSM2Samp, coord.xy, radius, receiverDepth, noise, 1);
	}
	else if (coord.w == 2)
	{
		clip(tex2Dlod(PSSM3Samp, float4(coord.xy, 0, 0)).r - 1e-5);
		shadow = ShadowPCF(PSSM3Samp, coord.xy, radius, receiverDepth, noise, 2);
	}
	else
	{
		clip(tex2Dlod(PSSM4Samp, float4(coord.xy, 0, 0)).r - 1e-5);
		shadow = ShadowPCF(PSSM4Samp, coord.xy, radius, receiverDepth, noise, 3);
	}
#endif

	return shadow * terminator;
}

float4 ShadowMapGenPS(
	in float2 coord : TEXCOORD0,
	in float3 viewdir : TEXCOORD1) : COLOR
{
	float4 MRT8 = tex2Dlod(Gbuffer8Map, float4(coord, 0, 0));
	clip(MRT8.x - 1e-5);

	MaterialParam material;
	material.linearDepth = MRT8.x;
	material.visibility = MRT8.z;

	clip(any(material.visibility) - 1e-5);

	float4 MRT6 = tex2Dlod(Gbuffer6Map, float4(coord, 0, 0));
	material.normal = DecodeNormal(MRT6.xyz);

	float3 viewPosition = viewdir * (material.linearDepth / viewdir.z);

	float shadow = ShadingShadow(material, viewPosition);

#if CONTACT_SHADOW_QUALITY >= 1
	float3 L = mul(-SunDirection, (float3x3)matView);
	float contactShadow = GetContactShadow(viewPosition, material.normal, L, coord, material.linearDepth);
	shadow *= contactShadow;
#if SSGS_QUALITY >= 1
	shadow *= GetGlobalShadow(viewPosition, material.normal, L, coord);
#endif
#elif SSGS_QUALITY >= 1
	float3 L_ssgs = mul(-SunDirection, (float3x3)matView);
	shadow *= GetGlobalShadow(viewPosition, material.normal, L_ssgs, coord);
#endif

	return shadow;
}

#if SHADOW_BLUR_COUNT
float4 ShadowMapBlurPS(float2 coord : TEXCOORD0, uniform sampler source, uniform float2 offset) : COLOR
{
	float2 offset1 = coord + offset;
	float2 offset2 = coord - offset;

	float totalWeight = 1;
	float totalColor = tex2Dlod(source, float4(coord, 0, 0)).r;

	float center_d = tex2Dlod(Gbuffer8Map, float4(coord, 0, 0)).r;

	[unroll]
	for(int r = 1; r < SHADOW_BLUR_COUNT; r++)
	{
		float shadow1 = tex2Dlod(source, float4(offset1, 0, 0)).r;
		float shadow2 = tex2Dlod(source, float4(offset2, 0, 0)).r;

		float depth1 = tex2Dlod(Gbuffer8Map, float4(offset1, 0, 0)).r;
		float depth2 = tex2Dlod(Gbuffer8Map, float4(offset2, 0, 0)).r;

		float bilateralWeight1 = BilateralWeight(r, depth1, center_d, SHADOW_BLUR_COUNT, 10);
		float bilateralWeight2 = BilateralWeight(r, depth2, center_d, SHADOW_BLUR_COUNT, 10);

		totalColor += shadow1 * bilateralWeight1;
		totalColor += shadow2 * bilateralWeight2;

		totalWeight += bilateralWeight1;
		totalWeight += bilateralWeight2;

		offset1 += offset;
		offset2 -= offset;
	}

	return totalColor / totalWeight;
}
#endif
