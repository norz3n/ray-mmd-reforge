#define SHADOW_BLUR_COUNT 6

#if CONTACT_SHADOW_QUALITY >= 1 || SSGS_QUALITY >= 1
#	include "shader/ContactShadow.fxsub"
#endif

static float4x4 matLightProject = CreateOrthoProject(2, 2, mPSSMDepthZMin, mPSSMDepthZMax);
static float4x4 matLightView = CreateLightViewMatrix(SunDirection, -SunDirection, mLightDistance);
static float4x4 matLightViewProject = mul(matLightView, matLightProject);
static float4x4 matLightViewFromCameraView = mul(matViewInverse, matLightView);
static float4x4 matLightProjectFromCameraView = mul(matViewInverse, matLightViewProject);
static float4x4 lightCropParams = CreateLightCropParams(matLightViewFromCameraView, SHADOW_MAP_SIZE);

static const float2 ShadowMapOffset  = 0.5 / SHADOW_MAP_SIZE;
static const float2 ShadowMapOffset2 = 1.0 / SHADOW_MAP_SIZE;

#ifndef SUN_SHADOW_VSM_QUALITY
#	define SUN_SHADOW_VSM_QUALITY 4
#endif

#if SUN_SHADOW_VSM_QUALITY == 1
#	define VSM_SAMPLES 1
#elif SUN_SHADOW_VSM_QUALITY == 2
#	define VSM_SAMPLES 4
static const float2 kVSMDisk[4] = {
	float2( 0.000000f,  0.500000f),
	float2( 0.500000f,  0.000000f),
	float2( 0.000000f, -0.500000f),
	float2(-0.500000f,  0.000000f)
};
#elif SUN_SHADOW_VSM_QUALITY == 3
#	define VSM_SAMPLES 8
static const float2 kVSMDisk[8] = {
	float2( 0.000000f,  0.000000f),
	float2( 0.527046f,  0.000000f),
	float2(-0.263523f,  0.653197f),
	float2(-0.359670f, -0.706606f),
	float2( 0.830147f,  0.222437f),
	float2(-0.883074f,  0.336621f),
	float2( 0.433190f, -0.887015f),
	float2( 0.297439f,  0.998844f)
};
#else
#	define VSM_SAMPLES 12
static const float2 kVSMDisk[12] = {
	float2( 0.000000f,  0.000000f),
	float2( 0.435794f,  0.000000f),
	float2(-0.217897f,  0.540166f),
	float2(-0.297446f, -0.584347f),
	float2( 0.686532f,  0.183955f),
	float2(-0.730303f,  0.278385f),
	float2( 0.358249f, -0.733560f),
	float2( 0.245842f,  0.826040f),
	float2(-0.771960f, -0.445690f),
	float2( 0.908075f, -0.193026f),
	float2(-0.640656f,  0.697920f),
	float2( 0.053535f, -0.967005f)
};
#endif

float2 RotateSample(float2 pos, float2 rotation)
{
	return float2(pos.x * rotation.x - pos.y * rotation.y, pos.y * rotation.x + pos.x * rotation.y);
}

float2 SampleMoments(sampler source, float2 coord, float2 rotation, float filterRadius)
{
#if VSM_SAMPLES == 1
	return tex2Dlod(source, float4(coord, 0, 0)).rg;
#else
	float2 moments = 0.0f;
	float2 rotScale = rotation * (filterRadius * ShadowMapOffset2);

	[unroll]
	for (int i = 0; i < VSM_SAMPLES; i++)
	{
		float2 pos = coord + RotateSample(kVSMDisk[i], rotScale);
		moments += tex2Dlod(source, float4(pos, 0, 0)).rg * (1.0f / float(VSM_SAMPLES));
	}
	return moments;
#endif
}

float SampleCascadeShadowSingle(sampler source, float2 coord, float receiverDepth, float2 rotation, int cascadeIndex)
{
	float cascadeRadius = mSunVSMFilterRadius * (1.0f / (1.0f + cascadeIndex * 0.25f));
	float2 moments = SampleMoments(source, coord, rotation, cascadeRadius);

	[flatten]
	if (moments.x < 1e-5f)
		return 1.0f;

	return ChebyshevUpperBound(moments, receiverDepth, mSunVSMMinVariance, mSunVSMLightBleedingReduction);
}

float SampleCascadeShadowMap(int index, float2 coord, float receiverDepth, float2 rotation)
{
	[branch]
	if (index == 0)
		return SampleCascadeShadowSingle(VSM1Samp, coord, receiverDepth, rotation, 0);
	else if (index == 1)
		return SampleCascadeShadowSingle(VSM2Samp, coord, receiverDepth, rotation, 1);
	else if (index == 2)
		return SampleCascadeShadowSingle(VSM3Samp, coord, receiverDepth, rotation, 2);
	else
		return SampleCascadeShadowSingle(VSM4Samp, coord, receiverDepth, rotation, 3);
}

float ShadingShadow(MaterialParam material, float3 viewPosition)
{
	float3 L = mul(-SunDirection, (float3x3)matView);
	float cosTheta = dot(material.normal, L);

	// Terminator cutoff: surfaces facing away from sunlight are in full self-shadow
	float terminator = saturate(cosTheta * 12.0f);
	[branch]
	if (terminator <= 0.0f)
	{
		return 0.0f;
	}

	float normalBias = saturate(1.0f - saturate(cosTheta));

	float4 proj = mul(float4(viewPosition, 1), matLightProjectFromCameraView);

	float4 lightPPos01 = proj.xyxy * float4(lightCropParams[0].xy, lightCropParams[1].xy) + float4(lightCropParams[0].zw, lightCropParams[1].zw);
	float4 lightPPos23 = proj.xyxy * float4(lightCropParams[2].xy, lightCropParams[3].xy) + float4(lightCropParams[2].zw, lightCropParams[3].zw);

	float4 lightCoord01 = PosToCoord(lightPPos01);
	float4 lightCoord23 = PosToCoord(lightPPos23);

	float4 lightPPos0 = float4(lightCoord01.xy, min2(float2(1, 1) - abs(lightPPos01.xy)), 0);
	float4 lightPPos1 = float4(lightCoord01.zw, min2(float2(1, 1) - abs(lightPPos01.zw)), 1);
	float4 lightPPos2 = float4(lightCoord23.xy, min2(float2(1, 1) - abs(lightPPos23.xy)), 2);
	float4 lightPPos3 = float4(lightCoord23.zw, min2(float2(1, 1) - abs(lightPPos23.zw)), 3);

	float4 coord = lightPPos3;
	if (lightPPos2.z > 0) { coord = lightPPos2; }
	if (lightPPos1.z > 0) { coord = lightPPos1; }
	if (lightPPos0.z > 0) { coord = lightPPos0; }
	clip(coord.z);

	float depthSlope = ShadowSlopeScaledBias(proj.z / mPSSMDepthZMax) * mPSSMDepthZMax;
	float receiverDepth = dot(float4(viewPosition, 1), matLightViewFromCameraView._13_23_33_43);
	float baseBias = (material.linearDepth + depthSlope * (1.0f + normalBias * 2.0f)) * 0.0035f + max(0.0f, material.linearDepth - 100.0f) * 0.007f;
	receiverDepth -= baseBias;

	float angle = InterleavedGradientNoise(coord.xy * SHADOW_MAP_SIZE) * PI_2;
	float2 rotation = float2(cos(angle), sin(angle));

	float shadow = SampleCascadeShadowMap(int(coord.w), coord.xy + ShadowMapOffset, receiverDepth, rotation);

	return shadow * terminator;
}

float4 ShadowMapGenPS(
	in float2 coord : TEXCOORD0,
	in float3 viewdir : TEXCOORD1) : COLOR
{
	float4 MRT8 = tex2Dlod(Gbuffer8Map, float4(coord, 0, 0));
	clip(MRT8.x - 1e-5);

	MaterialParam material;
	material.linearDepth = MRT8.x;
	material.visibility = MRT8.z;

	clip(any(material.visibility) - 1e-5);

	float4 MRT6 = tex2Dlod(Gbuffer6Map, float4(coord, 0, 0));
	material.normal = DecodeNormal(MRT6.xyz);

	float3 viewPosition = viewdir * (material.linearDepth / viewdir.z);

	float shadow = ShadingShadow(material, viewPosition);

#if CONTACT_SHADOW_QUALITY >= 1
	float3 L = mul(-SunDirection, (float3x3)matView);
	float contactShadow = GetContactShadow(viewPosition, material.normal, L, coord, material.linearDepth);
	shadow *= contactShadow;
#if SSGS_QUALITY >= 1
	shadow *= GetGlobalShadow(viewPosition, material.normal, L, coord);
#endif
#elif SSGS_QUALITY >= 1
	float3 L_ssgs = mul(-SunDirection, (float3x3)matView);
	shadow *= GetGlobalShadow(viewPosition, material.normal, L_ssgs, coord);
#endif

	return shadow;
}

#if SHADOW_BLUR_COUNT
float4 ShadowMapBlurPS(float2 coord : TEXCOORD0, uniform sampler source, uniform float2 offset) : COLOR
{
	float2 offset1 = coord + offset;
	float2 offset2 = coord - offset;

	float totalWeight = 1;
	float totalColor = tex2Dlod(source, float4(coord, 0, 0)).r;

	float center_d = tex2Dlod(Gbuffer8Map, float4(coord, 0, 0)).r;

	[unroll]
	for(int r = 1; r < SHADOW_BLUR_COUNT; r++)
	{
		float shadow1 = tex2Dlod(source, float4(offset1, 0, 0)).r;
		float shadow2 = tex2Dlod(source, float4(offset2, 0, 0)).r;

		float depth1 = tex2Dlod(Gbuffer8Map, float4(offset1, 0, 0)).r;
		float depth2 = tex2Dlod(Gbuffer8Map, float4(offset2, 0, 0)).r;

		float bilateralWeight1 = BilateralWeight(r, depth1, center_d, SHADOW_BLUR_COUNT, 10);
		float bilateralWeight2 = BilateralWeight(r, depth2, center_d, SHADOW_BLUR_COUNT, 10);

		totalColor += shadow1 * bilateralWeight1;
		totalColor += shadow2 * bilateralWeight2;

		totalWeight += bilateralWeight1;
		totalWeight += bilateralWeight2;

		offset1 += offset;
		offset2 -= offset;
	}

	return totalColor / totalWeight;
}
#endif
