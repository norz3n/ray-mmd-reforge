float4 SSSSStencilTestPS(in float2 coord : TEXCOORD0) : COLOR
{
	int lightModelOpaque = DecodeLightModel(tex2Dlod(Gbuffer4Map, float4(coord, 0, 0)));
	int lightModelAlpha  = DecodeLightModel(tex2Dlod(Gbuffer8Map, float4(coord, 0, 0)));
	if (lightModelOpaque != SHADINGMODELID_SKIN &&
		lightModelOpaque != SHADINGMODELID_SUBSURFACE &&
		lightModelAlpha != SHADINGMODELID_SKIN &&
		lightModelAlpha != SHADINGMODELID_SUBSURFACE)
	{
		clip(-1);
	}

	return 1;
}

float4 SSSGaussBlurVS(
	in float4 Position : POSITION,
	in float4 Texcoord : TEXCOORD,
	out float4 oTexcoord0 : TEXCOORD0,
	out float4 oTexcoord1 : TEXCOORD1) : POSITION
{
	oTexcoord0 = Texcoord;
	oTexcoord0.xy += ViewportOffset;
	oTexcoord0.zw = oTexcoord0.xy * ViewportSize;
	oTexcoord1 = GetProjConstant(); 
	return Position;
}

float4 SSSGaussBlurPS(
	in float2 coord : TEXCOORD0,
	in float4 projConstant : TEXCOORD1,
	uniform sampler source,
	uniform sampler original,
	uniform float2 direction) : COLOR
{
	// 11-Tap Jimenez sample offsets (5 symmetric pairs + center)
	const float offsets[5] = { 0.080f, 0.220f, 0.450f, 0.780f, 1.300f };

	// Christensen-Burley Spectral Diffusion Profiles:
	// Profile 0: Skin (Human / Anime epidermis & subdermal blood absorption)
	// Profile 1: Subsurface (Deep red tissue / thin ears / nostrils)
	const float3 cCenterWeights[2] = {
		float3(0.240f, 0.380f, 0.480f),
		float3(0.180f, 0.350f, 0.500f)
	};

	const float3 cPairWeights[2][5] = {
		// Skin Profile weights
		{
			float3(0.160f, 0.150f, 0.130f),
			float3(0.110f, 0.080f, 0.065f),
			float3(0.065f, 0.045f, 0.040f),
			float3(0.035f, 0.025f, 0.015f),
			float3(0.010f, 0.010f, 0.010f)
		},
		// Subsurface / Thin tissue Profile weights
		{
			float3(0.160f, 0.150f, 0.120f),
			float3(0.120f, 0.085f, 0.060f),
			float3(0.075f, 0.050f, 0.035f),
			float3(0.040f, 0.030f, 0.025f),
			float3(0.015f, 0.010f, 0.010f)
		}
	};

	float4 MRT2 = tex2Dlod(Gbuffer2Map, float4(coord, 0, 0));
	float4 MRT4 = tex2Dlod(Gbuffer4Map, float4(coord, 0, 0));

	float3 N = DecodeNormal(MRT2.xyz);
	float linearDepth = MRT4.x;
	float customDataA = MRT2.w;
	int lightModel = (int)floor(MRT4.w);

	// Fallback to alpha G-buffers if opaque linearDepth is empty
	if (linearDepth <= 1e-4f)
	{
		float4 MRT6 = tex2Dlod(Gbuffer6Map, float4(coord, 0, 0));
		float4 MRT8 = tex2Dlod(Gbuffer8Map, float4(coord, 0, 0));
		linearDepth = MRT8.x;
		lightModel = (int)floor(MRT8.w);
		N = DecodeNormal(MRT6.xyz);
		customDataA = MRT6.w;
	}

	// Early out if depth is invalid
	if (linearDepth <= 1e-4f)
	{
		return tex2Dlod(source, float4(coord, 0, 0));
	}

	float3 P = GetViewPosition(projConstant, coord, linearDepth);

	// Perspective correction: single NdotV scalar keeps both passes symmetric.
	// ponytail: direction-split projection was tried but caused oval dark patches; upgrade if per-axis correction is ever needed.
	float perspectiveScale = lerp(0.3f, 1.0f, saturate(dot(N, normalize(-P))));

	int profileIndex = (lightModel == SHADINGMODELID_SKIN) ? 0 : 1;
	float sssAmount = saturate(customDataA);
	float sssStrength = (lightModel == SHADINGMODELID_SKIN) ? 1.0f : sssAmount;
	float sssWidthScale = (lightModel == SHADINGMODELID_SKIN) ? mSSSSScale : (mSSSSScale * 2.5f);
	
	// World-space SSS radius scaled by perspective distance
	float sssRadius = (0.0055f * sssStrength * perspectiveScale) / max(sssWidthScale, 0.01f);

	float4 centerColor = tex2Dlod(source, float4(coord, 0, 0));
	float3 totalColor = centerColor.rgb * cCenterWeights[profileIndex];
	float3 totalWeight = cCenterWeights[profileIndex];

	float2 sampleStep = direction * (sssRadius / max(linearDepth, 0.1f)) * float2(1.0f / ViewportAspect, 1.0f);

	// Scalar ratio-clamp: treats horizontal and vertical passes identically,
	// avoiding the oval kernel produced by the old 2D Euclidean clamp.
	// Still caps miniature-model blow-out. ponytail: upgrade to per-axis clamp if anisotropic SSS ever needed.
	const float kMaxStepRatio = 0.04f;
	float stepRatio = sssRadius / max(linearDepth, 0.1f);
	if (stepRatio > kMaxStepRatio)
		sampleStep *= kMaxStepRatio / stepRatio;

	// 11-Tap separable convolution with bilateral depth & normal weighting
	[unroll]
	for (int i = 0; i < 5; ++i)
	{
		float tapOffset = offsets[i];
		float2 offset1 = coord + tapOffset * sampleStep;
		float2 offset2 = coord - tapOffset * sampleStep;

		float4 sampleColor1 = tex2Dlod(source, float4(offset1, 0, 0));
		float4 sampleColor2 = tex2Dlod(source, float4(offset2, 0, 0));

		// Scale-invariant bilateral depth tolerance:
		// Proportional to physical tap span in world space + relative linear depth scale.
		// Avoids absolute world-space floors (e.g. 0.08) that bleed through miniature/doll-size models.
		float depthTolerance = max(tapOffset * sssRadius * 3.5f, max(linearDepth * 0.035f, 1e-4f));
		float depthWeight1 = saturate(1.0f - abs(sampleColor1.a - linearDepth) / depthTolerance);
		float depthWeight2 = saturate(1.0f - abs(sampleColor2.a - linearDepth) / depthTolerance);

		float3 N1 = DecodeNormal(tex2Dlod(Gbuffer2Map, float4(offset1, 0, 0)).xyz);
		float3 N2 = DecodeNormal(tex2Dlod(Gbuffer2Map, float4(offset2, 0, 0)).xyz);
		float dotN1 = dot(N1, N);
		float dotN2 = dot(N2, N);
		float normalWeight1 = (dotN1 > 0.0f) ? pow(dotN1, 1.25f) : 0.0f;
		float normalWeight2 = (dotN2 > 0.0f) ? pow(dotN2, 1.25f) : 0.0f;

		float3 w1 = cPairWeights[profileIndex][i] * (normalWeight1 * depthWeight1);
		float3 w2 = cPairWeights[profileIndex][i] * (normalWeight2 * depthWeight2);

		totalWeight += w1 + w2;
		totalColor += w1 * sampleColor1.rgb + w2 * sampleColor2.rgb;
	}

	float3 finalColor = totalColor / max(totalWeight, 1e-4f);

	// Detail preservation blend on second pass (suppressed for skin to prevent re-introducing unblurred harsh shadow edges)
	if (direction.y > 0.01f)
	{
		float4 origColor = tex2Dlod(original, float4(coord, 0, 0));
		float blendFactor = (lightModel == SHADINGMODELID_SKIN) ? 0.0f : (0.45f * (1.0f - sssAmount));
		finalColor = lerp(finalColor, origColor.rgb, blendFactor);
	}

	return float4(finalColor, centerColor.a);
}