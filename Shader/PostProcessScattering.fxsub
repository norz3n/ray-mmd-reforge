float4 SSSSStencilTestPS(in float2 coord : TEXCOORD0) : COLOR
{
	float lightModel = DecodeLightModel(tex2Dlod(Gbuffer8Map, float4(coord, 0, 0)));
	if (lightModel != SHADINGMODELID_SKIN &&
		lightModel != SHADINGMODELID_SUBSURFACE)
	{
		clip(-1);
	}

	return 1;
}

float4 SSSGaussBlurVS(
	in float4 Position : POSITION,
	in float4 Texcoord : TEXCOORD,
	out float4 oTexcoord0 : TEXCOORD0,
	out float4 oTexcoord1 : TEXCOORD1) : POSITION
{
	oTexcoord0 = Texcoord;
	oTexcoord0.xy += ViewportOffset;
	oTexcoord0.zw = oTexcoord0.xy * ViewportSize;
	oTexcoord1 = GetProjConstant(); 
	return Position;
}

float4 SSSGaussBlurPS(
	in float2 coord : TEXCOORD0,
	in float4 projConstant : TEXCOORD1,
	uniform sampler source,
	uniform sampler original,
	uniform float2 direction) : COLOR
{
	const float offsets[6] = { 0.352, 0.719, 1.117, 1.579, 2.177, 3.213 };

	const float3 profileVarArr[2] = { float3(6.6, 5.6, 2.8), float3(9.6, 2.8, 2.2) };
	const float4 profileSpikeRadArr[2] = { float4(0.30, 0.30, 0.80, 8.0 ), float4(0.35, 0.40, 0.50, 1.0) };

	float4 MRT2 = tex2Dlod(Gbuffer2Map, float4(coord, 0, 0));
	float4 MRT4 = tex2Dlod(Gbuffer4Map, float4(coord, 0, 0));

	float3 N = DecodeNormal(MRT2.xyz);
	float linearDepth = MRT4.x;
	float customDataA = MRT2.w;
	int lightModel = (int)floor(MRT4.w);

	float3 P = GetViewPosition(projConstant, coord, linearDepth);

	// Epsilon guards: normalize() explodes when the normal points straight at the camera
	// (N.xz ~ 0) or the pixel sits on the view axis (P.xz ~ 0), turning sssRadius into NaN
	float perspectiveScaleX = dot(normalize(N.xz + 1e-6f), normalize(-P.xz + 1e-6f));
	float perspectiveScaleY = dot(normalize(N.yz + 1e-6f), normalize(-P.yz + 1e-6f));
	float perspectiveScale = max(dot(direction, float2(perspectiveScaleX, perspectiveScaleY)), 0.3);

	float sssAmount = customDataA;
	float sssIndex = (lightModel != SHADINGMODELID_SKIN) ? 0 : 1;
	float sssStrength = (lightModel != SHADINGMODELID_SKIN) ? sssAmount : 1;
	float sssWidth = (lightModel != SHADINGMODELID_SKIN) ? mSSSSScale * 3 : mSSSSScale;
	float sssRadius = 0.0055 * profileSpikeRadArr[sssIndex].w * sssStrength * perspectiveScale / sssWidth;

	float3 sampleWeight = 1;
	float4 sampleColor = tex2Dlod(source, float4(coord, 0, 0));
	float2 sampleStep = direction * sssRadius / linearDepth;

	// Bound the kernel footprint: a world-space radius can swallow an entire miniature
	// model (every body part inside one kernel mixes into mush) when the camera is close
	float2 maxStep = 16.0f * ViewportOffset2;
	float stepLenSq = dot(sampleStep, sampleStep);
	float maxLenSq = dot(maxStep, maxStep);
	if (stepLenSq > maxLenSq)
		sampleStep *= sqrt(maxLenSq / stepLenSq);

	[unroll]
	for (int i = 0; i < 6; i++)
	{
		float tapOffset = offsets[i] / 5.5;
		float2 offset1 = coord + tapOffset * sampleStep;
		float2 offset2 = coord - tapOffset * sampleStep;

		float4 sampleColor1 = tex2Dlod(source, float4(offset1, 0, 0));
		float4 sampleColor2 = tex2Dlod(source, float4(offset2, 0, 0));

		// Scale-invariant depth gate: the tolerance tracks the world-space distance the tap
		// spans (tapOffset * sssRadius), so the kernel stays sealed on tiny models where
		// absolute depth deltas collapse to near zero and everything bled through everything
		float depthTolerance = max(tapOffset * sssRadius * 2.0f, 1e-5f);
		float depthWeight1 = saturate(1.0f - abs(sampleColor1.a - linearDepth) / depthTolerance);
		float depthWeight2 = saturate(1.0f - abs(sampleColor2.a - linearDepth) / depthTolerance);

		float3 N1 = DecodeNormal(tex2Dlod(Gbuffer2Map, float4(offset1, 0, 0)).xyz);
		float3 N2 = DecodeNormal(tex2Dlod(Gbuffer2Map, float4(offset2, 0, 0)).xyz);
		float normalWeight1 = saturate(dot(N1, N));
		float normalWeight2 = saturate(dot(N2, N));
		float normalScale1 = normalWeight1 * normalWeight1;
		float normalScale2 = normalWeight2 * normalWeight2;

		float3 weight1 = exp(-(offsets[i] * offsets[i]) / profileVarArr[sssIndex]) * normalScale1 * depthWeight1;
		float3 weight2 = exp(-(offsets[i] * offsets[i]) / profileVarArr[sssIndex]) * normalScale2 * depthWeight2;
		
		sampleWeight += weight1;
		sampleWeight += weight2;

		sampleColor.rgb += weight1 * sampleColor1.rgb;
		sampleColor.rgb += weight2 * sampleColor2.rgb;
	}

	sampleColor.rgb /= max(sampleWeight, 1e-4f);

	if (direction.y > 0.01)
	{
		sampleColor.rgb = lerp(sampleColor.rgb, tex2Dlod(original, float4(coord, 0, 0)).rgb, profileSpikeRadArr[sssIndex].xyz * (1 - sssAmount));
	}

	return sampleColor;
}