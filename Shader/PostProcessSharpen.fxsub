// ponytail: AMD FidelityFX CAS (Contrast Adaptive Sharpening) 1.2 with CAS_BETTER_DIAGONALS 3x3 kernel
float3 CASSharpen(sampler2D source, float2 coord, float2 offset, float sharpness)
{
	// 3x3 sample neighborhood:
	// a b c
	// d e f
	// g h i
	float3 a = tex2Dlod(source, float4(coord + float2(-offset.x, -offset.y), 0, 0)).rgb;
	float3 b = tex2Dlod(source, float4(coord + float2(0, -offset.y), 0, 0)).rgb;
	float3 c = tex2Dlod(source, float4(coord + float2(offset.x, -offset.y), 0, 0)).rgb;
	float3 d = tex2Dlod(source, float4(coord + float2(-offset.x, 0), 0, 0)).rgb;
	float3 e = tex2Dlod(source, float4(coord, 0, 0)).rgb;
	float3 f = tex2Dlod(source, float4(coord + float2(offset.x, 0), 0, 0)).rgb;
	float3 g = tex2Dlod(source, float4(coord + float2(-offset.x, offset.y), 0, 0)).rgb;
	float3 h = tex2Dlod(source, float4(coord + float2(0, offset.y), 0, 0)).rgb;
	float3 i = tex2Dlod(source, float4(coord + float2(offset.x, offset.y), 0, 0)).rgb;

	// Soft min and max (CAS_BETTER_DIAGONALS: Cross min/max + Box 3x3 min/max)
	float3 mnCross = min(min(min(d, e), f), min(b, h));
	float3 mnBox   = min(min(min(mnCross, a), c), min(g, i));
	float3 mn      = mnCross + mnBox;

	float3 mxCross = max(max(max(d, e), f), max(b, h));
	float3 mxBox   = max(max(max(mxCross, a), c), max(g, i));
	float3 mx      = mxCross + mxBox;

	// Smooth minimum distance to signal limit divided by smooth max
	float3 amp = saturate(min(mn, 2.0 - mx) / max(mx, 1e-5));
	amp = sqrt(amp);

	// Shaping sharpness: Peak weight from AMD CasSetup: sharp = -1.0 / lerp(8.0, 5.0, sharpness)
	float peak = -1.0 / lerp(8.0, 5.0, saturate(sharpness));
	float3 w = amp * peak;

	// Filter kernel normalization and output
	float3 rcpWeight = 1.0 / (1.0 + 4.0 * w);
	float3 result = (b * w + d * w + f * w + h * w + e) * rcpWeight;
	return saturate(result);
}

// ponytail: Sine-free isotropic GPU hash eliminates 1D projection moire and diagonal artifacts
float2 Hash23(float3 p)
{
	float3 p3 = frac(p * float3(0.1031f, 0.1030f, 0.0973f));
	p3 += dot(p3, p3.yzx + 33.33f);
	return frac((p3.xx + p3.yz) * p3.zy);
}

// Procedural Cinematic Film Grain
float3 ApplyFilmGrain(float3 color, float2 coord, float time, float intensity)
{
	// High-frequency decorrelated noise in pixel space with temporal jitter
	float2 pixelPos = coord * ViewportSize;
	float2 noise2D = Hash23(float3(pixelPos, frac(time) * 1000.0f));
	
	// Triangular probability density function (TPDF) for soft photographic grain distribution [-1, 1]
	float noise = (noise2D.x - noise2D.y) * intensity;
	
	// Blend: Parabolic curve to softly fade grain in deep shadows and bright highlights
	float luma = dot(color, float3(0.299f, 0.587f, 0.114f));
	float grainWeight = 1.0f - pow(abs(luma - 0.5f) * 2.0f, 2.0f);
	
	return saturate(color + noise * grainWeight);
}

#ifndef POST_SHARPEN_INTENSITY
#	define POST_SHARPEN_INTENSITY 0.5
#endif

#ifndef FILM_GRAIN_ENABLE
#	define FILM_GRAIN_ENABLE 0
#endif

#ifndef FILM_GRAIN_INTENSITY
#	define FILM_GRAIN_INTENSITY 0.05
#endif

float4 PostProcessSharpenPS(in float2 coord : TEXCOORD0, uniform sampler2D source, uniform float2 offset) : COLOR
{
	float3 finalColor = CASSharpen(source, coord, offset, POST_SHARPEN_INTENSITY);

#if FILM_GRAIN_ENABLE
	finalColor = ApplyFilmGrain(finalColor, coord, time, FILM_GRAIN_INTENSITY);
#endif

	return float4(ColorDithering(finalColor, coord), 1.0);
}
