/**
 * Hexagonal Bokeh Depth of Field
 * Clean Room Implementation for Ray-MMD
 * Reference: Colin Barré-Brisebois (2017) "Hexagonal Bokeh Blur Revisited"
 * https://colinbarrebrisebois.com/2017/04/18/hexagonal-bokeh-blur-revisited/
 */

#define DOF_BLUR_RADIUS 8
#define DOF_POSSION_RADIUS 20
#define DOF_POSSION_RINGS 5
#define DOF_POSSION_POINT_PER_RING 8
#define DOF_POSSION_SAMPLES 61

static const float _HexagonalBokehAngle = 1.236f;

static const float4 _FocalCoCMap_TexelSize = float4(1.0f / ViewportSize, ViewportSize);
static const float4 _FocalBokehMap_TexelSize = float4(2.0f / ViewportSize, ViewportSize * 0.5f);

texture AutoFocalMap : RENDERCOLORTARGET<int2 Dimensions = {1, 1}; string Format="R16F";>;
texture FocalCoCMap : RENDERCOLORTARGET<float2 ViewportRatio={1.0, 1.0}; string Format="R16F";>;
texture FocalBokehMap : RENDERCOLORTARGET<float2 ViewportRatio={0.5, 0.5}; string Format="A16B16G16R16F";>;
texture FocalBlur1Map : RENDERCOLORTARGET<float2 ViewportRatio={0.5, 0.5}; string Format="A16B16G16R16F";>;
texture FocalBlur2Map : RENDERCOLORTARGET<float2 ViewportRatio={0.5, 0.5}; string Format="A16B16G16R16F";>;
texture FocalHexBokehMap : RENDERCOLORTARGET<float2 ViewportRatio={0.5, 0.5}; string Format="A16B16G16R16F";>;

sampler AutoFocalMapPointSamp = sampler_state
{
	texture = <AutoFocalMap>;
	MinFilter = POINT; MagFilter = POINT; MipFilter = NONE;
	AddressU = CLAMP; AddressV = CLAMP;
};

sampler FocalCoCMapPointSamp = sampler_state
{
	texture = <FocalCoCMap>;
	MinFilter = POINT; MagFilter = POINT; MipFilter = NONE;
	AddressU = CLAMP; AddressV = CLAMP;
};

sampler FocalCoCMapLinearSamp = sampler_state
{
	texture = <FocalCoCMap>;
	MinFilter = LINEAR; MagFilter = LINEAR; MipFilter = NONE;
	AddressU = CLAMP; AddressV = CLAMP;
};

sampler FocalBokehMapPointSamp = sampler_state
{
	texture = <FocalBokehMap>;
	MinFilter = POINT; MagFilter = POINT; MipFilter = NONE;
	AddressU = CLAMP; AddressV = CLAMP;
};

sampler FocalBokehMapLinearSamp = sampler_state
{
	texture = <FocalBokehMap>;
	MinFilter = LINEAR; MagFilter = LINEAR; MipFilter = NONE;
	AddressU = CLAMP; AddressV = CLAMP;
};

sampler FocalBlur1MapPointSamp = sampler_state
{
	texture = <FocalBlur1Map>;
	MinFilter = POINT; MagFilter = POINT; MipFilter = NONE;
	AddressU = CLAMP; AddressV = CLAMP;
};

sampler FocalBlur1MapLinearSamp = sampler_state
{
	texture = <FocalBlur1Map>;
	MinFilter = LINEAR; MagFilter = LINEAR; MipFilter = NONE;
	AddressU = CLAMP; AddressV = CLAMP;
};

sampler FocalBlur2MapPointSamp = sampler_state
{
	texture = <FocalBlur2Map>;
	MinFilter = POINT; MagFilter = POINT; MipFilter = NONE;
	AddressU = CLAMP; AddressV = CLAMP;
};

sampler FocalBlur2MapLinearSamp = sampler_state
{
	texture = <FocalBlur2Map>;
	MinFilter = LINEAR; MagFilter = LINEAR; MipFilter = NONE;
	AddressU = CLAMP; AddressV = CLAMP;
};

sampler FocalHexBokehMapPointSamp = sampler_state
{
	texture = <FocalHexBokehMap>;
	MinFilter = POINT; MagFilter = POINT; MipFilter = NONE;
	AddressU = CLAMP; AddressV = CLAMP;
};

sampler FocalHexBokehMapLinearSamp = sampler_state
{
	texture = <FocalHexBokehMap>;
	MinFilter = LINEAR; MagFilter = LINEAR; MipFilter = NONE;
	AddressU = CLAMP; AddressV = CLAMP;
};

