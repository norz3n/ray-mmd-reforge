/**
 * Ray-MMD ReForge: Screen-Space Reflections (SSR) Post-Processing Pipeline
 *
 * Implements physically based screen-space cone-traced reflections with
 * multi-resolution roughness pyramid filtering and Fresnel attenuation.
 *
 * Credit: material by dendewa (Ray-LAB) - implementation reference.
 */

#ifndef RAY_MMD_POST_PROCESS_SSR_FXSUB
#define RAY_MMD_POST_PROCESS_SSR_FXSUB

#if SSR_QUALITY == 1
#	define SSR_MAX_RAY_STEPS 16
#elif SSR_QUALITY == 2
#	define SSR_MAX_RAY_STEPS 32
#elif SSR_QUALITY >= 3
#	define SSR_MAX_RAY_STEPS 64
#else
#	define SSR_MAX_RAY_STEPS 16
#endif

// Blur filter offsets for roughness mip levels
static const float2 SSRBlurKernelScale = mSSRBlur * float2(ViewportAspect, 1.0f);

static const float2 SSRBlurStepX1 = float2(1.0f / SSRBlurKernelScale.x, 0.0f);
static const float2 SSRBlurStepX2 = float2(2.0f / SSRBlurKernelScale.x, 0.0f);
static const float2 SSRBlurStepX3 = float2(4.0f / SSRBlurKernelScale.x, 0.0f);
static const float2 SSRBlurStepX4 = float2(8.0f / SSRBlurKernelScale.x, 0.0f);

static const float2 SSRBlurStepY1 = float2(0.0f, 1.0f / SSRBlurKernelScale.y);
static const float2 SSRBlurStepY2 = float2(0.0f, 2.0f / SSRBlurKernelScale.y);
static const float2 SSRBlurStepY3 = float2(0.0f, 4.0f / SSRBlurKernelScale.y);
static const float2 SSRBlurStepY4 = float2(0.0f, 8.0f / SSRBlurKernelScale.y);

// For technique compatibility with ray.fx
static const float2 SSROffsetX1 = SSRBlurStepX1;
static const float2 SSROffsetX2 = SSRBlurStepX2;
static const float2 SSROffsetX3 = SSRBlurStepX3;
static const float2 SSROffsetX4 = SSRBlurStepX4;
static const float2 SSROffsetY1 = SSRBlurStepY1;
static const float2 SSROffsetY2 = SSRBlurStepY2;
static const float2 SSROffsetY3 = SSRBlurStepY3;
static const float2 SSROffsetY4 = SSRBlurStepY4;

texture SSRLightX1Map : RENDERCOLORTARGET<float2 ViewportRatio = {1.0, 1.0}; string Format = "A16B16G16R16F";>;
texture SSRLightX2Map : RENDERCOLORTARGET<float2 ViewportRatio = {0.5, 0.5}; string Format = "A16B16G16R16F";>;
texture SSRLightX3Map : RENDERCOLORTARGET<float2 ViewportRatio = {0.25, 0.25}; string Format = "A16B16G16R16F";>;
texture SSRLightX4Map : RENDERCOLORTARGET<float2 ViewportRatio = {0.125, 0.125}; string Format = "A16B16G16R16F";>;
texture SSRLightX1MapTemp : RENDERCOLORTARGET<float2 ViewportRatio = {1.0, 1.0}; string Format = "A16B16G16R16F";>;
texture SSRLightX2MapTemp : RENDERCOLORTARGET<float2 ViewportRatio = {0.5, 0.5}; string Format = "A16B16G16R16F";>;
texture SSRLightX3MapTemp : RENDERCOLORTARGET<float2 ViewportRatio = {0.25, 0.25}; string Format = "A16B16G16R16F";>;
texture SSRLightX4MapTemp : RENDERCOLORTARGET<float2 ViewportRatio = {0.125, 0.125}; string Format = "A16B16G16R16F";>;

sampler SSRLightX1Samp = sampler_state { texture = <SSRLightX1Map>; MinFilter = LINEAR; MagFilter = LINEAR; AddressU = CLAMP; AddressV = CLAMP; MipFilter = NONE; };
sampler SSRLightX2Samp = sampler_state { texture = <SSRLightX2Map>; MinFilter = LINEAR; MagFilter = LINEAR; AddressU = CLAMP; AddressV = CLAMP; MipFilter = NONE; };
sampler SSRLightX3Samp = sampler_state { texture = <SSRLightX3Map>; MinFilter = LINEAR; MagFilter = LINEAR; AddressU = CLAMP; AddressV = CLAMP; MipFilter = NONE; };
sampler SSRLightX4Samp = sampler_state { texture = <SSRLightX4Map>; MinFilter = LINEAR; MagFilter = LINEAR; AddressU = CLAMP; AddressV = CLAMP; MipFilter = NONE; };
sampler SSRLightX1SampTemp = sampler_state { texture = <SSRLightX1MapTemp>; MinFilter = LINEAR; MagFilter = LINEAR; AddressU = CLAMP; AddressV = CLAMP; MipFilter = NONE; };
sampler SSRLightX2SampTemp = sampler_state { texture = <SSRLightX2MapTemp>; MinFilter = LINEAR; MagFilter = LINEAR; AddressU = CLAMP; AddressV = CLAMP; MipFilter = NONE; };
sampler SSRLightX3SampTemp = sampler_state { texture = <SSRLightX3MapTemp>; MinFilter = LINEAR; MagFilter = LINEAR; AddressU = CLAMP; AddressV = CLAMP; MipFilter = NONE; };
sampler SSRLightX4SampTemp = sampler_state { texture = <SSRLightX4MapTemp>; MinFilter = LINEAR; MagFilter = LINEAR; AddressU = CLAMP; AddressV = CLAMP; MipFilter = NONE; };

/**
 * Screen-Space Raymarching & Reflection Hit-Testing Pixel Shader.
 */
float4 SSRConeTracingPS(in float4 coord : TEXCOORD0, in float3 viewdir : TEXCOORD1) : COLOR 
{
	float4 gbuffDepth = tex2Dlod(Gbuffer8Map, float4(coord.xy, 0, 0));
	clip(gbuffDepth.x - 1e-5f);

	float4 gbuffAlbedo = tex2Dlod(Gbuffer5Map, float4(coord.xy, 0, 0));
	clip(gbuffAlbedo.w - 0.05f);

	float4 gbuffNormal = tex2Dlod(Gbuffer6Map, float4(coord.xy, 0, 0));
	float4 gbuffSpecular = tex2Dlod(Gbuffer7Map, float4(coord.xy, 0, 0));

	MaterialParam surfaceMat;
	DecodeGbuffer(gbuffAlbedo, gbuffNormal, gbuffSpecular, gbuffDepth, surfaceMat);

	float3 surfaceReflectivity = surfaceMat.albedo + surfaceMat.specular;
	clip(sum(surfaceReflectivity) - 1e-5f);

	float3 viewVector = normalize(viewdir);
	float3 worldPosVS = viewdir * (surfaceMat.linearDepth / viewdir.z);
	float3 reflectRayVS = normalize(reflect(-viewVector, surfaceMat.normal));

	float reflectionFacingAngle = dot(reflectRayVS, -viewVector);
	clip(reflectionFacingAngle - 1e-5f);

	float traceDistance = mSSRRangeScale;
	traceDistance *= max(0.0f, mSSRRangeMax - surfaceMat.linearDepth) + surfaceMat.linearDepth;
	traceDistance *= pow(1.0f - saturate(dot(viewVector, surfaceMat.normal)) * (1.0f - SSR_QUALITY * 0.1f), 5.0f - SSR_QUALITY);

	float2 hitScreenUV = 0.0f;
	float3 traceConfig = float3(mSSROffset * (1.0f - saturate(dot(viewVector, surfaceMat.normal))), mSSRThickness, 0.0f);

	bool isHit = HZTrace(SSR_MAX_RAY_STEPS, worldPosVS, reflectRayVS, traceDistance * 2.0f, traceConfig, hitScreenUV);
	if (!isHit)
		clip(-1);

	// Screen-edge vignette fading for both ray origin and target hit destination to eliminate edge cutoff
	float2 screenCenterDist = abs(coord.xy * 2.0f - 1.0f);
	float invEdgeWidth = 1.0f / max(0.01f, 1.0f - mSSRFadeStart);
	float edgeVignette = 1.0f - saturate((screenCenterDist.x - mSSRFadeStart) * invEdgeWidth);
	edgeVignette *= 1.0f - saturate((screenCenterDist.y - mSSRFadeStart) * invEdgeWidth);

	float2 hitCenterDist = abs(hitScreenUV * 2.0f - 1.0f);
	float hitVignette = 1.0f - saturate((hitCenterDist.x - 0.85f) / 0.15f);
	hitVignette *= 1.0f - saturate((hitCenterDist.y - 0.85f) / 0.15f);

	float finalVignette = smoothstep(0.0f, 1.0f, edgeVignette * hitVignette);

	float angleFade = saturate(reflectionFacingAngle);
	float finalFade = finalVignette * angleFade;

	float ssrMask = tex2Dlod(SSRMapSamp, float4(coord.xy, 0, 0)).a;
	finalFade *= ssrMask;

	float4 hitColor = tex2Dlod(ShadingMapPointSamp, float4(hitScreenUV, 0, 0));
	return float4(hitColor.rgb, 1.0f) * finalFade;
}

/**
 * 5-Tap Bilateral / Gaussian Separable Blur Filter.
 */
float4 SSRGaussionBlurPS(in float2 coord : TEXCOORD0, uniform sampler source, uniform float2 offset) : COLOR
{
	static const float kCenterWeight = 0.2023600f;
	static const float kTapWeight12  = 0.3030530f;
	static const float kTapWeight34  = 0.0957660f;
	static const float kTapOffset12  = 1.4091991f;
	static const float kTapOffset34  = 3.2979345f;

	float4 result = tex2Dlod(source, float4(coord, 0, 0)) * kCenterWeight;
	result += tex2Dlod(source, float4(coord + offset * kTapOffset12, 0, 0)) * kTapWeight12;
	result += tex2Dlod(source, float4(coord - offset * kTapOffset12, 0, 0)) * kTapWeight12;
	result += tex2Dlod(source, float4(coord + offset * kTapOffset34, 0, 0)) * kTapWeight34;
	result += tex2Dlod(source, float4(coord - offset * kTapOffset34, 0, 0)) * kTapWeight34;

	return result;
}

/**
 * Final Composite: Roughness-Weighted Mip Pyramidal Blending and PBR Fresnel Tinting.
 */
float4 SSRFinalCombinePS(in float2 coord : TEXCOORD0, in float3 viewdir : TEXCOORD1) : COLOR
{
	float4 gbuffAlbedo   = tex2Dlod(Gbuffer5Map, float4(coord, 0, 0));
	float4 gbuffNormal   = tex2Dlod(Gbuffer6Map, float4(coord, 0, 0));
	float4 gbuffSpecular = tex2Dlod(Gbuffer7Map, float4(coord, 0, 0));
	float4 gbuffDepth    = tex2Dlod(Gbuffer8Map, float4(coord, 0, 0));

	MaterialParam surfaceMat;
	DecodeGbuffer(gbuffAlbedo, gbuffNormal, gbuffSpecular, gbuffDepth, surfaceMat);

	float surfaceGlossiness = saturate(surfaceMat.smoothness + mSSRSmoothness);
	float glossSq = surfaceGlossiness * surfaceGlossiness;

	float mipBlendWeight = frac(min(glossSq, 0.9999f) * 3.0f);

	float4 mip0Color = tex2Dlod(SSRLightX1Samp, float4(coord, 0, 0));
	float4 mip1Color = tex2Dlod(SSRLightX2Samp, float4(coord, 0, 0));
	float4 mip2Color = tex2Dlod(SSRLightX3Samp, float4(coord, 0, 0));
	float4 mip3Color = tex2Dlod(SSRLightX4Samp, float4(coord, 0, 0));

	float4 blendedReflection = 0.0f;

	[branch]
	if (glossSq > (2.0f / 3.0f))
		blendedReflection = lerp(mip1Color, mip0Color, mipBlendWeight * mipBlendWeight);
	else if (glossSq > (1.0f / 3.0f))
		blendedReflection = lerp(mip2Color, mip1Color, mipBlendWeight);
	else
		blendedReflection = lerp(mip3Color, mip2Color, mipBlendWeight);

	float3 normalVS = surfaceMat.normal;
	float3 viewVector = normalize(viewdir);
	float3 specularF0 = surfaceMat.specular;

	float3 pbrFresnelColor = EnvironmentSpecularUnreal4(abs(dot(normalVS, viewVector)), surfaceGlossiness, specularF0);

	float userBrightness = mSSRBrightness;
	float fresnelFactor = lerp(0.0f, luminance(pbrFresnelColor), saturate(mSSRFresnel * 2.0f));
	fresnelFactor = lerp(fresnelFactor, 1.0f, saturate(mSSRFresnel * 2.0f - 1.0f));

	return float4(blendedReflection.rgb * pbrFresnelColor * userBrightness, blendedReflection.a * fresnelFactor);
}

#endif // RAY_MMD_POST_PROCESS_SSR_FXSUB
