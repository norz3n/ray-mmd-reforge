/**
 * Ray-MMD ReForge: Screen-Space Path Tracing (SSPT / RTGI) Resolve & Composite
 *
 * Module: SSPT_Resolve.fxsub
 * Independent PBR Diffuse Multi-Bounce Composite & Material Response Pass based on qUINT RTGI.
 * Composites path-traced irradiance, ambient occlusion, material BRDFs, and energy-conserving bounces.
 */

#ifndef RAY_MMD_SSPT_RESOLVE_FXSUB
#define RAY_MMD_SSPT_RESOLVE_FXSUB

#include "shader/SSPT/SSPT_Common.fxsub"

/**
 * Composites denoised indirect path-traced GI with material albedo, BRDF shading models, and occlusion.
 */
float4 SSPTFinalCombinePS(in float2 uvCoord : TEXCOORD0, in float3 viewDir : TEXCOORD1) : COLOR
{
	float zCenter = GetSSPTLinearDepth(uvCoord);
	MaterialParam mat;
	DecodeGbuffer(
		tex2Dlod(Gbuffer5Map, float4(uvCoord, 0.0f, 0.0f)),
		tex2Dlod(Gbuffer6Map, float4(uvCoord, 0.0f, 0.0f)),
		tex2Dlod(Gbuffer7Map, float4(uvCoord, 0.0f, 0.0f)),
		tex2Dlod(Gbuffer8Map, float4(uvCoord, 0.0f, 0.0f)),
		mat);

	if (!(zCenter > 1e-4f && zCenter < 200.0f))
		return 0.0f;

	// Glass is a purely refractive/specular dielectric: no diffuse GI absorption or emission
	if (mat.lightModel == SHADINGMODELID_GLASS)
		return 0.0f;

	float3 rawGi = tex2Dlod(SSGIMapSamp, float4(uvCoord, 0.0f, 0.0f)).rgb;
	rawGi = clamp(rawGi, 0.0f, 100.0f);

	// Pre-albedo gathered irradiance, reused for indirect specular
	float3 gatherIrradiance = rawGi;

	bool isSkin = (mat.lightModel == SHADINGMODELID_SKIN || mat.lightModel == SHADINGMODELID_SUBSURFACE);

	// AO is computed before shading and applied in-material (ShadingMaterials),
	// so it already darkens direct/IBL light before the GI composite adds bounce.
	float occlusion = 1.0f;

	float3 camDir = normalize(viewDir);
	float NdV = saturate(dot(mat.normal, camDir));

	[branch]
	if (isSkin)
	{
		rawGi = (rawGi / (1.0f + rawGi * 0.05f)) * mat.albedo;
		rawGi *= 1.0f + SKIN_GI_COMPENSATION * saturate(dot(rawGi, float3(0.299f, 0.587f, 0.114f)));
	}
	else if (mat.lightModel == SHADINGMODELID_GLASS)
	{
		rawGi *= max(0.02f, mat.albedo) * (1.0f - saturate(pow(1.0f - NdV, 5.0f))) * mat.alpha;
	}
	else if (mat.lightModel == SHADINGMODELID_CLOTH)
	{
		rawGi *= mat.albedo + mat.customDataB * (pow(1.0f - NdV, 4.0f) * mat.customDataA);
	}
	else if (mat.lightModel == SHADINGMODELID_CLEAR_COAT)
	{
		rawGi *= mat.albedo * (1.0f - mat.customDataA * (0.04f + 0.96f * pow(1.0f - NdV, 5.0f)));
	}
	else
	{
		rawGi = (rawGi / (1.0f + rawGi * 0.05f)) * mat.albedo;
	}

	// Energy-conserving multi-bounce interreflection
	// Skin features high internal scattering and dermal diffuse bounce; physical albedo response
	// prevents skin from falling into unnatural darkness compared to surrounding fabrics and geometry.
	float3 multiBounce = isSkin ? (1.0f + (mat.albedo * 2.2f) / max(1.0f - mat.albedo * 0.5f, 0.1f)) : (1.0f + (mat.albedo * 1.85f) / max(1.0f - mat.albedo * 0.6f, 0.1f));
	rawGi *= multiBounce;

#if SSGI_SPECULAR_GI
	// Rough specular indirect: Fresnel-weighted slice of gathered irradiance
	float3 specGi = 0.0f;
	if (mat.lightModel != SHADINGMODELID_GLASS && mat.lightModel != SHADINGMODELID_EMISSIVE && mat.lightModel != SHADINGMODELID_CLOTH)
	{
		float3 F = mat.specular + (1.0f - mat.specular) * pow(1.0f - NdV, 5.0f);
		float roughWeight = saturate(1.0f - mat.smoothness * 1.25f);
		specGi = gatherIrradiance * F * (roughWeight * (isSkin ? 0.25f : 0.5f));
	}
#endif

#if SUN_SHADOW_QUALITY && SUN_LIGHT_ENABLE
	float directShadow = tex2Dlod(ShadowMapSamp, float4(uvCoord, 0.0f, 0.0f)).r;
	// Direct solar shadow retention: prevents SSPT from overriding shadows from ShadowMap.
	// In direct sunlight (directShadow == 1.0), 100% of GI bounce is retained.
	// Inside deep cast shadows (directShadow == 0.0), GI is scaled by SSPT_SHADOW_RETENTION,
	// keeping shadows deep, crisp, and high-contrast while still catching warm/cool bounced light.
	float shadowRetention = lerp(SSPT_SHADOW_RETENTION, 1.0f, directShadow * directShadow);
	rawGi *= shadowRetention;
#if SSGI_SPECULAR_GI
	specGi *= shadowRetention;
#endif
#endif

	float receiverVis = tex2Dlod(SSGIVisibilityMapSamp, float4(uvCoord, 0.0f, 0.0f)).a;
#if SSGI_SPECULAR_GI
	return float4(clamp((rawGi + specGi) * mSSGIIntensity * occlusion * receiverVis, 0.0f, 100.0f), 0.0f);
#else
	return float4(clamp(rawGi * mSSGIIntensity * occlusion * receiverVis, 0.0f, 100.0f), 0.0f);
#endif
}

#endif // RAY_MMD_SSPT_RESOLVE_FXSUB
